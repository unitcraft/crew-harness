{
  "kind": "test",
  "machine": "DialogSession",
  "name": "free input: two turns of the dialog grow the counter of the agent to 2, and the user has no counter (Alula 2.26: no datum of a counter for a free input)",
  "start_at": 1000,
  "params": {"проект.срок_бездействия": 30000},
  "steps": [
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "one"}, "expect": {"state": "Awaiting", "open": ["agent-1"], "data": {"agent_attempt": 1}}},
    {"do": "feed", "event": {"kind": "answer", "name": "agent_done", "request": "agent-1"}, "expect": {"state": "Idle", "open": [], "data": {"agent_attempt": 1}}},
    {"do": "feed", "event": {"kind": "signal", "name": "user_message", "input": "two"}, "expect": {"state": "Awaiting", "open": ["agent-2"], "data": {"agent_attempt": 2}}}
  ]
}
