node_modules/

# nova build output; nova.lock.toml is NOT ignored: it pins the build and belongs in the repository.
target/

# `nova build <file>` drops <name>.exe beside the source, the package rule says built artefacts
# live in target/: the stray one is ignored rather than moved.
*.exe

# Codegen leaves a <name>.c beside every <name>.nv it compiles.
*.c

# Local replacement of a dependency by a folder (until a version of the package `alula` is published, tasks 144 and 148); it is never committed.
nova.override.toml

# Personal settings of a project of the control panel (absolute paths of the machine); the shared ones, .crew-harness/config.json, are committed (task 192.12).
.crew-harness/local.json
