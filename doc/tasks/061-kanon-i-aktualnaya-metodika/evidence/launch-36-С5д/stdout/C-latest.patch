+## Состояния
+
+```nova
+type State enum
+  // развилки
+  | ЗАХОД | ОТКАЗ | ВСЕ_ЗАКРЫТЫ | ПОВТОР_ОБРАЩЕНИЯ | СВЕРКА | РАЗБОР | БЕЗ_ПРОБ | ИТОГ | ПОТОЛОК
+  // операции
+  | ЗАМОК | РАЗБЛОК | ВОЗВРАТ | АННУЛ | ФИЛЬТР | СВОД
+  // обращения
+  | СВИДЕТЕЛЬ | ЛИНЗЫ | СБОЙ | ИЗМЕНЁН | ПОВТОР | В3 | В9 | ПРАВКА | В7 | ВОПРОС | ПРИНЯТИЕ | ПАУЗА
+  // концы
+  | ОСТАНОВЛЕНО | ОШИБКА | КОНЕЦ
+
+/// Начальное состояние — ЗАХОД. Вид состояния (обращение, операция, развилка, конец) по первоисточнику, раздел «Состояния».
+fn вид(s State) -> Kind => match s {
+  СВИДЕТЕЛЬ | ЛИНЗЫ | СБОЙ | ИЗМЕНЁН | ПОВТОР | В3 | В9 | ПРАВКА | В7 | ВОПРОС | ПРИНЯТИЕ | ПАУЗА => Обращение
+  ЗАМОК | РАЗБЛОК | ВОЗВРАТ | АННУЛ | ФИЛЬТР | СВОД => Операция
+  ЗАХОД | ОТКАЗ | ВСЕ_ЗАКРЫТЫ | ПОВТОР_ОБРАЩЕНИЯ | СВЕРКА | РАЗБОР | БЕЗ_ПРОБ | ИТОГ | ПОТОЛОК => Развилка
+  ОСТАНОВЛЕНО | ОШИБКА | КОНЕЦ => Конец
+}
+
+/// Конец ли состояние (ОСТАНОВЛЕНО, ОШИБКА, КОНЕЦ)
+fn в_конце(s State) -> bool => match s {
+  ОСТАНОВЛЕНО | ОШИБКА | КОНЕЦ => true
+  _ => false
+}
+
+/// Конец или ПАУЗА: «стоп человека» и «стоп от родителя» здесь отбрасываются
+fn в_конце_или_паузе(s State) -> bool => match s {
+  ОСТАНОВЛЕНО | ОШИБКА | КОНЕЦ | ПАУЗА => true
+  _ => false
+}
+
+/// Правка автора: обращения, где пишется предложение (ПРАВКА, ВОПРОС)
+fn правит_автор(s State) -> bool => match s {
+  ПРАВКА | ВОПРОС => true
+  _ => false
+}
+```
