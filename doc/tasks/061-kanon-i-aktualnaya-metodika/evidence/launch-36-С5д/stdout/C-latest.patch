+fn Машина @линзы(id str) -> Lens => match @линзы.get(id) {
+  Some(л) => л
+  None => unreachable("линза не заведена: записи линз создаёт метод `запустить` при старте машины")
+}
+
+fn Машина mut @установить_потери(id str, значение int) => {
+  ro л = @линзы(id)
+  @линзы.insert(id, Lens { id: л.id, lost: значение, probes: л.probes, attempt: л.attempt })
+}
+
+fn Машина mut @установить_пробы(id str, значение int) => {
+  ro л = @линзы(id)
+  @линзы.insert(id, Lens { id: л.id, lost: л.lost, probes: значение, attempt: л.attempt })
+}
+
+fn Машина mut @установить_попытку(id str, значение int) => {
+  ro л = @линзы(id)
+  @линзы.insert(id, Lens { id: л.id, lost: л.lost, probes: л.probes, attempt: значение })
+}
+```
