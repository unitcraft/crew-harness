// hub_test.nv - the session server over FILES with the fake ACP agent (task 099): the scenarios of crew_harness.server/testkit.nv.
// The same scenarios run over PostgreSQL in src/server_pg: the results must be the same.
module crew_harness.server_live

import crew_harness.server.{kit_files, kit_files_mcp, scenario_question_mcp, scenario_question_mcp_timeout, scenario_chat, scenario_stream_burst, scenario_permission, scenario_question, scenario_question_off, scenario_cancel, scenario_switch_agent, scenario_rename, scenario_order_move_delete, scenario_restart_idle, scenario_restart_open, scenario_crash, scenario_two_pages, scenario_rejects, scenario_many, scenario_broken_agent, scenario_renamed_table, scenario_migrate_flat, scenario_images, scenario_catalog, scenario_choose_cold, scenario_settings_persist, scenario_settings_family}

fn clean(report str) -> () {
    if report.byte_len() > 0 { panic("NOT AS IT MUST BE: ${report}") }
}

test "files: two turns of a chat" {
    clean(scenario_chat(kit_files("chat", 30000)))
}

test "files: burst chunks flush before the end event" {
    ro report = scenario_stream_burst(kit_files("burst", 30000))
    if report.byte_len() > 0 { panic("stream burst: ${report}") }
}

test "files: permission asked, allowed, denied" {
    clean(scenario_permission(kit_files("perm", 30000)))
}

test "files: a question with a choice is asked, answered, skipped, withdrawn" {
    clean(scenario_question(kit_files("ask", 30000)))
}

test "files: the tool ask_user_question of the hub: asked, answered, skipped, withdrawn" {
    clean(scenario_question_mcp(kit_files_mcp("askmcp", 30000, 1800000)))
}

test "files: the tool ask_user_question of the hub: nobody answers in time" {
    clean(scenario_question_mcp_timeout(kit_files_mcp("askmcpt", 30000, 700)))
}

test "files: with ask_form off the agent is not told about forms" {
    mut settings = kit_files("askoff", 30000)
    settings.ask_form = false
    clean(scenario_question_off(settings))
}

test "files: a cancel keeps the session open" {
    clean(scenario_cancel(kit_files("cancel", 30000)))
}

test "files: a session is renamed in the header" {
    clean(scenario_rename(kit_files("rename", 30000)))
}

test "files: sessions are ordered, moved to another project and deleted" {
    clean(scenario_order_move_delete(kit_files("order", 30000)))
}

test "files: the family changes in the window" {
    clean(scenario_switch_agent(kit_files("switch", 30000)))
}

test "files: the choices of the owner stay with the session" {
    clean(scenario_settings_persist(kit_files("setpersist", 30000)))
}

test "files: the choices are kept per family" {
    clean(scenario_settings_family(kit_files("setfamily", 30000)))
}

test "files: restart between turns" {
    clean(scenario_restart_idle(kit_files("restart", 30000)))
}

test "files: an older data folder with flat files is moved into the folders of the sessions" {
    clean(scenario_migrate_flat(kit_files("flat", 30000)))
}

test "files: restart in the middle of a turn" {
    clean(scenario_restart_open(kit_files("open", 2000)))
}

test "files: the agent dies" {
    clean(scenario_crash(kit_files("crash", 30000)))
}

test "files: two pages, one session" {
    clean(scenario_two_pages(kit_files("two", 30000)))
}

test "files: what cannot be done is an error" {
    clean(scenario_rejects(kit_files("rejects", 30000)))
}

test "files: several sessions" {
    clean(scenario_many(kit_files("many", 30000)))
}

test "files: an agent that refuses to start" {
    clean(scenario_broken_agent(kit_files("broken", 30000)))
}

test "files: the table with other names of the states" {
    clean(scenario_renamed_table(kit_files("renamed", 30000)))
}

test "files: pictures in a message" {
    clean(scenario_images(kit_files("images", 30000)))
}

test "files: the catalog of the families is told, written and read back" {
    clean(scenario_catalog(kit_files("catalog", 30000)))
}

test "files: a choice in a session whose agent is not running starts it and is made" {
    clean(scenario_choose_cold(kit_files("cold", 30000)))
}
