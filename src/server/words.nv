// words.nv - the words between the code and the table of the sessions (task 126): the dictionary of the border, as data.
//
// Everything that crosses the border between `src/machine/machines/dialog.alula.md` (the table: the states, the rows, the journal) and the code
// (the hub, the client of ACP, the engine) is a word of this list; `README.md` ("The border of the table and the code") says the same in words.
// `words_test.nv` keeps the two honest: a word the code gives must be here, a word marked `known` must be declared in the table, a word marked
// not known must not be (the machine writes `event_unknown` for it and does nothing else).
module crew_harness.server

/// CodeWord: a word that goes between the code and the machine of the sessions.
///   - `name`: the name of the engine event (the Latin key of the table for a word, a signal and a part);
///   - `kind`: the kind of the engine event: `input` (a word or a signal), `progress` (a part of an answer), `answered`, `refused`, `expired`;
///   - `source`: where the code makes the word;
///   - `fields`: the fields of the input (`-` - none);
///   - `known`: the table declares the word (or has a row for the answer, the failure, the term); false - the table does not know it, on purpose.
export type CodeWord { name str, kind str, source str, fields str, known bool }

fn cw(name str, kind str, source str, fields str, known bool) -> CodeWord => { name, kind, source, fields, known }

/// The words that the hub gives to the machine (from the page).
export fn words_given_by_code() -> []CodeWord => [
    cw("user_message", "input", "src/server/hub.nv: Hub.say", "content (text)", true),
    cw("cancel", "input", "src/server/hub.nv: Hub.cancel", "-", true),
    cw("permission_decision", "input", "src/server/hub.nv: Hub.decide", "request, decision (JSON text)", false),
    cw("session_created", "input", "src/server/hub.nv: Hub.create", "name, agent, folder, project (JSON text)", false)
]

/// The words that come from the agent (the client of ACP) and from the engine (the term).
export fn words_from_agent() -> []CodeWord => [
    cw("agent_chunk", "progress", "src/acp/project.nv: project_update", "content (text)", true),
    cw("agent_done", "answered", "src/acp/project.nv: stop_event (end_turn)", "-", true),
    cw("agent_refused", "refused", "src/acp/project.nv: refused_event, stop_event", "the code of FailCode", true),
    cw("timeout", "expired", "src/engine/engine.nv: the term of a request", "-", true),
    cw("agent_thought", "progress", "src/acp/project.nv: project_update", "text", false),
    cw("tool_call", "progress", "src/acp/project.nv: project_update", "JSON text", false),
    cw("tool_call_update", "progress", "src/acp/project.nv: project_update", "JSON text", false),
    cw("usage_update", "progress", "src/acp/project.nv: project_update", "JSON text", false),
    cw("plan", "progress", "src/acp/project.nv: project_update", "JSON text", false),
    cw("permission_request", "progress", "src/acp/project.nv: project_permission", "JSON text", false),
    cw("acp_skipped", "progress", "src/acp/project.nv: project_update", "text", false),
    cw("agent_model", "progress", "src/acp/project.nv: project_update (configOptions); with no open request it is a word of the same name (progress_event), the hub also gives it when the agent is ready (Hub.watch_agent)", "model (JSON text)", false),
    cw("acp_note", "input", "src/acp/client.nv: AcpClient.note", "text", false)
]
