// testkit.nv - support of the tests of the session server (here, in src/server_live and in src/server_pg): the settings of a hub
// that talks to the fake ACP agent (src/acp/testdata/fake_agent.mjs, Node 22 or newer), a rig that drives a hub as a page does,
// and the scenarios of the task. A scenario returns "" when everything was as it must be, else the list of what was not.
//
// It is ordinary code of the module and not a `_test.nv` file because two test units use it (the same scenarios run over the
// files and over PostgreSQL: the results must be the same); nothing in the product calls it. The tests look for the root of the
// repository upward from the working directory (the nearest folder with `nova.toml`).
module crew_harness.server

import crew_harness.product_machines.{dialog_machine_text}
import crew_harness.pgdb.{PgConfig}
import std.encoding.json.{Json, JsonValue, JsonObject}
import crew_harness.storage.{session_dir, session_file, session_images_dir, save_image, replace_file}
import std.fs.{Fs, real_fs, Path, try_exists, remove_dir_all, read_dir, rename, read_text}
import std.os.{Os, real_os, cwd, temp_dir, pid}

// ----- the settings of a test -----

fn kit_repo_root() -> Path {
    mut dir = with Os = real_os() {
        match cwd() {
            Ok(p) => p
            Err(e) => panic("no working directory")
        }
    }
    mut hops = 0
    while hops < 12 {
        ro marker = dir.join("nova.toml")
        ro found = with Fs = real_fs() {
            match try_exists(marker) {
                Ok(b) => b
                Err(e) => false
            }
        }
        if found { return dir }
        match dir.parent() {
            Some(par) => { dir = par }
            None => break
        }
        hops += 1
    }
    panic("nova.toml was not found above the working directory")
}

fn kit_agent(id str, extra str, marker str) -> AgentSpec {
    ro script = kit_repo_root().join("src").join("acp").join("testdata").join("fake_agent.mjs").display()
    mut args = []str.new()
    args.push(script)
    args.push("--live")
    args.push(extra)
    if marker.byte_len() > 0 { args.push("--stream-marker=${marker}") }
    AgentSpec { id, label: "Fake", program: "node", args, ask: "native" }
}

fn kit_data_dir(name str) -> str {
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("crew-server-test-${id}-${name}")
    with Fs = real_fs() {
        ro removed = remove_dir_all(dir)
    }
    dir.display()
}

fn kit_settings(store str, name str, idle_ms int, pg PgConfig) -> ServerSettings {
    ro data_dir = kit_data_dir(name)
    // the folder of the sessions is a plain folder, not a repository: in a repository the modes of work open a task with a tree of its own (task 192q)
    ro work = write_file("${data_dir}/work/.keep", "")
    mut agents = []AgentSpec.new()
    agents.push(kit_agent("opencode", "--ok", "${data_dir}/stream-active"))
    agents.push(kit_agent("broken", "--auth-error", ""))
    agents.push(kit_agent("second", "--ok", ""))
    agents.push(kit_agent("pictures", "--images", ""))
    ServerSettings {
        port: 8099, data_dir, store, pg, agents, idle_term_ms: idle_ms,
        workdir: "${data_dir}/work", web_dir: "src/web", hub_program: "", hub_args: []str.new(), acp_trace: false, ask_form: true, ask_timeout_ms: 1800000,
        stt_url: "http://127.0.0.1:8178/inference", stt_language: "auto", max_image_bytes: 10485760,
        routes_dir: "doc/routes", route_reviewer_order: ["second"], route_task_limit: 12, route_task_messages: 40, route_fix_attempts: 2, route_worktree_ask: true, route_overlap_seconds: 30
    }
}

fn kit_no_pg() -> PgConfig => { host: "127.0.0.1", port: 5432, database: "crew", user: "crew_app", password: "" }

/// The settings of a hub over files in a folder of its own, with the fake agent and the idle term of a turn.
export fn kit_files(name str, idle_ms int) -> ServerSettings => kit_settings("files", name, idle_ms, kit_no_pg())

/// The settings of a hub over files whose agent `opencode` takes the MCP tool of the questions (`ask: mcp`) and says it can use an HTTP server (`--ask` of the fake agent).
export fn kit_files_mcp(name str, idle_ms int, ask_timeout_ms int) -> ServerSettings {
    mut settings = kit_files(name, idle_ms)
    mut agents = []AgentSpec.new()
    for a in settings.agents {
        if a.id == "opencode" {
            mut args = []str.new()
            for word in a.args { args.push(word) }
            args.push("--ask")
            agents.push(AgentSpec { id: a.id, label: a.label, program: a.program, args, ask: "mcp" })
        } else {
            agents.push(a)
        }
    }
    settings.agents = agents
    settings.ask_timeout_ms = ask_timeout_ms
    settings
}

/// The settings of a hub over PostgreSQL (the connection of the test database), the inbox files in a folder of its own.
export fn kit_pg(name str, idle_ms int, pg PgConfig) -> ServerSettings => kit_settings("pg", name, idle_ms, pg)

// ----- lines of the page -----

fn kit_object(line str) -> Option[JsonObject] {
    match Json.parse(line) {
        Ok(v) => v.object()
        Err(e) => None
    }
}

/// A string field of the line of the page ("" when there is none).
export fn line_field(line str, key str) -> str {
    match kit_object(line) {
        Some(o) => match o.get(key) {
            Some(v) => v.str() ?? ""
            None => ""
        }
        None => ""
    }
}

/// A string field of the `input` of the line ("" when there is none).
export fn line_input(line str, key str) -> str {
    match kit_object(line) {
        Some(o) => match o.get("input") {
            Some(i) => match i.object() {
                Some(io) => match io.get(key) {
                    Some(v) => v.str() ?? ""
                    None => ""
                }
                None => ""
            }
            None => ""
        }
        None => ""
    }
}

/// The step of the line, -1 when there is none.
export fn line_step(line str) -> int {
    match kit_object(line) {
        Some(o) => match o.get("step") {
            Some(v) => v.int() ?? -1
            None => -1
        }
        None => -1
    }
}

/// The kinds of the lines, in order.
export fn kinds_of(lines []str) -> []str {
    mut out = []str.new()
    for line in lines { out.push(line_field(line, "kind")) }
    out
}

/// The text of the chunks of the answer of one turn, in the order of their steps.
export fn answer_of(lines []str, turn str) -> str {
    mut parts = []str.new()
    mut steps = []int.new()
    for line in lines {
        if line_field(line, "kind") == "agent_chunk" && line_input(line, "turn") == turn {
            ro step = line_step(line)
            mut at = steps.len()
            while at > 0 && step < steps[at - 1] { at -= 1 }
            steps.insert(at, step)
            parts.insert(at, line_input(line, "text"))
        }
    }
    joined(parts, "")
}

/// The first line of this kind after `from`, "" when there is none.
export fn first_of(lines []str, kind str, from int) -> str {
    mut at = 0
    for line in lines {
        if at >= from && line_field(line, "kind") == kind { return line }
        at += 1
    }
    ""
}

// The lines of a message of the hub: an array is taken apart; every line is written again by the JSON writer, so that the same
// line is the same text however it came.
fn kit_flatten(text str) -> []str {
    mut out = []str.new()
    match Json.parse(text) {
        Ok(v) => match v.array() {
            Some(items) => {
                for item in items { out.push(item.to_str()) }
            }
            None => out.push(v.to_str())
        }
        Err(e) => out.push(text)
    }
    out
}

fn kit_page_text(kind str, trace str, input str) -> str {
    ro body = match Json.parse(input) {
        Ok(v) => v
        Err(e) => panic("the input of a test message is not JSON: ${input}")
    }
    mut o = JsonObject.new()
    ro r1 = o.insert("id", JsonValue.str("page-${kind}-${trace}"))
    ro r2 = o.insert("trace", JsonValue.str(trace))
    ro r3 = o.insert("step", JsonValue.int(0))
    ro r4 = o.insert("kind", JsonValue.str(kind))
    ro r5 = o.insert("input", body)
    ro r6 = o.insert("time", JsonValue.int(0))
    JsonValue.object(o).to_str()
}

// ----- the rig: a hub driven as a page does -----

/// Heard: a message of the hub and the pages it reached (those attached at that moment).
export type Heard { conn int, text str, to []int }

/// Rig: a hub and everything it said; `mark` is the place in `heard` after which `until` looks.
export type Rig { hub Hub, heard []Heard, mark int }

/// Start a hub over the settings; a hub that cannot start stops the test.
export fn rig_open(settings ServerSettings) Proc Detach Time Net Fs Os -> Rig {
    match start_hub(settings) {
        Ok(hub) => Rig { hub, heard: []Heard.new(), mark: 0 }
        Err(e) => panic("the hub cannot start: ${e}")
    }
}

/// Start a hub over a changed text of the table of the dialog.
export fn rig_open_with(settings ServerSettings, table_text str) Proc Detach Time Net Fs Os -> Rig {
    match start_hub_from(settings, table_text) {
        Ok(hub) => Rig { hub, heard: []Heard.new(), mark: 0 }
        Err(e) => panic("the hub cannot start: ${e}")
    }
}

/// The table of the dialog as it is committed, with the two states named otherwise (`Waiting` for the open turn, `Resting` for the first state): nothing else changes.
export fn renamed_table_text() -> str {
    dialog_machine_text().replace("\"Awaiting\"", "\"Waiting\"").replace("\"Idle\"", "\"Resting\"")
}

fn Rig mut @collect() -> () {
    for o in @hub.take_output() {
        @heard.push(Heard { conn: o.conn, text: o.text, to: if o.conn == 0 { @hub.attached() } else { [o.conn] } })
    }
}

/// A page sends an event of this kind about this session; `input` is the JSON text of its input.
export fn Rig mut @page(conn int, kind str, trace str, input str) Proc Detach Time -> () {
    @hub.handle(conn, kit_page_text(kind, trace, input))
    @collect()
}

/// A page is attached.
export fn Rig mut @attach(conn int) -> () {
    @hub.attach(conn)
    @collect()
}

/// Forget what was heard so far: `until` looks only at what comes after this.
export fn Rig mut @forget() -> () {
    @mark = @heard.len()
}

/// Pump for `ms` milliseconds.
export fn Rig mut @run(ms int) Proc Detach Time -> () {
    ro deadline = Time.now().unix_millis() + ms
    while Time.now().unix_millis() < deadline {
        ro made = @hub.pump()
        @collect()
        10.to_millis().sleep()
    }
}

/// Pump until a message that came after the last success holds the text, at most `limit_ms`. True - it did; the next call looks after that message.
export fn Rig mut @until(needle str, limit_ms int) Proc Detach Time -> bool {
    ro deadline = Time.now().unix_millis() + limit_ms
    while Time.now().unix_millis() < deadline {
        ro made = @hub.pump()
        @collect()
        mut at = @mark
        while at < @heard.len() {
            if @heard[at].text.contains(needle) {
                @mark = at + 1
                return true
            }
            at += 1
        }
        10.to_millis().sleep()
    }
    false
}

// The lines one page has been told: mode 0 - the lines of the sessions, 1 - the lines of the catalog of the families (task 192o), 2 - all of them.
fn Rig @lines_in_mode(conn int, mode int) -> []str {
    mut out = []str.new()
    for h in @heard {
        if h.to.contains(conn) {
            for line in kit_flatten(h.text) {
                ro catalog = line_field(line, "kind") == "agent_catalog"
                if mode == 2 || (mode == 1 && catalog) || (mode == 0 && !catalog) { out.push(line) }
            }
        }
    }
    out
}

/// The lines of the sessions one page has been told, in order (a message with an array is taken apart; the lines of the catalog are not among
/// them), without `route_state` (it is not a part of the story of the session).
export fn Rig @lines_for(conn int) -> []str {
    mut out = []str.new()
    for line in @lines_in_mode(conn, 0) {
        if line_field(line, "kind") != "route_state" { out.push(line) }
    }
    out
}

/// The same with the lines `route_state` (the mode of work, task 192q).
export fn Rig @all_lines_for(conn int) -> []str => @lines_in_mode(conn, 0)

/// The lines of the catalog of the families one page has been told, in order.
export fn Rig @catalog_for(conn int) -> []str => @lines_in_mode(conn, 1)

/// Everything one page has been told, in order.
export fn Rig @everything_for(conn int) -> []str => @lines_in_mode(conn, 2)

/// Close the hub: the processes of the agents are killed.
export fn Rig mut @shut() Time -> () {
    @hub.close()
}

// ----- the checks of a scenario -----

/// Check: what a scenario found wrong.
export type Check { failures []str }

fn Check mut @expect(ok bool, what str) -> () {
    if !ok { @failures.push(what) }
}

fn Check @report() -> str => kit_text_with(@failures, "; ")

fn kit_text(lines []str) -> str => joined(lines, "\n")

fn kit_text_with(lines []str, sep str) -> str => joined(lines, sep)

// Where two lists of lines differ: "" when they do not, else the first place and the two lines.
fn kit_diff(a []str, b []str) -> str {
    mut at = 0
    while at < a.len() && at < b.len() {
        if a[at] != b[at] { return "line ${at}: ${a[at]} <> ${b[at]}" }
        at += 1
    }
    if a.len() != b.len() { return "${a.len()} lines <> ${b.len()} lines" }
    ""
}

fn kit_check() -> Check => { failures: []str.new() }

fn kit_file_exists(path str) -> bool {
    with Fs = real_fs() {
        match try_exists(Path.from_bytes(path.bytes())) {
            Ok(value) => value
            Err(error) => false
        }
    }
}

fn kit_unique(lines []str) -> bool {
    mut seen = []str.new()
    for line in lines {
        ro id = line_field(line, "id")
        if seen.contains(id) { return false }
        seen.push(id)
    }
    true
}

fn kit_increasing(lines []str) -> bool {
    mut last = -1
    for line in lines {
        ro step = line_step(line)
        if step <= last { return false }
        last = step
    }
    true
}

fn kit_with(lines []str, needle str) -> int {
    mut n = 0
    for line in lines {
        if line.contains(needle) { n += 1 }
    }
    n
}

const KIT_DONE = "\"kind\":\"agent_done\""

// ----- the scenarios -----

/// Create a session, talk in it twice: the chunks, the turns, the ids and the steps of the lines.
export fn scenario_chat(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-chat", "{\"name\":\"Проба\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 3000), "the session is shown")
    rig.page(1, "user_message", "s-chat", "{\"turn\":\"page-turn\",\"text\":\"привет мир\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the first turn ends")
    rig.page(1, "user_message", "s-chat", "{\"turn\":\"page-turn-2\",\"text\":\"второй ход\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the second turn ends")
    ro lines = rig.lines_for(1)
    ro kinds = kinds_of(lines)
    c.expect(kinds.len() > 0 && kinds[0] == "session_created", "the first line is the session")
    c.expect(kit_with(lines, "\"kind\":\"user_message\"") == 2, "two messages of the owner")
    c.expect(kit_with(lines, KIT_DONE) == 2, "two ends of a turn")
    c.expect(kit_unique(lines), "the ids are unique")
    c.expect(kit_increasing(lines), "the steps grow")
    ro first = first_of(lines, "user_message", 0)
    ro turn1 = line_input(first, "turn")
    ro second = first_of(lines, "user_message", 3)
    ro turn2 = line_input(second, "turn")
    c.expect(turn1.byte_len() > 0 && turn2.byte_len() > 0 && turn1 != turn2, "the turns differ")
    c.expect(answer_of(lines, turn1) == "Echo: привет мир", "the answer of the first turn: ${answer_of(lines, turn1)}")
    c.expect(answer_of(lines, turn2) == "Echo: второй ход", "the answer of the second turn: ${answer_of(lines, turn2)}")
    c.expect(line_field(lines[0], "trace") == "s-chat", "the trace is the session")
    c.expect(line_input(lines[0], "name") == "Проба", "the name of the session")
    c.expect(rig.hub.takes_message("s-chat"), "the session is open for the next message")
    c.expect(rig.hub.machine_name() == "DialogSession", "the sessions run on the Alula machine DialogSession")
    c.expect(rig.hub.state_text_of("s-chat").contains("\"started\":true"), "the snapshot is the state of an Alula machine")
    rig.shut()
    c.report()
}

/// A real ACP child produces faster than a slow store can persist. The page must receive a chunk
/// at a pump boundary while the producer marker is still present and before agent_done.
export fn scenario_stream_burst(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-burst", "{\"name\":\"Поток\",\"agent\":\"opencode\"}")
    rig.page(1, "session_created", "s-fair", "{\"name\":\"Вторая сессия\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 3000), "the session is shown")
    c.expect(rig.until("\"trace\":\"s-fair\"", 3000), "the second session is shown")
    rig.page(1, "user_message", "s-burst", "{\"turn\":\"t-burst\",\"text\":\"burst\"}")
    rig.page(1, "user_message", "s-fair", "{\"turn\":\"t-fair\",\"text\":\"short\"}")
    mut saw_chunk_before_done = false
    mut burst_done = false
    mut fair_done = false
    mut fair_done_before_burst = false
    mut attached_during_stream = false
    mut producer_active_at_flush = false
    ro deadline = Time.now().unix_millis() + 15000
    while (!burst_done || !fair_done) && Time.now().unix_millis() < deadline {
        ro made = rig.hub.pump()
        rig.collect()
        ro burst_lines = rig.hub.page_lines("s-burst")
        ro fair_lines = rig.hub.page_lines("s-fair")
        mut first_chunk = false
        for line in burst_lines {
            if line_field(line, "kind") == "agent_chunk" { first_chunk = true }
            if line_field(line, "kind") == "agent_done" { burst_done = true }
        }
        for line in fair_lines {
            if line_field(line, "kind") == "agent_done" { fair_done = true }
        }
        if first_chunk && !saw_chunk_before_done && !burst_done {
            saw_chunk_before_done = true
            producer_active_at_flush = kit_file_exists("${settings.data_dir}/stream-active")
        }
        if fair_done && !burst_done { fair_done_before_burst = true }
        if first_chunk && !burst_done && !attached_during_stream {
            rig.attach(2)
            attached_during_stream = true
        }
        if !burst_done || !fair_done { 5.to_millis().sleep() }
    }
    c.expect(saw_chunk_before_done, "a page-visible chunk precedes agent_done at a pump boundary")
    c.expect(producer_active_at_flush, "the fake ACP producer is still running when the chunk is drained")
    c.expect(burst_done && fair_done, "both turns end")
    c.expect(fair_done_before_burst, "the second session finishes while the burst session is still pumping")
    c.expect(attached_during_stream, "a new page can attach during the burst")
    c.expect(kit_with(rig.lines_for(2), "\"kind\":\"agent_chunk\"") > 0, "the attaching page receives in-flight history")
    ro lines = rig.hub.page_lines("s-burst")
    ro turn = line_input(first_of(lines, "user_message", 0), "turn")
    ro text = answer_of(lines, turn)
    mut expected = ""
    mut i = 0
    while i < 256 {
        expected = "${expected}b${i};"
        i += 1
    }
    c.expect(text == expected, "the burst text is complete and ordered")
    c.expect(kit_with(lines, "\"kind\":\"agent_chunk\"") == 256, "each burst chunk is shown once")
    c.expect(kit_unique(lines) && kit_increasing(lines), "event ids and steps stay unique and increasing")
    rig.shut()
    mut again = rig_open(settings)
    ro restored = again.hub.page_lines("s-burst")
    c.expect(kit_text(restored) == kit_text(lines), "the committed burst history is identical after restart")
    again.shut()
    c.report()
}

/// The agent asks for permission: the owner allows one request and denies the next.
export fn scenario_permission(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-perm", "{\"name\":\"Разрешения\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-perm", "{\"turn\":\"t1\",\"text\":\"permission go\"}")
    c.expect(rig.until("\"kind\":\"permission_request\"", 15000), "the request for permission is shown")
    ro asked = first_of(rig.lines_for(1), "permission_request", 0)
    ro request = line_input(asked, "request")
    c.expect(request.byte_len() > 0, "the request has a key")
    c.expect(line_input(asked, "action") == "edit", "the action of the request")
    c.expect(!rig.hub.takes_message("s-perm"), "the turn waits for the owner")
    rig.page(1, "permission_decision", "s-perm", "{\"request\":\"${request}\",\"decision\":\"allow\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the turn ends after the decision")
    ro lines = rig.lines_for(1)
    c.expect(kit_with(lines, "permission: selected:allow-once") == 1, "the agent was told: allow")
    c.expect(kit_with(lines, "\"kind\":\"permission_decision\"") == 1, "the decision is shown")
    c.expect(kit_with(lines, "\"kind\":\"tool_call\"") >= 1, "the tool call is shown")
    // the second request is denied
    rig.page(1, "user_message", "s-perm", "{\"turn\":\"t2\",\"text\":\"permission again\"}")
    c.expect(rig.until("\"kind\":\"permission_request\"", 15000), "the second request is shown")
    ro asked2 = first_of(rig.lines_for(1), "permission_request", 0)
    ro all = rig.lines_for(1)
    mut second_request = ""
    mut seen = 0
    for line in all {
        if line_field(line, "kind") == "permission_request" {
            seen += 1
            if seen == 2 { second_request = line_input(line, "request") }
        }
    }
    c.expect(second_request.byte_len() > 0 && second_request != request, "the second request has a key of its own")
    rig.page(1, "permission_decision", "s-perm", "{\"request\":\"${second_request}\",\"decision\":\"deny\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the second turn ends")
    c.expect(kit_with(rig.lines_for(1), "permission: selected:reject-once") == 1, "the agent was told: deny")
    // a decision nobody asked for changes nothing
    ro before = rig.lines_for(1).len()
    rig.page(1, "permission_decision", "s-perm", "{\"request\":\"999\",\"decision\":\"allow\"}")
    rig.run(150)
    c.expect(rig.lines_for(1).len() == before, "a decision nobody asked for is not shown")
    rig.shut()
    c.report()
}

/// The agent asks the owner a question with a choice (task 192i): the page gets `question_request`, the answer reaches the agent as the content of the
/// form and the page is told `question_resolved`; a skip is declined; a cancelled turn takes the form away.
export fn scenario_question(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-ask", "{\"name\":\"Вопросы\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-ask", "{\"turn\":\"t1\",\"text\":\"ask go\"}")
    c.expect(rig.until("\"kind\":\"question_request\"", 15000), "the question is shown")
    ro asked = first_of(rig.lines_for(1), "question_request", 0)
    ro request = line_input(asked, "request")
    c.expect(request.byte_len() > 0, "the question has a key")
    c.expect(asked.contains("Какой формат?") && asked.contains("YAML") && asked.contains("\"multiSelect\":false"), "the question has its text and its options")
    c.expect(!rig.hub.takes_message("s-ask"), "the turn waits for the owner")
    rig.page(1, "question_answer", "s-ask", "{\"request\":\"${request}\",\"skipped\":false,\"answers\":[{\"index\":0,\"selected\":[\"YAML\"],\"other\":\"\"}]}")
    c.expect(rig.until(KIT_DONE, 15000), "the turn ends after the answer")
    ro lines = rig.lines_for(1)
    c.expect(kit_with(lines, "accept") == 1 && kit_with(lines, "question_0") == 1, "the agent got the choice")
    c.expect(kit_with(lines, "\"kind\":\"question_resolved\"") == 1, "the page is told the question is settled")
    // the second question is skipped
    rig.page(1, "user_message", "s-ask", "{\"turn\":\"t2\",\"text\":\"ask again\"}")
    c.expect(rig.until("\"kind\":\"question_request\"", 15000), "the second question is shown")
    mut second = ""
    mut seen = 0
    for line in rig.lines_for(1) {
        if line_field(line, "kind") == "question_request" {
            seen += 1
            if seen == 2 { second = line_input(line, "request") }
        }
    }
    c.expect(second.byte_len() > 0 && second != request, "the second question has a key of its own")
    rig.page(1, "question_answer", "s-ask", "{\"request\":\"${second}\",\"skipped\":true}")
    c.expect(rig.until(KIT_DONE, 15000), "the second turn ends")
    c.expect(kit_with(rig.lines_for(1), "decline") == 1, "the agent was told: declined")
    // an answer nobody asked for changes nothing
    ro before = rig.lines_for(1).len()
    rig.page(1, "question_answer", "s-ask", "{\"request\":\"999\",\"skipped\":true}")
    rig.run(150)
    c.expect(rig.lines_for(1).len() == before, "an answer nobody asked for is not shown")
    // a cancel takes the form away
    rig.page(1, "user_message", "s-ask", "{\"turn\":\"t3\",\"text\":\"ask third\"}")
    c.expect(rig.until("\"kind\":\"question_request\"", 15000), "the third question is shown")
    rig.page(1, "cancel", "s-ask", "{}")
    c.expect(rig.until("\"kind\":\"question_resolved\"", 5000), "a cancelled turn settles the question")
    c.expect(rig.until("\"kind\":\"cancel\"", 5000), "the cancel is shown")
    c.expect(rig.hub.takes_message("s-ask"), "the session is open after the cancel")
    rig.run(300)
    c.expect(kit_with(rig.lines_for(1), "\"kind\":\"question_resolved\"") == 3, "each question is settled once")
    rig.shut()
    c.report()
}

/// The agent asks through the MCP tool of the hub (task 192i): the tool is handed over in `session/new`, the call waits for the owner, the answer is the text of the
/// tool; a skip and a cancelled turn are told to the agent, the page takes the form away each time.
export fn scenario_question_mcp(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    c.expect(rig.hub.mcp_address("s-mcp").starts_with("http://127.0.0.1:"), "the MCP server listens on the loopback")
    c.expect(rig.hub.mcp_token().byte_len() >= 32, "the token is long")
    rig.attach(1)
    rig.page(1, "session_created", "s-mcp", "{\"name\":\"MCP\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-mcp", "{\"turn\":\"t1\",\"text\":\"askmcp go\"}")
    c.expect(rig.until("\"kind\":\"question_request\"", 20000), "the question of the tool is shown")
    ro asked = first_of(rig.lines_for(1), "question_request", 0)
    ro request = line_input(asked, "request")
    c.expect(request.starts_with("mcp-"), "the key of the question")
    c.expect(asked.contains("Какой формат?") && asked.contains("YAML"), "the question has its text and its options")
    c.expect(!rig.hub.takes_message("s-mcp"), "the turn waits for the owner")
    rig.page(1, "question_answer", "s-mcp", "{\"request\":\"${request}\",\"skipped\":false,\"answers\":[{\"index\":0,\"selected\":[\"YAML\"],\"other\":\"\"}]}")
    c.expect(rig.until(KIT_DONE, 20000), "the turn ends after the answer")
    ro lines = rig.lines_for(1)
    c.expect(kit_with(lines, "ask_user_question") >= 1 && kit_with(lines, "YAML") >= 2, "the agent saw the tool and got the choice")
    c.expect(kit_with(lines, "\"kind\":\"question_resolved\"") == 1, "the page is told the question is settled")
    // skipped
    rig.page(1, "user_message", "s-mcp", "{\"turn\":\"t2\",\"text\":\"askmcp again\"}")
    c.expect(rig.until("\"kind\":\"question_request\"", 20000), "the second question is shown")
    mut second = ""
    mut seen = 0
    for line in rig.lines_for(1) {
        if line_field(line, "kind") == "question_request" {
            seen += 1
            if seen == 2 { second = line_input(line, "request") }
        }
    }
    c.expect(second.starts_with("mcp-") && second != request, "the second question has a key of its own")
    rig.page(1, "question_answer", "s-mcp", "{\"request\":\"${second}\",\"skipped\":true}")
    c.expect(rig.until(KIT_DONE, 20000), "the second turn ends")
    c.expect(kit_with(rig.lines_for(1), "пропустил") == 1, "the agent was told: skipped")
    // an answer nobody asked for changes nothing
    ro before = rig.lines_for(1).len()
    rig.page(1, "question_answer", "s-mcp", "{\"request\":\"mcp-999\",\"skipped\":true}")
    rig.run(150)
    c.expect(rig.lines_for(1).len() == before, "an answer nobody asked for is not shown")
    // a cancel takes the form away
    rig.page(1, "user_message", "s-mcp", "{\"turn\":\"t3\",\"text\":\"askmcp third\"}")
    c.expect(rig.until("\"kind\":\"question_request\"", 20000), "the third question is shown")
    rig.page(1, "cancel", "s-mcp", "{}")
    c.expect(rig.until("\"kind\":\"question_resolved\"", 5000), "a cancelled turn settles the question")
    c.expect(rig.until("\"kind\":\"cancel\"", 5000), "the cancel is shown")
    c.expect(rig.hub.takes_message("s-mcp"), "the session is open after the cancel")
    rig.shut()
    c.report()
}

/// A question of the tool that nobody answers in time: the agent is told the term passed and the page takes the form away.
export fn scenario_question_mcp_timeout(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-mcpt", "{\"name\":\"MCP term\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-mcpt", "{\"turn\":\"t1\",\"text\":\"askmcp go\"}")
    c.expect(rig.until("\"kind\":\"question_request\"", 20000), "the question is shown")
    c.expect(rig.until("\"kind\":\"question_resolved\"", 20000), "the term passed: the form is taken away")
    c.expect(rig.until(KIT_DONE, 20000), "the turn goes on and ends")
    c.expect(kit_with(rig.lines_for(1), "таймаут ожидания ответа") == 1, "the agent was told: the term passed")
    rig.shut()
    c.report()
}

/// With the setting `ask_form` off the agent is not told that the client shows forms, so it does not ask (the fake agent says so).
export fn scenario_question_off(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-askoff", "{\"name\":\"Без вопросов\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-askoff", "{\"turn\":\"t1\",\"text\":\"ask go\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the turn ends")
    c.expect(kit_with(rig.lines_for(1), "ask: no-form") == 1, "the agent was not told about forms")
    c.expect(kit_with(rig.lines_for(1), "question_request") == 0, "no question is shown")
    rig.shut()
    c.report()
}

/// The table of the dialog with other names of the states: the hub does the same (a message while a turn is open is not taken, a cancel ends the turn, the next turn works).
export fn scenario_renamed_table(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open_with(settings, renamed_table_text())
    rig.attach(1)
    rig.page(1, "session_created", "s-ren", "{\"name\":\"Другие имена\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-ren", "{\"turn\":\"t1\",\"text\":\"slow go\"}")
    c.expect(rig.until("\"text\":\"started\"", 15000), "the turn has begun")
    c.expect(rig.hub.state_of("s-ren") == "Waiting", "the names of the states are those of the changed table")
    c.expect(!rig.hub.takes_message("s-ren"), "the open turn does not take a message")
    ro log_before = rig.hub.take_log()
    rig.page(1, "user_message", "s-ren", "{\"turn\":\"t2\",\"text\":\"second\"}")
    rig.run(200)
    c.expect(kit_with(rig.lines_for(1), "\"kind\":\"user_message\"") == 1, "a message while a turn is open is not taken")
    c.expect(kit_with(rig.hub.take_log(), "while a turn is open: ignored") == 1, "the hub says it ignored the message")
    rig.page(1, "cancel", "s-ren", "{}")
    c.expect(rig.until("\"kind\":\"cancel\"", 5000), "the cancel is shown")
    c.expect(rig.hub.state_of("s-ren") == "Resting", "the first state has the changed name too")
    c.expect(rig.hub.takes_message("s-ren"), "the session takes a message after the cancel")
    rig.run(600)
    rig.page(1, "user_message", "s-ren", "{\"turn\":\"t3\",\"text\":\"after cancel\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the next turn ends")
    c.expect(answer_of(rig.lines_for(1), line_input(first_of(rig.lines_for(1), "user_message", 4), "turn")) == "Echo: after cancel", "the next turn is answered")
    rig.shut()
    c.report()
}

/// The owner cancels a turn: the session stays open, the late words of the agent are not shown, the next turn works.
export fn scenario_cancel(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-cancel", "{\"name\":\"Отмена\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-cancel", "{\"turn\":\"t1\",\"text\":\"slow go\"}")
    c.expect(rig.until("\"text\":\"started\"", 15000), "the turn has begun")
    c.expect(!rig.hub.takes_message("s-cancel"), "the turn is open")
    rig.page(1, "cancel", "s-cancel", "{}")
    c.expect(rig.until("\"kind\":\"cancel\"", 5000), "the cancel is shown")
    c.expect(rig.hub.takes_message("s-cancel"), "the session is open after the cancel")
    // the agent answers the cancelled turn late: a chunk and the stop reason; neither is shown
    rig.run(600)
    c.expect(kit_with(rig.lines_for(1), "late chunk") == 0, "the late chunk is not shown")
    c.expect(kit_with(rig.lines_for(1), "\"kind\":\"agent_refused\"") == 0, "the late stop reason is not shown")
    rig.page(1, "user_message", "s-cancel", "{\"turn\":\"t2\",\"text\":\"after cancel\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the next turn ends")
    c.expect(answer_of(rig.lines_for(1), line_input(first_of(rig.lines_for(1), "user_message", 4), "turn")) == "Echo: after cancel", "the next turn is answered")
    c.expect(rig.hub.takes_message("s-cancel"), "the session is open")
    rig.shut()
    c.report()
}

/// The family changes in the window (task 192): the same session, another agent; the protocol goes to it as a turn that the feed does not show.
export fn scenario_switch_agent(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-sw", "{\"name\":\"Смена\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-sw", "{\"turn\":\"t1\",\"text\":\"before the change\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the first turn ends")
    rig.page(1, "session_agent", "s-sw", "{\"agent\":\"nobody\"}")
    c.expect(rig.until("unknown agent: nobody", 5000), "an agent nobody configured is refused")
    rig.page(1, "session_agent", "s-sw", "{\"agent\":\"second\"}")
    c.expect(rig.until("\"kind\":\"agent_switched\"", 15000), "the change is told to the page")
    ro told = first_of(rig.lines_for(1), "agent_switched", 0)
    c.expect(line_input(told, "to") == "second" && line_input(told, "from") == "opencode", "the change names both agents")
    c.expect(rig.hub.session_ids().len() == 1, "no new session")
    rig.page(1, "user_message", "s-sw", "{\"turn\":\"t2\",\"text\":\"after the change\"}")
    c.expect(rig.until(KIT_DONE, 20000), "the next turn is answered by the new agent")
    ro lines = rig.lines_for(1)
    c.expect(answer_of(lines, line_input(first_of(lines, "user_message", 3), "turn")) == "Echo: after the change", "the next message goes to the new agent")
    c.expect(kit_with(lines, "Это продолжение разговора") == 0, "the turn of the protocol is not shown")
    ro before = rig.hub.page_lines("s-sw")
    rig.shut()

    mut again = rig_open(settings)
    c.expect(kit_text(again.hub.page_lines("s-sw")) == kit_text(before), "the lines are the same after the restart")
    again.shut()
    c.report()
}

// ----- the choices of the owner stay with the session (task 192t) -----

// The settings with the agent `opencode` that has no "yolo" in its list of modes any more (`--no-yolo` of the fake agent).
fn kit_without_yolo(settings ServerSettings) -> ServerSettings {
    mut agents = []AgentSpec.new()
    for a in settings.agents {
        if a.id == "opencode" {
            mut args = []str.new()
            for word in a.args { args.push(word) }
            args.push("--no-yolo")
            agents.push(AgentSpec { id: a.id, label: a.label, program: a.program, args, ask: a.ask })
        } else {
            agents.push(a)
        }
    }
    ServerSettings {
        port: settings.port, data_dir: settings.data_dir, store: settings.store, pg: settings.pg, agents, idle_term_ms: settings.idle_term_ms,
        workdir: settings.workdir, web_dir: settings.web_dir, hub_program: settings.hub_program, hub_args: settings.hub_args, acp_trace: settings.acp_trace,
        ask_form: settings.ask_form, ask_timeout_ms: settings.ask_timeout_ms, stt_url: settings.stt_url, stt_language: settings.stt_language,
        max_image_bytes: settings.max_image_bytes, routes_dir: settings.routes_dir, route_reviewer_order: settings.route_reviewer_order, route_task_limit: settings.route_task_limit,
        route_task_messages: settings.route_task_messages, route_fix_attempts: settings.route_fix_attempts, route_worktree_ask: settings.route_worktree_ask, route_overlap_seconds: settings.route_overlap_seconds
    }
}

// A message `text` to the session, then the answer of the turn once it ends ("" when it did not end).
fn kit_ask(mut rig Rig, trace str, text str) Proc Detach Time Net Fs Os -> str {
    rig.forget()
    ro from = rig.lines_for(1).len()
    rig.page(1, "user_message", trace, "{\"turn\":\"t${from}\",\"text\":\"${text}\"}")
    if !rig.until(KIT_DONE, 20000) { return "" }
    ro lines = rig.lines_for(1)
    answer_of(lines, line_input(first_of(lines, "user_message", from), "turn"))
}

// The owner chooses; true when the summary of the page shows `needle` (the setting as the summary names it).
fn kit_choose(mut rig Rig, trace str, setting str, value str, needle str) Proc Detach Time Net Fs Os -> bool {
    rig.forget()
    rig.page(1, "session_setting", trace, "{\"setting\":\"${setting}\",\"value\":\"${value}\"}")
    rig.until(needle, 8000)
}

fn kit_last_of(lines []str, kind str) -> str {
    mut last = ""
    for line in lines {
        if line_field(line, "kind") == kind { last = line }
    }
    last
}

const KIT_DEFAULTS = "mode: default model: fake-model effort: medium"
const KIT_CHOSEN = "mode: yolo model: fake-model-b effort: high"

/// The owner chose a mode, a model and an effort: they are in the journal, and every agent that is started again (the hub restarts, the
/// agent dies) gets them again; a value the agent does not offer any more is dropped with a line in the feed.
export fn scenario_settings_persist(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-set", "{\"name\":\"Выбор\",\"agent\":\"opencode\"}")
    c.expect(kit_ask(rig, "s-set", "mode") == "mode: default model: fake-model effort: medium", "a new agent has its defaults")
    c.expect(kit_choose(rig, "s-set", "mode", "yolo", "\"mode\":\"yolo\""), "the mode is chosen")
    c.expect(kit_choose(rig, "s-set", "model", "fake-model-b", "\"model_id\":\"fake-model-b\""), "the model is chosen")
    c.expect(kit_choose(rig, "s-set", "effort", "high", "\"effort\":\"high\""), "the effort is chosen")
    c.expect(kit_ask(rig, "s-set", "mode") == KIT_CHOSEN, "the agent holds the choices")
    rig.run(200)
    ro journal = kit_file_text(kit_session_file(settings, "s-set", "journal"))
    c.expect(journal.contains("setting_chosen") && journal.contains("yolo") && journal.contains("fake-model-b"), "the journal keeps the choices")
    rig.shut()

    mut again = rig_open(settings)
    again.attach(1)
    ro shown = kit_last_of(again.hub.page_lines("s-set"), "session_model")
    c.expect(shown.contains("\"mode\":\"yolo\"") && shown.contains("\"effort\":\"high\""), "the page shows the choices before the agent is started")
    c.expect(kit_ask(again, "s-set", "mode") == KIT_CHOSEN, "the agent of the restarted hub gets the choices again")
    ro summary = kit_last_of(again.lines_for(1), "session_model")
    c.expect(summary.contains("\"mode\":\"yolo\"") && summary.contains("\"model_id\":\"fake-model-b\""), "the summary after the start has the choices: ${summary}")
    again.forget()
    again.page(1, "user_message", "s-set", "{\"turn\":\"tc\",\"text\":\"crash go\"}")
    c.expect(again.until("\"reason\":\"ConnectionLost\"", 15000), "the agent dies")
    c.expect(kit_ask(again, "s-set", "mode") == KIT_CHOSEN, "the agent that replaces the dead one gets the choices")
    again.shut()

    mut changed = rig_open(kit_without_yolo(settings))
    changed.attach(1)
    c.expect(kit_ask(changed, "s-set", "mode") == "mode: default model: fake-model-b effort: high", "a mode the agent does not offer is not asked for")
    c.expect(kit_with(changed.lines_for(1), "\"kind\":\"setting_dropped\"") == 1, "the owner is told in the feed")
    ro dropped = first_of(changed.lines_for(1), "setting_dropped", 0)
    c.expect(line_input(dropped, "setting") == "mode" && line_input(dropped, "value") == "yolo" && line_input(dropped, "used") == "default", "the line names the mode, the lost value and the one used")
    changed.shut()

    mut last = rig_open(settings)
    last.attach(1)
    c.expect(kit_ask(last, "s-set", "mode") == "mode: default model: fake-model-b effort: high", "the dropped choice is gone from the journal")
    last.shut()
    c.report()
}

/// The choices are kept per family: a family that comes later has its own, and the way back brings the first ones back.
export fn scenario_settings_family(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-fam", "{\"name\":\"Семьи\",\"agent\":\"opencode\"}")
    c.expect(kit_ask(rig, "s-fam", "mode") == KIT_DEFAULTS, "the first family starts with its defaults")
    c.expect(kit_choose(rig, "s-fam", "mode", "yolo", "\"mode\":\"yolo\""), "the first family: yolo")
    rig.forget()
    rig.page(1, "session_agent", "s-fam", "{\"agent\":\"second\"}")
    c.expect(rig.until("\"kind\":\"agent_switched\"", 15000), "to the second family")
    c.expect(kit_ask(rig, "s-fam", "mode") == KIT_DEFAULTS, "the choices of the first family do not go to the second")
    c.expect(kit_choose(rig, "s-fam", "mode", "plan", "\"mode\":\"plan\""), "the second family: plan")
    rig.page(1, "session_agent", "s-fam", "{\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"agent_switched\"", 15000), "back to the first family")
    c.expect(kit_ask(rig, "s-fam", "mode") == "mode: yolo model: fake-model effort: medium", "the way back brings the first choices back")
    rig.page(1, "session_agent", "s-fam", "{\"agent\":\"second\"}")
    c.expect(rig.until("\"kind\":\"agent_switched\"", 15000), "to the second family again")
    c.expect(kit_ask(rig, "s-fam", "mode") == "mode: plan model: fake-model effort: medium", "the second family has its own choice")
    rig.shut()

    mut again = rig_open(settings)
    again.attach(1)
    c.expect(kit_ask(again, "s-fam", "mode") == "mode: plan model: fake-model effort: medium", "after the restart the family of the session has its choice")
    again.shut()
    c.report()
}

fn kit_png_bytes() -> []u8 => [137 as u8, 80 as u8, 78 as u8, 71 as u8, 13 as u8, 10 as u8, 26 as u8, 10 as u8]

// The base64 of kit_png_bytes: 12 characters.
const KIT_PNG_B64 = "iVBORw0KGgo="

fn kit_file_text(path str) -> str {
    with Fs = real_fs() {
        match read_text(Path.from_bytes(path.bytes())) {
            Ok(t) => t
            Err(e) => ""
        }
    }
}

fn kit_session_file(settings ServerSettings, session str, name str) -> str {
    match session_file(settings.data_dir, session, name) {
        Some(path) => path.display()
        None => ""
    }
}

fn kit_image_path(settings ServerSettings, session str, file str) -> str {
    match session_images_dir(settings.data_dir, session) {
        Some(dir) => dir.join(file).display()
        None => ""
    }
}

// The lines of one session.
fn kit_of_trace(lines []str, trace str) -> []str {
    mut out = []str.new()
    for line in lines {
        if line_field(line, "trace") == trace { out.push(line) }
    }
    out
}

// The answer to the first message of a session.
fn kit_first_answer(lines []str, trace str) -> str {
    ro mine = kit_of_trace(lines, trace)
    answer_of(mine, line_input(first_of(mine, "user_message", 0), "turn"))
}

fn kit_picture_input(turn str, text str, images str) -> str => "{\"turn\":\"${turn}\",\"text\":\"${text}\",\"images\":${images}}"

/// Pictures in a message (task 192): kept as files, the journal and the lines of the page hold the records and never the bytes; an agent that
/// says it takes pictures gets image blocks; one that does not gets the text with a note and the page an information line; a picture the page has put
/// by number is found; a message with too many pictures, a wrong type or a missing file is refused as a whole.
export fn scenario_images(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-pic", "{\"name\":\"Картинки\",\"agent\":\"pictures\"}")
    rig.page(1, "user_message", "s-pic", kit_picture_input("t1", "look", "[{\"name\":\"shot.png\",\"mime\":\"image/png\",\"data\":\"${KIT_PNG_B64}\"}]"))
    c.expect(rig.until(KIT_DONE, 15000), "the turn with a picture ends")
    ro lines = rig.lines_for(1)
    ro records = first_of(lines, "message_images", 0)
    c.expect(records.contains("\"n\":1") && records.contains("\"bytes\":8") && records.contains("\"name\":\"shot.png\"") && records.contains("image/png"), "the page is told the record of the picture: ${records}")
    c.expect(kit_with(lines, KIT_PNG_B64) == 0, "the bytes are in no line of the page")
    c.expect(kit_first_answer(lines, "s-pic") == "Echo: look [blocks:text,image; image/png:12:iVBORw0K]", "the agent got a text block and an image block: ${kit_first_answer(lines, "s-pic")}")
    c.expect(kit_file_exists(kit_image_path(settings, "s-pic", "1.png")), "the picture is kept as a file")
    ro journal = kit_file_text(kit_session_file(settings, "s-pic", "journal"))
    c.expect(journal.contains("message_images") && !journal.contains(KIT_PNG_B64), "the journal holds the record, not the bytes")

    rig.page(1, "session_created", "s-nopic", "{\"name\":\"Без картинок\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-nopic", kit_picture_input("t1", "look", "[{\"name\":\"shot.png\",\"mime\":\"image/png\",\"data\":\"${KIT_PNG_B64}\"}]"))
    c.expect(rig.until("images_skipped", 15000), "an agent that does not take pictures: the page is told")
    c.expect(rig.until(KIT_DONE, 15000), "the turn without the picture ends")
    ro plain = rig.lines_for(1)
    ro skipped = first_of(plain, "images_skipped", 0)
    c.expect(skipped.contains("\"count\":1") && skipped.contains("\"trace\":\"s-nopic\""), "the information line counts the pictures: ${skipped}")
    ro said = kit_first_answer(plain, "s-nopic")
    c.expect(said == "Echo: look\n[приложено изображений: 1, агент их не принимает]", "the text carries the note and no image block went: ${said}")
    c.expect(kit_file_exists(kit_image_path(settings, "s-nopic", "1.png")), "the picture is kept all the same")

    // a picture the page has put by number (the front keeps it: POST /api/session-image), sent alone
    ro put = save_image(settings.data_dir, "s-ref", "image/png", kit_png_bytes())
    c.expect(put.n == 1 && put.reason == "", "the upload gets the number 1")
    rig.page(1, "session_created", "s-ref", "{\"name\":\"По номеру\",\"agent\":\"pictures\"}")
    rig.page(1, "user_message", "s-ref", kit_picture_input("t1", "", "[{\"name\":\"a.png\",\"n\":1}]"))
    c.expect(rig.until("[blocks:image; image/png:12:iVBORw0K]", 15000), "a picture alone goes as an image block without a text block")
    c.expect(rig.until(KIT_DONE, 15000), "the turn of a picture alone ends")

    // refused as a whole: nothing of the message is kept in the journal
    rig.forget()
    rig.page(1, "user_message", "s-ref", kit_picture_input("t2", "x", "[{\"name\":\"a\",\"n\":1},{\"name\":\"a\",\"n\":1},{\"name\":\"a\",\"n\":1},{\"name\":\"a\",\"n\":1},{\"name\":\"a\",\"n\":1},{\"name\":\"a\",\"n\":1},{\"name\":\"a\",\"n\":1}]"))
    c.expect(rig.until("at most 6 pictures", 3000), "seven pictures are refused")
    rig.page(1, "user_message", "s-ref", kit_picture_input("t3", "x", "[{\"name\":\"a.txt\",\"mime\":\"text/plain\",\"data\":\"QUJD\"}]"))
    c.expect(rig.until("is not taken", 3000), "a type that is not a picture is refused")
    rig.page(1, "user_message", "s-ref", kit_picture_input("t4", "x", "[{\"name\":\"gone.png\",\"n\":99}]"))
    c.expect(rig.until("gone.png is not there", 3000), "a picture that is not there is refused")
    c.expect(kit_with(rig.lines_for(1), "\"kind\":\"user_message\"") == 3, "no refused message is shown or kept")
    c.expect(rig.hub.takes_message("s-ref"), "the session still takes a message")

    ro before = rig.hub.page_lines("s-pic")
    rig.shut()
    mut again = rig_open(settings)
    c.expect(kit_text(again.hub.page_lines("s-pic")) == kit_text(before), "the lines with the record of the picture are the same after the restart")
    c.expect(kit_with(again.hub.page_lines("s-pic"), "message_images") == 1, "the record comes back from the journal")
    again.shut()
    c.report()
}

fn kit_write_file(path str, text str) -> bool {
    with Fs = real_fs() { replace_file(Path.from_bytes(path.bytes()), text) }
}

fn kit_after_gap() Time -> int => Time.now().unix_millis()

/// The catalog of the families (task 192o): what an agent gave is told to the pages at once and written to `<data_dir>/agents.json` (not oftener than every 2 s);
/// a page that comes later is told the catalog before the sessions; a damaged file is ignored with a line in the log.
export fn scenario_catalog(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    ro file = "${settings.data_dir}/agents.json"
    mut rig = rig_open(settings)
    rig.attach(1)
    c.expect(!kit_file_exists(file), "no catalog file before an agent gave something")
    rig.page(1, "session_created", "s-cat", "{\"name\":\"Каталог\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"agent_catalog\"", 15000), "the catalog of the family is told to the page when the agent gave its choices")
    ro first_at = kit_after_gap()
    ro told = first_of(rig.catalog_for(1), "agent_catalog", 0)
    c.expect(line_input(told, "agent") == "opencode" && line_input(told, "model_id") == "fake-model" && line_input(told, "mode") == "default", "the line names the agent and carries its values: ${told}")
    c.expect(kit_file_text(file).contains("\"opencode\"") && kit_file_text(file).contains("Fake Model") && kit_file_text(file).contains("Asks before changes"), "the first record is written at once: ${kit_file_text(file)}")
    rig.page(1, "user_message", "s-cat", "{\"turn\":\"t1\",\"text\":\"model-change please\"}")
    c.expect(rig.until("\"kind\":\"agent_catalog\"", 15000), "a change of the choices is told to the page again")
    ro changed_at = kit_after_gap()
    c.expect(kit_with(rig.catalog_for(1), "Second Model") >= 1, "the new list is in the line")
    if changed_at - first_at < 1500 {
        c.expect(!kit_file_text(file).contains("Second Model"), "the second write waits for the gap of 2 s")
    }
    c.expect(rig.until(KIT_DONE, 15000), "the turn ends")
    rig.run(2400)
    c.expect(kit_file_text(file).contains("Second Model") && !kit_file_text(file).contains("Fake Model"), "after the gap the change is written: ${kit_file_text(file)}")
    rig.page(1, "session_agent", "s-cat", "{\"agent\":\"second\"}")
    c.expect(rig.until("\"kind\":\"agent_switched\"", 15000), "the family changes")
    c.expect(rig.until("catalog/second/", 15000), "the other family gives its choices and gets a record of its own")
    rig.run(2400)
    c.expect(kit_file_text(file).contains("\"second\":{") && kit_file_text(file).contains("\"opencode\":{"), "both records are in the file: ${kit_file_text(file)}")
    rig.shut()

    mut again = rig_open(settings)
    again.attach(9)
    ro lines = again.everything_for(9)
    c.expect(again.catalog_for(9).len() == 2, "a page that comes after the restart is told both records: ${again.catalog_for(9).len()}")
    c.expect(kinds_of(lines).len() > 0 && kinds_of(lines)[0] == "agent_catalog", "the catalog comes before the sessions")
    again.shut()

    c.expect(kit_write_file(file, "{\"agents\":{\"opencode\":{\"mod"), "a damaged file is made")
    mut third = rig_open(settings)
    ro said = kit_text(third.hub.take_log())
    c.expect(said.contains("agents.json"), "the damaged file is named in the log: ${said}")
    third.attach(9)
    c.expect(third.catalog_for(9).len() == 0, "a damaged file gives no records")
    third.shut()
    c.report()
}

/// A choice of the owner (mode) in a session whose agent is not running (after a restart): the hub starts the agent and makes the choice when it is ready (task 192).
export fn scenario_choose_cold(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-cold", "{\"name\":\"Холодная\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-cold", "{\"turn\":\"t1\",\"text\":\"before\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the first turn ends")
    rig.shut()

    mut again = rig_open(settings)
    again.attach(2)
    c.expect(!again.hub.has_agent("s-cold"), "no agent is running after the restart")
    again.page(2, "session_setting", "s-cold", "{\"setting\":\"mode\",\"value\":\"plan\"}")
    c.expect(again.until("\"mode\":\"plan\"", 20000), "the agent is started for the choice and the page is told the new mode")
    c.expect(again.hub.has_agent("s-cold"), "the agent is running now")
    again.shut()
    c.report()
}

/// The service restarts between two turns: the session, its lines and its next turn.
export fn scenario_restart_idle(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-rest", "{\"name\":\"Перезапуск\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-rest", "{\"turn\":\"t1\",\"text\":\"before restart\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the first turn ends")
    ro before = rig.hub.page_lines("s-rest")
    rig.shut()

    mut again = rig_open(settings)
    c.expect(again.hub.session_ids().len() == 1 && again.hub.session_ids()[0] == "s-rest", "the session is found")
    ro after = again.hub.page_lines("s-rest")
    c.expect(kit_text(after) == kit_text(before), "the lines of the page are the same after the restart")
    c.expect(again.hub.takes_message("s-rest"), "the session is idle")
    c.expect(!again.hub.has_agent("s-rest"), "no agent is started for an idle session")
    again.attach(7)
    c.expect(again.lines_for(7).len() == before.len(), "a page that comes after the restart is told everything")
    again.forget()
    again.page(7, "user_message", "s-rest", "{\"turn\":\"t2\",\"text\":\"after restart\"}")
    c.expect(again.until(KIT_DONE, 15000), "the turn after the restart ends")
    ro lines = again.lines_for(7)
    ro turn = line_input(first_of(lines, "user_message", before.len()), "turn")
    c.expect(answer_of(lines, turn) == "Echo: after restart", "the turn after the restart is answered: ${answer_of(lines, turn)} (turn ${turn}, ${lines.len()} lines)")
    c.expect(kit_unique(lines) && kit_increasing(lines), "the ids are unique and the steps grow across the restart")
    again.shut()
    c.report()
}

// The folder of a session back to the flat files of the older form (`<root>/<id>/journal` -> `<root>/<id>.journal`); the folder is removed.
fn kit_flatten(root str, id str) Fs -> int {
    mut moved = 0
    match session_dir(root, id) {
        None => ()
        Some(dir) => {
            match read_dir(dir) {
                Err(e) => ()
                Ok(entries) => {
                    for entry in entries {
                        match entry.name_str() {
                            Some(name) => {
                                match rename(dir.join(name), Path.from_bytes(root.bytes()).join("${id}.${name}")) {
                                    Ok(done) => { moved += 1 }
                                    Err(e) => ()
                                }
                            }
                            None => ()
                        }
                    }
                }
            }
            ro removed = remove_dir_all(dir)
        }
    }
    moved
}

fn kit_there(root str, id str, name str) -> bool {
    match session_file(root, id, name) {
        None => false
        Some(p) => with Fs = real_fs() {
            match try_exists(p) {
                Ok(b) => b
                Err(e) => false
            }
        }
    }
}

/// The files of a session lie in the folder of the session (task 192k); a data folder of the older form (flat files) is moved into the
/// folders at the start of the hub, the session is resumed from its folder, the next start moves nothing.
export fn scenario_migrate_flat(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    ro root = settings.data_dir
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-flat", "{\"name\":\"Flat\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-flat", "{\"turn\":\"t1\",\"text\":\"before the move\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the first turn ends")
    ro before = rig.hub.page_lines("s-flat")
    rig.shut()
    c.expect(kit_there(root, "s-flat", "snapshot") && kit_there(root, "s-flat", "journal"), "a new session writes into its folder: snapshot and journal")
    c.expect(kit_there(root, "s-flat", "inbox"), "the inbox of the agent is in the folder too")

    // the data folder as the older versions left it
    ro flat = with Fs = real_fs() { kit_flatten(root, "s-flat") }
    c.expect(flat >= 3, "the folder is turned into flat files (${flat})")
    c.expect(!kit_there(root, "s-flat", "snapshot"), "the folder of the session is gone")

    mut again = rig_open(settings)
    c.expect(kit_with(again.hub.take_log(), "migrated 1 sessions to per-session folders") == 1, "the hub says it migrated one session")
    c.expect(again.hub.session_ids().len() == 1 && again.hub.session_ids()[0] == "s-flat", "the session is found in its folder")
    c.expect(kit_text(again.hub.page_lines("s-flat")) == kit_text(before), "the lines of the page are the same after the migration")
    c.expect(kit_there(root, "s-flat", "snapshot") && kit_there(root, "s-flat", "journal") && kit_there(root, "s-flat", "inbox"), "the files are in the folder")
    c.expect(again.hub.takes_message("s-flat"), "the session is idle")
    again.attach(7)
    again.forget()
    again.page(7, "user_message", "s-flat", "{\"turn\":\"t2\",\"text\":\"after the move\"}")
    c.expect(again.until(KIT_DONE, 15000), "the turn after the migration ends")
    ro lines = again.lines_for(7)
    ro turn = line_input(first_of(lines, "user_message", before.len()), "turn")
    c.expect(answer_of(lines, turn) == "Echo: after the move", "the turn after the migration is answered: ${answer_of(lines, turn)}")
    again.shut()

    mut third = rig_open(settings)
    c.expect(kit_with(third.hub.take_log(), "migrated") == 0, "the next start moves nothing")
    c.expect(third.hub.session_ids().len() == 1, "the session is still there")
    third.shut()
    c.report()
}

/// The service restarts while a turn is open: the request ends with Timeout, the session goes on.
export fn scenario_restart_open(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-open", "{\"name\":\"Открытый запрос\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-open", "{\"turn\":\"t1\",\"text\":\"silent go\"}")
    rig.run(300)
    c.expect(!rig.hub.takes_message("s-open"), "the turn is open")
    rig.shut()

    mut again = rig_open(settings)
    c.expect(!again.hub.takes_message("s-open"), "the request is still open after the restart")
    c.expect(again.hub.has_agent("s-open"), "an agent is started for the open request")
    again.attach(3)
    c.expect(again.until("\"reason\":\"Timeout\"", 15000), "the request ends with Timeout")
    c.expect(again.hub.takes_message("s-open"), "the session is open after the timeout")
    again.page(3, "user_message", "s-open", "{\"turn\":\"t2\",\"text\":\"still here\"}")
    c.expect(again.until(KIT_DONE, 15000), "the next turn ends")
    ro lines = again.lines_for(3)
    c.expect(kit_with(lines, "\"kind\":\"agent_refused\"") == 1, "one refusal")
    c.expect(answer_of(lines, line_input(first_of(lines, "user_message", 2), "turn")) == "Echo: still here", "the next turn is answered")
    again.shut()
    c.report()
}

/// The agent dies in the middle of a turn: the refusal ConnectionLost, and the next message gets a new agent.
export fn scenario_crash(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-crash", "{\"name\":\"Падение\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-crash", "{\"turn\":\"t1\",\"text\":\"crash go\"}")
    c.expect(rig.until("\"reason\":\"ConnectionLost\"", 15000), "the refusal ConnectionLost is shown")
    c.expect(kit_with(rig.lines_for(1), "about to crash") == 1, "the word before the crash is shown")
    c.expect(rig.hub.takes_message("s-crash"), "the session is open after the crash")
    rig.page(1, "user_message", "s-crash", "{\"turn\":\"t2\",\"text\":\"after crash\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the next turn ends with a new agent")
    ro lines = rig.lines_for(1)
    c.expect(answer_of(lines, line_input(first_of(lines, "user_message", 3), "turn")) == "Echo: after crash", "the next turn is answered")
    rig.shut()
    c.report()
}

/// Two pages on one session see the same lines; a page that comes later is told the whole story.
export fn scenario_two_pages(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.attach(2)
    rig.page(1, "session_created", "s-two", "{\"name\":\"Двое\",\"agent\":\"opencode\"}")
    rig.page(2, "user_message", "s-two", "{\"turn\":\"t1\",\"text\":\"from the second page\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the turn ends")
    rig.attach(3)
    rig.forget()
    ro a = rig.lines_for(1)
    ro b = rig.lines_for(2)
    ro late = rig.lines_for(3)
    c.expect(a.len() > 3, "the first page was told")
    c.expect(kit_text(a) == kit_text(b), "both pages see the same lines")
    c.expect(kit_diff(late, a) == "", "the page that came later is told the same story: ${kit_diff(late, a)}")
    rig.page(1, "user_message", "s-two", "{\"turn\":\"t2\",\"text\":\"from the first page\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the second turn ends")
    c.expect(kit_diff(rig.lines_for(2), rig.lines_for(3)) == "", "the second and the third page see the same lines: ${kit_diff(rig.lines_for(2), rig.lines_for(3))}")
    rig.hub.release(2)
    rig.page(1, "user_message", "s-two", "{\"turn\":\"t3\",\"text\":\"alone\"}")
    c.expect(rig.until(KIT_DONE, 15000), "the third turn ends")
    c.expect(rig.lines_for(2).len() < rig.lines_for(1).len(), "a page that went is told nothing more")
    rig.shut()
    c.report()
}

/// What cannot be done is told to the page as an error and nothing is kept.
export fn scenario_rejects(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-bad", "{\"name\":\"Чужой\",\"agent\":\"nobody\"}")
    ro lines = rig.lines_for(1)
    c.expect(lines.len() == 2 && line_field(lines[0], "kind") == "session_created" && line_field(lines[1], "kind") == "error", "an unknown agent is an error")
    c.expect(line_input(lines[1], "message").contains("nobody"), "the error names the agent")
    c.expect(rig.hub.session_ids().len() == 0, "nothing is kept")
    rig.page(1, "session_created", "bad/name", "{\"name\":\"x\",\"agent\":\"opencode\"}")
    c.expect(rig.lines_for(1).len() == 4, "a name that is not safe is an error too")
    c.expect(rig.hub.session_ids().len() == 0, "nothing is kept for it either")
    rig.page(1, "user_message", "nowhere", "{\"turn\":\"t\",\"text\":\"hello\"}")
    rig.page(1, "cancel", "nowhere", "{}")
    c.expect(rig.lines_for(1).len() == 4, "a message to an unknown session is not answered")
    c.expect(rig.hub.take_log().len() > 0, "but it is logged")
    rig.shut()
    c.report()
}

/// Several sessions side by side: independent, found again in order after a restart.
export fn scenario_many(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-b", "{\"name\":\"Вторая\",\"agent\":\"opencode\"}")
    rig.page(1, "session_created", "s-a", "{\"name\":\"Первая\",\"agent\":\"opencode\"}")
    rig.page(1, "user_message", "s-a", "{\"turn\":\"t1\",\"text\":\"alpha\"}")
    rig.page(1, "user_message", "s-b", "{\"turn\":\"t1\",\"text\":\"beta\"}")
    c.expect(rig.until(KIT_DONE, 15000), "one turn ends")
    c.expect(rig.until(KIT_DONE, 15000), "the other ends")
    ro a = rig.hub.page_lines("s-a")
    ro b = rig.hub.page_lines("s-b")
    c.expect(answer_of(a, line_input(first_of(a, "user_message", 0), "turn")) == "Echo: alpha", "the first session has its own answer")
    c.expect(answer_of(b, line_input(first_of(b, "user_message", 0), "turn")) == "Echo: beta", "the second session has its own answer")
    c.expect(kit_unique(rig.lines_for(1)), "the ids of different sessions do not meet")
    rig.shut()

    mut again = rig_open(settings)
    ro ids = again.hub.session_ids()
    c.expect(ids.len() == 2 && ids[0] == "s-a" && ids[1] == "s-b", "both sessions are found, in order of their names")
    c.expect(kit_text(again.hub.page_lines("s-a")) == kit_text(a), "the first session is the same")
    c.expect(kit_text(again.hub.page_lines("s-b")) == kit_text(b), "the second session is the same")
    again.attach(5)
    c.expect(again.lines_for(5).len() == a.len() + b.len(), "a page is told both sessions")
    again.shut()
    c.report()
}

/// An agent that refuses the handshake: the session exists, the page is told, and a message gets a refusal.
export fn scenario_broken_agent(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-broken", "{\"name\":\"Сломанный\",\"agent\":\"broken\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 3000), "the session is shown")
    c.expect(rig.until("refused to start", 10000), "the page is told that the agent refused to start")
    ro told = first_of(rig.lines_for(1), "error", 0)
    c.expect(line_input(told, "message").contains("Authentication required"), "the reason is told: ${line_input(told, "message")}")
    c.expect(rig.hub.session_ids().len() == 1, "the session is kept")
    rig.page(1, "user_message", "s-broken", "{\"turn\":\"t\",\"text\":\"hello\"}")
    c.expect(rig.until("\"kind\":\"agent_refused\"", 10000), "a message gets a refusal")
    c.expect(rig.hub.takes_message("s-broken"), "the session stays open")
    rig.shut()
    c.report()
}
