// signals.nv - the signals between the code and the table of the sessions (task 126): the dictionary of the border, as data.
//
// Everything that crosses the border between `src/machine/machines/dialog.alula.md` (the table: the states, the rows, the journal) and the code
// (the hub, the client of ACP, the engine) is a signal of this list; `README.md` ("The border of the table and the code") says the same in prose.
// `signals_test.nv` keeps the two honest: a signal the code gives must be here, a signal marked `known` must be declared in the table, a signal marked
// not known must not be (the machine writes `event_unknown` for it and does nothing else).
module crew_harness.server

/// CodeSignal: a signal that goes between the code and the machine of the sessions.
///   - `name`: the name of the engine event (the Latin key of the table for a signal of a party, a signal of the machine and a part);
///   - `kind`: the kind of the engine event: `input` (a signal of a party or of the machine), `progress` (a part of an answer), `answered`, `refused`, `expired`;
///   - `source`: where the code makes the signal;
///   - `fields`: the fields of the input (`-` - none);
///   - `known`: the table declares the signal (or has a row for the answer, the failure, the term); false - the table does not know it, on purpose.
export type CodeSignal { name str, kind str, source str, fields str, known bool }

fn cs(name str, kind str, source str, fields str, known bool) -> CodeSignal => { name, kind, source, fields, known }

/// The signals that the hub gives to the machine (from the page).
export fn signals_given_by_code() -> []CodeSignal => [
    cs("user_message", "input", "src/server/hub.nv: Hub.say", "content (text)", true),
    cs("cancel_request", "input", "src/server/hub.nv: Hub.cancel", "-", true),
    cs("permission_decision", "input", "src/server/hub.nv: Hub.decide", "request, decision (JSON text)", false),
    cs("question_answer", "input", "src/server/hub.nv: Hub.answer", "request, skipped, answers (JSON text)", false),
    cs("session_created", "input", "src/server/hub.nv: Hub.create", "name, agent, folder, project, project_id (JSON text)", false),
    cs("agent_switched", "input", "src/server/hub.nv: Hub.switch_agent", "from, to, shown, total, cut (JSON text)", false),
    cs("message_images", "input", "src/server/hub.nv: Hub.say (the pictures of the message that follows: n, name, mime, bytes)", "images (JSON text)", false),
    cs("route_set", "input", "src/server/routes_hub.nv: Hub.rt_journal (the mode of work of the session)", "route (JSON text)", false),
    cs("route_task", "input", "src/server/routes_hub.nv: Hub.rt_task_op (the task and its subtasks, trees, state)", "op and its fields (JSON text)", false),
    cs("route_step", "input", "src/server/routes_hub.nv: Hub.rt_step (the state of a step of the mode)", "n, state (JSON text)", false),
    cs("route_note", "input", "src/server/routes_hub.nv: Hub.rt_note (a line of the hub in the feed)", "text (JSON text)", false),
    cs("route_review", "input", "src/server/routes_hub.nv: Hub.route_review_finish (the block of the independent review in the feed)", "family, step, text (JSON text)", false),
    cs("setting_chosen", "input", "src/server/hub.nv: Hub.watch_agent (the agent took a choice of the owner)", "agent, setting, value, at (JSON text)", false),
    cs("setting_dropped", "input", "src/server/hub.nv: Hub.watch_agent (the agent does not offer a saved choice any more)", "agent, setting, value, used (JSON text)", false)
]

/// The signals that come from the agent (the client of ACP) and from the engine (the term).
export fn signals_from_agent() -> []CodeSignal => [
    cs("agent_chunk", "progress", "src/acp/project.nv: project_update", "content (text)", true),
    cs("agent_done", "answered", "src/acp/project.nv: stop_event (end_turn)", "-", true),
    cs("agent_refused", "refused", "src/acp/project.nv: refused_event, stop_event", "the code of FailCode", true),
    cs("timeout", "expired", "src/engine/engine.nv: the term of a request", "-", true),
    cs("turn_usage", "progress", "src/acp/client.nv: on_result (the usage of session/prompt), src/acp/project.nv: turn_usage_projection", "new, cached, output, total, reason (JSON text)", false),
    cs("agent_thought", "progress", "src/acp/project.nv: project_update", "text", false),
    cs("tool_call", "progress", "src/acp/project.nv: project_update", "JSON text", false),
    cs("tool_call_update", "progress", "src/acp/project.nv: project_update", "JSON text", false),
    cs("usage_update", "progress", "src/acp/project.nv: project_update", "JSON text", false),
    cs("plan", "progress", "src/acp/project.nv: project_update", "JSON text", false),
    cs("permission_request", "progress", "src/acp/project.nv: project_permission", "JSON text", false),
    cs("question_request", "progress", "src/acp/ask.nv: project_question", "JSON text", false),
    cs("question_resolved", "progress", "src/acp/client.nv: AcpClient.resolve_asks", "JSON text", false),
    cs("acp_skipped", "progress", "src/acp/project.nv: project_update", "text", false),
    cs("agent_model", "progress", "src/acp/project.nv: project_update (configOptions); with no open request it is a signal of the same name (progress_event), the hub also gives it when the agent is ready (Hub.watch_agent)", "model (JSON text)", false),
    cs("acp_note", "input", "src/acp/client.nv: AcpClient.note", "text", false),
    cs("images_skipped", "input", "src/acp/client.nv: AcpClient.drive (the agent did not say promptCapabilities.image)", "agent, count (JSON text)", false)
]
