// dialog_test.nv - the many-turn chat session (`dialog_session`, task 099): after an answer, a refusal, a timeout or a cancel
// of the turn the session stays open and takes the next message. The machine as a pure function, and the engine over it in
// memory with the deaths of rules 13 and 34(e) of the methodology: the process dies between the changes of one step, and the
// other side (the agent) acts in the window.
module crew_harness.server

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import crew_harness.engine.{Engine, MemoryWorld, Incoming, EventKind, FailCode, JournalEntry, Order, StepEnvironment, Transition, Journal, Store, Link, start_engine, resume_engine, memory_journal, memory_store, memory_link, memory_time, journal_line, journal_event, param}
import crew_harness.chat.{ChatSession, ChatState, dialog_session, chat_session, encode_chat_state, user_says, user_cancels, agent_chunk, agent_done, agent_refused}

// ----- the machine as a pure function -----

fn d_stamped(kind EventKind, name str, request Option[str], input str) -> Incoming => {
    id: "e-1", trace: "t-1", step: 2, kind, name, request, input, at: 1000
}

// The result of one step: where the machine goes and the orders it gave to the environment.
type DRun { state ChatState, orders []Order }

fn d_machine_run(session ChatSession, state ChatState, event Incoming) -> DRun {
    mut environment = StepEnvironment.new()
    ro transition = session.step(state, event, environment)
    match transition {
        Go(next) => DRun { state: next, orders: environment.orders }
        Stay => DRun { state, orders: environment.orders }
    }
}

fn d_summary(orders []Order) -> str {
    mut parts = []str.new()
    for o in orders {
        match o {
            Send(order) => parts.push("Send(${order.party}:${order.input})")
            Note(event) => parts.push("Log")
            Cancel(order) => parts.push("Cancel(${order.party})")
            Save => parts.push("Save")
            Finish(c) => parts.push("Finish")
        }
    }
    parts.join(",")
}

fn d_run(state ChatState, event Incoming) -> DRun => d_machine_run(dialog_session(30000), state, event)

fn d_name(state ChatState) -> str => dialog_session(30000).state_name(state)

fn d_same(first ChatState, second ChatState) -> bool => encode_chat_state(first) == encode_chat_state(second)

fn d_said(text str) -> Incoming => d_stamped(EventKind.Input, "user_message", None, text)
fn d_chunk(text str) -> Incoming => d_stamped(EventKind.Progress, "agent_chunk", Some("agent-1"), text)
fn d_done() -> Incoming => d_stamped(EventKind.Answered, "agent_done", Some("agent-1"), "")
fn d_refused(code str) -> Incoming => d_stamped(EventKind.Refused, "agent_refused", Some("agent-1"), code)
fn d_expired() -> Incoming => d_stamped(EventKind.Expired, "timeout", Some("agent-1"), "")
fn d_cancel() -> Incoming => d_stamped(EventKind.Input, "cancel", None, "")

fn d_waiting() -> ChatState => d_run(dialog_session(30000).initial(), d_said("hi")).state

test "dialog: an answer leaves the session in Idle, not finished" {
    ro r = d_run(d_run(d_waiting(), d_chunk("Hel")).state, d_done())
    assert(d_name(r.state) == "Idle")
    assert(d_summary(r.orders) == "Log,Save")
}

test "dialog: the next message after an answer opens the next request" {
    ro idle = d_run(d_waiting(), d_done()).state
    ro r = d_run(idle, d_said("second"))
    assert(d_name(r.state) == "Awaiting")
    assert(d_summary(r.orders) == "Log,Send(agent:second),Save")
}

test "dialog: a refusal, a timeout and a cancel end the turn, not the session" {
    ro refused = d_run(d_waiting(), d_refused("ModelRefused"))
    assert(d_name(refused.state) == "Idle")
    assert(d_summary(refused.orders) == "Log,Save")
    ro expired = d_run(d_waiting(), d_expired())
    assert(d_name(expired.state) == "Idle")
    assert(d_summary(expired.orders) == "Log,Save")
    ro cancelled = d_run(d_waiting(), d_cancel())
    assert(d_name(cancelled.state) == "Idle")
    assert(d_summary(cancelled.orders) == "Log,Cancel(agent),Save")
}

test "dialog: a cancel in Idle is a note, nothing ends" {
    ro idle = dialog_session(30000).initial()
    ro r = d_run(idle, d_cancel())
    assert(d_same(r.state, idle))
    assert(d_summary(r.orders) == "Log")
}

test "dialog: the answer of a turn does not carry into the next one" {
    ro first = d_run(d_run(d_waiting(), d_chunk("one")).state, d_done()).state
    ro second = d_run(first, d_said("two")).state
    assert(!encode_chat_state(second).contains("one"))
}

test "dialog: the single-turn session is unchanged" {
    ro r = d_machine_run(chat_session(), chat_session().initial(), d_said("hi"))
    ro done = d_machine_run(chat_session(), r.state, d_done())
    assert(chat_session().state_name(done.state) == "Done")
    assert(d_summary(done.orders) == "Log,Finish,Save")
}

// ----- the engine over the dialog in memory -----

// ORACLE-WORKAROUND(12, 13, 26): the type arguments of `start_engine` and `resume_engine` are written out here and in the helpers below; infer them when items 12 and 13 are fixed
fn d_begin(mut world MemoryWorld) -> Engine[ChatSession, ChatState] {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        start_engine[ChatState, ChatSession](dialog_session(30000), "dlg-1")
    }
}

fn d_resumed(mut world MemoryWorld) -> Engine[ChatSession, ChatState] {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        match resume_engine[ChatState, ChatSession](dialog_session(30000), "dlg-1") {
            Some(e) => e
            None => panic("no snapshot to resume from")
        }
    }
}

fn d_feed(mut e Engine[ChatSession, ChatState], mut world MemoryWorld, event Incoming) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.feed(event)
    }
}

fn d_accept_only(mut e Engine[ChatSession, ChatState], mut world MemoryWorld, event Incoming) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.on_arrival(event)
    }
}

fn d_dispatch(mut e Engine[ChatSession, ChatState], mut world MemoryWorld) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.dispatch()
    }
}

fn d_pump(mut e Engine[ChatSession, ChatState], mut world MemoryWorld) -> int {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.pump()
    }
}

fn d_state(e Engine[ChatSession, ChatState]) -> str => dialog_session(30000).state_name(e.state())

fn d_kinds(world MemoryWorld, kind str) -> int {
    mut n = 0
    for entry in world.journal_entries() {
        if entry.event.code == kind { n += 1 }
    }
    n
}

test "dialog engine: two turns in one session, the requests are agent-1 and agent-2" {
    mut world = MemoryWorld.at(1000)
    mut e = d_begin(world)
    d_feed(e, world, user_says("one"))
    d_feed(e, world, agent_chunk("agent-1", "A"))
    d_feed(e, world, agent_done("agent-1"))
    assert(!e.is_finished())
    assert(d_state(e) == "Idle")
    d_feed(e, world, user_says("two"))
    assert(d_state(e) == "Awaiting")
    assert(world.sent.len() == 2)
    assert(world.sent[0].id == "agent-1")
    assert(world.sent[1].id == "agent-2")
    assert(world.sent[1].input == "two")
    d_feed(e, world, agent_chunk("agent-2", "B"))
    d_feed(e, world, agent_done("agent-2"))
    assert(!e.is_finished())
    assert(e.open_ids().len() == 0)
    assert(d_state(e) == "Idle")
}

test "dialog engine: a cancel closes the turn, the late answer is discarded, the next turn works" {
    mut world = MemoryWorld.at(1000)
    mut e = d_begin(world)
    d_feed(e, world, user_says("slow"))
    d_feed(e, world, agent_chunk("agent-1", "start"))
    d_feed(e, world, user_cancels())
    assert(!e.is_finished())
    assert(d_state(e) == "Idle")
    assert(world.cancelled.len() == 1)
    assert(world.cancelled[0] == "agent-1")
    d_feed(e, world, agent_chunk("agent-1", "late"))
    d_feed(e, world, agent_refused("agent-1", FailCode.StoppedByHuman))
    assert(d_kinds(world, "reply_discarded") == 2)
    d_feed(e, world, user_says("again"))
    assert(world.sent.len() == 2)
    assert(world.sent[1].id == "agent-2")
    d_feed(e, world, agent_chunk("agent-2", "ok"))
    d_feed(e, world, agent_done("agent-2"))
    assert(d_state(e) == "Idle")
    assert(!e.is_finished())
}

test "dialog engine: the idle term ends the turn with Timeout and the session goes on" {
    mut world = MemoryWorld.at(1000)
    mut e = d_begin(world)
    d_feed(e, world, user_says("silent"))
    world.advance(31000)
    assert(d_pump(e, world) == 1)
    assert(d_state(e) == "Idle")
    assert(!e.is_finished())
    assert(world.cancelled.len() == 1)
    d_feed(e, world, user_says("next"))
    assert(world.sent.len() == 2)
}

test "dialog engine: death after the commit of the second turn, before the send: sent once as agent-2" {
    mut world = MemoryWorld.at(1000)
    mut e1 = d_begin(world)
    d_feed(e1, world, user_says("one"))
    d_feed(e1, world, agent_done("agent-1"))
    d_accept_only(e1, world, user_says("two"))
    assert(world.sent.len() == 1)
    mut e2 = d_resumed(world)
    d_dispatch(e2, world)
    assert(world.sent.len() == 2)
    assert(world.sent[1].id == "agent-2")
    assert(world.sent[1].input == "two")
    mut e3 = d_resumed(world)
    d_dispatch(e3, world)
    assert(world.sent.len() == 2)
}

test "dialog engine: the agent answers while the process is dead: the answer is taken once after the restart" {
    mut world = MemoryWorld.at(1000)
    mut e1 = d_begin(world)
    d_feed(e1, world, user_says("one"))
    // the process dies; the agent (the other side) goes on and its events wait in the inbox
    world.deliver(Incoming.from_source("acp-1", agent_chunk("agent-1", "text")))
    world.deliver(Incoming.from_source("acp-2", agent_done("agent-1")))
    mut e2 = d_resumed(world)
    assert(d_pump(e2, world) == 2)
    assert(d_state(e2) == "Idle")
    assert(world.acked.len() == 2)
    assert(!e2.is_finished())
    d_feed(e2, world, user_says("two"))
    assert(world.sent.len() == 2)
    assert(world.sent[1].id == "agent-2")
}

// the line of an incoming answer written by a step that died before its snapshot
fn dead_answer_line(trace str, step int) -> JournalEntry => {
    trace, step, cause: "answered-9", state: "Awaiting", request: "agent-1", at: 1500,
    event: journal_event("event_accepted", [param("kind", "answered"), param("name", "agent_done"), param("source", "acp-1")])
}

test "dialog engine: death between the journal line and the snapshot of the answer: the answer is taken again once" {
    mut world = MemoryWorld.at(1000)
    mut e1 = d_begin(world)
    d_feed(e1, world, user_says("one"))
    // the lines of the step of the answer are written, the snapshot of that step is not: the step did not commit
    world.journal.push(journal_line(dead_answer_line(e1.trace(), e1.step_number() + 1)))
    world.deliver(Incoming.from_source("acp-1", agent_done("agent-1")))
    mut e2 = d_resumed(world)
    assert(d_state(e2) == "Awaiting")
    assert(d_pump(e2, world) == 1)
    assert(d_state(e2) == "Idle")
    assert(d_kinds(world, "reply_discarded") == 0)
}

test "dialog engine: death after the cancel was committed, before it was sent: the cancel goes out once" {
    mut world = MemoryWorld.at(1000)
    mut e1 = d_begin(world)
    d_feed(e1, world, user_says("slow"))
    d_accept_only(e1, world, user_cancels())
    assert(world.cancelled.len() == 0)
    mut e2 = d_resumed(world)
    d_dispatch(e2, world)
    assert(world.cancelled.len() == 1)
    assert(world.cancelled[0] == "agent-1")
    mut e3 = d_resumed(world)
    d_dispatch(e3, world)
    assert(world.cancelled.len() == 1)
    assert(d_state(e3) == "Idle")
    d_feed(e3, world, user_says("again"))
    assert(world.sent.len() == 2)
}

test "dialog engine: the history of two turns survives a restart" {
    mut world = MemoryWorld.at(1000)
    mut e1 = d_begin(world)
    d_feed(e1, world, user_says("one"))
    d_feed(e1, world, agent_chunk("agent-1", "A"))
    d_feed(e1, world, agent_done("agent-1"))
    d_feed(e1, world, user_says("two"))
    d_feed(e1, world, agent_chunk("agent-2", "B"))
    ro live = e1.take_events()
    mut e2 = d_resumed(world)
    ro again = with Journal = memory_journal(world) { e2.history() }
    assert(again.len() == live.len())
    assert(again.len() == 5)
    assert(again[0].input == "one")
    assert(again[3].input == "two")
    assert(again[4].input == "B")
    assert(again[4].request == Some("agent-2"))
}
