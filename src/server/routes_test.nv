// routes_test.nv - task 192q: the modes of work by the methodology (`routes.nv`): the files of the modes, the numbers of the tasks, the progress files,
// the rule "extend the subtask or open a new one", the state `route_state` for the page, the choice of the independent reviewer.
module crew_harness.server

import std.encoding.json.{Json, JsonValue, JsonObject}
import std.fs.{Fs, real_fs, read_text}

fn rt_doc_text() -> str => "# Режим\n\nпояснение\n\n## инструкция\n\nДелай быстро.\nВторая строка.\n\n## шаг 1 · self · Постановка\n\nНапиши постановку {N} в {task}.\n\n## шаг two · independent · Проверка · обязательный\n\nПроверь.\n\n## шаг 3 · self · Итог\n\nИтог.\n"

test "routes: the file of a mode is cut into the instruction and the steps" {
    ro doc = parse_route_doc("fast", rt_doc_text())
    assert(doc.route == "fast")
    assert(doc.instruction == "Делай быстро.\nВторая строка.")
    assert(doc.steps.len() == 3)
    assert(doc.steps[0].id == "1")
    assert(doc.steps[0].kind == "self")
    assert(doc.steps[0].title == "Постановка")
    assert(doc.steps[0].prompt == "Напиши постановку {N} в {task}.")
    assert(!doc.steps[0].required)
    assert(doc.steps[1].id == "two")
    assert(doc.steps[1].kind == "independent")
    assert(doc.steps[1].required)
    assert(doc.steps[2].title == "Итог")
}

test "routes: a file without steps has none, a file without the instruction has an empty one, a wrong kind makes no step" {
    ro none = parse_route_doc("interactive", "# Режим\n\n## инструкция\n\nТолько текст.\n")
    assert(none.steps.len() == 0)
    assert(none.instruction == "Только текст.")
    ro bare = parse_route_doc("fast", "## шаг 1 · self · Один\n\nтело\n")
    assert(bare.instruction == "")
    assert(bare.steps.len() == 1)
    ro wrong = parse_route_doc("fast", "## шаг 1 · robot · Один\n\nтело\n## шаг 2 · self · Два\n\nтело\n")
    assert(wrong.steps.len() == 1)
    assert(wrong.steps[0].title == "Два")
}

test "routes: the files of the repository are read by the parser: 0, 6 and 8 steps, the last independent step is required" {
    ro fast = parse_route_doc("fast", rt_repo_file("fast.md"))
    ro full = parse_route_doc("full", rt_repo_file("full.md"))
    ro inter = parse_route_doc("interactive", rt_repo_file("interactive.md"))
    assert(inter.steps.len() == 0)
    assert(inter.instruction.byte_len() > 100)
    assert(fast.steps.len() == 6)
    assert(full.steps.len() == 8)
    assert(fast.instruction.byte_len() > 100)
    for step in fast.steps { assert(step.prompt.byte_len() > 50) }
    for step in full.steps { assert(step.prompt.byte_len() > 50) }
    assert(rt_independent(fast.steps) == 1)
    assert(rt_independent(full.steps) == 1)
    for step in fast.steps { if step.kind == "independent" { assert(step.required) } }
    for step in full.steps { if step.kind == "independent" { assert(step.required) } }
}

fn rt_independent(steps []RouteStep) -> int {
    mut n = 0
    for s in steps { if s.kind == "independent" { n += 1 } }
    n
}

fn rt_repo_file(name str) -> str {
    ro p = kit_repo_root().join("doc").join("routes").join(name)
    with Fs = real_fs() {
        match read_text(p) {
            Ok(t) => t
            Err(e) => panic("cannot read ${name}")
        }
    }
}

test "routes: the prompt gets the number of the subtask and the folder of the task" {
    assert(route_fill("файл {task}/message.{N}.md, подзадача {N}", 3, "doc/tasks/007-x/task") == "файл doc/tasks/007-x/task/message.3.md, подзадача 3")
}

test "routes: the number of the next task is the greatest number plus one, three digits" {
    assert(next_task_number([]str.new()) == 1)
    assert(next_task_number(["001-a", "009-b", "010-c", "readme.md", "x12"]) == 11)
    assert(next_task_number(["192-vvod", "192q-routes-server", "task-190"]) == 193)
    assert(task_number_text(7) == "007")
    assert(task_number_text(42) == "042")
    assert(task_number_text(193) == "193")
    assert(task_number_text(1000) == "1000")
}

test "routes: the slug is Latin, a-z0-9 and dashes, at most 40 characters" {
    assert(task_slug("Сделай кнопку выхода") == "sdelay-knopku-vyhoda")
    assert(task_slug("Fix the BUG in parser!") == "fix-the-bug-in-parser")
    assert(task_slug("   ") == "task")
    assert(task_slug("!!!") == "task")
    ro long = task_slug("один два три четыре пять шесть семь восемь девять десять одиннадцать двенадцать")
    assert(long.byte_len() <= 40)
    assert(!long.ends_with("-"))
    assert(!long.starts_with("-"))
    assert(!task_slug("a   b---c").contains("--"))
}

test "routes: the progress file is counted by the boxes" {
    ro p = parse_progress("# Прогресс\n\n- [x] Постановка\n- [ ] Проба\n  - [X] Вложенный\n- [ ] Итог\nпросто строка\n- [x]\n")
    assert(p.total == 4)
    assert(p.done == 2)
    assert(p.items.len() == 4)
    assert(p.items[0].text == "Постановка" && p.items[0].done)
    assert(p.items[1].text == "Проба" && !p.items[1].done)
    assert(p.items[2].text == "Вложенный" && p.items[2].done)
    ro empty = parse_progress("")
    assert(empty.total == 0 && empty.done == 0)
}

test "routes: the empty checklist is made of the steps of the mode, a step is marked by its title" {
    ro doc = parse_route_doc("fast", rt_doc_text())
    ro text = progress_template(2, doc.steps)
    assert(text.contains("- [ ] Постановка\n"))
    assert(text.contains("- [ ] Проверка\n"))
    assert(text.contains("- [ ] Итог"))
    assert(parse_progress(text).total == 3)
    ro marked = progress_mark(text, "Проверка", false)
    ro p = parse_progress(marked)
    assert(p.total == 3 && p.done == 1)
    assert(p.items[1].done)
    assert(!p.items[0].done)
    ro skipped = progress_mark(marked, "Итог", true)
    assert(skipped.contains("- [x] Итог (пропущен)"))
    assert(parse_progress(skipped).done == 2)
    assert(progress_template(1, []RouteStep.new()).contains("шагов у режима нет"))
}

test "routes: the date of a message is read from the milliseconds" {
    assert(civil_stamp(0) == "1970-01-01 00:00")
    assert(civil_stamp(1793000000000) == "2026-10-26 07:33")
    assert(civil_stamp(951782400000 + 3600000 * 5 + 60000 * 7) == "2000-02-29 05:07")
}

test "routes: the files of a subtask: the message, the supplement" {
    ro first = message_file_text(1, "Сделай X\nподробности", 0)
    assert(first.starts_with("# Сообщение 1"))
    assert(first.contains("1970-01-01 00:00"))
    assert(first.contains("Сделай X\nподробности"))
    ro more = message_addition_text("ещё Y", 60000)
    assert(more.contains("## Дополнение 1970-01-01 00:01"))
    assert(more.contains("ещё Y"))
    assert(subtask_title("\n\n  Первая строка очень длинная ".repeat(5)).byte_len() > 0)
    assert(subtask_title("Первая строка\nвторая") == "Первая строка")
}

test "routes: a message extends the subtask while its checklist is not complete, otherwise it opens a new one" {
    // (forced, there is a subtask, boxes in total, boxes done, marked done by the owner)
    assert(subtask_extends("", false, 0, 0, false) == false)
    assert(subtask_extends("", true, 3, 1, false) == true)
    assert(subtask_extends("", true, 3, 3, false) == false)
    assert(subtask_extends("", true, 0, 0, false) == false)
    assert(subtask_extends("", true, 3, 1, true) == false)
    assert(subtask_extends("new", true, 3, 1, false) == false)
    assert(subtask_extends("same", true, 3, 3, false) == true)
    assert(subtask_extends("same", true, 0, 0, true) == true)
    assert(subtask_extends("same", false, 0, 0, false) == false)
}

test "routes: many subtasks or many messages suggest a new task" {
    assert(!task_too_big(11, 20, 12, 40))
    assert(task_too_big(12, 20, 12, 40))
    assert(task_too_big(3, 40, 12, 40))
    assert(!task_too_big(100, 100, 0, 0))
}

test "routes: the reviewer is the first of the order that is not the family of the session and is available" {
    ro order = ["codex", "claude", "kimi", "opencode"]
    assert(pick_reviewer(order, ["opencode", "claude", "kimi"], "opencode") == "claude")
    assert(pick_reviewer(order, ["opencode", "codex", "claude"], "codex") == "claude")
    assert(pick_reviewer(order, ["opencode", "codex"], "claude") == "codex")
    assert(pick_reviewer(order, ["kimi", "opencode"], "kimi") == "opencode")
    // nobody of the order: any other agent; nobody at all: empty
    assert(pick_reviewer(order, ["fake", "fake2"], "fake") == "fake2")
    assert(pick_reviewer(order, ["opencode"], "opencode") == "")
    assert(pick_reviewer([]str.new(), []str.new(), "x") == "")
}

fn rt_sample() -> RouteSession {
    mut rt = route_session_new()
    rt.apply("route_set", "{\"route\":\"fast\"}")
    rt.apply("route_task", "{\"op\":\"open\",\"id\":\"007-sdelay\",\"number\":\"007\",\"dir\":\"/t/doc/tasks/007-sdelay/task\",\"shown\":\"doc/tasks/007-sdelay/task\",\"branch\":\"task/007-sdelay\",\"worktree\":\"/w/r-007-sdelay\",\"title\":\"Сделай X\"}")
    rt
}

fn rt_titles() -> []str => ["Постановка", "Проверка", "Итог"]

fn rt_obj(text str) -> JsonObject {
    match Json.parse(text) {
        Ok(v) => match v.object() {
            Some(o) => o
            None => panic("not an object")
        }
        Err(e) => panic("not JSON")
    }
}

test "routes: the state of a mode for the page: route, steps, the task with its subtasks and boxes" {
    mut rt = rt_sample()
    rt.apply("route_task", "{\"op\":\"subtask\",\"n\":2,\"title\":\"Ещё Y\"}")
    rt.apply("route_step", "{\"n\":1,\"state\":\"done\"}")
    rt.apply("route_step", "{\"n\":2,\"state\":\"running\"}")
    ro one = parse_progress("- [x] Постановка\n- [x] Проверка\n- [x] Итог\n")
    ro two = parse_progress("- [x] Постановка\n- [ ] Проверка\n- [ ] Итог\n")
    ro text = route_view_text(rt, rt_titles(), [one, two], true, 0)
    ro o = rt_obj(text)
    assert(jtext(o, "route") == "fast")
    match o.get("running") {
        Some(v) => assert((v.bool() ?? true) == false)
        None => panic("no running")
    }
    ro steps = (o.get("steps") ?? JsonValue.null()).array() ?? []JsonValue.new()
    assert(steps.len() == 3)
    ro s1 = steps[0].object() ?? JsonObject.new()
    assert(jtext(s1, "title") == "Постановка" && jtext(s1, "state") == "done")
    ro s2 = steps[1].object() ?? JsonObject.new()
    assert(jtext(s2, "state") == "running")
    assert(((s2.get("n") ?? JsonValue.null()).int() ?? 0) == 2)
    ro s3 = steps[2].object() ?? JsonObject.new()
    assert(jtext(s3, "state") == "pending")
    ro task = jchild(o, "task") ?? JsonObject.new()
    assert(jtext(task, "id") == "007-sdelay")
    assert(jtext(task, "number") == "007")
    assert(jtext(task, "branch") == "task/007-sdelay")
    assert(jtext(task, "worktree") == "/w/r-007-sdelay")
    assert(jtext(task, "title") == "Сделай X")
    ro subs = (task.get("subtasks") ?? JsonValue.null()).array() ?? []JsonValue.new()
    assert(subs.len() == 2)
    ro a = subs[0].object() ?? JsonObject.new()
    ro b = subs[1].object() ?? JsonObject.new()
    assert(jtext(a, "state") == "done")
    assert(((a.get("done") ?? JsonValue.null()).int() ?? 0) == 3 && ((a.get("total") ?? JsonValue.null()).int() ?? 0) == 3)
    assert(jtext(b, "state") == "running")
    assert(((b.get("done") ?? JsonValue.null()).int() ?? 0) == 1 && ((b.get("total") ?? JsonValue.null()).int() ?? 0) == 3)
    ro items = (b.get("items") ?? JsonValue.null()).array() ?? []JsonValue.new()
    assert(items.len() == 3)
    assert(jtext(items[0].object() ?? JsonObject.new(), "text") == "Постановка")
    match task.get("suggest_new_task") {
        Some(v) => assert((v.bool() ?? false) == false)
        None => ()
    }
}

test "routes: interactive has no steps and no task until a message; the task is null then" {
    mut rt = route_session_new()
    ro text = route_view_text(rt, []str.new(), []Progress.new(), false, 0)
    ro o = rt_obj(text)
    assert(jtext(o, "route") == "interactive")
    ro steps = (o.get("steps") ?? JsonValue.null()).array() ?? []JsonValue.new()
    assert(steps.len() == 0)
    match o.get("task") {
        Some(v) => assert(v.is_null())
        None => panic("task must be there, null")
    }
}

test "routes: a subtask that was extended shows merged_into; a subtask of its own tree shows the branch and the tree; the planned one is planned" {
    mut rt = rt_sample()
    rt.apply("route_task", "{\"op\":\"extend\",\"n\":1}")
    assert(rt.merged_into == 1)
    rt.apply("route_task", "{\"op\":\"subtask\",\"n\":2,\"title\":\"Вторая\"}")
    assert(rt.merged_into == 0)
    rt.apply("route_task", "{\"op\":\"sub_worktree\",\"n\":2,\"branch\":\"task/007-sdelay-s2\",\"worktree\":\"/w/r-007-sdelay-s2\"}")
    ro p = parse_progress("- [ ] Постановка\n")
    ro text = route_view_text(rt, ["Постановка"], [p, p], false, 0)
    ro task = jchild(rt_obj(text), "task") ?? JsonObject.new()
    ro subs = (task.get("subtasks") ?? JsonValue.null()).array() ?? []JsonValue.new()
    ro a = subs[0].object() ?? JsonObject.new()
    ro b = subs[1].object() ?? JsonObject.new()
    assert(jtext(a, "state") == "planned")
    assert(jtext(b, "state") == "running")
    assert(jtext(b, "branch") == "task/007-sdelay-s2")
    assert(jtext(b, "worktree") == "/w/r-007-sdelay-s2")
    match b.get("merged") {
        Some(v) => assert((v.bool() ?? true) == false)
        None => panic("no merged")
    }
    rt.apply("route_task", "{\"op\":\"extend\",\"n\":2}")
    ro again = rt_obj(route_view_text(rt, ["Постановка"], [p, p], false, 0))
    ro sub2 = ((jchild(again, "task") ?? JsonObject.new()).get("subtasks") ?? JsonValue.null()).array() ?? []JsonValue.new()
    ro last = sub2[1].object() ?? JsonObject.new()
    assert(jtext(last, "merged_into") == "2")
    ro first = sub2[0].object() ?? JsonObject.new()
    match first.get("merged_into") {
        Some(v) => assert(v.is_null())
        None => panic("no merged_into")
    }
}

test "routes: a merged subtask is done and its tree is gone; a conflict keeps it unmerged with the text" {
    mut rt = rt_sample()
    rt.apply("route_task", "{\"op\":\"sub_worktree\",\"n\":1,\"branch\":\"task/007-sdelay-s1\",\"worktree\":\"/w/r-007-sdelay-s1\"}")
    rt.apply("route_task", "{\"op\":\"sub_conflict\",\"n\":1,\"text\":\"CONFLICT in a.txt\"}")
    ro p = parse_progress("- [ ] Постановка\n")
    ro after = jchild(rt_obj(route_view_text(rt, ["Постановка"], [p], false, 0)), "task") ?? JsonObject.new()
    ro s1 = ((after.get("subtasks") ?? JsonValue.null()).array() ?? []JsonValue.new())[0].object() ?? JsonObject.new()
    assert(jtext(s1, "conflict") == "CONFLICT in a.txt")
    assert(jtext(s1, "state") != "done")
    rt.apply("route_task", "{\"op\":\"sub_merged\",\"n\":1}")
    ro done = jchild(rt_obj(route_view_text(rt, ["Постановка"], [p], false, 0)), "task") ?? JsonObject.new()
    ro d1 = ((done.get("subtasks") ?? JsonValue.null()).array() ?? []JsonValue.new())[0].object() ?? JsonObject.new()
    assert(jtext(d1, "state") == "done")
    assert(jtext(d1, "worktree") == "")
    assert(jtext(d1, "conflict") == "")
    match d1.get("merged") {
        Some(v) => assert((v.bool() ?? false) == true)
        None => panic("no merged")
    }
}

test "routes: the journal replays the state: the task, the steps, a new task clears them" {
    mut rt = rt_sample()
    rt.apply("route_step", "{\"n\":3,\"state\":\"skipped\"}")
    assert(rt.route == "fast")
    assert(rt.task_open)
    assert(rt.step_state(3) == "skipped")
    assert(rt.step_state(1) == "pending")
    assert(rt.messages == 1)
    rt.apply("route_task", "{\"op\":\"close\"}")
    assert(rt.task_closed)
    rt.apply("route_task", "{\"op\":\"new\"}")
    assert(!rt.task_open && !rt.task_closed)
    assert(rt.step_state(3) == "pending")
    assert(rt.subs.len() == 0)
    rt.apply("route_set", "{\"route\":\"full\"}")
    assert(rt.route == "full")
}

test "routes: the working folder of the agent is the tree of the subtask, else the tree of the task, else the folder of the session" {
    mut rt = route_session_new()
    assert(rt.agent_dir("/repo") == "/repo")
    rt = rt_sample()
    assert(rt.agent_dir("/repo") == "/w/r-007-sdelay")
    rt.apply("route_task", "{\"op\":\"subtask\",\"n\":2,\"title\":\"B\"}")
    rt.apply("route_task", "{\"op\":\"sub_worktree\",\"n\":2,\"branch\":\"b\",\"worktree\":\"/w/r-007-sdelay-s2\"}")
    assert(rt.agent_dir("/repo") == "/w/r-007-sdelay-s2")
    rt.apply("route_task", "{\"op\":\"sub_merged\",\"n\":2}")
    assert(rt.agent_dir("/repo") == "/w/r-007-sdelay")
}

test "routes: the prelude of a message: the instruction once, the files of the subtask each time, the prompt of a step" {
    ro doc = parse_route_doc("fast", rt_doc_text())
    ro first = route_prelude(doc, true, "doc/tasks/007-x/task", 2, "")
    assert(first.starts_with("[crew]"))
    assert(first.contains("Делай быстро."))
    assert(first.contains("doc/tasks/007-x/task"))
    assert(first.contains("message.2.md"))
    assert(first.contains("progress.2.md"))
    ro later = route_prelude(doc, false, "doc/tasks/007-x/task", 3, "")
    assert(!later.contains("Делай быстро."))
    assert(later.contains("progress.3.md"))
    ro step = route_prelude(doc, false, "doc/tasks/007-x/task", 3, "Сделай шаг.")
    assert(step.contains("Сделай шаг."))
    assert(route_prelude(doc, false, "", 1, "").byte_len() == 0)
}

test "routes: the protocol for the reviewer holds the prompt, the message, the diff and the last answer" {
    ro text = review_prompt("Проверь всё.", "Сообщение пользователя", "M a.txt", "diff --git a/a.txt", "Я сделал X.")
    assert(text.starts_with("Проверь всё."))
    assert(text.contains("Сообщение пользователя"))
    assert(text.contains("M a.txt"))
    assert(text.contains("diff --git a/a.txt"))
    assert(text.contains("Я сделал X."))
    ro cut = cut_text("x".repeat(100), 10)
    assert(cut.byte_len() < 100)
    assert(cut.contains("обрезано"))
    assert(cut_text("short", 10) == "short")
}
