// hub.nv - the core of the session server (task 099): the sessions, each with an engine of its own, and the page.
//
// The hub knows nothing of sockets. The page talks to it in lines of JSON in the format of tasks 093/094 (`src/web/README.md`);
// the hub is told "a page came" (`attach`), "a page went" (`detach`), "a page said this" (`handle`), and it is asked for its
// output (`take_output`): a list of `Outgoing`, each for one page (`conn`) or for all of them (`conn` 0). `pump` is called by a
// timer and takes the events of the agents. The caller of the hub is a loop: in the product it reads and writes the pipes of the
// hub program (stdio.nv), in the tests it is the test.
//
// A session = the engine of the dialog machine (the table `dialog.alula.md`, run by `AlulaMachine`, task 114) over the handlers of the store (files or PostgreSQL, by the
// settings) and of the agent (the ACP client over a process). The page sees only what the engine accepted: every accepted
// event is turned into a page event by `page_event` (task 095), stamped with the id, the step and the time of the engine.
//   - The id of the page event is "<session>/<engine id>": the page keeps the ids of ALL sessions in one set.
//   - The turn of the page ("turn") is the engine id of the user_message that opened it; the events after it carry it.
//   - The first event of a session is `session_created` (name, agent, folder), made by the server and kept in the journal like any
//     other: the journal alone tells the whole story again after a restart (`Engine.history`).
// What is not an event of the engine and has no place in the journal (the agent could not be started, a wrong session name) is
// told to the page as a synthetic `error` event, with an id of its own ("srv-<n>"); it is not kept.
module crew_harness.server

import alula.engine.{Engine, Incoming, EventKind, Journal, Store, Link, PartyRequest, start_engine, resume_engine, decode_snapshot}
import crew_harness.product_machines.{find_machines_dir, load_product_machines}
import alula.machine_run.{AlulaMachine, AlulaState}
import crew_harness.acp.{AcpConfig, AcpClient, AcpImage, AcpPreset, AskSetup, no_ask, open_client_full, acp_link, page_event, TRACE_LIMIT}
import crew_harness.projects.{EnvEntry, projects_get, parse_dotenv, normalize_folder_path, project_has_folder, valid_project_id}
import crew_harness.storage.{remove_session_dir, open_data_dir, file_journal, file_store, list_sessions, valid_session_name, session_file_made, migrate_flat_sessions, image_ext, decode_image, save_image, find_image, replace_file}
import crew_harness.pgstore.{PgWorld, pg_journal, pg_store}
import crew_harness.pgdb.{pg_list}
import std.concurrency.nvchan.{Chan, ChanTx, ChanRx}
import std.encoding.hex.{Hex}
import std.encoding.json.{Json, JsonValue, JsonObject}
import std.fs.{Fs, real_fs}
import std.net.{real_net}
import std.prelude.effects.{real_random}
import std.os.{Os, real_os, cwd, args}
import std.fs.{Fs, real_fs, Path, read_text, try_exists}

/// Outgoing: a text for the page `conn`; conn 0 - for every page that is attached.
export type Outgoing { conn int, text str }

// ORACLE-WORKAROUND(29): the record is `Dialog`, not `Session` (the driver has a `Session`); name it `Session` when item 29 is fixed
type Dialog {
    id str,
    name str,
    agent str,
    engine Engine[AlulaMachine, AlulaState],
    world PgWorld,
    clients []AcpClient,
    turn str,
    lines []str,
    announced bool,
    model_announced bool,
    started_at int,
    slow_told bool,
    folder str,
    project_id str,
    has_rank bool,
    rank int,
    rt RouteSession,
    chosen []SavedChoice
}

// A choice of the owner (task 192t), kept per family: the agent, the setting (`mode`, `model`, `effort`) and the id chosen.
type SavedChoice { agent str, setting str, value str }

fn chosen_without(list []SavedChoice, agent str, setting str) -> []SavedChoice {
    mut out = []SavedChoice.new()
    for c in list {
        if !(c.agent == agent && c.setting == setting) { out.push(c) }
    }
    out
}

fn chosen_put(list []SavedChoice, agent str, setting str, value str) -> []SavedChoice {
    mut out = chosen_without(list, agent, setting)
    out.push(SavedChoice { agent, setting, value })
    out
}

// What a new agent of this family is asked for.
fn presets_for(list []SavedChoice, agent str) -> []AcpPreset {
    mut out = []AcpPreset.new()
    for c in list {
        if c.agent == agent { out.push(AcpPreset { setting: c.setting, value: c.value }) }
    }
    out
}

fn chosen_text(agent str, setting str, value str, at int) -> str {
    mut o = JsonObject.new()
    jput(o, "agent", JsonValue.str(agent))
    jput(o, "setting", JsonValue.str(setting))
    jput(o, "value", JsonValue.str(value))
    jput(o, "at", JsonValue.int(at))
    JsonValue.object(o).to_str()
}

fn dropped_text(agent str, setting str, value str, used str) -> str {
    mut o = JsonObject.new()
    jput(o, "agent", JsonValue.str(agent))
    jput(o, "setting", JsonValue.str(setting))
    jput(o, "value", JsonValue.str(value))
    jput(o, "used", JsonValue.str(used))
    JsonValue.object(o).to_str()
}

// A call of the tool `ask_user_question` (task 192i) that waits for the owner: the key the page answers by, the call of the MCP server, the session, the
// questions as the page got them, and where the text for the agent goes.
type McpPending { key str, call int, session str, questions JsonValue, reply ChanTx[str] }

// The signals of the journal that carry the mode of work (task 192q, `routes_hub.nv`).
fn route_signals() -> []str => ["route_set", "route_task", "route_step", "route_note", "route_review", "context_compacted", "task_extended", "task_extend_undone"]

/// Hub: the sessions, the pages, the output not yet taken, the log.
/// A choice of the owner (model, effort, mode) made while the agent of the session was not running: it waits until the agent is ready.
type PendingChoice { trace str, setting str, value str }

export type Hub {
    settings ServerSettings,
    machine AlulaMachine,
    workdir str,
    sessions []Dialog,
    conns []int,
    out []Outgoing,
    log []str,
    serial int,
    mcps []McpServer,
    mcp_pending []McpPending,
    mcp_serial int,
    ctl_letters []CtlLetter,
    ctl_waits []CtlWait,
    ctl_serial int,
    catalog JsonObject,
    catalog_dirty bool,
    catalog_saved_at int,
    choices []PendingChoice,
    reviews []Review,
    route_obs int,
    marks []MachMark,
    trees_tx ChanTx[TreeDone],
    trees_rx ChanRx[TreeDone],
    held []HeldMsg,
    reserved []int
}

/// TreeDone: the answer of the background job that makes the wip tree of a session (task 192.8): the exit code of `git worktree add` (-1: not run), its error stream as bytes, the note, the path and the base.
export type TreeDone { trace str, code int, err []u8, note str, path str, base str }

/// HeldMsg: a message of the owner that waits for the tree of its session (task 192.8); it is sent to the agent when the tree is ready or has failed.
export type HeldMsg { trace str, text str, items []JsonValue }

// ----- small helpers -----

fn jput(mut o JsonObject, key str, value JsonValue) -> () {
    ro replaced = o.insert(key, value)
}

fn jobject(text str) -> Option[JsonObject] {
    match Json.parse(text) {
        Ok(v) => v.object()
        Err(e) => None
    }
}

fn jtext(o JsonObject, key str) -> str {
    match o.get(key) {
        Some(v) => v.str() ?? ""
        None => ""
    }
}

fn jchild(o JsonObject, key str) -> Option[JsonObject] {
    match o.get(key) {
        Some(v) => v.object()
        None => None
    }
}

fn now_millis() Time -> int => Time.now().unix_millis()

fn acp_config_of(program str, args []str, cwd str, inbox_path str) -> AcpConfig => { program, args, cwd, inbox_path }

fn joined(parts []str, sep str) -> str {
    consume sb = StringBuilder.new()
    mut first = true
    for part in parts {
        if !first { sb.append(sep) }
        sb.append(part)
        first = false
    }
    sb.into_str()
}

fn array_text(lines []str) -> str => "[${joined(lines, ",")}]"

fn jlist(o JsonObject, key str) -> []JsonValue {
    match o.get(key) {
        Some(v) => v.array() ?? []JsonValue.new()
        None => []JsonValue.new()
    }
}

fn jnumber(o JsonObject, key str) -> int {
    match o.get(key) {
        Some(v) => v.int() ?? 0
        None => 0
    }
}

// ----- the store, by the settings: the same engine over files or over PostgreSQL -----

// ORACLE-WORKAROUND(49, 12, 13, 26): `begin_engine` of the interpreter (private, generic) captured the name, so this is `begin_session_engine`; the type arguments of `start_engine` are written out (the same in `resume_stored` and `decode_snapshot` below); rename it to `begin_engine` when item 49 is fixed and drop the arguments when items 12 and 13 are fixed
fn begin_session_engine(pg bool, root str, mut world PgWorld, machine AlulaMachine, id str) Time -> Engine[AlulaMachine, AlulaState] {
    if pg {
        with Journal = pg_journal(world), Store = pg_store(world) {
            start_engine[AlulaState, AlulaMachine](machine, id)
        }
    } else {
        with Journal = file_journal(root, id), Store = file_store(root) {
            start_engine[AlulaState, AlulaMachine](machine, id)
        }
    }
}

// ORACLE-WORKAROUND(26): the type arguments of `decode_snapshot` and `resume_engine` are written out; infer them when items 12 and 13 are fixed
fn resume_stored(pg bool, root str, mut world PgWorld, machine AlulaMachine, id str) Time -> Option[Engine[AlulaMachine, AlulaState]] {
    if pg {
        with Journal = pg_journal(world), Store = pg_store(world) {
            // a damaged snapshot would stop the process (`resume_engine`): look at it first
            match Store.load(id) {
                None => None
                Some(snapshot) => match decode_snapshot[AlulaState, AlulaMachine](machine, snapshot) {
                    None => None
                    Some(state) => resume_engine[AlulaState, AlulaMachine](machine, id)
                }
            }
        }
    } else {
        with Journal = file_journal(root, id), Store = file_store(root) {
            match Store.load(id) {
                None => None
                Some(snapshot) => match decode_snapshot[AlulaState, AlulaMachine](machine, snapshot) {
                    None => None
                    Some(state) => resume_engine[AlulaState, AlulaMachine](machine, id)
                }
            }
        }
    }
}

fn accept_in(pg bool, root str, mut s Dialog, event Incoming) Time -> () {
    if pg {
        with Journal = pg_journal(s.world), Store = pg_store(s.world) {
            s.engine.on_arrival(event)
        }
    } else {
        with Journal = file_journal(root, s.id), Store = file_store(root) {
            s.engine.on_arrival(event)
        }
    }
}

fn feed_in(pg bool, root str, mut s Dialog, event Incoming) Time -> () {
    if pg {
        with Journal = pg_journal(s.world), Store = pg_store(s.world), Link = acp_link(s.clients[0]) {
            s.engine.feed(event)
        }
    } else {
        with Journal = file_journal(root, s.id), Store = file_store(root), Link = acp_link(s.clients[0]) {
            s.engine.feed(event)
        }
    }
}

fn pump_in(pg bool, root str, mut s Dialog) Time -> int {
    if pg {
        with Journal = pg_journal(s.world), Store = pg_store(s.world), Link = acp_link(s.clients[0]) {
            s.engine.pump()
        }
    } else {
        with Journal = file_journal(root, s.id), Store = file_store(root), Link = acp_link(s.clients[0]) {
            s.engine.pump()
        }
    }
}

fn history_in(pg bool, root str, mut s Dialog) -> []Incoming {
    if pg {
        with Journal = pg_journal(s.world) {
            s.engine.history()
        }
    } else {
        with Journal = file_journal(root, s.id) {
            s.engine.history()
        }
    }
}

// ----- events -> lines of the page -----

// The page line of an accepted event, None - the page has no kind for it. `s.turn` follows the user messages.
fn line_of(mut s Dialog, e Incoming) -> Option[str] {
    if e.kind == EventKind.Input && e.name == "user_message" { s.turn = e.id }
    ro shown = Incoming { id: "${s.id}/${e.id}", trace: s.id, step: e.step, kind: e.kind, name: e.name, request: e.request, input: e.input, at: e.at }
    page_event(shown, s.turn)
}

fn meta_text(name str, agent str, folder str, project str, project_id str) -> str => meta_text_child(name, agent, folder, project, project_id, "", "")

// Task 192.3: the session may be a child of another session (`parent` is the id of the epic, `parent_kind` "epic"; the old journals also hold "subtask"); the page nests it under the parent.
fn meta_text_child(name str, agent str, folder str, project str, project_id str, parent str, parent_kind str) -> str {
    mut o = JsonObject.new()
    jput(o, "name", JsonValue.str(name))
    jput(o, "agent", JsonValue.str(agent))
    jput(o, "folder", JsonValue.str(folder))
    if project.byte_len() > 0 { jput(o, "project", JsonValue.str(project)) }
    // the id of the project of the control panel (task 192m): only the id is kept in the journal, never the variables
    if project_id.byte_len() > 0 { jput(o, "project_id", JsonValue.str(project_id)) }
    if parent.byte_len() > 0 {
        jput(o, "parent", JsonValue.str(parent))
        jput(o, "parent_kind", JsonValue.str(parent_kind))
    }
    JsonValue.object(o).to_str()
}

fn event_line(id str, trace str, step int, kind str, input JsonObject, at int) -> str {
    mut o = JsonObject.new()
    jput(o, "id", JsonValue.str(id))
    jput(o, "trace", JsonValue.str(trace))
    jput(o, "step", JsonValue.int(step))
    jput(o, "kind", JsonValue.str(kind))
    jput(o, "input", JsonValue.object(input))
    jput(o, "time", JsonValue.int(at))
    JsonValue.object(o).to_str()
}

fn error_input(turn str, message str) -> JsonObject {
    mut input = JsonObject.new()
    jput(input, "turn", JsonValue.str(turn))
    jput(input, "message", JsonValue.str(message))
    input
}

fn created_input(name str, agent str, folder str) -> JsonObject {
    mut input = JsonObject.new()
    jput(input, "name", JsonValue.str(name))
    jput(input, "agent", JsonValue.str(agent))
    jput(input, "folder", JsonValue.str(folder))
    input
}

fn decision_text(request str, decision str) -> str {
    mut o = JsonObject.new()
    jput(o, "request", JsonValue.str(request))
    jput(o, "decision", JsonValue.str(decision))
    JsonValue.object(o).to_str()
}

// ----- the hub -----

fn Hub mut @say_log(text str) -> () {
    @log.push(text)
    if @log.len() > 200 { @log.remove(0) }
}

fn Hub @find(id str) -> int {
    mut at = 0
    for s in @sessions {
        if s.id == id { return at }
        at += 1
    }
    -1
}

fn Hub mut @send(conn int, text str) -> () {
    @out.push(Outgoing { conn, text })
}

// The accepted events of a session become lines of the page; the lines are kept and sent to every page.
fn Hub mut @drain(at int) Time -> () {
    mut s = @sessions[at]
    for e in s.engine.take_events() {
        if e.name == "agent_model" { @catalog_note(s.agent, e.input) }
        match line_of(s, e) {
            Some(line) => {
                s.lines.push(line)
                @send(0, line)
            }
            None => ()
        }
    }
}

// A synthetic `error` event for one page (or all): it belongs to no step of the engine and is not kept.
fn Hub mut @tell_error(conn int, trace str, step int, turn str, message str) Time -> () {
    @serial += 1
    @send(conn, event_line("srv-${@serial}", trace, step, "error", error_input(turn, message), now_millis()))
}

// The catalog of the families (task 192o): an `agent_model` of a session is merged into the record of the agent of that session; a changed record is told to
// every page at once and written to the file (`catalog_save_due` coalesces the writes).
fn Hub mut @catalog_note(agent str, summary_text str) Time -> () {
    if agent.byte_len() == 0 { return }
    ro summary = match jobject(summary_text) {
        Some(x) => x
        None => return
    }
    ro old = match jchild(@catalog, agent) {
        Some(r) => r
        None => JsonObject.new()
    }
    match catalog_update(old, summary, now_millis()) {
        None => ()
        Some(record) => {
            jput(@catalog, agent, JsonValue.object(record))
            @catalog_dirty = true
            @send(0, catalog_line(agent, record))
        }
    }
}

fn Hub @catalog_path() -> Path => Path.from_bytes("${@settings.data_dir}/${CATALOG_FILE}".bytes())

// Write the file if a record changed and the gap since the last write has passed (`force`: now). A write that fails is tried again after the gap.
fn Hub mut @catalog_save(force bool) Time -> () {
    ro now = now_millis()
    if !catalog_save_due(@catalog_dirty, now, @catalog_saved_at, force) { return }
    @catalog_saved_at = now
    ro path = @catalog_path()
    ro written = with Fs = real_fs() { replace_file(path, catalog_file_text(@catalog)) }
    if written {
        @catalog_dirty = false
    } else {
        @say_log("the catalog of the families cannot be written to ${CATALOG_FILE}: it is tried again")
    }
}

// The file of the catalog is read at the start; a missing file is an empty catalog, a damaged one is ignored (and said so in the log).
fn Hub mut @catalog_load() -> () {
    ro path = @catalog_path()
    ro there = with Fs = real_fs() {
        match try_exists(path) {
            Ok(b) => b
            Err(e) => false
        }
    }
    if !there { return }
    ro text = with Fs = real_fs() {
        match read_text(path) {
            Ok(t) => t
            Err(e) => ""
        }
    }
    match catalog_parse(text) {
        Ok(agents) => { @catalog = agents }
        Err(why) => @say_log("${CATALOG_FILE} is ignored: ${why}")
    }
}

fn Hub @catalog_lines() -> []str {
    mut lines = []str.new()
    for agent in @catalog.keys() {
        match jchild(@catalog, agent) {
            Some(record) => lines.push(catalog_line(agent, record))
            None => ()
        }
    }
    lines
}

/// The ids of the agents that have a record in the catalog, in the order they were first given.
export fn Hub @catalog_agents() -> []str => @catalog.keys()

/// A page is attached: it gets the catalog of the families, then everything that happened in every session, one message per session.
export fn Hub mut @attach(conn int) -> () {
    if !@conns.contains(conn) { @conns.push(conn) }
    ro known = @catalog_lines()
    if known.len() > 0 { @send(conn, array_text(known)) }
    for s in @sessions {
        if s.lines.len() > 0 { @send(conn, array_text(s.lines)) }
    }
    @route_attach(conn)
    @machine_attach(conn)
    @req_attach(conn)
}

/// A page is gone (it is not told anything more).
export fn Hub mut @release(conn int) -> () {
    mut rest = []int.new()
    for c in @conns {
        if c != conn { rest.push(c) }
    }
    @conns = rest
}

// The file of the raw exchange with the agent (`<id>/acp.jsonl`, the folder is made); "" - the trace is off (`acp_trace` false) or the id is not a safe name.
fn Hub @trace_path_of(s Dialog) -> str {
    if !@settings.acp_trace { return "" }
    match session_file_made(@settings.data_dir, s.id, "acp.jsonl") {
        Some(p) => p.display()
        None => ""
    }
}

fn Hub @open_config(s Dialog) -> Option[AcpConfig] => @open_config_for(s.agent, s.id, s.rt.agent_dir(@cwd_of(s.folder)))

// What the agent of this session is offered for its questions (task 192i): nothing when the setting `ask_form` is off or the agent is `off`; the form
// (its own tool of questions) when it is `native`; the MCP tool of the hub, and no form, when it is `mcp`.
fn Hub @ask_for(agent str, id str) -> AskSetup => @ask_with_tasks(@ask_base(agent, id), id)

// Task 192.2: the tools of the recognition of the tasks go to every agent that takes an HTTP MCP server: `crew_task_list` always (the button), `crew_task` when `route_auto_propose`.
fn Hub @ask_with_tasks(base AskSetup, id str) -> AskSetup {
    if !@settings.route_tool || @mcps.len() == 0 { return AskSetup { form: base.form, mcp_url: base.mcp_url, mcp_token: base.mcp_token, hint: base.hint } }
    ro auto = @settings.route_auto_propose
    if base.mcp_url.byte_len() > 0 {
        return AskSetup { form: base.form, mcp_url: @mcp_url_tools(id, if auto { "all" } else { "asklist" }), mcp_token: base.mcp_token, hint: if auto { "${base.hint} ${TASK_HINT}" } else { base.hint } }
    }
    AskSetup { form: base.form, mcp_url: @mcp_url_tools(id, if auto { "task" } else { "list" }), mcp_token: @mcp_token_value(), hint: if auto { TASK_HINT } else { "" } }
}

fn Hub @mcp_url_tools(id str, tools str) -> str => if tools == "all" { @mcp_url_for(id) } else { "${@mcp_url_for(id)}/${tools}" }

const TASK_HINT = "[crew] Когда замечаешь реальную работу над файлами проекта (не вопрос и не беседу), вызови инструмент crew_task (сервер crew) до первой правки файла."

fn Hub @ask_base(agent str, id str) -> AskSetup {
    if !@settings.ask_form { return no_ask() }
    match @settings.agent(agent) {
        Some(spec) => {
            if spec.ask == "off" { return no_ask() }
            if spec.ask == "mcp" { return AskSetup { form: false, mcp_url: @mcp_url_for(id), mcp_token: @mcp_token_value(), hint: ASK_HINT } }
            AskSetup { form: true, mcp_url: "", mcp_token: "", hint: "" }
        }
        None => no_ask()
    }
}

// The note put before the first prompt of an agent that was given the MCP tool: it is not in the journal and not in the feed (the client puts it before the prompt).
const ASK_HINT = "[crew] Если нужно что-то уточнить у пользователя или выбрать между вариантами — вызывай инструмент ask_user_question (сервер crew), не пиши вопрос текстом."

fn Hub @mcp_url_for(id str) -> str {
    if @mcps.len() == 0 { return "" }
    ro port = @mcps[0].port
    "http://127.0.0.1:${port}/mcp/${id}"
}

fn Hub @mcp_token_value() -> str {
    if @mcps.len() == 0 { return "" }
    @mcps[0].token
}

fn Hub @wants_mcp() -> bool {
    if @settings.route_tool { return true }
    if !@settings.ask_form { return false }
    for a in @settings.agents {
        if a.ask == "mcp" { return true }
    }
    false
}

/// Start the MCP server of the questions (only when an agent of the settings asks by `mcp`; the tests call it too). The port is the system's choice, the token is random.
export fn Hub mut @start_mcp() Proc Detach Time Net -> bool {
    if @mcps.len() > 0 { return true }
    ro token = with Random = real_random() { Hex.encode(Random.bytes(24)) }
    match start_mcp_server(token, @settings.ask_timeout_ms) {
        Ok(server) => {
            @mcps.push(server)
            @say_log("the MCP server of the questions listens on 127.0.0.1:${server.port}")
            true
        }
        Err(reason) => {
            @say_log("the MCP server of the questions did not start: ${reason}")
            false
        }
    }
}

/// The address of the MCP server of the questions for a session ("" - it is not running).
export fn Hub @mcp_address(id str) -> str => @mcp_url_for(id)

/// The token of the MCP server of the questions ("" - it is not running).
export fn Hub @mcp_token() -> str => @mcp_token_value()

// The folder an agent works in: the folder of the project chosen for the session, else the working folder of the server.
fn Hub @cwd_of(folder str) -> str => if folder.byte_len() > 0 { folder } else { @workdir }

fn Hub @open_config_for(agent str, id str, cwd str) -> Option[AcpConfig] {
    match @settings.agent(agent) {
        Some(spec) => {
            ro inbox = match session_file_made(@settings.data_dir, id, "inbox") {
                Some(p) => p.display()
                None => ""
            }
            Some(acp_config_of(spec.program, spec.args, cwd, inbox))
        }
        None => None
    }
}

/// Launch: the folder an agent of a session works in ("" - the working folder of the server) and the variables of its project.
type Launch { folder str, env []EnvEntry }

// The folder and the variables of a project for a new session: the folder is the one asked for (it must belong to the project)
// or the first one of the project. `Err` says in words why the session cannot be made; no value of a variable is in a reason.
fn Hub @launch_for(project_id str, folder str) -> Result[Launch, str] {
    if project_id.byte_len() == 0 { return Ok(Launch { folder: "", env: []EnvEntry.new() }) }
    if !valid_project_id(project_id) { return Err("the project was not found") }
    ro project = match projects_get(@settings.data_dir, project_id) {
        Ok(p) => p
        Err(f) => return Err(if f.status == 404 { "the project was not found" } else { "the projects cannot be read" })
    }
    mut chosen = ""
    if folder.byte_len() == 0 {
        if project.folders.len() > 0 { chosen = project.folders[0].path }
    } else {
        ro normal = match normalize_folder_path(folder) {
            Ok(p) => p
            Err(reason) => return Err("the folder is wrong")
        }
        if !project_has_folder(project, normal) { return Err("the folder is not in the project") }
        chosen = normal
    }
    ro parsed = match parse_dotenv(project.env) {
        Ok(entries) => entries
        Err(reason) => return Err("the variables of the project: ${reason}")
    }
    Ok(Launch { folder: chosen, env: parsed })
}

// The variables for the agent of a session that runs (again): read from the file of the projects each time, so a change of the
// project reaches the next start. A project that is gone (or a file that cannot be read) gives no variables: the session goes on
// in its folder, and the log says so (without a value).
fn Hub mut @env_of(s Dialog) -> []EnvEntry {
    if s.project_id.byte_len() == 0 { return []EnvEntry.new() }
    match @launch_for(s.project_id, s.folder) {
        Ok(launch) => launch.env
        Err(reason) => {
            @say_log("the session ${s.id} starts without the variables of its project: ${reason}")
            []EnvEntry.new()
        }
    }
}

// Task 192.9: the OpenCode that the hub starts gets the configuration of the owner without the plugin crew-harness (`agent_config.nv`): the variable XDG_CONFIG_HOME over the variables of the project.
fn Hub mut @agent_env(agent str, base []EnvEntry) -> []EnvEntry {
    mut out = []EnvEntry.new()
    for e in base { out.push(e) }
    match @settings.agent(agent) {
        Some(spec) => {
            ro word = "${spec.id} ${spec.program}".to_ascii_lower()
            if !word.contains("opencode") { return out }
            ro extra = with Fs = real_fs(), Os = real_os() { opencode_env(@settings.data_dir) }
            if extra.len() == 0 {
                @say_log("the agent ${agent} starts with the configuration of the owner as it is (no clean copy of it)")
                return out
            }
            mut merged = []EnvEntry.new()
            for e in out { if e.key != "XDG_CONFIG_HOME" { merged.push(e) } }
            for e in extra { merged.push(e) }
            return merged
        }
        None => return out
    }
}

// Make sure the session has a live agent: start one if there is none or the old one is gone. "" - well, else the reason.
fn Hub mut @ensure_client(at int) Proc Detach Time -> str {
    mut s = @sessions[at]
    if s.clients.len() > 0 {
        ro phase = s.clients[0].phase()
        if phase == "ready" || phase == "initializing" || phase == "opening" { return "" }
        s.clients[0].close()
        s.clients = []AcpClient.new()
    }
    match @open_config(s) {
        None => "the agent ${s.agent} is not configured"
        Some(config) => match open_client_full(config, @trace_path_of(s), TRACE_LIMIT, @ask_for(s.agent, s.id), @agent_env(s.agent, @env_of(s))) {
            Ok(client) => {
                s.clients.push(client)
                // the choices of the owner for this family go to every agent started for the session (task 192t)
                s.clients[0].set_presets(presets_for(s.chosen, s.agent))
                s.announced = false
                s.model_announced = false
                s.slow_told = false
                s.started_at = now_millis()
                // the folder the agent is started in is the one `route_sync_cwd` compares with (a session of a project: the folder of the project): else the agent is restarted at EVERY message (task 192.8)
                s.rt.cwd_now = s.rt.agent_dir(@cwd_of(s.folder))
                s.rt.told = false
                ""
            }
            Err(reason) => reason
        }
    }
}

// Does the state of the session take a message of the owner? The table answers; the hub does not know how its states are called.
fn Hub @takes_message_at(at int) -> bool {
    ro s = @sessions[at]
    @machine.accepts_signal(s.engine.state(), "user_message")
}

fn Hub mut @add_session(s Dialog) -> () {
    @sessions.push(s)
}

/// Start the hub: the settings are checked, the machines of the product are read from their folder and checked (task 248: the setting
/// `machines_dir`, else `machines/product` beside the program, else beside its folder; a missing file, another alula_version or a hash of a
/// library that is not the hash of its file stops the start with the path), the data folder is opened, every session of the store is resumed
/// (the engine from its snapshot and journal, the lines of the page from the journal); an agent is started for a session only if a request of it is open.
export fn start_hub(settings ServerSettings) Proc Detach Time Net Fs Os -> Result[Hub, str] => start_hub_from(settings, "")

/// The same over the text of the JSON of the machine of the sessions ("" - `dialog.alula.json` of the folder of the machines; the tests run a changed
/// copy of the table: a state with another name).
export fn start_hub_from(settings ServerSettings, table_text str) Proc Detach Time Net Fs Os -> Result[Hub, str] {
    settings.check()?
    ro argv = with Os = real_os() { args() }
    ro machines_dir = find_machines_dir(settings.machines_dir, if argv.len() > 0 { argv[0] } else { "" })?
    ro machines = match load_product_machines(machines_dir) {
        Ok(m) => m
        Err(e) => return Err("the machines of the product cannot be read: ${e}")
    }
    ro registry = machines.registry()?
    ro machine_text = if table_text.byte_len() > 0 { table_text } else { machines.dialog() }
    if !open_data_dir(settings.data_dir) { return Err("the data folder ${settings.data_dir} cannot be opened") }
    ro workdir = if settings.workdir.byte_len() > 0 {
        settings.workdir
    } else {
        match with Os = real_os() { cwd() } {
            Ok(p) => p.display()
            Err(e) => return Err("the working folder is unknown")
        }
    }
    ro machine = hub_machine_with(machine_text, registry, settings.idle_term_ms)?
    ro trees_chan = Chan[TreeDone].new(64)
    mut hub = Hub {
        settings, machine, workdir, sessions: []Dialog.new(), conns: []int.new(), out: []Outgoing.new(), log: []str.new(), serial: 0, mcps: []McpServer.new(), mcp_pending: []McpPending.new(), mcp_serial: 0, ctl_letters: []CtlLetter.new(), ctl_waits: []CtlWait.new(), ctl_serial: 0, catalog: JsonObject.new(), catalog_dirty: false, catalog_saved_at: 0, choices: []PendingChoice.new(), reviews: []Review.new(), route_obs: 0, marks: []MachMark.new(), trees_tx: trees_chan.tx, trees_rx: trees_chan.rx, held: []HeldMsg.new(), reserved: []int.new()
    }
    if hub.wants_mcp() { ro started = hub.start_mcp() }
    ro pg = settings.store == "pg"
    // the flat files of the older form (`<id>.inbox` ...) go into the folders of their sessions before the sessions are listed (task 192k)
    ro migration = migrate_flat_sessions(settings.data_dir)
    if migration.sessions > 0 { hub.say_log("migrated ${migration.sessions} sessions to per-session folders") }
    for line in migration.kept { hub.say_log(line) }
    hub.catalog_load()
    ro ids = if pg {
        match with Net = real_net() { pg_list(settings.pg) } {
            Ok(list) => list
            Err(f) => return Err("the sessions cannot be listed: ${f.message}")
        }
    } else {
        list_sessions(settings.data_dir)
    }
    for id in ids {
        hub.resume_session(id)
    }
    hub.say_log("the machines of the product: ${machines_dir} (${machine.name()})")
    hub.say_log("started: ${settings.describe()}; ${hub.sessions.len()} session(s) resumed")
    Ok(hub)
}

fn Hub mut @resume_session(id str) Proc Detach Time -> () {
    ro pg = @settings.store == "pg"
    ro root = @settings.data_dir
    mut world = PgWorld.open(@settings.pg, id)
    match resume_stored(pg, root, world, @machine, id) {
        None => @say_log("the session ${id} cannot be resumed: no usable snapshot")
        Some(engine) => {
            mut s = Dialog { id, name: id, agent: "", engine, world, clients: []AcpClient.new(), turn: "", lines: []str.new(), announced: false, model_announced: false, started_at: 0, slow_told: false, folder: "", project_id: "", has_rank: false, rank: 0, rt: route_session_new(), chosen: []SavedChoice.new() }
            mut saw_created = false
            for e in history_in(pg, root, s) {
                if e.name == "session_created" && e.kind == EventKind.Input && !saw_created {
                    saw_created = true
                    match jobject(e.input) {
                        Some(meta) => {
                            s.name = if jtext(meta, "name").byte_len() > 0 { jtext(meta, "name") } else { id }
                            s.agent = jtext(meta, "agent")
                            // a session of a project goes on in the folder it was made for; one without a project, in the working folder
                            if jtext(meta, "project_id").byte_len() > 0 {
                                s.project_id = jtext(meta, "project_id")
                                s.folder = jtext(meta, "folder")
                            }
                        }
                        None => ()
                    }
                }
                // the owner renamed the session (task 192): the last name is the name
                if e.name == "session_renamed" && e.kind == EventKind.Input {
                    match jobject(e.input) {
                        Some(change) => { if jtext(change, "name").byte_len() > 0 { s.name = jtext(change, "name") } }
                        None => ()
                    }
                }
                // the owner placed the session (task 192): the place in the list of its project, and maybe another project; the last word is the place
                if e.name == "session_placed" && e.kind == EventKind.Input {
                    match jobject(e.input) {
                        Some(change) => {
                            match change.get("rank") {
                                Some(v) => {
                                    s.has_rank = true
                                    s.rank = jnumber(change, "rank")
                                }
                                None => ()
                            }
                            match change.get("project_id") {
                                Some(v) => { s.project_id = jtext(change, "project_id") }
                                None => ()
                            }
                        }
                        None => ()
                    }
                }
                // the family changed in the window (task 192): the agent of the session is the last one it was handed to
                if e.name == "agent_switched" && e.kind == EventKind.Input {
                    match jobject(e.input) {
                        Some(change) => { if jtext(change, "to").byte_len() > 0 { s.agent = jtext(change, "to") } }
                        None => ()
                    }
                }
                if e.at > s.rt.active_at { s.rt.active_at = e.at }
                // the mode of work and its task come back from the journal (task 192q)
                if e.kind == EventKind.Input && route_signals().contains(e.name) { s.rt.apply(e.name, e.input) }
                // the choices of the owner, per family: the last word of the journal (task 192t)
                if e.kind == EventKind.Input && (e.name == "setting_chosen" || e.name == "setting_dropped") {
                    match jobject(e.input) {
                        Some(change) => {
                            if e.name == "setting_chosen" {
                                s.chosen = chosen_put(s.chosen, jtext(change, "agent"), jtext(change, "setting"), jtext(change, "value"))
                            } else {
                                s.chosen = chosen_without(s.chosen, jtext(change, "agent"), jtext(change, "setting"))
                            }
                        }
                        None => ()
                    }
                }
                match line_of(s, e) {
                    Some(line) => s.lines.push(line)
                    None => ()
                }
            }
            s.rt.normalize()
            @add_session(s)
            if engine.open_ids().len() > 0 {
                ro reason = @ensure_client(@sessions.len() - 1)
                if reason.byte_len() > 0 { @say_log("the agent of ${id} cannot be started: ${reason}") }
            }
        }
    }
}

// Task 192.3: a child session of `parent` is made by the hub itself (the same record, the journal, the page is told); its agent is started later, when the child has work.
fn Hub mut @cs_make_session(cid str, name str, agent str, folder str, project_id str, parent str, pkind str, route str) Proc Detach Time -> int {
    ro pg = @settings.store == "pg"
    ro root = @settings.data_dir
    mut world = PgWorld.open(@settings.pg, cid)
    ro engine = begin_session_engine(pg, root, world, @machine, cid)
    mut s = Dialog { id: cid, name, agent, engine, world, clients: []AcpClient.new(), turn: "", lines: []str.new(), announced: false, model_announced: false, started_at: 0, slow_told: false, folder, project_id, has_rank: false, rank: 0, rt: route_session_new(), chosen: []SavedChoice.new() }
    accept_in(pg, root, s, Incoming.signal("session_created", meta_text_child(name, agent, @cwd_of(folder), "", project_id, parent, pkind)))
    @add_session(s)
    ro at = @sessions.len() - 1
    @drain(at)
    mut place = JsonObject.new()
    js(place, "route", route)
    jput(place, "worktree", JsonValue.bool(true))
    @rt_journal(at, "route_set", JsonValue.object(place).to_str())
    at
}

fn prepare_none() -> Prepared => prepared_not("")

// ----- what the page says -----

fn Hub mut @create(conn int, trace str, input JsonObject) Proc Detach Time -> () {
    ro name = if jtext(input, "name").byte_len() > 0 { jtext(input, "name") } else { trace }
    ro agent = jtext(input, "agent")
    ro project = jtext(input, "project")
    ro project_id = jtext(input, "project_id")
    if !valid_session_name(trace) {
        @send(conn, event_line("srv-new", trace, 0, "session_created", created_input(name, agent, @workdir), now_millis()))
        @tell_error(conn, trace, 1, "", "the session name is not valid: letters, digits, dot, dash and underscore")
        return
    }
    if @find(trace) >= 0 { return }
    match @settings.agent(agent) {
        None => {
            @send(conn, event_line("srv-new", trace, 0, "session_created", created_input(name, agent, @workdir), now_millis()))
            @tell_error(conn, trace, 1, "", "unknown agent: ${agent}")
        }
        Some(spec) => {
            // the project of the control panel (task 192m): its folder is the folder of the agent, its variables reach the process of the agent
            ro launch = match @launch_for(project_id, jtext(input, "folder")) {
                Ok(l) => l
                Err(reason) => {
                    @send(conn, event_line("srv-new", trace, 0, "session_created", created_input(name, agent, @workdir), now_millis()))
                    @tell_error(conn, trace, 1, "", "the session cannot be made: ${reason}")
                    return
                }
            }
            ro pg = @settings.store == "pg"
            ro root = @settings.data_dir
            mut world = PgWorld.open(@settings.pg, trace)
            ro engine = begin_session_engine(pg, root, world, @machine, trace)
            mut s = Dialog { id: trace, name, agent, engine, world, clients: []AcpClient.new(), turn: "", lines: []str.new(), announced: false, model_announced: false, started_at: 0, slow_told: false, folder: launch.folder, project_id, has_rank: false, rank: 0, rt: route_session_new(), chosen: []SavedChoice.new() }
            accept_in(pg, root, s, Incoming.signal("session_created", meta_text(name, agent, @cwd_of(launch.folder), project, project_id)))
            @add_session(s)
            ro at = @sessions.len() - 1
            @drain(at)
            // the mode and the place of work chosen on the page before the first message (the default: interactive, with a tree)
            mut place = JsonObject.new()
            js(place, "route", if route_valid(jtext(input, "route")) { jtext(input, "route") } else { "interactive" })
            jput(place, "worktree", JsonValue.bool(match input.get("worktree") { Some(v) => jflag(input, "worktree"), None => true }))
            @rt_journal(at, "route_set", JsonValue.object(place).to_str())
            @route_broadcast(at, true)
            ro reason = @ensure_client(at)
            if reason.byte_len() > 0 {
                @say_log("the agent of ${trace} cannot be started: ${reason}")
                @tell_error(0, trace, @sessions[at].engine.step_number(), "", "the agent ${agent} cannot be started: ${reason}")
            }
        }
    }
}

/// The most pictures one message carries.
export const MAX_IMAGES = 6

/// ImageMeta: what the journal keeps of a picture: its number in the session, the name the owner saw, the type and the size. Never the bytes.
type ImageMeta { n int, name str, mime str, bytes int }

/// Prepared: the pictures of a message after they were checked and kept: their records, the files for the prompt, and the reason (""
/// - all well) the message is refused for.
type Prepared { metas []ImageMeta, files []AcpImage, reason str }

fn prepared_not(reason str) -> Prepared => { metas: []ImageMeta.new(), files: []AcpImage.new(), reason }

// A name to show: at most 80 characters, no line breaks; "image.png" when there is none.
fn short_name(name str) -> str {
    ro flat = name.replace("\n", " ").replace("\r", " ").replace("\t", " ")
    if flat.trim_ascii().byte_len() == 0 { return "image.png" }
    mut parts = []str.new()
    mut count = 0
    for c in flat.chars() {
        count += 1
        if count <= 80 { parts.push("${c}") }
    }
    parts.join("")
}

fn images_text(metas []ImageMeta) -> str {
    mut rows = []JsonValue.new()
    for m in metas {
        mut o = JsonObject.new()
        jput(o, "n", JsonValue.int(m.n))
        jput(o, "name", JsonValue.str(m.name))
        jput(o, "mime", JsonValue.str(m.mime))
        jput(o, "bytes", JsonValue.int(m.bytes))
        rows.push(JsonValue.object(o))
    }
    mut o = JsonObject.new()
    jput(o, "images", JsonValue.array(rows))
    JsonValue.object(o).to_str()
}

// The pictures of a message of the page: each one is `{name, mime, data}` (base64, the hub keeps the file) or `{name, n}` (the page has put
// the file already by `POST /api/session-image/<session>`, the hub looks at it). The limit of the number and of the size is checked here, whatever the page did.
fn Hub @prepare_images_in(trace str, items []JsonValue) Fs -> Prepared {
    if items.len() > MAX_IMAGES { return prepared_not("at most ${MAX_IMAGES} pictures in a message") }
    mut metas = []ImageMeta.new()
    mut files = []AcpImage.new()
    for item in items {
        ro o = match item.object() {
            Some(x) => x
            None => return prepared_not("a picture must be an object")
        }
        ro name = short_name(jtext(o, "name"))
        ro data = jtext(o, "data")
        mut n = jnumber(o, "n")
        if data.byte_len() > 0 {
            ro mime = jtext(o, "mime")
            if image_ext(mime).byte_len() == 0 { return prepared_not("the type of the picture ${name} is not taken (png, jpeg, webp, gif)") }
            ro bytes = match decode_image(data) {
                Some(b) => b
                None => return prepared_not("the picture ${name} is not base64")
            }
            if bytes.len() > @settings.max_image_bytes { return prepared_not("the picture ${name} is over ${@settings.max_image_bytes} bytes") }
            ro saved = save_image(@settings.data_dir, trace, mime, bytes)
            if saved.reason.byte_len() > 0 { return prepared_not(saved.reason) }
            n = saved.n
        }
        match find_image(@settings.data_dir, trace, n) {
            None => return prepared_not("the picture ${name} is not there")
            Some(file) => {
                if file.bytes > @settings.max_image_bytes { return prepared_not("the picture ${name} is over ${@settings.max_image_bytes} bytes") }
                metas.push(ImageMeta { n, name, mime: file.mime, bytes: file.bytes })
                files.push(AcpImage { path: file.path.display(), mime: file.mime, name })
            }
        }
    }
    Prepared { metas, files, reason: "" }
}

fn Hub @prepare_images(trace str, items []JsonValue) -> Prepared {
    with Fs = real_fs() {
        @prepare_images_in(trace, items)
    }
}

fn Hub mut @say(trace str, text str, items []JsonValue) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 {
        @say_log("a message to an unknown session: ${trace}")
        return
    }
    if text.byte_len() == 0 && items.len() == 0 { return }
    // task 192.2: the code word answers the last card of a proposal of a task and is not sent to the agent
    if items.len() == 0 && @ct_word(at, text) { return }
    if !@takes_message_at(at) {
        @say_log("a message to ${trace} while a turn is open: ignored")
        return
    }
    if @sessions[at].rt.running || @sessions[at].rt.job.byte_len() > 0 {
        @tell_error(0, trace, @sessions[at].engine.step_number(), "", "идёт прогон шагов: остановите его, чтобы написать")
        return
    }
    // the mode of work (task 192q): the task, its tree and its files first, then the agent in the right folder
    ro line = @route_on_message(at, text)
    // task 192.8: the tree of the session is made in the background; the message waits for it (it is not lost) and the hub answers the pages meanwhile
    if @sessions[at].rt.wip_prep > 0 {
        @wip_hold(trace, text, items)
        return
    }
    @route_sync_cwd(at)
    ro reason = @ensure_client(at)
    if reason.byte_len() > 0 {
        @tell_error(0, trace, @sessions[at].engine.step_number(), "", "the agent cannot be started: ${reason}")
        return
    }
    mut s = @sessions[at]
    mut prepared = prepare_none()
    if items.len() > 0 {
        prepared = @prepare_images(trace, items)
        if prepared.reason.byte_len() > 0 {
            @tell_error(0, trace, s.engine.step_number(), "", "the pictures are not sent: ${prepared.reason}")
            return
        }
        // the journal keeps the records of the pictures, right before the message they belong to; the files go to the client for the prompt
        accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("message_images", images_text(prepared.metas)))
        s.clients[0].attach_images(prepared.files)
        @route_save_images(at, prepared.files)
    }
    @ct_remember(at, text, prepared.files)
    ro reminder = @route_reminder_of(at)
    @req_part(at, "reminder", "Напоминание режима", reminder)
    ro prelude0 = @route_message_prelude(at)
    ro prelude = if prelude0.byte_len() > 0 { "${reminder}\n\n${prelude0}" } else { reminder }
    if prelude.byte_len() > 0 { s.clients[0].set_prelude(prelude) }
    // task 192.11: the request of this turn for the page "Запрос"
    @req_commit(at, "", req_owner_parts(text, prepared.files))
    feed_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("user_message", text))
    s.clients[0].attach_images([]AcpImage.new())
    @drain(at)
    @route_broadcast(at, false)
}

fn Hub mut @cancel(trace str) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    mut s = @sessions[at]
    if s.clients.len() == 0 { return }
    @mcp_withdraw(trace)
    // a question that waits for the owner goes first: the page takes the form away, and the agent is answered "cancel" (task 192i)
    for key in s.clients[0].withdraw_questions() {
        mut withdrawn = JsonObject.new()
        jput(withdrawn, "request", JsonValue.str(key))
        jput(withdrawn, "skipped", JsonValue.bool(true))
        jput(withdrawn, "cancelled", JsonValue.bool(true))
        feed_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("question_answer", JsonValue.object(withdrawn).to_str()))
    }
    feed_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("cancel_request", ""))
    @drain(at)
}

fn Hub mut @decide(trace str, request str, decision str) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    mut s = @sessions[at]
    if s.clients.len() == 0 { return }
    ro event = Incoming.signal("permission_decision", decision_text(request, decision))
    if s.clients[0].decide_event(event) {
        feed_in(@settings.store == "pg", @settings.data_dir, s, event)
        @drain(at)
    } else {
        @say_log("a decision for ${trace} that nobody asked: request ${request}")
    }
}

// The owner answered a question of the agent (task 192i): the agent gets the content of the form, the engine journals the answer.
fn Hub mut @answer(trace str, input JsonObject) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    match @mcp_take(jtext(input, "request")) {
        Some(pending) => {
            ro told = pending.reply.send("ok:${ask_result_text(pending.questions, JsonValue.object(input))}")
            @mcp_settled(at, input)
            return
        }
        None => ()
    }
    mut s = @sessions[at]
    if s.clients.len() == 0 { return }
    ro event = Incoming.signal("question_answer", JsonValue.object(input).to_str())
    if s.clients[0].answer_event(event) {
        feed_in(@settings.store == "pg", @settings.data_dir, s, event)
        @drain(at)
    } else {
        @say_log("an answer for ${trace} to a question that nobody asked: request ${jtext(input, "request")}")
    }
}

// The pending call of the tool with this key, taken out of the list; None - there is none.
fn Hub mut @mcp_take(key str) -> Option[McpPending] {
    mut found = -1
    mut index = 0
    for p in @mcp_pending {
        if p.key == key { found = index }
        index += 1
    }
    if found < 0 { return None }
    ro pending = @mcp_pending[found]
    mut rest = []McpPending.new()
    for p in @mcp_pending {
        if p.key != key { rest.push(p) }
    }
    @mcp_pending = rest
    Some(pending)
}

fn Hub mut @mcp_take_call(call int) -> Option[McpPending] {
    mut key = ""
    for p in @mcp_pending {
        if p.call == call { key = p.key }
    }
    if key.byte_len() == 0 { return None }
    @mcp_take(key)
}

// The page is told a question of the tool is settled (an answer, a skip, a term, a cancel): an event of the session, kept in its journal like the answer of the owner.
fn Hub mut @mcp_settled(at int, answer JsonObject) Proc Detach Time -> () {
    mut s = @sessions[at]
    accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("question_answer", JsonValue.object(answer).to_str()))
    @drain(at)
}

fn withdrawn_answer(key str, why str) -> JsonObject {
    mut o = JsonObject.new()
    jput(o, "request", JsonValue.str(key))
    jput(o, "skipped", JsonValue.bool(true))
    jput(o, "cancelled", JsonValue.bool(true))
    jput(o, why, JsonValue.bool(true))
    o
}

// The calls of the tool of a session are over because its turn is cancelled: the agent is told the owner skipped, the page takes the forms away.
fn Hub mut @mcp_withdraw(trace str) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    @ctl_withdraw(trace)
    mut keys = []str.new()
    for p in @mcp_pending {
        if p.session == trace { keys.push(p.key) }
    }
    for key in keys {
        match @mcp_take(key) {
            Some(pending) => {
                ro told = pending.reply.send("ok:${ask_result_text(pending.questions, JsonValue.object(withdrawn_answer(key, "turn")))}")
                @mcp_settled(at, withdrawn_answer(key, "turn"))
            }
            None => ()
        }
    }
}

// A message of the MCP server: a call of the tool opens a question on the page of its session; a call whose term passed takes it away.
fn Hub mut @mcp_message(msg McpMsg) Proc Detach Time -> () {
    if msg.kind == "task" {
        @ct_tool_call(msg)
        return
    }
    if msg.kind == "tasklist" {
        @ct_list_call(msg)
        return
    }
    if msg.kind == "ctl" {
        @ctl_call(msg)
        return
    }
    if msg.kind == "gone" {
        @ctl_gone(msg.call)
        match @mcp_take_call(msg.call) {
            Some(pending) => {
                ro at = @find(pending.session)
                if at >= 0 { @mcp_settled(at, withdrawn_answer(pending.key, "timeout")) }
            }
            None => ()
        }
        return
    }
    ro at = @find(msg.session)
    if at < 0 {
        ro told = msg.reply.send("err:the session ${msg.session} is not known to the hub")
        return
    }
    if @takes_message_at(at) {
        ro told = msg.reply.send("err:no turn is open in the session, so nobody can answer now")
        return
    }
    ro questions = match Json.parse(msg.text) {
        Ok(v) => v
        Err(e) => JsonValue.array([]JsonValue.new())
    }
    @mcp_serial += 1
    ro key = "mcp-${@mcp_serial}"
    @mcp_pending.push(McpPending { key, call: msg.call, session: msg.session, questions, reply: msg.reply })
    mut o = JsonObject.new()
    jput(o, "request", JsonValue.str(key))
    jput(o, "tool_call", JsonValue.str(""))
    jput(o, "questions", questions)
    mut s = @sessions[at]
    accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("question_request", JsonValue.object(o).to_str()))
    @drain(at)
}

fn Hub mut @mcp_poll() Proc Detach Time -> () {
    if @mcps.len() == 0 { return }
    mut more = true
    while more {
        match @mcps[0].inbox.try_recv() {
            Some(msg) => @mcp_message(msg)
            None => { more = false }
        }
    }
}

fn switched_text(from str, to str, shown int, total int, cut bool) -> str {
    mut o = JsonObject.new()
    jput(o, "from", JsonValue.str(from))
    jput(o, "to", JsonValue.str(to))
    jput(o, "shown", JsonValue.int(shown))
    jput(o, "total", JsonValue.int(total))
    jput(o, "cut", JsonValue.int(if cut { 1 } else { 0 }))
    JsonValue.object(o).to_str()
}

fn transfer_request(id str, trace str, step int, text str) -> PartyRequest[str] => {
    id, attempt: 1, party: "agent", input: text, idle_term: 0, trace, step
}

fn send_transfer(mut s Dialog, request PartyRequest[str]) -> () {
    with Link = acp_link(s.clients[0]) {
        Link.send(request)
    }
}

fn renamed_text(name str) -> str {
    mut o = JsonObject.new()
    jput(o, "name", JsonValue.str(name))
    JsonValue.object(o).to_str()
}

// The owner renamed the session in the header (task 192): the same session and journal, a new name; every page is told by the event `session_renamed`.
fn Hub mut @rename(trace str, name str) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    ro clean = name.trim()
    if clean.byte_len() == 0 || clean.byte_len() > 400 { return }
    mut s = @sessions[at]
    s.name = clean
    accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("session_renamed", renamed_text(clean)))
    @sessions[at] = s
    @drain(at)
}

fn placed_text(rank int, move bool, project_id str, project str) -> str {
    mut o = JsonObject.new()
    jput(o, "rank", JsonValue.int(rank))
    if move {
        jput(o, "project_id", JsonValue.str(project_id))
        jput(o, "project", JsonValue.str(project))
    }
    JsonValue.object(o).to_str()
}

// The owner dragged the sessions of a project into a new order (task 192): `ids` is the whole list top to bottom; the place of a session is its number.
// Only the sessions whose place changed are written to their journals; a name that is not a session is skipped.
fn Hub mut @reorder(ids []JsonValue) Proc Detach Time -> () {
    mut place = 0
    for v in ids {
        ro id = v.str() ?? ""
        ro at = @find(id)
        if at < 0 { continue }
        mut s = @sessions[at]
        if !s.has_rank || s.rank != place {
            s.has_rank = true
            s.rank = place
            accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("session_placed", placed_text(place, false, "", "")))
            @sessions[at] = s
            @drain(at)
        }
        place += 1
    }
}

// The owner dropped a session on the head of another project (task 192): the session goes to the top of that project; its folder stays as it was.
fn Hub mut @move(trace str, project_id str) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    mut name = ""
    if project_id.byte_len() > 0 {
        match projects_get(@settings.data_dir, project_id) {
            Ok(p) => { name = p.name }
            Err(f) => {
                @tell_error(0, trace, @sessions[at].engine.step_number(), "", "the project is not there: ${f.message}")
                return
            }
        }
    }
    mut front = 0
    for other in @sessions {
        if other.id != trace && other.project_id == project_id && other.has_rank && other.rank - 1 < front { front = other.rank - 1 }
    }
    mut s = @sessions[at]
    if s.project_id == project_id { return }
    s.project_id = project_id
    s.has_rank = true
    s.rank = front
    accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("session_placed", placed_text(front, true, project_id, name)))
    @sessions[at] = s
    @drain(at)
}

fn delete_files(root str, id str) Fs -> bool => remove_session_dir(root, id)

// The owner deleted a session (task 192): the turn is cancelled, the agent is stopped, the folder of the session (the journal, the snapshot, the inbox, the
// trace of the agent, the pictures) is removed, and every page is told by the event `session_deleted` (it is not kept: the session is gone). Over PostgreSQL
// the application role cannot delete, so the owner is told and nothing changes.
fn Hub mut @delete(conn int, trace str, branch str) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    if @settings.store == "pg" {
        @tell_error(conn, trace, @sessions[at].engine.step_number(), "", "a session cannot be deleted over PostgreSQL")
        return
    }
    @mcp_withdraw(trace)
    @cancel(trace)
    mut s = @sessions[at]
    if s.clients.len() > 0 {
        s.clients[0].close()
        s.clients = []AcpClient.new()
    }
    // the tree and the branch of the task live as long as the session is in the list; a deleted session takes them with it only when there is nothing to lose
    // (no commits that are not merged, no changed files), else they stay, unless the owner said "drop" (`branch`: "drop" - with the work, "keep" - leave them)
    if s.rt.task_open && s.rt.worktree.byte_len() > 0 {
        @route_close_agent_in(at, s.rt.worktree)
        ro count = tk_unmerged(s.rt.worktree)
        ro work = count > 0 || @route_dirty(s)
        if branch == "drop" || (!work && branch != "keep") {
            ro dropped = tk_tree_drop(@cwd_of(s.folder), s.rt.worktree, s.rt.branch)
            if !dropped.ok { @say_log("the tree of the task ${s.rt.task_id} is not removed: ${dropped.text}") }
        } else {
            @say_log("the session ${trace} is deleted, the tree ${s.rt.worktree} and the branch ${s.rt.branch} stay (${count} commits not merged)")
        }
    }
    // task 192.4: the tree (no branch) of a work that was not a task (a session with a task of its own tree has none: the wip fields are cleared)
    if s.rt.wip_tree.byte_len() > 0 { @wip_delete(at, branch) }
    ro removed = with Fs = real_fs() { delete_files(@settings.data_dir, trace) }
    if !removed {
        @tell_error(conn, trace, s.engine.step_number(), "", "the folder of the session cannot be removed")
        return
    }
    mut rest = []Dialog.new()
    for other in @sessions {
        if other.id != trace { rest.push(other) }
    }
    @sessions = rest
    mut kept = []PendingChoice.new()
    for c in @choices {
        if c.trace != trace { kept.push(c) }
    }
    @choices = kept
    @serial += 1
    @send(0, event_line("srv-${@serial}", trace, 0, "session_deleted", JsonObject.new(), now_millis()))
    @say_log("the session ${trace} is deleted")
}

// The owner changed the family in the window (task 192): the same session, the same journal, another agent. The new agent is started
// first (a failure leaves the old one), then the old one is closed and the new one gets the whole protocol of the conversation as
// a turn of its own: it is not a turn of the engine, so the feed does not show it, and what the agent answers to it is discarded.
fn Hub mut @switch_agent(trace str, agent str) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    mut s = @sessions[at]
    if agent == s.agent { return }
    match @settings.agent(agent) {
        None => {
            @tell_error(0, trace, s.engine.step_number(), "", "unknown agent: ${agent}")
            return
        }
        Some(spec) => ()
    }
    if s.clients.len() > 0 && !@takes_message_at(at) { @cancel(trace) }
    if !@takes_message_at(at) {
        @tell_error(0, trace, s.engine.step_number(), "", "the turn is still open: the agent is not changed, try again in a moment")
        return
    }
    ro config = match @open_config_for(agent, s.id, s.rt.agent_dir(@cwd_of(s.folder))) {
        Some(c) => c
        None => {
            @tell_error(0, trace, s.engine.step_number(), "", "the agent ${agent} is not configured")
            return
        }
    }
    match open_client_full(config, @trace_path_of(s), TRACE_LIMIT, @ask_for(agent, s.id), @agent_env(agent, @env_of(s))) {
        Err(reason) => {
            @say_log("the agent of ${trace} cannot be changed to ${agent}: ${reason}")
            @tell_error(0, trace, s.engine.step_number(), "", "the agent ${agent} cannot be started: ${reason}; the session stays with ${s.agent}")
        }
        Ok(client) => {
            ro from = s.agent
            ro transfer = build_transfer(s.lines, from, TRANSFER_LIMIT)
            if s.clients.len() > 0 { s.clients[0].close() }
            s.clients = []AcpClient.new()
            s.clients.push(client)
            // this family has choices of its own (kept in the journal); those of the family left are not carried over
            s.clients[0].set_presets(presets_for(s.chosen, agent))
            s.agent = agent
            s.announced = false
            s.model_announced = false
            s.slow_told = false
            s.started_at = now_millis()
            s.rt.cwd_now = s.rt.agent_dir(@cwd_of(s.folder))
            s.rt.told = false
            accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("agent_switched", switched_text(from, agent, transfer.shown, transfer.total, transfer.cut)))
            @sessions[at] = s
            @drain(at)
            if transfer.total > 0 {
                @serial += 1
                send_transfer(s, transfer_request("transfer-${@serial}", trace, s.engine.step_number(), transfer.text))
            }
            @say_log("the session ${trace} goes on with ${agent} (was ${from}): ${transfer.shown} of ${transfer.total} messages whole")
        }
    }
}

// The owner chose a model, an effort or a mode (task 192): the agent is asked; the answer comes back as `agent_model`.
fn Hub mut @choose(trace str, setting str, value str) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    mut s = @sessions[at]
    // an agent that is not running (a session after a restart, or an idle one): start it, the choice waits until it is ready
    if s.clients.len() == 0 || s.clients[0].phase() != "ready" {
        ro reason = @ensure_client(at)
        if reason.byte_len() > 0 {
            @tell_error(0, trace, s.engine.step_number(), "", "the agent cannot be started: ${reason}")
            return
        }
        @choices.push(PendingChoice { trace, setting, value })
        return
    }
    if !s.clients[0].select_option(setting, value) {
        @say_log("a choice for ${trace} that the agent did not offer: ${setting} = ${value}")
    }
}

// The choices that waited for the agent of this session are made now (it is ready).
fn Hub mut @apply_choices(mut s Dialog) -> () {
    mut rest = []PendingChoice.new()
    for c in @choices {
        if c.trace != s.id {
            rest.push(c)
        } else if !s.clients[0].select_option(c.setting, c.value) {
            @say_log("a choice for ${s.id} that the agent did not offer: ${c.setting} = ${c.value}")
        }
    }
    @choices = rest
}

/// A page said something: an event in the format of the page (`session_created`, `user_message`, `cancel`, `permission_decision`, `question_answer`).
/// Anything else is ignored and logged.
export fn Hub mut @handle(conn int, text str) Proc Detach Time -> () {
    ro o = match jobject(text) {
        Some(x) => x
        None => {
            @say_log("a message that is not a JSON object from page ${conn}")
            return
        }
    }
    ro handled_at = now_millis()
    ro kind = jtext(o, "kind")
    ro trace = jtext(o, "trace")
    ro input = match jchild(o, "input") {
        Some(x) => x
        None => JsonObject.new()
    }
    if trace.byte_len() == 0 {
        @say_log("a message without a trace from page ${conn}")
        return
    }
    ro active_at = @find(trace)
    if active_at >= 0 {
        mut touched = @sessions[active_at]
        touched.rt.active_at = now_millis()
        @sessions[active_at] = touched
    }
    if kind == "session_created" {
        @create(conn, trace, input)
    } else if kind == "user_message" {
        @say(trace, jtext(input, "text"), jlist(input, "images"))
    } else if kind == "cancel" {
        @cancel(trace)
    } else if kind == "permission_decision" {
        @decide(trace, jtext(input, "request"), jtext(input, "decision"))
    } else if kind == "question_answer" {
        @answer(trace, input)
    } else if kind == "session_agent" {
        @switch_agent(trace, jtext(input, "agent"))
    } else if kind == "session_delete" {
        @delete(conn, trace, jtext(input, "branch"))
    } else if kind == "session_reorder" {
        @reorder(jlist(input, "ids"))
    } else if kind == "session_move" {
        @move(trace, jtext(input, "project_id"))
    } else if kind == "session_rename" {
        @rename(trace, jtext(input, "name"))
    } else if kind == "session_setting" {
        @choose(trace, jtext(input, "setting"), jtext(input, "value"))
    } else if kind == "machine_state_get" {
        @machine_get(trace)
    } else if kind == "request_get" {
        @req_get(trace, jint(input, "turn"))
    } else if kind == "session_route" {
        @route_set(trace, jtext(input, "route"))
    } else if kind == "route_run" {
        @route_run(trace)
    } else if kind == "route_skip" {
        @route_skip(trace, jint(input, "step"))
    } else if kind == "route_stop" {
        @route_stop_signal(trace)
    } else if kind == "route_new_task" {
        @route_new_task(trace)
    } else if kind == "route_subtask_new" {
        @route_force(trace, "new")
    } else if kind == "route_subtask_same" {
        @route_force(trace, "same")
    } else if kind == "route_subtask_worktree" {
        @route_subtree_signal(trace, jint(input, "n"))
    } else if kind == "route_subtask_done" {
        @route_subtask_done(trace, jint(input, "n"))
    } else if kind == "route_subtask_parallel" {
        @route_parallel(trace, jint(input, "n"), jflag(input, "on"))
    } else if kind == "route_subtask_choose" {
        @route_choose_signal(trace, jint(input, "n"), jtext(input, "tree"))
    } else if kind == "route_merge" || kind == "route_publish" {
        @route_merge(trace)
    } else if kind == "route_tests_run" {
        @route_tests_run(trace)
    } else if kind == "route_tree_drop" {
        @route_tree_drop(trace, jflag(input, "force"))
    } else if kind == "session_worktree" {
        @route_worktree(trace, jflag(input, "on"))
    } else if kind == "route_diff" {
        @route_diff(trace)
    } else if kind == "route_prop" {
        @ct_answer(trace, jint(input, "id"), jtext(input, "action"), jtext(input, "agent"), jtext(input, "mode"), jint(input, "target"), jtext(input, "run"), jtext(input, "children"))
    } else if kind == "route_children_merge" {
        @cs_chain_signal(trace)
    } else if kind == "route_ext_undo" {
        @ct_ext_undo(trace, jint(input, "id"))
    } else if kind == "route_recognize" {
        @ct_recognize(trace)
    } else if kind == "route_apply" {
        @ct_apply(trace, jlist(input, "items"))
    } else {
        @say_log("a message of the kind ${kind} from page ${conn}: ignored")
    }
    // a state the machine passed through while the message was taken (the open turn) is told now, not at the next pump
    @machine_pump()
    // task 192.8: an operation of the thread of the hub that takes more than 5 s is written to the log (who, how long): the hub answers nobody meanwhile
    if now_millis() - handled_at > 5000 { @say_log("slow: the message ${kind} of ${trace} took ${now_millis() - handled_at} ms") }
}

// The first time an agent is ready, or has refused to start, is told: to the log, and a refusal to the page.
fn Hub mut @watch_agent(at int) Time -> () {
    mut s = @sessions[at]
    mut told = false
    // the choices of the owner the agent took go to the journal; the ones it does not offer any more are dropped there, and the owner is told (task 192t)
    for p in s.clients[0].take_settled() {
        s.chosen = chosen_put(s.chosen, s.agent, p.setting, p.value)
        accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("setting_chosen", chosen_text(s.agent, p.setting, p.value, now_millis())))
        told = true
    }
    for d in s.clients[0].take_dropped() {
        s.chosen = chosen_without(s.chosen, s.agent, d.setting)
        accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("setting_dropped", dropped_text(s.agent, d.setting, d.value, d.used)))
        told = true
    }
    if s.announced {
        @sessions[at] = s
        if told { @drain(at) }
        return
    }
    mut model_arrived = told
    ro phase = s.clients[0].phase()
    if !s.slow_told && phase != "ready" && phase != "failed" && now_millis() - s.started_at > 10000 {
        s.slow_told = true
        @say_log("the agent of ${s.id} is still starting (phase ${phase}): ${s.clients[0].stderr_tail()}")
    }
    // task 192.8: an agent that does not answer `initialize` in `agent_start_timeout_seconds` is told to the owner (a red line); the session stays alive, the next message starts a new agent
    if !s.announced && phase != "ready" && phase != "failed" && now_millis() - s.started_at > @settings.agent_start_ms {
        s.announced = true
        ro tail = s.clients[0].stderr_tail()
        s.clients[0].close()
        s.clients = []AcpClient.new()
        @say_log("the agent of ${s.id} did not start in ${@settings.agent_start_ms / 1000} s (phase ${phase}): ${tail}")
        @sessions[at] = s
        @tell_error(0, s.id, s.engine.step_number(), "", "агент ${s.agent} не ответил за ${@settings.agent_start_ms / 1000} с (фаза ${phase}); сессия жива, следующее сообщение запустит агента заново")
        return
    }
    // the first summary waits until the choices asked for after the start are settled (a few seconds at most), so that it shows them
    if phase == "ready" && (s.clients[0].sets_pending() == 0 || now_millis() - s.started_at > 5000) {
        s.announced = true
        @say_log("the agent of ${s.id} is ready: ${s.clients[0].agent_name()}")
        @apply_choices(s)
        if !s.model_announced {
            s.model_announced = true
            accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("agent_model", s.clients[0].options()))
            model_arrived = true
        }
    } else if phase == "failed" {
        s.announced = true
        ro why = s.clients[0].last_error()
        @say_log("the agent of ${s.id} refused to start: ${why}")
        @tell_error(0, s.id, s.engine.step_number(), "", "the agent refused to start: ${why}")
    }
    @sessions[at] = s
    if model_arrived { @drain(at) }
}

/// The work of a moment: the agents are asked for what they have, the engines take it. Returns the number of steps made.
export fn Hub mut @pump() Proc Detach Time -> int {
    ro pumped_at = now_millis()
    @mcp_poll()
    mut made = 0
    mut at = 0
    while at < @sessions.len() {
        mut s = @sessions[at]
        if s.clients.len() > 0 {
            made += pump_in(@settings.store == "pg", @settings.data_dir, s)
            @drain(at)
            @watch_agent(at)
        }
        at += 1
    }
    @catalog_save(false)
    @wip_poll()
    @route_pump()
    @machine_pump()
    if now_millis() - pumped_at > 5000 { @say_log("slow: the pump took ${now_millis() - pumped_at} ms") }
    made
}

/// What the hub has to say to the pages, in order; the list is emptied.
export fn Hub mut @take_output() -> []Outgoing {
    ro out = @out
    @out = []Outgoing.new()
    out
}

/// The lines of the log since the last call.
export fn Hub mut @take_log() -> []str {
    ro out = @log
    @log = []str.new()
    out
}

/// Close the agents of all sessions (their processes are killed). The store has nothing to close.
export fn Hub mut @close() Time -> () {
    for server in @mcps { server.stop() }
    @catalog_save(true)
    for s in @sessions {
        mut mine = s
        if mine.clients.len() > 0 {
            mine.clients[0].close()
            mine.clients = []AcpClient.new()
        }
    }
    @route_close_reviews()
}

/// The ids of the sessions, in the order they were found or made.
export fn Hub @session_ids() -> []str {
    mut out = []str.new()
    for s in @sessions { out.push(s.id) }
    out
}

/// The page lines of a session since its beginning (what a page that attaches now receives).
export fn Hub @page_lines(id str) -> []str {
    ro at = @find(id)
    if at < 0 { return []str.new() }
    @sessions[at].lines
}

/// Does the session take a message of the owner now (no turn is open)? False for an unknown session. The table answers (`accepts_signal`), not a name of a state.
export fn Hub @takes_message(id str) -> bool {
    ro at = @find(id)
    if at < 0 { return false }
    @takes_message_at(at)
}

/// The name of the state of the machine of a session as the table calls it (for people and for the log; the code does not compare it), "" for an unknown session.
export fn Hub @state_of(id str) -> str {
    ro at = @find(id)
    if at < 0 { return "" }
    @machine.state_name(@sessions[at].engine.state())
}

/// Does the session have an agent process?
export fn Hub @has_agent(id str) -> bool {
    ro at = @find(id)
    if at < 0 { return false }
    @sessions[at].clients.len() > 0
}

/// The pages that are attached now (a copy: the list of the hub changes).
export fn Hub @attached() -> []int {
    mut out = []int.new()
    for c in @conns { out.push(c) }
    out
}

/// The name of the machine the sessions run on ("DialogSession").
export fn Hub @machine_name() -> str => @machine.name()

/// The state of a session as the text of its snapshot (the encoded state of the machine), "" for an unknown session.
export fn Hub @state_text_of(id str) -> str {
    ro at = @find(id)
    if at < 0 { return "" }
    @machine.encode_state(@sessions[at].engine.state())
}
