// taskwt_stub.nv - task 192q: THE STUB of the git operations of the tasks. The real module is `taskwt.nv` of task 192r (trees of tasks and of subtasks,
// merges, conflicts, publishing, the touched files); when it is taken into this branch, DELETE THIS FILE and, if the signatures differ, adapt the calls of
// `routes_hub.nv` (they are all in this one list of names). Here: the small real functions the hub needs to work with a temporary repository (a tree of a
// task, the count of the commits not merged, the state of a tree) and refusals ("not available") for the rest.
module crew_harness.server

/// TwTree: a tree made for a task or a subtask.
export type TwTree { ok bool, branch str, worktree str, base str, text str }

/// TwMerge: the result of a merge or a rebase: `status` is "merged", "conflict" (with the files) or "error".
export type TwMerge { status str, files []str, text str }

/// TwPublish: the result of the last step of publishing: `status` "done" or "error"; `main_note` says what happened to the main copy.
export type TwPublish { status str, text str, main_note str }

fn tw_unavailable() -> TwMerge => { status: "error", files: []str.new(), text: "the git operations of the tasks are not in this build (module taskwt of task 192r)" }

// `<parent>/worktrees/<repo>-<folder><suffix>` (the parent itself when it is called `worktrees`)
fn tw_tree_path(main_copy str, folder str, suffix str) -> str {
    mut base = main_copy.replace("\\", "/")
    while base.ends_with("/") && base.byte_len() > 1 { base = base[..base.byte_len() - 1] }
    ro cut = base.rfind("/") ?? -1
    if cut < 0 { return "worktrees/${base}-${folder}${suffix}" }
    ro parent = base[..cut]
    ro repo = base[cut + 1..]
    ro root = if parent.ends_with("/worktrees") || parent == "worktrees" { parent } else { "${parent}/worktrees" }
    "${root}/${repo}-${folder}${suffix}"
}

/// Is the folder the root of a git repository (a `.git` folder or file)?
export fn tw_is_repo(dir str) -> bool => path_there("${dir}/.git")

/// The names of the task branches (`task/007-x` as `007-x`, also of `origin`), for the number of the next task.
export fn task_branch_names(main_copy str) Proc -> []str {
    mut out = []str.new()
    ro r = git_run(main_copy, ["for-each-ref", "--format=%(refname:short)", "refs/heads/task", "refs/remotes/origin/task"])
    if r.ok {
        for line in r.text.lines() {
            ro name = line.trim_ascii()
            if name.starts_with("origin/task/") {
                out.push(name["origin/task/".byte_len()..])
            } else if name.starts_with("task/") {
                out.push(name["task/".byte_len()..])
            }
        }
    }
    out
}

/// A tree for the task `folder` ("007-name"): branch `task/<folder>` from `origin/main` (from the current branch when there is no origin), the tree next to the main copy.
export fn task_tree_create(main_copy str, folder str) Proc -> TwTree {
    ro base = if git_run(main_copy, ["rev-parse", "--verify", "--quiet", "origin/main"]).ok { "origin/main" } else { "HEAD" }
    ro branch = "task/${folder}"
    ro path = tw_tree_path(main_copy, folder, "")
    ro r = git_run(main_copy, ["worktree", "add", "-b", branch, path, base])
    if r.ok { { ok: true, branch, worktree: path, base, text: "" } } else { { ok: false, branch: "", worktree: "", base: "", text: r.text } }
}

/// Remove the tree and the branch of a task that has nothing to lose (no commits that are not merged, a clean tree).
export fn task_tree_remove(main_copy str, tree str, branch str) Proc -> GitOut {
    ro r = git_run(main_copy, ["worktree", "remove", tree])
    if !r.ok { return r }
    git_run(main_copy, ["branch", "-d", branch])
}

/// A tree for the subtask `n` of the task: branch `<task branch>-s<n>` from the tip of the branch of the task.
export fn subtask_tree_create(task_tree str, main_copy str, folder str, n int) Proc -> TwTree =>
    { ok: false, branch: "", worktree: "", base: "", text: tw_unavailable().text }

/// Merge the branch of a subtask into the tree of the task (`--no-ff`).
export fn subtask_merge(task_tree str, sub_branch str, message str) Proc -> TwMerge => tw_unavailable()

/// Finish a merge that had conflicts after they were resolved: "merged", "conflict" (still unresolved files) or "error".
export fn subtask_merge_finish(task_tree str, message str) Proc -> TwMerge => tw_unavailable()

/// Abandon a merge in the tree of the task.
export fn subtask_merge_abort(task_tree str) Proc -> GitOut => { ok: false, text: tw_unavailable().text }

/// Remove the tree and the branch of a merged subtask.
export fn subtask_tree_remove(task_tree str, sub_tree str, sub_branch str) Proc -> GitOut => { ok: false, text: tw_unavailable().text }

/// The files a subtask says it touches (the section `Затрагивает:` of its progress file).
export fn parse_touches(text str) -> []str {
    mut out = []str.new()
    mut inside = false
    for line in text.lines() {
        ro t = line.trim_ascii()
        if t.starts_with("Затрагивает:") {
            inside = true
            for part in t["Затрагивает:".byte_len()..].split(",") {
                ro p = part.trim_ascii().replace("`", "")
                if p.byte_len() > 0 { out.push(p) }
            }
        } else if inside && t.starts_with("- ") && !t.starts_with("- [") {
            ro p = t[2..].trim_ascii().replace("`", "")
            if p.byte_len() > 0 { out.push(p) }
        } else if inside && t.byte_len() > 0 {
            inside = false
        }
    }
    out
}

/// Do two lists of paths share a file or a folder?
export fn overlap(a []str, b []str) -> bool {
    for x in a {
        for y in b {
            if x == y || x.starts_with("${y}/") || y.starts_with("${x}/") { return true }
        }
    }
    false
}

/// The number of the commits of the tree that are not in `base`.
export fn unmerged_count(tree str, base str) Proc -> int {
    ro r = git_run(tree, ["rev-list", "--count", "${base}..HEAD"])
    if !r.ok { return 0 }
    match r.text.to_int() {
        Ok(n) => n
        Err(e) => 0
    }
}

/// The changed files of the tree against `base` with the lines added and removed (`git diff --numstat`).
export fn diff_numstat(tree str, base str) Proc -> []DiffRec {
    mut out = []DiffRec.new()
    ro r = git_run(tree, ["diff", "--numstat", "${base}...HEAD"])
    if r.ok {
        for line in r.text.lines() {
            mut parts = []str.new()
            for p in line.split("	") { parts.push(p) }
            if parts.len() >= 3 {
                out.push(DiffRec { path: parts[2], added: parts[0].to_int() ?? 0, removed: parts[1].to_int() ?? 0 })
            }
        }
    }
    out
}

/// The summary of the changes of the tree against `base` (`git diff --stat`).
export fn diff_stat(tree str, base str) Proc -> str {
    ro r = git_run(tree, ["diff", "--stat", "${base}...HEAD"])
    if r.ok { r.text } else { r.text }
}

/// No changes that are not committed (the text of `git status` is empty).
export fn is_clean(tree str) Proc -> bool {
    ro r = git_run(tree, ["status", "--porcelain"])
    r.ok && r.text.byte_len() == 0
}

/// The words for the agent that must resolve the conflicts in `files` (`kind`: "merge" of a subtask or "rebase" on `origin/main`).
export fn resolve_prompt(files []str, kind str) -> str =>
    "Разреши конфликты (${kind}) в файлах: ${joined(files, ", ")}. Сохрани смысл обеих сторон, убери маркеры конфликта, добавь файлы в индекс (git add), прогони тесты затронутой части и заверши ${kind} (не коммить в обход). Последней строкой ответа напиши ровно «ТЕСТЫ: ЗЕЛЁНЫЕ» или «ТЕСТЫ: КРАСНЫЕ»."

/// Fetch and rebase the tree of the task on `origin/main`: "merged" (done), "conflict" or "error".
export fn publish_rebase(task_tree str) Proc -> TwMerge => tw_unavailable()

/// Continue the rebase after the conflicts were resolved.
export fn publish_continue(task_tree str) Proc -> TwMerge => tw_unavailable()

/// Abandon the rebase.
export fn publish_abort(task_tree str) Proc -> GitOut => { ok: false, text: tw_unavailable().text }

/// The one way to the remote: `git push origin HEAD:main` (no force) from the tree of the task; then the main copy by `merge --ff-only` if it is clean and on `main`; then the tree and the branch are removed.
export fn publish_push(task_tree str, main_copy str, branch str) Proc -> TwPublish => { status: "error", text: tw_unavailable().text, main_note: "" }
