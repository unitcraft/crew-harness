// transfer.nv - task 192: the protocol of a conversation that is handed to another agent when the owner changes the family in the window.
//
// Pure functions over the lines of the page of a session (`Dialog.lines`): the messages of the owner and the answers of the agent come
// WHOLE and word for word, the tools as one line (the action, the state, a short result), the earlier changes of the agent as a note.
// A limit of size never cuts inside a message: from the end to the beginning whole messages are taken while they fit, the earlier ones
// stay only as headers (the first words), and the caller tells the owner so.
module crew_harness.server

/// The size (bytes of text) of a protocol over which the earlier messages are given only as headers.
export const TRANSFER_LIMIT = 400000

/// Transfer: the text to send, the number of the messages (of the owner and of the agent) given whole, the number of all of them,
/// and whether the earlier ones were cut to headers.
export type Transfer { text str, shown int, total int, cut bool }

type TEntry { role str, turn str, id str, text str, status str, detail str }

fn t_text(o JsonObject, key str) -> str => jtext(o, key)

fn t_input(o JsonObject) -> JsonObject {
    match jchild(o, "input") {
        Some(x) => x
        None => JsonObject.new()
    }
}

fn t_entry(role str, turn str, id str, text str) -> TEntry => { role, turn, id, text, status: "", detail: "" }

// The entries of the protocol from the lines of the page, in the order of the lines.
// The names of the pictures of a `message_images` line, each as a line "[изображение: имя]": the new agent is told that a picture was there, the bytes do not go.
fn t_picture_notes(input JsonObject) -> str {
    mut notes = []str.new()
    match input.get("images") {
        Some(list) => {
            for item in list.array() ?? []JsonValue.new() {
                match item.object() {
                    Some(o) => notes.push("[изображение: ${jtext(o, "name")}]")
                    None => ()
                }
            }
        }
        None => ()
    }
    notes.join("\n")
}

fn t_entries(lines []str) -> []TEntry {
    mut out = []TEntry.new()
    mut pictures = ""
    for line in lines {
        match jobject(line) {
            None => ()
            Some(o) => {
                ro kind = t_text(o, "kind")
                ro input = t_input(o)
                if kind == "message_images" {
                    pictures = t_picture_notes(input)
                } else if kind == "user_message" {
                    ro said = t_text(input, "text")
                    ro full = if pictures.byte_len() == 0 { said } else if said.byte_len() == 0 { pictures } else { "${said}\n${pictures}" }
                    pictures = ""
                    out.push(t_entry("user", t_text(input, "turn"), "", full))
                } else if kind == "agent_chunk" {
                    ro last = out.len() - 1
                    if last >= 0 && out[last].role == "agent" && out[last].turn == t_text(input, "turn") {
                        ro was = out[last]
                        out[last] = t_entry("agent", was.turn, "", "${was.text}${t_text(input, "text")}")
                    } else {
                        out.push(t_entry("agent", t_text(input, "turn"), "", t_text(input, "text")))
                    }
                } else if kind == "tool_call" {
                    mut e = t_entry("tool", t_text(input, "turn"), t_text(input, "id"), "${t_text(input, "title")} (${t_text(input, "kind")})")
                    e.status = t_text(input, "status")
                    e.detail = t_text(input, "detail")
                    out.push(e)
                } else if kind == "tool_call_update" {
                    mut at = out.len() - 1
                    while at >= 0 {
                        if out[at].role == "tool" && out[at].id == t_text(input, "id") {
                            mut e = out[at]
                            if t_text(input, "status").byte_len() > 0 { e.status = t_text(input, "status") }
                            if t_text(input, "detail").byte_len() > 0 { e.detail = t_text(input, "detail") }
                            out[at] = e
                            break
                        }
                        at -= 1
                    }
                } else if kind == "agent_switched" {
                    out.push(t_entry("note", "", "", "смена агента: ${t_text(input, "from")} -> ${t_text(input, "to")}"))
                }
            }
        }
    }
    out
}

// The first `n` characters of a text in one line.
fn t_preview(text str, n int) -> str {
    ro flat = text.replace("\n", " ")
    mut parts = []str.new()
    mut count = 0
    for c in flat.chars() {
        count += 1
        if count <= n { parts.push("${c}") }
    }
    if count <= n { return flat }
    "${parts.join("")}…"
}

fn t_render(e TEntry) -> str {
    if e.role == "user" { return "[пользователь]\n${e.text}" }
    if e.role == "agent" { return "[агент]\n${e.text}" }
    if e.role == "tool" {
        mut line = "[действие] ${e.text}: ${if e.status.byte_len() > 0 { e.status } else { "?" }}"
        if e.detail.byte_len() > 0 { line = "${line}; ${t_preview(e.detail, 200)}" }
        return line
    }
    "[${e.text}]"
}

fn t_header(e TEntry) -> str {
    if e.role == "user" { return "- пользователь: ${t_preview(e.text, 80)}" }
    "- агент: ${t_preview(e.text, 80)}"
}

fn t_is_message(e TEntry) -> bool => e.role == "user" || e.role == "agent"

/// The protocol of the conversation `lines` for the agent that takes it over from `from_agent`; `limit` is the size over which the earlier
/// messages shrink to headers (`TRANSFER_LIMIT` in the product).
export fn build_transfer(lines []str, from_agent str, limit int) -> Transfer {
    ro entries = t_entries(lines)
    mut rendered = []str.new()
    mut total = 0
    for e in entries {
        rendered.push(t_render(e))
        if t_is_message(e) { total += 1 }
    }
    // from the end: whole entries while they fit; the last one goes in whatever its size
    mut first = entries.len()
    mut size = 0
    while first > 0 {
        ro next = size + rendered[first - 1].byte_len() + 2
        if next > limit && first < entries.len() { break }
        size = next
        first -= 1
    }
    mut shown = 0
    mut at = first
    while at < entries.len() {
        if t_is_message(entries[at]) { shown += 1 }
        at += 1
    }
    mut parts = []str.new()
    parts.push("Это продолжение разговора, ранее вёл ${from_agent}; ниже протокол; продолжай с последнего сообщения пользователя, ничего не отвечай на протокол.")
    if first > 0 {
        mut heads = []str.new()
        mut i = 0
        while i < first {
            if t_is_message(entries[i]) { heads.push(t_header(entries[i])) }
            i += 1
        }
        parts.push("Ранее в разговоре (только заголовки, ${heads.len()} сообщений):\n${heads.join("\n")}")
    }
    mut k = first
    while k < entries.len() {
        parts.push(rendered[k])
        k += 1
    }
    Transfer { text: parts.join("\n\n"), shown, total, cut: first > 0 }
}
