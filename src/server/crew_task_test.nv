// crew_task_test.nv - task 192.2: the pure part of `crew_task`: the code word, the arguments of the tools, the clash of the files, the limit,
// the files of a subtask, the view for the page, and the tool calls over `mcp_handle_for`.
module crew_harness.server

import std.encoding.json.{Json, JsonValue, JsonObject}

fn ctj(text str) -> JsonValue {
    match Json.parse(text) {
        Ok(v) => v
        Err(e) => panic("bad json in a test: ${text}")
    }
}

fn ct_get(v JsonValue, key str) -> JsonValue {
    match v.object() {
        Some(o) => match o.get(key) {
            Some(x) => x
            None => JsonValue.null()
        }
        None => JsonValue.null()
    }
}

fn ct_items(v JsonValue) -> []JsonValue {
    match v.array() {
        Some(items) => items
        None => []JsonValue.new()
    }
}

fn ct_args() -> str => "{\"kind\":\"new\",\"title\":\"Кнопка выхода\",\"summary\":\"Добавить кнопку выхода\",\"touches\":[\"src/web/view.js\",\"src/web/app.css\"],\"confidence\":\"high\"}"

test "crew_task: the code word is found in lower case, with punctuation and the Cyrillic case" {
    assert(is_code_word("задача", "задача"))
    assert(is_code_word("  Задача! ", "задача"))
    assert(is_code_word("«ЗАДАЧА»", "Задача"))
    assert(is_code_word("Сверх.", "сверх"))
    assert(!is_code_word("задача номер два", "задача"))
    assert(!is_code_word("задача", ""))
    assert(!is_code_word("", "задача"))
}

test "crew_task: the arguments of the tool become a proposal, a bad call gives the reason" {
    match proposal_of_arguments(ctj(ct_args())) {
        Ok(p) => {
            assert(p.kind == "new")
            assert(p.title == "Кнопка выхода")
            assert(p.touches.len() == 2)
            assert(p.state == "open")
            assert(!p.listed)
        }
        Err(e) => panic(e)
    }
    match proposal_of_arguments(ctj("{\"kind\":\"extend\",\"title\":\"t\",\"summary\":\"s\",\"extends\":\"2\"}")) {
        Ok(p) => {
            assert(p.kind == "extend")
            assert(p.extends == 2)
        }
        Err(e) => panic(e)
    }
    match proposal_of_arguments(ctj("{\"kind\":\"new\",\"summary\":\"s\"}")) {
        Ok(p) => panic("a proposal without a title")
        Err(e) => assert(e.contains("title"))
    }
}

test "crew_task: the proposal goes through its text and through the marker line" {
    match proposal_of_arguments(ctj(ct_args())) {
        Ok(p) => {
            match proposal_of_text(proposal_arguments_text(p)) {
                Ok(q) => {
                    assert(q.title == p.title)
                    assert(q.touches.len() == 2)
                }
                Err(e) => panic(e)
            }
        }
        Err(e) => panic(e)
    }
    match proposal_of_marker("Понял.\n[[crew_task]] ${ct_args()}\nготово") {
        Some(p) => assert(p.title == "Кнопка выхода")
        None => panic("the marker is not read")
    }
    assert(proposal_of_marker("просто текст").is_none())
}

test "crew_task: the tools are listed by the path of the session" {
    ro all = mcp_handle_for("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}", "all")
    ro names_all = ct_items(ct_get(ct_get(ctj(all.text), "result"), "tools"))
    assert(names_all.len() == 18)
    ro only = mcp_handle_for("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}", "list")
    ro names_list = ct_items(ct_get(ct_get(ctj(only.text), "result"), "tools"))
    // task 250: the tools crew_* (15) and crew_task with its actions come with every set but the old one
    assert(names_list.len() == 17)
    assert(ct_get(names_list[names_list.len() - 1], "name").str() == Some("crew_task_list"))
    ro asked = mcp_handle_for("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}", "asklist")
    assert(ct_items(ct_get(ct_get(ctj(asked.text), "result"), "tools")).len() == 18)
    ro auto = mcp_handle_for("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}", "task")
    assert(ct_items(ct_get(ct_get(ctj(auto.text), "result"), "tools")).len() == 17)
}

test "crew_task: a call of crew_task is a task message with the checked arguments, a call of the wrong tool for the path is refused" {
    ro call = "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"crew_task\",\"arguments\":${ct_args()}}}"
    ro out = mcp_handle_for(call, "task")
    assert(out.kind == "task")
    assert(out.questions.contains("Кнопка выхода"))
    ro refused = mcp_handle_for(call, "list")
    assert(refused.kind == "reply")
    assert(ct_get(ct_get(ctj(refused.text), "result"), "isError").bool() == Some(true))
    ro bad = mcp_handle_for("{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"tools/call\",\"params\":{\"name\":\"crew_task\",\"arguments\":{}}}", "all")
    assert(bad.kind == "reply")
}

fn ct_list_args() -> str => "{\"tasks\":[{\"id\":1,\"kind\":\"new\",\"title\":\"Кнопка\",\"summary\":\"сделать кнопку\",\"touches\":[\"src/web/view.js\"],\"note\":\"обсуждали\"},{\"id\":2,\"kind\":\"extend\",\"title\":\"Тест\",\"summary\":\"добавить тест\",\"extends\":1}]}"

test "crew_task_list: the call gives the items, an empty list is allowed, a wrong item rejects the call" {
    ro call = "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"tools/call\",\"params\":{\"name\":\"crew_task_list\",\"arguments\":${ct_list_args()}}}"
    ro out = mcp_handle_for(call, "list")
    assert(out.kind == "tasklist")
    match proposals_of_list_text(out.questions) {
        Ok(items) => {
            assert(items.len() == 2)
            ro first = items[0]
            ro second = items[1]
            assert(first.listed)
            assert(first.note == "обсуждали")
            assert(second.kind == "extend")
            assert(second.extends == 1)
        }
        Err(e) => panic(e)
    }
    match proposals_of_list(ctj("{\"tasks\":[]}")) {
        Ok(items) => assert(items.len() == 0)
        Err(e) => panic(e)
    }
    match proposals_of_list(ctj("{\"tasks\":[{\"summary\":\"x\"}]}")) {
        Ok(items) => panic("an item without a title")
        Err(e) => assert(e.contains("title"))
    }
    match proposals_of_list(ctj("{}")) {
        Ok(items) => panic("no tasks")
        Err(e) => assert(e.contains("tasks"))
    }
    match proposals_of_marker("[[crew_task_list]] ${ct_list_args()}") {
        Some(items) => assert(items.len() == 2)
        None => panic("the marker of the list is not read")
    }
}

test "crew_task: files of two works overlap by file and by folder; no files while something runs is unknown; no clash with nothing running" {
    ro running = [RunSub { n: 1, touches: ["src/web/view.js"] }, RunSub { n: 2, touches: ["doc/"] }]
    ro none = clash_of(["src/server/hub.nv"], running)
    assert(none.with_n == 0)
    ro same = clash_of(["src/web/view.js"], running)
    assert(same.with_n == 1)
    assert(same.files.len() == 1)
    ro folder = clash_of(["doc/routes/fast.md"], running)
    assert(folder.with_n == 2)
    ro unknown = clash_of([]str.new(), running)
    assert(unknown.with_n == 1)
    assert(unknown.unknown)
    ro empty = clash_of(["a.txt"], []RunSub.new())
    assert(empty.with_n == 0)
    assert(!limit_reached(2, 3))
    assert(limit_reached(3, 3))
    assert(!limit_reached(9, 0))
}

test "crew_task: the refused titles are remembered and the cards are found" {
    ro refused = [word_key("Кнопка выхода")]
    assert(was_refused(refused, "кнопка выхода!"))
    assert(!was_refused(refused, "другое"))
    mut p = proposal_new("new", "Кнопка", "s", 0, []str.new(), "")
    p.id = 4
    ro props = [p]
    assert(has_proposal(props, "кнопка"))
    assert(proposal_at(props, 4) == 0)
    assert(proposal_at(props, 5) == -1)
    assert(last_open(props) == 0)
    mut q = proposal_new("new", "Из списка", "s", 0, []str.new(), "")
    q.id = 5
    q.listed = true
    assert(last_open([p, q]) == 0)
    assert(last_open([q]) == -1)
}

test "crew_task: the file of a subtask holds the summary and the message of the owner, an addition holds the date" {
    ro text = crew_message_text(2, "Сделать кнопку", "давай сделаем кнопку выхода", 0)
    assert(text.contains("# Сообщение 2"))
    assert(text.contains("Сделать кнопку"))
    assert(text.contains("## Сообщение владельца"))
    assert(text.contains("давай сделаем кнопку выхода"))
    ro same = crew_message_text(1, "Один и тот же текст", "Один и тот же текст", 0)
    assert(!same.contains("## Сообщение владельца"))
    ro add = crew_addition_text("Ещё тест", "и тест", 0)
    assert(add.contains("## Дополнение"))
    assert(add.contains("Ещё тест"))
}

test "crew_task: the hint lists the tasks, the request names the candidates" {
    ro hint = tasks_hint("doc/tasks/001-x", [SubLine { n: 1, title: "Кнопка", state: "идёт", waits: 0, file: "" }, SubLine { n: 2, title: "Тест", state: "ждёт", waits: 1, file: "" }])
    assert(hint.contains("1. «Кнопка» (идёт)"))
    assert(hint.contains("ждёт подзадачу 1"))
    assert(hint.contains("doc/tasks/001-x/message.2.md"))
    assert(tasks_hint("x", []SubLine.new()) == "")
    ro req = recognize_request(hint, ["- «Кандидат»"])
    assert(req.contains("crew_task_list"))
    assert(req.contains("Кандидат"))
    // task 192.9: the request forbids the work and the talk, names the call for each family and keeps the marker only as the last way
    assert(req.contains("НИЧЕГО не делай с файлами"))
    assert(req.contains("Не рассуждай вслух"))
    assert(req.contains("tools.crew.crew_task_list"))
    assert(req.contains("mcp__crew__crew_task_list"))
    assert(req.contains("[[crew_task_list]]"))
    assert(req.contains("одной короткой фразой"))
}

test "crew_task: the view holds the cards, the numbers and the words" {
    mut p = proposal_new("extend", "Тест", "s", 1, ["a.txt"], "high")
    p.id = 3
    p.state = "overlap"
    p.with_n = 1
    mut q = proposal_new("new", "Из списка", "s", 0, []str.new(), "")
    q.id = 4
    q.listed = true
    q.choice = "discuss"
    ro text = crew_view_extend("{\"route\":\"interactive\"}", [p, q], [SubLine { n: 1, title: "Кнопка", state: "идёт", waits: 0, file: "" }], 2, 3, "задача", "сверх")
    ro v = ctj(text)
    assert(ct_get(v, "route").str() == Some("interactive"))
    assert(ct_get(v, "active").int() == Some(2))
    assert(ct_get(v, "max_active").int() == Some(3))
    assert(ct_get(v, "confirm_word").str() == Some("задача"))
    assert(ct_get(v, "over_word").str() == Some("сверх"))
    assert(ct_get(v, "candidates").int() == Some(1))
    ro cards = ct_items(ct_get(v, "proposals"))
    assert(cards.len() == 2)
    assert(ct_get(cards[0], "extends_title").str() == Some("Кнопка"))
    assert(ct_get(cards[0], "state").str() == Some("overlap"))
    assert(ct_get(cards[1], "listed").bool() == Some(true))
}

test "crew_task: the journal rebuilds the subtasks with their files, the wait and the start" {
    mut rt = route_session_new()
    rt.apply("route_task", "{\"op\":\"open\",\"id\":\"001-x\",\"number\":\"001\",\"dir\":\"d\",\"shown\":\"s\",\"title\":\"Кнопка\",\"touches\":\"src/a.js\\nsrc/b.js\"}")
    assert(rt.subs.len() == 1)
    assert(rt.subs[0].touches.len() == 2)
    rt.apply("route_task", "{\"op\":\"subtask\",\"n\":2,\"title\":\"Второе\",\"touches\":\"src/a.js\",\"waits\":1,\"queued\":0}")
    assert(rt.subs[1].waits == 1)
    ro waiting = ctj(route_view_text(rt, []str.new(), [Progress { done: 0, total: 0, items: []ProgressItem.new() }, Progress { done: 0, total: 0, items: []ProgressItem.new() }], false, 0, task_extra_none()))
    ro subs = ct_items(ct_get(ct_get(waiting, "task"), "subtasks"))
    assert(ct_get(subs[1], "state").str() == Some("waits"))
    assert(ct_get(subs[1], "waits_for").int() == Some(1))
    rt.apply("route_task", "{\"op\":\"sub_start\",\"n\":2}")
    assert(rt.subs[1].waits == 0)
    assert(!rt.subs[1].queued)
}

test "crew_task: the agent works in the tree of the subtask it was told about, else in the tree of the task; a task of the list is marked" {
    mut rt = route_session_new()
    rt.apply("route_task", "{\"op\":\"open\",\"id\":\"001-x\",\"number\":\"001\",\"dir\":\"d\",\"shown\":\"s\",\"title\":\"A\",\"worktree\":\"W\",\"crew\":1}")
    assert(rt.by_crew)
    rt.apply("route_task", "{\"op\":\"subtask\",\"n\":2,\"title\":\"B\"}")
    rt.apply("route_task", "{\"op\":\"sub_worktree\",\"n\":2,\"branch\":\"b2\",\"worktree\":\"W2\"}")
    assert(rt.agent_dir("S") == "W2")
    rt.focus = 1
    assert(rt.agent_dir("S") == "W")
    rt.focus = 2
    assert(rt.agent_dir("S") == "W2")
    rt.normalize()
    assert(rt.focus == 0)
    ro view = ctj(route_view_text(rt, []str.new(), [Progress { done: 0, total: 0, items: []ProgressItem.new() }, Progress { done: 0, total: 0, items: []ProgressItem.new() }], false, 0, task_extra_none()))
    assert(ct_get(ct_get(view, "task"), "crew").bool() == Some(true))
    rt.apply("route_task", "{\"op\":\"new\"}")
    assert(!rt.by_crew)
}

test "crew_task: the kinds are new, extend, child and epic; the old subtask and epic_task are read as a child of the epic" {
    match proposal_of_text("{\"kind\":\"child\",\"epic\":232,\"title\":\"A\"}") {
        Ok(p) => assert(p.kind == "child" && p.epic == 232)
        Err(e) => panic(e)
    }
    match proposal_of_text("{\"kind\":\"subtask\",\"parent\":7,\"title\":\"A\"}") {
        Ok(p) => assert(p.kind == "child" && p.epic == 7)
        Err(e) => panic(e)
    }
    match proposal_of_text("{\"kind\":\"epic_task\",\"epic\":9,\"title\":\"A\"}") {
        Ok(p) => assert(p.kind == "child" && p.epic == 9)
        Err(e) => panic(e)
    }
    match proposal_of_text("{\"kind\":\"epic\",\"title\":\"Big\"}") {
        Ok(p) => assert(p.kind == "epic" && p.epic == 0)
        Err(e) => panic(e)
    }
    match proposal_of_text("{\"kind\":\"whatever\",\"title\":\"A\"}") {
        Ok(p) => assert(p.kind == "new")
        Err(e) => panic(e)
    }
}

fn ctx_line(kind str, used int, size int) -> str => "{\"kind\":\"${kind}\",\"trace\":\"s\",\"input\":{\"used\":${used},\"size\":${size}}}"

test "context: a fall of used by more than the percent is a compaction; a smaller fall, a rise, a change of the agent and the off switch are not" {
    ro drop = ctx_scan([ctx_line("usage_update", 100000, 200000), ctx_line("usage_update", 30000, 200000)], 0, 0, 40)
    assert(drop.before == 100000 && drop.after == 30000 && drop.used == 30000 && drop.size == 200000)
    // the value of the earlier pass is remembered between two looks
    ro second = ctx_scan([ctx_line("usage_update", 20000, 200000)], 100000, 200000, 40)
    assert(second.before == 100000 && second.after == 20000)
    ro mild = ctx_scan([ctx_line("usage_update", 100000, 200000), ctx_line("usage_update", 70000, 200000)], 0, 0, 40)
    assert(mild.before == 0 && mild.used == 70000)
    ro rise = ctx_scan([ctx_line("usage_update", 10000, 200000), ctx_line("usage_update", 90000, 200000)], 0, 0, 40)
    assert(rise.before == 0)
    ro switched = ctx_scan([ctx_line("usage_update", 100000, 200000), "{\"kind\":\"agent_switched\",\"input\":{}}", ctx_line("usage_update", 1000, 200000)], 0, 0, 40)
    assert(switched.before == 0 && switched.used == 1000)
    ro off = ctx_scan([ctx_line("usage_update", 100000, 200000), ctx_line("usage_update", 1000, 200000)], 0, 0, 0)
    assert(off.before == 0)
    ro first = ctx_scan([ctx_line("usage_update", 1000, 200000)], 0, 0, 40)
    assert(first.before == 0 && first.used == 1000)
    assert(ctx_scan([], 5, 9, 40).used == 5)
}

test "context: the view holds the used / size and the history of the compactions; the reminder names the mode, the step and the place; the rules are in the tools" {
    ro text = hints_view_extend("{}", []HintRec.new(), 30000, 200000, [CtxRec { ms: 5, before: 100000, after: 30000 }])
    ro o = cht_j(text).object() ?? JsonObject.new()
    ro cx = (o.get("context") ?? JsonValue.null()).object() ?? JsonObject.new()
    assert(((cx.get("used") ?? JsonValue.null()).int() ?? 0) == 30000 && ((cx.get("size") ?? JsonValue.null()).int() ?? 0) == 200000)
    assert((((cx.get("compactions") ?? JsonValue.null()).array() ?? []JsonValue.new()).len()) == 1)
    ro r = route_reminder("fast", "Тесты", "doc/tasks/007-x/task", "task/007-x")
    assert(r.contains("«fast»") && r.contains("шаг: Тесты") && r.contains("task/007-x") && r.contains("crew_task_list"))
    assert(route_reminder("interactive", "", "", "").contains("задачи ещё нет"))
    assert(crew_task_tool_json().to_str().contains("RULES"))
    assert(crew_task_list_tool_json().to_str().contains("RULES"))
}

test "auto extend: only an extension with the high confidence and a number is applied at once; the section is taken out by its exact text" {
    ro high = proposal_new("extend", "T", "s", 3, []str.new(), "high")
    assert(auto_extend_ok(high))
    assert(auto_extend_ok(proposal_new("extend", "T", "s", 3, []str.new(), " High ")))
    assert(!auto_extend_ok(proposal_new("extend", "T", "s", 3, []str.new(), "medium")))
    assert(!auto_extend_ok(proposal_new("extend", "T", "s", 3, []str.new(), "")))
    assert(!auto_extend_ok(proposal_new("extend", "T", "s", 0, []str.new(), "high")))
    assert(!auto_extend_ok(proposal_new("new", "T", "s", 0, []str.new(), "high")))
    assert(!auto_extend_ok(proposal_new("epic", "T", "s", 0, []str.new(), "high")))
    ro one = crew_addition_text("ещё X", "ещё X", 60000)
    ro file = "# Сообщение\n\nтекст\n${one}"
    match text_without_last(file, one) {
        Some(back) => assert(back == "# Сообщение\n\nтекст\n")
        None => panic("the section is not found")
    }
    // two equal sections: the last one goes
    match text_without_last("${file}${one}", one) {
        Some(back) => assert(back == file)
        None => panic("the section is not found")
    }
    assert(text_without_last("# Сообщение\n", one).is_none())
    assert(text_without_last("abc", "").is_none())
    ro rows = ext_view_extend("{}", [ExtRec { id: 1, task: 3, title: "Т", brief: "кратко", ms: 5, file: "f", added: "a", undone: true }])
    ro o = cht_j(rows).object() ?? JsonObject.new()
    ro list = (o.get("extensions") ?? JsonValue.null()).array() ?? []JsonValue.new()
    assert(list.len() == 1)
    ro first = list[0].object() ?? JsonObject.new()
    assert(((first.get("task") ?? JsonValue.null()).int() ?? 0) == 3 && ((first.get("undone") ?? JsonValue.null()).bool() ?? false))
    assert(crew_task_tool_json().to_str().contains("AT ONCE") && crew_task_list_tool_json().to_str().contains("applied by the hub at once"))
    assert(ext_applied_note("003", "кратко", "doc/tasks/003-x/task").contains("Новое требование владельца"))
    assert(ext_withdrawn_note("003", "кратко", "doc/tasks/003-x/task").contains("Требование отозвано"))
}

test "crew_task: the mode, the reason and the children of an epic are read, checked, travel through the text and go to the page (task 192.13)" {
    ro text = "{\"kind\":\"epic\",\"title\":\"Отладчик\",\"summary\":\"Сделать\",\"mode\":\"full\",\"reason\":\"две независимые части\",\"children\":[{\"title\":\"Фронт\",\"summary\":\"Страница\",\"touches\":[\"src/web\"],\"mode\":\"fast\"},{\"title\":\"Бек\",\"mode\":\"bogus\"},{\"summary\":\"без названия\"}]}"
    match proposal_of_text(text) {
        Ok(p) => {
            assert(p.mode == "full" && p.reason == "две независимые части")
            ro kids = proposal_children(p)
            assert(kids.len() == 2)
            assert(kids[0].title == "Фронт" && kids[0].mode == "fast" && kids[0].touches.len() == 1)
            assert(kids[1].title == "Бек" && kids[1].mode == "" && kids[1].summary == "Бек")
            // the way to the hub keeps all of it
            match proposal_of_text(proposal_arguments_text(p)) {
                Ok(q) => assert(q.mode == "full" && proposal_children(q).len() == 2 && proposal_children(q)[0].mode == "fast")
                Err(e) => panic("the text is not read back: ${e}")
            }
            // the page gets them
            ro view = cht_j(crew_view_extend("{}", [p], []SubLine.new(), 0, 3, "задача", "сверх"))
            ro card = ct_items(ct_get(view, "proposals"))[0]
            assert((ct_get(card, "mode").str() ?? "") == "full")
            assert(ct_items(ct_get(card, "children")).len() == 2)
            // the owner leaves the second child only / none / all
            assert(proposal_children(children_picked(p, "1")).len() == 1 && proposal_children(children_picked(p, "1"))[0].title == "Бек")
            assert(proposal_children(children_picked(p, "-")).len() == 0)
            assert(proposal_children(children_picked(p, "")).len() == 2)
            // a child as a proposal of its own: a child of the epic 7, the mode of the epic when it has none
            ro child = child_proposal(kids[1], 7, "full", "")
            assert(child.kind == "child" && child.epic == 7 && child.mode == "full")
            assert(child_proposal(kids[0], 7, "full", "").mode == "fast")
        }
        Err(e) => panic("the epic is not read: ${e}")
    }
    // an unknown mode is dropped; children are read only for an epic
    match proposal_of_text("{\"kind\":\"new\",\"title\":\"Т\",\"mode\":\"turbo\",\"children\":[{\"title\":\"X\"}]}") {
        Ok(p) => assert(p.mode == "" && proposal_children(p).len() == 0)
        Err(e) => panic("not read: ${e}")
    }
    assert(crew_task_tool_json().to_str().contains("children") && crew_task_list_tool_json().to_str().contains("reason"))
}

// ----- the texts by layers and the threshold of the addition at once (task 192.12) -----

test "prompts: a text of a layer replaces the built-in one, the values are put in by name" {
    assert(ext_applied_note("7", "кратко", "doc/t") == "[crew] Новое требование владельца к твоей задаче 7: кратко; см. doc/t/message.md, раздел «Дополнение». Учти его и продолжай в рабочем каталоге.")
    assert(ext_applied_note_t("Новое {brief} в {shown} ({number})", "7", "x", "d") == "Новое x в d (7)")
    assert(ext_withdrawn_note_t("снято {brief}", "x", "d") == "снято x")
    assert(decision_note_t("n={n} t={title} d={shown}", 3, "T", "dir") == "n=3 t=T d=dir")
    assert(decision_note("queued", 2, "T", "d") == "[crew] Подзадача 2 «T» ждёт очереди и стартует сама; пока ничего по ней не делай.")
    assert(decision_name_of("new") == "decision_new" && decision_name_of("no") == "decision_no" && decision_name_of("other") == "decision_no")
    assert(route_reminder_t("{route}|{step}|{place}", "fast", "", "doc/t", "task/1-x") == "fast|нет|задача в doc/t, ветка task/1-x")
    assert(route_reminder("fast", "", "", "").contains("задачи ещё нет"))
    ro lines = [SubLine { n: 1, title: "A", state: "в работе", waits: 0, file: "" }]
    assert(tasks_hint_t("список:\n{rows}", "doc/t", lines) == "список:\n1. «A» (в работе) — doc/t/message.1.md")
    assert(tasks_hint("doc/t", lines).contains("Задачи в работе"))
    assert(tasks_hint("doc/t", []SubLine.new()) == "")
    assert(recognize_request_t("ТЕКСТ", "известные", ["c1"]) == "ТЕКСТ\n\nизвестные\n\n[crew] Эти работы уже в списке кандидатов (не повторяй их):\nc1")
    assert(recognize_request("", []str.new()).starts_with("[crew] Распознай задачи."))
}

test "prompts: the description of a tool is replaced, the rest of the tool stays" {
    ro tool = crew_task_tool_json()
    assert(tool_description(tool).starts_with("Call it when"))
    ro changed = tool_with_description(tool, "Новое описание")
    assert(tool_description(changed) == "Новое описание")
    assert(changed.object().unwrap().get("name").unwrap().str() == Some("crew_task"))
    assert(changed.object().unwrap().contains("inputSchema"))
}

test "settings of the task: the confidence that applies an addition at once is high by default, medium widens it, off closes it" {
    ro high = proposal_new("extend", "T", "s", 3, []str.new(), "high")
    ro medium = proposal_new("extend", "T", "s", 3, []str.new(), "medium")
    assert(auto_extend_ok_at(high, "high") && !auto_extend_ok_at(medium, "high"))
    assert(auto_extend_ok_at(high, "medium") && auto_extend_ok_at(medium, "medium"))
    assert(!auto_extend_ok_at(high, "off") && !auto_extend_ok_at(medium, "off"))
    assert(!auto_extend_ok_at(proposal_new("new", "T", "s", 0, []str.new(), "high"), "medium"))
}

test "crew_task: the page gets the minutes of silence of the agent (task 192.14)" {
    ro o = cht_j(silent_view_extend("{}", 7)).object() ?? JsonObject.new()
    assert(((o.get("silent_minutes") ?? JsonValue.null()).int() ?? 0) == 7)
}
