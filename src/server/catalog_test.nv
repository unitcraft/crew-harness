// catalog_test.nv - task 192o: the catalog of the families (`catalog.nv`): the merge of a summary into the record of an agent, the file, the line of the page, the coalescing of the writes.
module crew_harness.server

import std.encoding.json.{Json, JsonValue, JsonObject}

fn ct_object(text str) -> JsonObject {
    match Json.parse(text) {
        Ok(v) => match v.object() {
            Some(o) => o
            None => panic("not an object: ${text}")
        }
        Err(e) => panic("not JSON: ${text}")
    }
}

fn ct_summary_claude() -> str => "{\"model\":\"Sonnet\",\"model_id\":\"sonnet\",\"models\":[{\"id\":\"opus\",\"name\":\"Opus\"},{\"id\":\"sonnet\",\"name\":\"Sonnet\"}],\"effort\":\"high\",\"effort_name\":\"Effort\",\"efforts\":[{\"id\":\"low\",\"name\":\"Low\"},{\"id\":\"high\",\"name\":\"High\"}],\"mode\":\"plan\",\"modes\":[{\"id\":\"plan\",\"name\":\"Plan\",\"description\":\"Plans first\"}]}"

fn ct_text(o JsonObject, key str) -> str {
    match o.get(key) {
        Some(v) => v.str() ?? ""
        None => ""
    }
}

fn ct_count(o JsonObject, key str) -> int {
    match o.get(key) {
        Some(v) => match v.array() {
            Some(items) => items.len()
            None => -1
        }
        None => 0
    }
}

fn ct_first(text str, now int) -> JsonObject {
    match catalog_update(JsonObject.new(), ct_object(text), now) {
        Some(r) => r
        None => panic("nothing was made")
    }
}

test "catalog: the first summary of an agent makes its record with the lists, the values and the time" {
    ro r = ct_first(ct_summary_claude(), 5000)
    assert(r.get("updated").unwrap().int() == Some(5000))
    assert(ct_text(r, "model") == "Sonnet")
    assert(ct_text(r, "model_id") == "sonnet")
    assert(ct_text(r, "effort") == "high")
    assert(ct_text(r, "effort_name") == "Effort")
    assert(ct_text(r, "mode") == "plan")
    assert(ct_count(r, "models") == 2)
    assert(ct_count(r, "efforts") == 2)
    assert(ct_count(r, "modes") == 1)
}

test "catalog: the same summary again changes nothing, so nothing is told and written" {
    ro r = ct_first(ct_summary_claude(), 5000)
    match catalog_update(r, ct_object(ct_summary_claude()), 9000) {
        Some(again) => panic("changed: ${JsonValue.object(again).to_str()}")
        None => ()
    }
}

test "catalog: a new value replaces the old one, a list that the summary lacks stays the last one that was given" {
    ro r = ct_first(ct_summary_claude(), 5000)
    ro next = match catalog_update(r, ct_object("{\"model\":\"Opus\",\"model_id\":\"opus\",\"mode\":\"default\"}"), 7000) {
        Some(x) => x
        None => panic("not changed")
    }
    assert(ct_text(next, "model_id") == "opus")
    assert(ct_text(next, "mode") == "default")
    assert(ct_count(next, "models") == 2)
    assert(ct_count(next, "efforts") == 2)
    assert(ct_count(next, "modes") == 1)
    assert(next.get("updated").unwrap().int() == Some(7000))
}

test "catalog: a list that the summary gives replaces the old one" {
    ro r = ct_first(ct_summary_claude(), 5000)
    ro next = match catalog_update(r, ct_object("{\"models\":[{\"id\":\"haiku\",\"name\":\"Haiku\"}]}"), 6000) {
        Some(x) => x
        None => panic("not changed")
    }
    assert(ct_count(next, "models") == 1)
    assert(ct_count(next, "efforts") == 2)
}

test "catalog: the time of a record only grows, even if the clock does not" {
    ro r = ct_first(ct_summary_claude(), 5000)
    ro next = match catalog_update(r, ct_object("{\"mode\":\"default\"}"), 4000) {
        Some(x) => x
        None => panic("not changed")
    }
    assert(next.get("updated").unwrap().int() == Some(5001))
}

test "catalog: an empty summary makes no record" {
    match catalog_update(JsonObject.new(), JsonObject.new(), 5000) {
        Some(x) => panic("a record from nothing")
        None => ()
    }
}

test "catalog: the file is read back as it was written, the records of two agents stay apart" {
    mut agents = JsonObject.new()
    ro a = ct_first(ct_summary_claude(), 5000)
    ro b = ct_first("{\"model\":\"Kimi\",\"model_id\":\"k\",\"models\":[{\"id\":\"k\",\"name\":\"Kimi\"}]}", 6000)
    ro r1 = agents.insert("claude", JsonValue.object(a))
    ro r2 = agents.insert("kimi", JsonValue.object(b))
    ro text = catalog_file_text(agents)
    assert(text.starts_with("{\"agents\":{"))
    ro back = match catalog_parse(text) {
        Ok(x) => x
        Err(e) => panic("not read: ${e}")
    }
    assert(back.len() == 2)
    ro kimi = match back.get("kimi") {
        Some(v) => v.object().unwrap()
        None => panic("no kimi")
    }
    assert(ct_text(kimi, "model") == "Kimi")
    assert(ct_count(kimi, "efforts") == 0)
    assert(catalog_file_text(back) == text)
}

test "catalog: a damaged file is an error and not a catalog" {
    assert(catalog_parse("{\"agents\":{\"claude\":{\"mod").is_err())
    assert(catalog_parse("").is_err())
    assert(catalog_parse("[]").is_err())
    assert(catalog_parse("{\"agents\":[]}").is_err())
    assert(catalog_parse("{\"agents\":{\"claude\":5}}").is_err())
    assert(catalog_parse("{}").is_err())
    assert(catalog_parse("{\"agents\":{}}").is_ok())
}

test "catalog: the line of the page is the event agent_catalog with the agent and the record, and its id carries the time" {
    ro r = ct_first(ct_summary_claude(), 5000)
    ro line = catalog_line("claude", r)
    ro o = ct_object(line)
    assert(ct_text(o, "kind") == "agent_catalog")
    assert(ct_text(o, "id") == "catalog/claude/5000")
    ro input = o.get("input").unwrap().object().unwrap()
    assert(ct_text(input, "agent") == "claude")
    assert(ct_text(input, "model_id") == "sonnet")
    assert(ct_count(input, "models") == 2)
    assert(o.get("time").unwrap().int() == Some(5000))
}

test "catalog: the writes are coalesced - nothing to write is not due, a write within the gap waits, after the gap or forced it is due" {
    assert(!catalog_save_due(false, 100000, 0, true))
    assert(catalog_save_due(true, 100000, 0, false))
    assert(!catalog_save_due(true, 100500, 100000, false))
    assert(!catalog_save_due(true, 101999, 100000, false))
    assert(catalog_save_due(true, 102000, 100000, false))
    assert(catalog_save_due(true, 100100, 100000, true))
}
