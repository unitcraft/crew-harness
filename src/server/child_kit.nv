// child_kit.nv - task 192.3: the scenario of the child sessions over a hub with the fake ACP agent in a repository (the helpers are in `routes_kit.nv` and `crew_task_kit.nv`).
module crew_harness.server

import std.encoding.json.{Json, JsonValue, JsonObject}

/// The settings of the scenario of the child sessions: a repository, the limit of eight tasks in work, the children are sessions of their own (the default).
export fn kit_routes_children(name str) Proc -> ServerSettings {
    mut settings = kit_routes_git(name)
    settings.route_max_active = 8
    settings.route_auto_propose = true
    settings.route_children = true
    settings
}

// The last route_state of the session `trace` as seen by the page `conn`.
fn ck_state(rig Rig, conn int, trace str) -> JsonObject {
    mut found = JsonObject.new()
    for line in rig.all_lines_for(conn) {
        if line_field(line, "kind") == "route_state" && line_field(line, "trace") == trace {
            match kit_object(line) {
                Some(o) => {
                    match jchild(o, "input") {
                        Some(i) => { found = i }
                        None => ()
                    }
                }
                None => ()
            }
        }
    }
    found
}

// The trace of the session with this name ("" - none) and the `parent` its journal says ("" - none).
fn ck_find(rig Rig, conn int, name str) -> str {
    for line in rig.all_lines_for(conn) {
        if line_field(line, "kind") == "session_created" && line_input(line, "name") == name { return line_field(line, "trace") }
    }
    ""
}

fn ck_parent(rig Rig, conn int, trace str) -> str {
    for line in rig.all_lines_for(conn) {
        if line_field(line, "kind") == "session_created" && line_field(line, "trace") == trace { return line_input(line, "parent") }
    }
    ""
}

// The helpers of the recognition for a hub with many sessions: the card is looked for in the state of THIS session (the last state of any session is not it).
fn ck_list(mut rig Rig, session str, turn str, items []JsonValue, first_title str) Proc Detach Time -> bool {
    mut attempt = 0
    while attempt < 3 {
        rig.run(1500)
        rig.page(1, "user_message", session, rk_tasklist_page("${turn}-${attempt}", items))
        if rig.until(KIT_DONE, 20000) {
            rig.run(300)
            if rk_card_id(ck_state(rig, 1, session), first_title) > 0 { return true }
        }
        attempt += 1
    }
    false
}

fn ck_press(mut rig Rig, session str, title str, action str) Proc Detach Time -> () {
    ro id = rk_card_id(ck_state(rig, 1, session), title)
    rig.page(1, "route_prop", session, "{\"id\":${id},\"action\":\"${action}\"}")
    rig.run(300)
}

fn ck_item(kind str, title str, parent int, epic int, extends int, touches []str) -> JsonValue {
    mut o = rk_item(kind, title, extends, touches).object() ?? JsonObject.new()
    jput(o, "parent", JsonValue.int(parent))
    jput(o, "epic", JsonValue.int(epic))
    JsonValue.object(o)
}

fn ck_task_id(rig Rig, conn int, trace str) -> str => jtext(rk_task(ck_state(rig, conn, trace)), "id")
fn ck_tree(rig Rig, conn int, trace str) -> str => jtext(rk_task(ck_state(rig, conn, trace)), "worktree")
fn ck_number(rig Rig, conn int, trace str) -> str => jtext(rk_task(ck_state(rig, conn, trace)), "number")

// The message file of the task of a session (in its tree when it has one).
fn ck_message(rig Rig, conn int, trace str) -> str {
    ro tree = ck_tree(rig, conn, trace)
    ro id = ck_task_id(rig, conn, trace)
    rk_text("${tree}/doc/tasks/${id}/task/message.md")
}

// The state key ("running", "waits", "ready", "merged") of the child with this number in the table of its parent, "" - no such row.
fn ck_row_state(rig Rig, conn int, parent str, number str) -> str {
    for r in rk_array(ck_state(rig, conn, parent), "children") {
        ro o = r.object() ?? JsonObject.new()
        if jtext(o, "number") == number { return jtext(o, "state") }
    }
    ""
}

fn ck_wait_row(mut rig Rig, parent str, number str, want str, limit_ms int) Proc Detach Time -> bool {
    ro deadline = Time.now().unix_millis() + limit_ms
    while Time.now().unix_millis() < deadline {
        rig.run(200)
        if ck_row_state(rig, 1, parent, number) == want { return true }
    }
    false
}

// The messages of the last error events of the page (for the text of a failed check).
fn ck_errors(rig Rig) -> str {
    mut out = []str.new()
    for line in rig.all_lines_for(1) {
        if line_field(line, "kind") == "error" { out.push(cut_text(line_input(line, "message"), 120)) }
    }
    mut tail = []str.new()
    mut at = if out.len() > 4 { out.len() - 4 } else { 0 }
    while at < out.len() {
        tail.push(out[at])
        at += 1
    }
    joined(tail, " | ")
}

// The last events of one session: kind and a bit of the text (for the text of a failed check).
fn ck_tail(rig Rig, trace str) -> str {
    mut out = []str.new()
    for line in rig.all_lines_for(1) {
        if line_field(line, "trace") == trace && line_field(line, "kind") != "route_state" { out.push("${line_field(line, "kind")}:${cut_text(line_input(line, "text"), 30)}${cut_text(line_input(line, "message"), 40)}") }
    }
    mut tail = []str.new()
    mut at = if out.len() > 7 { out.len() - 7 } else { 0 }
    while at < out.len() {
        tail.push(out[at])
        at += 1
    }
    "[${trace} takes=${rig.hub.takes_message(trace)} agent=${rig.hub.has_agent(trace)}] ${joined(tail, " ; ")}"
}

// The fake agent echoes the whole note word by word (a timer of the system makes a word ~16 ms): a long note is a turn of seconds. Wait until the agent of the session takes a message.
fn ck_idle(mut rig Rig, trace str, limit_ms int) Proc Detach Time -> bool {
    ro deadline = Time.now().unix_millis() + limit_ms
    while Time.now().unix_millis() < deadline {
        if rig.hub.takes_message(trace) { return true }
        rig.run(200)
    }
    rig.hub.takes_message(trace)
}

fn ck_commit(tree str, file str) Proc -> bool {
    ro wrote = write_file("${tree}/${file}", "work of ${file}\n")
    rk_git(tree, ["add", file]) && rk_git(tree, ["commit", "-m", "work: ${file}"])
}

fn ck_turns(rig Rig, conn int, trace str) -> int {
    mut n = 0
    for line in rig.all_lines_for(conn) {
        if line_field(line, "trace") == trace && line_field(line, "kind") == "user_message" && line_input(line, "text").contains("Решение по задаче") { n += 1 }
    }
    n
}

/// "В работу" makes sessions: a task of its own by default (a session on the top level, no parent, no table), a subtask only when the work is explicitly a part of a task (the first line
/// `Родитель: NNN`, the table `children.md` of the parent, the branch cut from the branch of the parent), a task of an epic only for an epic; two children work in parallel; a work that touches the
/// files of a running one waits; a child merges into the branch of its parent; the parent is held until the children are merged; the chain merges them in order; after a restart the children
/// are under the parent again.
export fn scenario_route_children(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rig.page(1, "session_created", "s-c1", "{\"name\":\"Беседа\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 5000), "the session of the talk is shown")

    // 1. two works "в работу": two sessions of their own, no parent, no table; the talk itself has no task
    c.expect(ck_list(rig, "s-c1", "t1", [ck_item("new", "Первая работа", 0, 0, 0, ["a.txt"]), ck_item("new", "Вторая работа", 0, 0, 0, ["b.txt"])], "Первая работа"), "the list is shown")
    rig.page(1, "route_quick", "s-c1", "{\"text\":\"1, 2 в работу\"}")
    rig.run(5000)
    ro p1 = ck_find(rig, 1, "Первая работа")
    ro p2 = ck_find(rig, 1, "Вторая работа")
    c.expect(p1 != "" && p2 != "" && p1 != p2, "two sessions are made: ${p1} ${p2}")
    c.expect(ck_parent(rig, 1, p1) == "" && ck_parent(rig, 1, p2) == "", "they are on the top level: no parent")
    c.expect(rk_task_is_null(ck_state(rig, 1, "s-c1")), "the talk has no task of its own")
    ro id1 = ck_task_id(rig, 1, p1)
    ro tree1 = ck_tree(rig, 1, p1)
    c.expect(id1.starts_with("001-") && ck_task_id(rig, 1, p2).starts_with("002-"), "the numbers are plain and common: ${id1} ${ck_task_id(rig, 1, p2)}")
    c.expect(tree1.byte_len() > 0 && dir_there(tree1) && jtext(rk_task(ck_state(rig, 1, p1)), "branch") == "task/${id1}", "a tree and a branch of their own: ${tree1}")
    ro m1 = ck_message(rig, 1, p1)
    c.expect(m1.contains("сделать: Первая работа") && !m1.contains("Родитель:") && !m1.contains("Эпик:"), "message.md of a task of its own has no line of a parent")
    c.expect(!path_there("${tree1}/doc/tasks/${id1}/task/children.md"), "and no table of children")
    c.expect(!path_there("${tree1}/doc/tasks/${id1}/task/message.1.md"), "no message.N.md")
    c.expect(ck_turns(rig, 1, p1) >= 1 && ck_turns(rig, 1, p2) >= 1, "both agents got their service turn (they work in parallel)")
    c.expect(rk_number(ck_state(rig, 1, "s-c1"), "active") == 2, "two are in work")

    // 2. a work that is explicitly a part of the task 1: a subtask, a session under it
    c.expect(ck_list(rig, "s-c1", "t2", [ck_item("subtask", "Часть первой", 1, 0, 0, ["c.txt"])], "Часть первой"), "a subtask is listed")
    ck_press(rig, "s-c1", "Часть первой", "start")
    rig.run(4000)
    ro s3 = ck_find(rig, 1, "Часть первой")
    c.expect(s3 != "" && ck_parent(rig, 1, s3) == p1, "the subtask is a session under the session of the task 1: ${s3}")
    ro id3 = ck_task_id(rig, 1, s3)
    c.expect(id3.starts_with("003-001-"), "its folder holds the number of the parent: ${id3}")
    ro tree3 = ck_tree(rig, 1, s3)
    c.expect(dir_there(tree3) && tree3 != tree1 && jtext(rk_task(ck_state(rig, 1, s3)), "branch") == "task/${id3}", "its own tree and branch: ${tree3}")
    ro m3 = ck_message(rig, 1, s3)
    c.expect(m3.starts_with("Родитель: 001\n") && m3.contains("сделать: Часть первой"), "the first line of message.md is the parent: ${cut_text(m3, 60)}")
    ro table = rk_text("${tree1}/doc/tasks/${id1}/task/children.md")
    c.expect(table.contains("003") && table.contains("подзадача") && table.contains("идёт") && table.contains(s3), "the table of the parent has the row of the child: ${cut_text(table, 200)}")
    c.expect(ck_row_state(rig, 1, p1, "003") == "running", "the panel of the parent lists the child")
    c.expect(jtext(jchild(ck_state(rig, 1, s3), "child") ?? JsonObject.new(), "parent") == p1, "the child knows its parent")
    c.expect(jtext(jchild(ck_state(rig, 1, s3), "child") ?? JsonObject.new(), "target") == "parent", "and that it merges into the branch of the parent")
    c.expect(ck_turns(rig, 1, s3) >= 1, "the agent of the child got its service turn")

    c.expect(ck_idle(rig, p1, 60000) && ck_idle(rig, s3, 60000), "the agents of the task 1 and of its subtask finish their turns")
    // 3. the parent is held while the child is not merged
    rig.page(1, "route_merge", p1, "{}")
    rig.run(800)
    c.expect(kit_with(rig.all_lines_for(1), "не слиты подзадачи: 003") >= 1, "'Слить в main' of the parent is refused while a child is not merged: ${ck_errors(rig)} ${ck_tail(rig, p1)}")
    c.expect(rk_array(ck_state(rig, 1, p1), "children_block").len() == 1, "and the page is told which child holds it")

    // 4. a work that touches the files of a running one waits for it, then starts by itself
    c.expect(ck_list(rig, "s-c1", "t3", [ck_item("new", "Пересекается", 0, 0, 0, ["c.txt"])], "Пересекается"), "a work on the same file is listed")
    ck_press(rig, "s-c1", "Пересекается", "start")
    c.expect(rk_card_state(ck_state(rig, 1, "s-c1"), "Пересекается") == "overlap", "the overlap with the task 3 is asked about")
    ck_press(rig, "s-c1", "Пересекается", "wait")
    rig.run(1500)
    ro sw = ck_find(rig, 1, "Пересекается")
    c.expect(sw != "" && ck_turns(rig, 1, sw) == 0, "the waiting task has a session but its agent is not started")
    rig.page(1, "route_subtask_done", s3, "{\"n\":1}")
    rig.run(4500)
    c.expect(ck_idle(rig, sw, 60000), "the waiting task finishes its first turn")
    c.expect(ck_turns(rig, 1, sw) >= 1, "the waiting task starts when the one it waits for is ready")

    // 5. the child merges into the branch of its parent
    c.expect(ck_commit(tree3, "c.txt"), "a commit in the tree of the child")
    rig.page(1, "route_merge", s3, "{}")
    c.expect(ck_wait_row(rig, p1, "003", "merged", 30000), "the child is merged: ${ck_row_state(rig, 1, p1, "003")} ${ck_errors(rig)}")
    c.expect(path_there("${tree1}/c.txt"), "the work of the child is in the tree of the parent")
    c.expect(!dir_there(tree3), "the tree of the merged child is removed")
    c.expect(rk_array(ck_state(rig, 1, p1), "children_block").len() == 0, "nothing holds the parent now")
    rig.run(500)
    c.expect(rk_text("${tree1}/doc/tasks/${id1}/task/children.md").contains("слита"), "the table says: слита")

    // 6. the chain: two more subtasks are merged in order by one button
    c.expect(ck_list(rig, "s-c1", "t4", [ck_item("subtask", "Хвост А", 1, 0, 0, ["ta.txt"]), ck_item("subtask", "Хвост Б", 1, 0, 0, ["tb.txt"])], "Хвост А"), "two more subtasks are listed")
    rig.page(1, "route_quick", "s-c1", "{\"text\":\"1, 2 в работу\"}")
    rig.run(5000)
    ro ta = ck_find(rig, 1, "Хвост А")
    ro tb = ck_find(rig, 1, "Хвост Б")
    c.expect(ta != "" && tb != "" && ck_parent(rig, 1, ta) == p1 && ck_parent(rig, 1, tb) == p1, "both are under the task 1")
    c.expect(ck_commit(ck_tree(rig, 1, ta), "ta.txt") && ck_commit(ck_tree(rig, 1, tb), "tb.txt"), "commits in their trees")
    rig.run(1500)
    c.expect(ck_idle(rig, ta, 60000) && ck_idle(rig, tb, 60000) && ck_idle(rig, p1, 60000), "the agents of the tails finish their turns")
    rig.page(1, "route_children_merge", p1, "{}")
    c.expect(ck_wait_row(rig, p1, ck_number(rig, 1, tb), "merged", 60000), "the chain merges the children: ${ck_row_state(rig, 1, p1, ck_number(rig, 1, tb))} ${ck_errors(rig)}")
    c.expect(ck_row_state(rig, 1, p1, ck_number(rig, 1, ta)) == "merged", "in order")
    c.expect(path_there("${tree1}/ta.txt") && path_there("${tree1}/tb.txt"), "both works are in the tree of the parent")
    c.expect(rk_number(ck_state(rig, 1, p1), "children_merged") == 3 && rk_number(ck_state(rig, 1, p1), "children_total") == 3, "the progress of the parent: 3 of 3")

    // 7. an epic: the mark makes the folder of the epic, a task of the epic has the line `Эпик:` and merges into main by itself
    rig.page(1, "session_created", "s-e", "{\"name\":\"Эпик пульта\",\"agent\":\"opencode\"}")
    c.expect(rig.until("Эпик пульта", 5000), "the session of the epic is shown")
    rig.page(1, "route_epic", "s-e", "{\"on\":true}")
    rig.run(1500)
    ro epic_state = ck_state(rig, 1, "s-e")
    ro epic_no = ck_number(rig, 1, "s-e")
    c.expect(((epic_state.get("epic") ?? JsonValue.null()).bool() ?? false) && epic_no.byte_len() > 0, "the epic has a number: ${epic_no}")
    ro epic_int = match epic_no.to_int() {
        Ok(v) => v
        Err(e) => 0
    }
    c.expect(ck_list(rig, "s-c1", "t5", [ck_item("epic_task", "Задача эпика", 0, epic_int, 0, ["e.txt"])], "Задача эпика"), "a task of the epic is listed")
    ck_press(rig, "s-c1", "Задача эпика", "start")
    rig.run(4000)
    ro et = ck_find(rig, 1, "Задача эпика")
    c.expect(et != "" && ck_parent(rig, 1, et) == "s-e", "the task of the epic is a session under the epic")
    c.expect(ck_message(rig, 1, et).starts_with("Эпик: ${epic_no}\n"), "the first line of its message.md is the epic")
    ro epic_dir = "${ck_tree(rig, 1, "s-e")}/doc/tasks/${ck_task_id(rig, 1, "s-e")}/task"
    c.expect(rk_text("${epic_dir}/children.md").contains("задача эпика") && rk_text("${epic_dir}/children.md").contains(ck_number(rig, 1, et)), "the table of the epic holds the task")
    c.expect(jtext(jchild(ck_state(rig, 1, et), "child") ?? JsonObject.new(), "target") == "parent", "the epic has a branch and a tree: its task merges into the branch of the epic")

    // 8. a restart: the children are under their parent again
    ro want_parent = ck_parent(rig, 1, s3)
    rig.shut()
    mut again = rig_open(settings)
    again.attach(2)
    again.run(1500)
    c.expect(ck_parent(again, 2, s3) == want_parent && want_parent == p1, "after the restart the child is under its parent")
    c.expect(ck_parent(again, 2, et) == "s-e" && ck_parent(again, 2, p1) == "", "the task of the epic too, the tasks of their own stay on the top")
    c.expect(rk_number(ck_state(again, 2, p1), "children_total") == 3, "the parent lists its children: ${rk_number(ck_state(again, 2, p1), "children_total")}")
    c.expect(ck_row_state(again, 2, p1, "003") == "merged", "and their states")
    c.expect(jtext(jchild(ck_state(again, 2, et), "child") ?? JsonObject.new(), "parent") == "s-e", "the child knows its parent after the restart")
    again.shut()
    c.report()
}
