// settings.nv - the settings of the session server from a JSON file and from the environment (task 099).
//
// The file is a JSON object; every key is optional (see `src/server/server.example.json`):
//   port, data_dir, store ("files" or "pg"), pg {host, port, database, user, password}, agents [{id, label, program, args}],
//   idle_term_seconds, workdir, web_dir, machines_dir (the folder of the machines of the product, task 248), hub {program, args}, acp_trace (true by default: the raw exchange with the agent is written to
//   <data_dir>/<session>/acp.jsonl), ask_form (true by default: the agents may ask the owner a question with a choice; see src/acp/README.md,
//   "Questions of the agent"), ask_timeout_seconds (1800: how long the tool `ask_user_question` waits for the owner), agents[].ask (native, mcp, off), stt {url, language} (the local whisper server the front sends the voice to: `/api/stt`),
//   max_image_bytes (the largest picture of a message, 10 MB by default; env CREW_SERVER_MAX_IMAGE_BYTES)
//   routes_dir ("doc/routes": the files of the modes of work, task 192q), route_reviewer_order (["codex","claude","kimi","opencode"]: the families of the independent reviewer),
//   route_task_limit (12 subtasks) and route_task_messages (40 messages): over them the page is told to suggest a new task, route_fix_attempts (2: tries of the agent to resolve a conflict), route_worktree_ask (true: a subtask whose files overlap with another asks the owner for a tree of its own for route_overlap_seconds = 30, then takes it), route_keep_days (30: days without activity after which a session is marked stale and the page asks whether to delete its tree and branch; 0 - no term)
// The environment is over the file, key by key:
//   CREW_SERVER_PORT, CREW_SERVER_STORE, CREW_SERVER_DATA_DIR, CREW_SERVER_AGENT (the command of the one agent "opencode",
//   words separated by spaces), CREW_SERVER_WORKDIR, CREW_SERVER_WEB_DIR, CREW_SERVER_MACHINES_DIR, CREW_SERVER_ACP_TRACE (true/false), CREW_SERVER_ASK_FORM (true/false), CREW_SERVER_ASK_TIMEOUT_SECONDS, CREW_SERVER_STT_URL, CREW_SERVER_STT_LANGUAGE, CREW_SERVER_IDLE_SECONDS, CREW_SERVER_HUB (the command
//   that starts the hub, words separated by spaces) and the CREW_PG_* variables of `crew_harness.pgconf`.
// The file is named by the argument or, when that is empty, by CREW_SERVER_CONFIG. The password lives in the environment or in a
// file outside the repository; it is in no error and no description.
module crew_harness.server

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import crew_harness.pgdb.{PgConfig, parse_pg_config}
import crew_harness.pgconf.{pg_config_env}
import std.encoding.json.{Json, JsonValue, JsonObject}
import std.fs.{Fs, read_text, Path}
import std.os.{Os, env}

/// AgentSpec: an agent the page can choose: the id the page names it by, the label, the command, and how it asks the owner (task 192i): `native` (its own
/// tool of questions, over `elicitation/create`; the default), `mcp` (the hub gives it the MCP tool `ask_user_question` and a hint), `off` (nothing).
export type AgentSpec { id str, label str, program str, args []str, ask str }

/// ServerSettings: everything the server is told. `store` is "files" or "pg"; `data_dir` holds the files of the file store
/// and, in both modes, the inbox files of the ACP client; `idle_term_ms` is the idle term of a turn; `workdir` is the folder
/// the agents work in ("" - the folder of the server); `machines_dir` is the folder of the machines of the product ("" - `machines/product` beside
/// the hub, else beside its folder: `crew_harness.product_machines.find_machines_dir`); `hub_program` and `hub_args` start the hub (the front only).
export type ServerSettings {
    port int,
    data_dir str,
    store str,
    pg PgConfig,
    agents []AgentSpec,
    idle_term_ms int,
    workdir str,
    web_dir str,
    machines_dir str,
    hub_program str,
    hub_args []str,
    acp_trace bool,
    ask_form bool,
    ask_timeout_ms int,
    stt_url str,
    stt_language str,
    max_image_bytes int,
    routes_dir str,
    route_reviewer_order []str,
    route_task_limit int,
    route_task_messages int,
    route_fix_attempts int,
    route_worktree_ask bool,
    route_overlap_seconds int,
    route_keep_days int,
    route_confirm_word str,
    route_over_limit_word str,
    route_max_active int,
    route_tool bool,
    route_auto_propose bool,
    route_children bool
}

fn st_text(o JsonObject, key str, fallback str) -> Result[str, str] {
    match o.get(key) {
        None => Ok(fallback)
        Some(v) => match v.str() {
            Some(s) => Ok(s)
            None => Err("the setting ${key} must be a string")
        }
    }
}

fn st_number(o JsonObject, key str, fallback int) -> Result[int, str] {
    match o.get(key) {
        None => Ok(fallback)
        Some(v) => match v.int() {
            Some(n) => Ok(n)
            None => Err("the setting ${key} must be a whole number")
        }
    }
}

fn st_flag(o JsonObject, key str, fallback bool) -> Result[bool, str] {
    match o.get(key) {
        None => Ok(fallback)
        Some(v) => match v.bool() {
            Some(b) => Ok(b)
            None => Err("the setting ${key} must be true or false")
        }
    }
}

/// The largest picture the server takes: 10 MB.
export const DEFAULT_MAX_IMAGE_BYTES = 10485760

fn st_image_limit_check(n int) -> Result[(), str] {
    if n < 1024 || n > 104857600 { return Err("max_image_bytes must be 1024 to 104857600 (100 MB)") }
    Ok(())
}

const STT_DEFAULT_URL = "http://127.0.0.1:8178/inference"

// The voice never leaves this machine: the address of the recognizer is a plain http one on 127.0.0.1 or localhost.
fn st_stt_url_ok(url str) -> bool => url.starts_with("http://127.0.0.1:") || url.starts_with("http://localhost:")

fn st_stt_check(url str, language str) -> Result[(), str] {
    if !st_stt_url_ok(url) { return Err("the stt url must be http://127.0.0.1:<port>/... or http://localhost:<port>/...") }
    if language.byte_len() == 0 { return Err("the stt language must not be empty (auto, ru, en, ...)") }
    Ok(())
}

fn st_words(v JsonValue, what str) -> Result[[]str, str] {
    ro items = match v.array() {
        Some(a) => a
        None => return Err("${what} must be a list of strings")
    }
    mut out = []str.new()
    for item in items {
        match item.str() {
            Some(s) => out.push(s)
            None => return Err("${what} must be a list of strings")
        }
    }
    Ok(out)
}

fn st_agent(v JsonValue) -> Result[AgentSpec, str] {
    ro o = match v.object() {
        Some(x) => x
        None => return Err("an agent must be an object")
    }
    ro id = st_text(o, "id", "")?
    ro program = st_text(o, "program", "")?
    if id.byte_len() == 0 { return Err("an agent needs an id") }
    if program.byte_len() == 0 { return Err("the agent ${id} needs a program") }
    ro label = st_text(o, "label", id)?
    ro args = match o.get("args") {
        Some(a) => st_words(a, "the args of the agent ${id}")?
        None => []str.new()
    }
    ro ask = st_text(o, "ask", "native")?
    if ask != "native" && ask != "mcp" && ask != "off" { return Err("the ask of the agent ${id} must be native, mcp or off") }
    Ok(AgentSpec { id, label, program, args, ask })
}

// On Windows OpenCode is an npm shim, a .cmd file, and a process cannot be started from the bare name.
#cfg(target_os = "windows")
fn st_opencode_program() -> str => "opencode.cmd"

#cfg(!target_os = "windows")
fn st_opencode_program() -> str => "opencode"

/// The program of the default agent: `opencode.cmd` on Windows, `opencode` elsewhere.
export fn default_opencode_program() -> str => st_opencode_program()

fn st_default_agents() -> []AgentSpec {
    mut out = []AgentSpec.new()
    out.push(AgentSpec { id: "opencode", label: "OpenCode", program: st_opencode_program(), args: ["acp"], ask: "native" })
    out
}

fn st_object(v JsonValue, what str) -> Result[JsonObject, str] {
    match v.object() {
        Some(o) => Ok(o)
        None => Err("${what} must be an object")
    }
}

/// The settings from the text of a file; the text is never quoted in an error.
export fn parse_server_settings(text str) -> Result[ServerSettings, str] {
    ro value = match Json.parse(text) {
        Ok(v) => v
        Err(e) => return Err("the settings are not JSON")
    }
    ro o = st_object(value, "the settings")?
    ro port = st_number(o, "port", 8099)?
    if port < 1 || port > 65535 { return Err("the port must be 1 to 65535") }
    ro data_dir = st_text(o, "data_dir", "crew-data")?
    ro store = st_text(o, "store", "files")?
    if store != "files" && store != "pg" { return Err("the store must be files or pg") }
    ro pg = match o.get("pg") {
        Some(p) => {
            ro po = st_object(p, "the setting pg")?
            match parse_pg_config(JsonValue.object(po).to_str()) {
                Ok(c) => c
                Err(e) => return Err("the setting pg: ${e}")
            }
        }
        None => parse_pg_config("{}")?
    }
    ro agents = match o.get("agents") {
        Some(list) => {
            ro items = match list.array() {
                Some(a) => a
                None => return Err("the setting agents must be a list")
            }
            if items.len() == 0 { return Err("the setting agents must name at least one agent") }
            mut out = []AgentSpec.new()
            for item in items { out.push(st_agent(item)?) }
            out
        }
        None => st_default_agents()
    }
    ro idle_seconds = st_number(o, "idle_term_seconds", 900)?
    if idle_seconds < 1 { return Err("idle_term_seconds must be 1 or more") }
    ro workdir = st_text(o, "workdir", "")?
    ro web_dir = st_text(o, "web_dir", "src/web")?
    ro machines_dir = st_text(o, "machines_dir", "")?
    ro acp_trace = st_flag(o, "acp_trace", true)?
    ro max_image_bytes = st_number(o, "max_image_bytes", DEFAULT_MAX_IMAGE_BYTES)?
    st_image_limit_check(max_image_bytes)?
    ro ask_form = st_flag(o, "ask_form", true)?
    ro ask_seconds = st_number(o, "ask_timeout_seconds", 1800)?
    if ask_seconds < 1 { return Err("ask_timeout_seconds must be 1 or more") }
    mut stt_url = STT_DEFAULT_URL
    mut stt_language = "auto"
    match o.get("stt") {
        Some(t) => {
            ro to = st_object(t, "the setting stt")?
            stt_url = st_text(to, "url", stt_url)?
            stt_language = st_text(to, "language", stt_language)?
        }
        None => ()
    }
    st_stt_check(stt_url, stt_language)?
    ro routes_dir = st_text(o, "routes_dir", "doc/routes")?
    ro route_reviewer_order = match o.get("route_reviewer_order") {
        Some(a) => st_words(a, "route_reviewer_order")?
        None => ["codex", "claude", "kimi", "opencode"]
    }
    ro route_task_limit = st_number(o, "route_task_limit", 12)?
    ro route_task_messages = st_number(o, "route_task_messages", 40)?
    ro route_fix_attempts = st_number(o, "route_fix_attempts", 2)?
    ro route_worktree_ask = st_flag(o, "route_worktree_ask", true)?
    ro route_overlap_seconds = st_number(o, "route_overlap_seconds", 30)?
    ro route_keep_days = st_number(o, "route_keep_days", 30)?
    ro route_confirm_word = st_text(o, "route_confirm_word", "задача")?
    ro route_over_limit_word = st_text(o, "route_over_limit_word", "сверх")?
    ro route_max_active = st_number(o, "route_max_active", 3)?
    ro route_tool = st_flag(o, "route_tool", true)?
    ro route_auto_propose = st_flag(o, "route_auto_propose", false)?
    ro route_children = st_flag(o, "route_children", true)?
    mut hub_program = "target/crew-hub.exe"
    mut hub_args = []str.new()
    match o.get("hub") {
        Some(h) => {
            ro ho = st_object(h, "the setting hub")?
            hub_program = st_text(ho, "program", hub_program)?
            match ho.get("args") {
                Some(a) => { hub_args = st_words(a, "the args of the hub")? }
                None => ()
            }
        }
        None => ()
    }
    Ok(ServerSettings { port, data_dir, store, pg, agents, idle_term_ms: idle_seconds * 1000, workdir, web_dir, machines_dir, hub_program, hub_args, acp_trace, ask_form, ask_timeout_ms: ask_seconds * 1000, stt_url, stt_language, max_image_bytes, routes_dir, route_reviewer_order, route_task_limit, route_task_messages, route_fix_attempts, route_worktree_ask, route_overlap_seconds, route_keep_days, route_confirm_word, route_over_limit_word, route_max_active, route_tool, route_auto_propose, route_children })
}

fn st_env(key str) Os -> Option[str] {
    match env(key) {
        Some(v) => if v.byte_len() > 0 { Some(v) } else { None }
        None => None
    }
}

fn st_env_flag(key str, fallback bool) Os -> Result[bool, str] {
    match st_env(key) {
        None => Ok(fallback)
        Some(text) => if text == "true" || text == "1" {
            Ok(true)
        } else if text == "false" || text == "0" {
            Ok(false)
        } else {
            Err("${key} must be true or false")
        }
    }
}

fn st_split(text str) -> []str {
    mut out = []str.new()
    for part in text.split(" ") {
        if part.byte_len() > 0 { out.push(part) }
    }
    out
}

fn st_env_number(key str) Os -> Result[Option[int], str] {
    match st_env(key) {
        None => Ok(None)
        Some(text) => match text.to_int() {
            Ok(n) => Ok(Some(n))
            Err(e) => Err("${key} must be a whole number")
        }
    }
}

// The words after the first one.
fn st_rest(words []str) -> []str {
    mut rest = []str.new()
    mut i = 1
    while i < words.len() {
        rest.push(words[i])
        i += 1
    }
    rest
}

// The one agent "opencode" of the command in the variable.
fn st_one_agent(words []str) -> []AgentSpec {
    mut one = []AgentSpec.new()
    one.push(AgentSpec { id: "opencode", label: "OpenCode", program: words[0], args: st_rest(words), ask: "native" })
    one
}

/// The settings: the file `file` (or the one named by CREW_SERVER_CONFIG when `file` is empty; no file means the defaults),
/// then the environment over it. The error never quotes the content of the file.
export fn server_settings(file str) Os Fs -> Result[ServerSettings, str] {
    ro name = if file.byte_len() > 0 { file } else { st_env("CREW_SERVER_CONFIG") ?? "" }
    ro base = if name.byte_len() == 0 {
        parse_server_settings("{}")?
    } else {
        ro text = match read_text(Path.from_bytes(name.bytes())) {
            Ok(t) => t
            Err(e) => return Err("the settings file ${name} cannot be read")
        }
        match parse_server_settings(text) {
            Ok(s) => s
            Err(e) => return Err("${e} (file ${name})")
        }
    }
    ro pg = pg_config_env(base.pg)?
    ro port = st_env_number("CREW_SERVER_PORT")?
    ro idle = st_env_number("CREW_SERVER_IDLE_SECONDS")?
    ro agent_words = match st_env("CREW_SERVER_AGENT") {
        Some(command) => st_split(command)
        None => []str.new()
    }
    ro agents = if agent_words.len() > 0 { st_one_agent(agent_words) } else { base.agents }
    ro hub_words = match st_env("CREW_SERVER_HUB") {
        Some(command) => st_split(command)
        None => []str.new()
    }
    ro hub_program = if hub_words.len() > 0 { hub_words[0] } else { base.hub_program }
    ro hub_args = if hub_words.len() > 0 { st_rest(hub_words) } else { base.hub_args }
    ro idle_term_ms = match idle {
        Some(n) => n * 1000
        None => base.idle_term_ms
    }
    ro acp_trace = st_env_flag("CREW_SERVER_ACP_TRACE", base.acp_trace)?
    ro ask_form = st_env_flag("CREW_SERVER_ASK_FORM", base.ask_form)?
    ro ask_seconds = st_env_number("CREW_SERVER_ASK_TIMEOUT_SECONDS")?
    ro ask_timeout_ms = match ask_seconds {
        Some(n) => n * 1000
        None => base.ask_timeout_ms
    }
    ro stt_url = st_env("CREW_SERVER_STT_URL") ?? base.stt_url
    ro stt_language = st_env("CREW_SERVER_STT_LANGUAGE") ?? base.stt_language
    st_stt_check(stt_url, stt_language)?
    ro image_limit = st_env_number("CREW_SERVER_MAX_IMAGE_BYTES")?
    ro max_image_bytes = image_limit ?? base.max_image_bytes
    st_image_limit_check(max_image_bytes)?
    ro merged = ServerSettings {
        port: port ?? base.port,
        data_dir: st_env("CREW_SERVER_DATA_DIR") ?? base.data_dir,
        store: st_env("CREW_SERVER_STORE") ?? base.store,
        pg,
        agents,
        idle_term_ms,
        workdir: st_env("CREW_SERVER_WORKDIR") ?? base.workdir,
        web_dir: st_env("CREW_SERVER_WEB_DIR") ?? base.web_dir,
        machines_dir: st_env("CREW_SERVER_MACHINES_DIR") ?? base.machines_dir,
        hub_program,
        hub_args,
        acp_trace,
        ask_form,
        ask_timeout_ms,
        stt_url,
        stt_language,
        max_image_bytes,
        routes_dir: st_env("CREW_SERVER_ROUTES_DIR") ?? base.routes_dir,
        route_reviewer_order: base.route_reviewer_order,
        route_task_limit: base.route_task_limit,
        route_task_messages: base.route_task_messages,
        route_fix_attempts: base.route_fix_attempts,
        route_worktree_ask: base.route_worktree_ask,
        route_overlap_seconds: base.route_overlap_seconds,
        route_keep_days: base.route_keep_days,
        route_confirm_word: base.route_confirm_word,
        route_over_limit_word: base.route_over_limit_word,
        route_max_active: base.route_max_active,
        route_tool: base.route_tool,
        route_auto_propose: base.route_auto_propose,
        route_children: base.route_children
    }
    if merged.store != "files" && merged.store != "pg" { return Err("the store must be files or pg") }
    if merged.port < 1 || merged.port > 65535 { return Err("the port must be 1 to 65535") }
    if merged.idle_term_ms < 1000 { return Err("the idle term must be 1 second or more") }
    if merged.ask_timeout_ms < 1000 { return Err("the term of a question must be 1 second or more") }
    Ok(merged)
}

/// Is the configuration fit to start? The store "pg" needs a configuration that `PgConfig.check` accepts (a local host and a password).
export fn ServerSettings @check() -> Result[(), str] {
    if @agents.len() == 0 { return Err("no agent is configured") }
    if @data_dir.byte_len() == 0 { return Err("the data folder is empty") }
    if @store == "pg" {
        match @pg.check() {
            Ok(done) => ()
            Err(e) => return Err("the store pg: ${e}")
        }
    }
    Ok(())
}

/// The settings for a log line: no password.
export fn ServerSettings @describe() -> str {
    mut ids = []str.new()
    for a in @agents { ids.push(a.id) }
    ro store = if @store == "pg" { "pg ${@pg.describe()}" } else { "files in ${@data_dir}" }
    "port ${@port}, store ${store}, agents ${ids.join(",")}, idle term ${@idle_term_ms / 1000} s"
}

/// The agent with this id.
export fn ServerSettings @agent(id str) -> Option[AgentSpec] {
    for a in @agents {
        if a.id == id { return Some(a) }
    }
    None
}
