// wip_hub.nv - task 192.4 (changed by the owner 2026-10-27, task 192.5): the hub side of the work that is not a task yet (a tree with NO branch).
//
// A session with the switch "Worktree" on gets a tree of its own at its FIRST message: `<worktrees>/<repo>-<short code of the session>` on a DETACHED head cut from a fresh origin/main
// (`git worktree add --detach`), no branch `wip/...`; the agent works in it. There is no number, no folder `doc/tasks` and no `message.md` yet. A session with the switch off works in the folder of
// the project on its branch (the page says which: `route_state.where`).
// "В работу" of the FIRST work of such a session does not make a new session: the branch `task/NNN-slug` is made in this very tree (`git switch -c` on the current head, so the changes made before and the
// commits made on the detached head go with it; the tree stays where it is, its path is in the journal), `doc/tasks/NNN-slug/task/message.md` is written in this tree and committed, and the session becomes
// the session of the task (`wip` of `route_task` is cleared by the `open` of the task). The way "Эпик" does the same and marks the task as an epic.
// The next separate works of the session are sessions of their own with trees cut from a fresh origin/main (`child_hub.nv`).
// A deleted session takes its tree with it when there is nothing to lose (no commits that are not in origin/main, no changed files); else the owner is asked (keep the work / delete all).
module crew_harness.server

import crew_harness.acp.{AcpImage}
import std.concurrency.nvchan.{ChanTx}
import std.os.{real_os}
import std.encoding.json.{Json, JsonValue, JsonObject}

// ----- the name -----

// The short name of a session for the branch: the letters, the digits and the hyphens of its id, lower case, up to 8 characters ("" - nothing fits).
fn wip_name(id str) -> str {
    ro low = id.to_ascii_lower()
    mut out = ""
    mut i = 0
    for b in low.bytes() {
        ro c = b as int
        ro fit = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45
        if fit && out.byte_len() < 8 && !(out.byte_len() == 0 && c == 45) { out = "${out}${low[i..i + 1]}" }
        i += 1
    }
    out
}

// Did the owner write to this session already (the first message makes the tree, not the later ones)?
fn wip_had_message(lines []str) -> bool {
    for line in lines {
        if line_field(line, "kind") == "user_message" { return true }
    }
    false
}

// The branch the folder stands on, from the files of git (no process): "" for a detached head or a folder that is not a repository.
fn wip_head_branch(dir str) -> str {
    ro dot = "${dir}/.git"
    mut head = ""
    if dir_there(dot) {
        head = "${dot}/HEAD"
    } else {
        match read_file(dot) {
            Some(t) => {
                if t.starts_with("gitdir:") { head = "${t["gitdir:".byte_len()..].trim_ascii()}/HEAD" }
            }
            None => ()
        }
    }
    if head.byte_len() == 0 { return "" }
    ro text = (read_file(head) ?? "").trim_ascii()
    if text.starts_with("ref: refs/heads/") { text["ref: refs/heads/".byte_len()..] } else { "" }
}

// ----- the start -----

/// The first message of a session in the mode interactive with the switch "Worktree" on: a tree on a detached head is made and the agent will work in it. Nothing is made again later.
/// Task 192.8: the tree is made IN THE BACKGROUND (a big repository takes tens of seconds to check out): the session is confirmed to the page at once, the page is told "preparing" (`where.kind`),
/// the message waits in `held` and goes to the agent when the tree is ready, has failed or `wip_timeout_ms` has passed (then the agent works in the folder of the project).
fn Hub mut @wip_start(at int) Proc Detach Time -> () {
    ro s = @sessions[at]
    // A foreign result is opened only as an explicit numbered task; never start an unbound wip in the owner's repository.
    if s.rt.result_repo.byte_len() > 0 { return }
    if !@settings.route_wip || !s.rt.use_tree || s.rt.wip_tree.byte_len() > 0 || s.rt.kind == "child" || s.rt.wip_prep != 0 { return }
    if s.rt.task_open || s.rt.route != "interactive" || wip_had_message(s.lines) { return }
    ro base = @route_repo_dir(s.id)
    if !tk_is_repo(base) { return }
    ro name = wip_name(s.id)
    if name.byte_len() == 0 { return }
    ro made = tk_wip_plan(base, name, @route_trees(s.id))
    if !made.ok {
        @tell_error(0, s.id, s.engine.step_number(), "", "дерево для работы не создано (${made.text}): агент работает в папке проекта")
        mut off = @sessions[at]
        off.rt.wip_prep = -1
        @sessions[at] = off
        return
    }
    mut me = @sessions[at]
    me.rt.wip_prep = now_millis()
    @sessions[at] = me
    if made.plan.reuse {
        // the tree is there already: nothing to wait for
        @wip_done(TreeDone { trace: s.id, code: 0, err: []u8.new(), note: "", path: made.plan.path, base: made.plan.base })
        return
    }
    ro tx = @trees_tx
    ro trace = s.id
    ro plan = made.plan
    detach { wip_job(tx, trace, plan) }
    @say_log("the tree of ${s.id} is being made in the background")
    @route_broadcast(at, true)
}

// The background job: the tree is made off the thread of the hub, the answer goes to the channel the pump reads.
fn wip_job(tx ChanTx[TreeDone], trace str, plan WipPlan) Proc Time -> () {
    ro run = with Os = real_os() { wip_add_run(plan) }
    ro told = tx.send(TreeDone { trace, code: run.code, err: run.err, note: run.note, path: plan.path, base: plan.base })
}

/// A message waits for the tree of its session; a second message of the same session is added to the first one.
fn Hub mut @wip_hold(trace str, text str, items []JsonValue) -> () {
    mut k = 0
    while k < @held.len() {
        if @held[k].trace == trace {
            mut h = @held[k]
            h.text = "${h.text}\n\n${text}"
            for x in items { h.items.push(x) }
            @held[k] = h
            return
        }
        k += 1
    }
    @held.push(HeldMsg { trace, text, items })
}

// The held message of the session goes on its way (the tree is ready, failed, or the term has passed).
fn Hub mut @wip_release(trace str) Proc Detach Time -> () {
    mut keep = []HeldMsg.new()
    mut mine = []HeldMsg.new()
    for h in @held {
        if h.trace == trace { mine.push(h) } else { keep.push(h) }
    }
    @held = keep
    for h in mine { @say(trace, h.text, h.items) }
}

/// At every pump: the answers of the background jobs of the trees, and the term of the ones that take too long.
fn Hub mut @wip_poll() Proc Detach Time -> () {
    mut more = true
    while more {
        match @trees_rx.try_recv() {
            Some(done) => @wip_done(done)
            None => { more = false }
        }
    }
    mut at = 0
    while at < @sessions.len() {
        ro s = @sessions[at]
        if s.rt.wip_prep > 0 && now_millis() - s.rt.wip_prep > @settings.wip_timeout_ms {
            mut me = @sessions[at]
            me.rt.wip_prep = -1
            @sessions[at] = me
            @tell_error(0, s.id, s.engine.step_number(), "", "рабочая копия не готова за ${@settings.wip_timeout_ms / 1000} с: агент работает прямо в папке проекта")
            @route_broadcast(at, true)
            @wip_release(s.id)
        }
        at += 1
    }
}

fn Hub mut @wip_done(done TreeDone) Proc Detach Time -> () {
    ro at = @find(done.trace)
    if at < 0 { return }
    ro s = @sessions[at]
    // the term has passed or the session took another way: the tree that came late is not taken
    if s.rt.wip_prep <= 0 { return }
    mut me = @sessions[at]
    me.rt.wip_prep = -1
    @sessions[at] = me
    if done.code != 0 {
        ro why = wip_run_why(WipRun { code: done.code, err: done.err, note: done.note })
        @tell_error(0, s.id, s.engine.step_number(), "", "дерево для работы не создано (git worktree add: ${why}): агент работает в папке проекта")
    } else {
        mut o = JsonObject.new()
        js(o, "branch", "")
        js(o, "worktree", done.path)
        js(o, "base", done.base)
        @rt_task_op(at, "wip", o)
        mut again = @sessions[at]
        again.rt.wip_at = 0
        @sessions[at] = again
        @say_log("the session ${s.id} works in the tree ${done.path}")
    }
    @route_broadcast(at, true)
    @wip_release(s.id)
}

// ----- "В работу" of the first work of a session with a wip branch -----

/// The first work of the session that has a wip tree: the branch `task/NNN-slug` is made in it, the folder of the task is written in the same tree and committed, the session becomes the session of the task.
/// false - the branch could not be made (the caller makes a session of its own as before).
fn Hub mut @wip_take(at int, p Proposal, how str, queued bool) Proc Detach Time -> bool {
    ro cur = @sessions[at]
    ro number = task_number_text(@take_task_number(cur.id))
    ro slug = child_slug("", "", p.title)
    ro folder = "${number}-${slug}"
    ro tree = cur.rt.wip_tree
    // the branch is made in this very tree on the current head: the commits made on the detached head and the changed files go with it
    ro made_branch = tk_branch_create(tree, "task/${folder}")
    if !made_branch.ok {
        @say_log("the branch task/${folder} of ${cur.id} is not made: ${made_branch.text}")
        return false
    }
    ro in_tree = dir_there("${tree}/doc/tasks")
    ro dir = if in_tree { "${tree}/doc/tasks/${folder}/task" } else { "${@settings.data_dir}/${cur.id}/tasks/${folder}/task" }
    ro shown = if in_tree { "doc/tasks/${folder}/task" } else { dir }
    mut sib = ""
    mut sib_no = 0
    if how == "wait" {
        ro sat = @cs_find_number(p.with_n)
        if sat >= 0 && sat != at {
            sib = @sessions[sat].id
            sib_no = p.with_n
        }
    }
    mut o = JsonObject.new()
    js(o, "id", folder)
    js(o, "number", number)
    js(o, "dir", dir)
    js(o, "shown", shown)
    js(o, "branch", "task/${folder}")
    js(o, "worktree", tree)
    js(o, "base", cur.rt.wip_base)
    js(o, "title", subtask_title(p.title))
    js(o, "touches", joined(p.touches, "\n"))
    ji(o, "crew", 1)
    js(o, "kind", "child")
    js(o, "origin", cur.id)
    js(o, "parent", "")
    js(o, "pkind", "")
    js(o, "pno", "")
    ji(o, "cno", 0)
    js(o, "ptree", "")
    js(o, "pbranch", "")
    js(o, "waits_sib", sib)
    ji(o, "waits_k", sib_no)
    ji(o, "queued", if queued { 1 } else { 0 })
    @rt_task_op(at, "open", o)
    ro doc = @route_doc(@sessions[at].rt.route)
    ro wrote = write_file("${dir}/message.md", child_message_text("", "", p.title, p.summary, p.source, now_millis()))
    ro made_progress = write_file("${dir}/progress.md", progress_template(1, doc.steps))
    if !wrote || !made_progress { @say_log("the files of the task ${folder} cannot be written in ${dir}") }
    mut files = []AcpImage.new()
    mut j = 0
    while j < p.images.len() {
        files.push(AcpImage { path: p.images[j], mime: "", name: if j < p.image_names.len() { p.image_names[j] } else { "image" } })
        j += 1
    }
    @route_save_images(at, files)
    // the way "Эпик": this very session is the epic from the start (the mark and the table of its children)
    if p.kind == "epic" { @cs_make_epic(at) }
    // the files of the task are a part of the work: they go into the branch at once
    if in_tree {
        ro why = tk_commit_task_files(tree, "doc/tasks/${folder}", number)
        if why.byte_len() > 0 { @say_log("the files of the task ${folder} are not committed: ${why}") }
    }
    @ct_drop(at, p.id, false)
    ro c = @sessions[at]
    @rt_note(at, "▸ работа стала ${if p.kind == "epic" { "эпиком" } else { "задачей" }} ${number}: ветка task/${folder} создана в дереве сессии")
    if sib.byte_len() > 0 || queued {
        @ct_note(at, if sib.byte_len() > 0 { "▸ «${p.title}» (задача ${number}) ждёт задачу ${p.with_n}" } else { "▸ «${p.title}» (задача ${number}) в очереди: в работе уже ${@cs_active_all()}" })
    } else {
        @ct_note(at, "▸ «${p.title}» (задача ${number}) взята в работу: ${if p.kind == "epic" { "эпик, эта сессия" } else { "эта сессия" }}")
        if !@ct_has_steps(c) { @ct_kick(at, 1, child_note(number, p.title, shown, "", "", @cs_target_text(c))) }
    }
    @route_broadcast(at, true)
    true
}

// ----- the observer -----

/// Once in a while for a session with no task: the branch of the folder of the agent, and for a wip tree the commits not in origin/main, the changed files, the days of silence.
/// true - something changed (the page is told).
fn Hub mut @wip_observe(at int) Proc Detach Time -> bool {
    mut s = @sessions[at]
    if s.rt.wip_tree.byte_len() == 0 {
        ro b = wip_head_branch(@route_repo_dir(s.id))
        if b == s.rt.where_branch { return false }
        s.rt.where_branch = b
        @sessions[at] = s
        return true
    }
    if now_millis() - s.rt.wip_at <= UNMERGED_MS { return false }
    ro count = tk_unmerged(s.rt.wip_tree)
    ro dirty = tk_tree_changes(s.rt.wip_tree).len() > 0
    mut last = s.rt.active_at
    if count > 0 {
        ro committed = tk_head_time(s.rt.wip_tree)
        if committed > last { last = committed }
    }
    if last == 0 && s.lines.len() > 0 { last = (line_field(s.lines[s.lines.len() - 1], "time").to_int() ?? 0) }
    ro days = if last > 0 { (now_millis() - last) / 86400000 } else { 0 }
    ro keep = @settings.route_keep_days
    ro stale = keep > 0 && days >= keep
    ro changed = count != s.rt.wip_unmerged || dirty != s.rt.wip_dirty || (if days < 0 { 0 } else { days }) != s.rt.wip_idle || stale != s.rt.wip_stale
    s.rt.wip_unmerged = count
    s.rt.wip_dirty = dirty
    s.rt.wip_idle = if days < 0 { 0 } else { days }
    s.rt.wip_stale = stale
    s.rt.where_branch = ""
    s.rt.wip_at = now_millis()
    @sessions[at] = s
    changed
}

// ----- the end -----

// Is there work in the wip tree that would be lost: commits not in origin/main or changed files?
fn Hub @wip_has_work(s Dialog) Proc -> bool => tk_unmerged(s.rt.wip_tree) > 0 || tk_tree_changes(s.rt.wip_tree).len() > 0

/// The owner deleted the session: the wip tree goes with it when there is nothing to lose, else only by the word `drop` (`keep` leaves it).
fn Hub mut @wip_delete(at int, branch str) Proc Detach Time -> () {
    ro s = @sessions[at]
    @route_close_agent_in(at, s.rt.wip_tree)
    ro work = @wip_has_work(s)
    if branch == "drop" || (!work && branch != "keep") {
        ro dropped = tk_tree_drop(@cwd_of(s.folder), s.rt.wip_tree, "")
        if !dropped.ok { @say_log("the tree ${s.rt.wip_tree} of ${s.id} is not removed: ${dropped.text}") }
    } else {
        @say_log("the session ${s.id} is deleted, the tree ${s.rt.wip_tree} stays")
    }
}

/// The card of a silent wip tree (30 days): the owner drops the tree and the branch (`force` - with the work in them) and the agent goes back to the folder of the project.
fn Hub mut @wip_drop(trace str, force bool) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    ro s = @sessions[at]
    if s.rt.wip_tree.byte_len() == 0 || s.rt.task_open { return }
    if s.rt.running || s.rt.job.byte_len() > 0 {
        @tell_error(0, trace, s.engine.step_number(), "", "идёт другая работа: дождитесь её конца")
        return
    }
    if !force && @wip_has_work(s) {
        @tell_error(0, trace, s.engine.step_number(), "", "в дереве есть не влитая работа: удалить её можно только явной кнопкой «Удалить вместе с работой»")
        return
    }
    @route_close_agent_in(at, s.rt.wip_tree)
    ro gone = tk_tree_drop(@cwd_of(s.folder), s.rt.wip_tree, "")
    if !gone.ok {
        @tell_error(0, trace, s.engine.step_number(), "", "дерево не удалено: ${gone.text}")
        return
    }
    mut o = JsonObject.new()
    js(o, "branch", "")
    js(o, "worktree", "")
    js(o, "base", "")
    @rt_task_op(at, "wip", o)
    @rt_note(at, "▸ отдельная копия (дерево) удалена")
    mut me = @sessions[at]
    me.rt.wip_unmerged = 0
    me.rt.wip_dirty = false
    me.rt.wip_stale = false
    me.rt.wip_idle = 0
    @sessions[at] = me
    @route_broadcast(at, true)
}
