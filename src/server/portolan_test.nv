// portolan_test.nv - the hub runs on Portolan (task 114): the machine of the sessions is the embedded `dialog.portolan.json` run by `PortolanMachine`, the idle term of the
// settings is its parameter of the project, a session in memory goes through two turns and a restart on it, the snapshot is the state of that machine.
module crew_harness.server

import std.text
import alula.engine.{Engine, MemoryWorld, Incoming, EventKind, Journal, Store, Link, StepEnvironment, start_engine, resume_engine, memory_journal, memory_store, memory_link, memory_time, decode_snapshot}
import crew_harness.chat.{user_says, user_cancels, agent_chunk, agent_done, ChatSession, ChatState, dialog_session, encode_chat_state}
import alula.machine_run.{PortolanMachine, PortolanState}

fn hm_made(ms int) -> PortolanMachine {
    match hub_machine(ms) {
        Ok(m) => m
        Err(e) => panic("the hub machine is not made: ${e}")
    }
}

fn hm_send_term(m PortolanMachine) -> int {
    mut environment = StepEnvironment.new()
    ro event = Incoming { id: "e-1", trace: "t-1", step: 2, kind: EventKind.Input, name: "user_message", request: None, input: "hi", at: 1000 }
    ro moved = m.step(m.initial(), event, environment)
    for o in environment.orders {
        match o {
            Send(order) => return order.idle_term
            _ => ()
        }
    }
    -1
}

test "hm made from the embedded table" {
    ro m = hm_made(900000)
    assert(m.name() == "DialogSession")
    assert(m.state_name(m.initial()) == "Idle")
}

test "hm idle term of the settings" {
    assert(hm_send_term(hm_made(900000)) == 900000)
    assert(hm_send_term(hm_made(2000)) == 2000)
    assert(hm_send_term(hm_made(1000)) == 1000)
    assert(hm_send_term(hm_made(3600000)) == 3600000)
}

test "hm a broken text is refused with the name of the machine" {
    match hub_machine_from("{\"format\":\"machine/2\"", 1000) {
        Ok(m) => assert(false)
        Err(e) => {
            assert(e.starts_with("the dialog machine cannot be made: "))
            assert(e.byte_len() > 40)
        }
    }
    match hub_machine_from("", 1000) {
        Ok(m) => assert(false)
        Err(e) => assert(e.starts_with("the dialog machine cannot be made: "))
    }
}

test "hm a term below zero is refused naming the parameter" {
    match hub_machine(-5) {
        Ok(m) => assert(false)
        Err(e) => {
            assert(e.starts_with("the dialog machine cannot be made: "))
            assert(e.contains("IDLE_TERM"))
        }
    }
}

// ----- an engine over the hub machine in memory -----

// ORACLE-WORKAROUND(12, 13, 26): the type arguments of `start_engine`, `resume_engine` and `decode_snapshot` are written out here and below; infer them when items 12 and 13 are fixed
fn hm_begin(m PortolanMachine, mut world MemoryWorld) -> Engine[PortolanMachine, PortolanState] {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        start_engine[PortolanState, PortolanMachine](m, "hub-1")
    }
}

fn hm_resumed(m PortolanMachine, mut world MemoryWorld) -> Option[Engine[PortolanMachine, PortolanState]] {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        resume_engine[PortolanState, PortolanMachine](m, "hub-1")
    }
}

fn hm_feed(mut e Engine[PortolanMachine, PortolanState], mut world MemoryWorld, event Incoming) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.feed(event)
    }
}

test "hm two turns and a restart in memory" {
    ro m = hm_made(30000)
    mut world = MemoryWorld.at(1000)
    mut e = hm_begin(m, world)
    hm_feed(e, world, user_says("one"))
    assert(m.state_name(e.state()) == "Awaiting")
    hm_feed(e, world, agent_chunk("agent-1", "A"))
    hm_feed(e, world, agent_done("agent-1"))
    assert(m.state_name(e.state()) == "Idle")
    assert(!e.is_finished())
    hm_feed(e, world, user_says("two"))
    assert(world.sent.len() == 2)
    assert(world.sent[1].id == "agent-2")
    assert(world.sent[1].idle_term == 30000)
    match hm_resumed(m, world) {
        Some(back) => {
            assert(m.state_name(back.state()) == "Awaiting")
            assert(back.open_ids().len() == 1)
            assert(back.open_ids()[0] == "agent-2")
            assert(m.encode_state(back.state()) == m.encode_state(e.state()))
        }
        None => assert(false)
    }
}

test "hm the snapshot is the state of the Portolan machine" {
    ro m = hm_made(30000)
    mut world = MemoryWorld.at(1000)
    mut e = hm_begin(m, world)
    hm_feed(e, world, user_says("привет"))
    match world.snapshots.get("hub-1") {
        Some(snapshot) => {
            assert(snapshot.data.contains("\"state\":\"Awaiting\""))
            assert(snapshot.data.contains("\"started\":true"))
            assert(snapshot.data.contains("\"data\":"))
            assert(snapshot.data.contains("привет"))
            match decode_snapshot[PortolanState, PortolanMachine](m, snapshot) {
                Some(es) => assert(es.state.name == "Awaiting")
                None => assert(false)
            }
        }
        None => assert(false)
    }
}

test "hm a snapshot of the machine on Nova is not a state of the hub machine" {
    // sessions of the old form are not migrated (there are none in a product base): the hub says it cannot resume them
    ro m = hm_made(30000)
    // ORACLE-WORKAROUND(36): two states are encoded one by one, not in `for state in [a(), b()]` (an array literal of calls in a `for` does not compile); loop when item 36 is fixed
    ro idle_text = encode_chat_state(dialog_session(30000).initial())
    assert(m.decode_state(idle_text) == None)
    ro waiting_text = encode_chat_state(user_says_state())
    assert(m.decode_state(waiting_text) == None)
    assert(m.decode_state("{\"state\":\"Idle\"}") == None)
    assert(m.decode_state("{\"state\":\"Awaiting\",\"user\":\"a\",\"reply\":\"b\"}") == None)
}

fn user_says_state() -> ChatState {
    mut environment = StepEnvironment.new()
    ro event = Incoming { id: "e-1", trace: "t-1", step: 2, kind: EventKind.Input, name: "user_message", request: None, input: "hi", at: 1000 }
    match dialog_session(30000).step(dialog_session(30000).initial(), event, environment) {
        Go(s) => s
        Stay => panic("the machine did not move")
    }
}
