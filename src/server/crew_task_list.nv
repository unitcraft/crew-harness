// crew_task_list.nv - task 192.2: the recognition of the tasks by the button "Распознать задачи" (the main way); the pure part.
//
// The owner talks with the agent, then presses the button. The hub asks the agent (a hidden note) to look through the talk and list the real works that were discussed and are not in the tasks yet:
// the agent calls `crew_task_list`. The list becomes one card in the feed: a table of the candidates, a switch "В работу / Обсудить / Забыть" and the way ("Способ") in each row and one button "Применить"
// (task 192.5; the quick text answer is gone). This file: the tool, the arguments, the text of the request to the agent.
module crew_harness.server

import std.encoding.json.{Json, JsonValue, JsonObject}

/// The name of the tool.
export const CREW_TASK_LIST_TOOL = "crew_task_list"

/// The description of the tool for `tools/list`.
export fn crew_task_list_tool_json() -> JsonValue {
    ro text = "{\"name\":\"crew_task_list\",\"description\":\"Call it ONLY when the hub asked you to recognise the tasks (a note that starts with [crew] Распознай задачи). Give the list of the real works on the files of the project (code, documents, tests, settings) that were discussed in this conversation and are not in the tasks of the session yet. A question, a talk or an explanation is not a work. One item for one work; by default a work is a task of its own (kind=new); if it adds to a task in work, kind=extend and its number in extends; if it is explicitly a child task of an epic (any open task of the list may be an epic), kind=child and the number of the epic in epic; a big work that will have child tasks - kind=epic. An empty list is allowed: nothing was found.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"tasks\":{\"type\":\"array\",\"description\":\"The recognised works.\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\",\"description\":\"The number in this list, from 1.\"},\"kind\":{\"type\":\"string\",\"enum\":[\"new\",\"child\",\"epic\",\"extend\"],\"description\":\"new (the default) - a task of its own; child - a child task of the epic in epic; epic - a big work with child tasks; extend - adds to the task in extends.\"},\"epic\":{\"type\":\"integer\",\"description\":\"For kind=child: the number of the epic.\"},\"title\":{\"type\":\"string\",\"description\":\"A short title (up to 60 characters).\"},\"summary\":{\"type\":\"string\",\"description\":\"What is to be done, in a few lines: it becomes the text of message.md of the task.\"},\"extends\":{\"type\":\"integer\",\"description\":\"For kind=extend: the number of the task.\"},\"touches\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"The files and folders the work will change.\"},\"note\":{\"type\":\"string\",\"description\":\"One line: why it is a work, or what is still unclear.\"}},\"required\":[\"title\",\"summary\"]}}},\"required\":[\"tasks\"]}}"
    mparse(text)
}

/// The proposals of the arguments of a call of `crew_task_list`, or the reason they are not good. An item that is not good is a reason for the whole call (the agent reads it and calls again).
export fn proposals_of_list(arguments JsonValue) -> Result[[]Proposal, str] {
    mut out = []Proposal.new()
    match mget(arguments, "tasks") {
        Some(list) => match list.array() {
            Some(items) => {
                if items.len() > 20 { return Err("crew_task_list: at most 20 tasks at once") }
                for item in items {
                    match proposal_of_arguments(item) {
                        Ok(p) => {
                            out.push(proposal_listed(p, mtext_of(item, "note")))
                        }
                        Err(reason) => return Err(reason.replace("crew_task:", "crew_task_list: an item:"))
                    }
                }
            }
            None => return Err("crew_task_list: the argument tasks must be a list")
        }
        None => return Err("crew_task_list: the argument tasks is missing")
    }
    Ok(out)
}

/// The list in the form it travels from the MCP server to the hub: a JSON array of the arguments of the items.
export fn proposals_list_text(items []Proposal) -> str {
    mut out = []JsonValue.new()
    for p in items {
        ro v = match Json.parse(proposal_arguments_text(p)) {
            Ok(x) => x
            Err(e) => JsonValue.null()
        }
        mut o = v.object() ?? JsonObject.new()
        mput(o, "note", JsonValue.str(p.note))
        out.push(JsonValue.object(o))
    }
    mut wrap = JsonObject.new()
    mput(wrap, "tasks", JsonValue.array(out))
    JsonValue.object(wrap).to_str()
}

/// The list from its text (the hub side).
export fn proposals_of_list_text(text str) -> Result[[]Proposal, str] {
    match Json.parse(text) {
        Ok(v) => proposals_of_list(v)
        Err(e) => Err("crew_task_list: the arguments are not JSON")
    }
}

/// The marker line of an agent that has no tools: `[[crew_task_list]] {"tasks":[...]}`.
export fn proposals_of_marker(answer str) -> Option[[]Proposal] {
    for line in answer.lines() {
        ro t = line.trim_ascii()
        if t.starts_with("[[crew_task_list]]") {
            match proposals_of_list_text(t["[[crew_task_list]]".byte_len()..].trim_ascii()) {
                Ok(items) => return Some(items)
                Err(e) => ()
            }
        }
    }
    None
}

/// The hidden note with which the hub asks the agent to recognise the tasks. `candidates` are the lines of the works that are being discussed already (not to be repeated), `known` the tasks of the session.
export fn recognize_request(known str, candidates []str) -> str {
    mut parts = []str.new()
    parts.push("[crew] Распознай задачи. Просмотри весь этот разговор и перечисли реальные работы над файлами проекта (код, документы, тесты, настройки), которые обсуждались и ещё не оформлены задачами. Вызови инструмент crew_task_list (сервер crew) один раз со списком: у каждой работы title, summary (что сделать, для message.md), touches (файлы и папки), note (одна строка). Вопросы, беседа и объяснения — не работы. По умолчанию работа — самостоятельная задача (kind=new). Если она дополняет задачу в работе — kind=extend и её номер в extends; если явно дочерняя задача какой-то открытой задачи (любая открытая задача может быть эпиком) — kind=child и epic=<номер>; если работа большая и сама разобьётся на дочерние задачи — kind=epic. Файлы проекта не меняй. Если инструмента нет, напиши в конце ответа одну строку [[crew_task_list]] {\"tasks\":[...]} с теми же полями.")
    if known.byte_len() > 0 { parts.push(known) }
    if candidates.len() > 0 { parts.push("[crew] Эти работы уже в списке кандидатов (не повторяй их):\n${joined(candidates, "\n")}") }
    joined(parts, "\n\n")
}
