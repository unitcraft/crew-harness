// front.nv - the front of the session server on Polaris (task 099): the files of the page, `/ws`, and the hub as a child process.
//
// The hub (engines, agents, the store) is a program of its own, `crew-hub` (src/crew_hub.nv); the front starts it with pipes and passes
// the page through, line by line (the lines are described in src/server/stdio.nv):
//   page --WebSocket--> conn fiber --"msg <conn> <text>"--> stdin of the hub
//   page <--WebSocket-- conn writer <--channel-- router fiber <--"<conn> <text>"-- stdout of the hub
// A WebSocket is read in one fiber and written in another, over two owners of the socket (`TcpStream.share`): the
// `WebSocket` type of Polaris is one value for both and cannot be shared by a fiber that waits for a frame and a fiber that
// has something to say. The framing is the codec of Polaris (`polaris.ws.Frame`); the handshake is its own too (`accept_response`),
// only the live socket is taken by `ServerResponse.upgrade` before Polaris wraps it.
//
// One fiber, the router, owns the list of the pages (a page = a number, its peer port, and the channel to its writer); the conn
// fibers register with it through a channel. Nothing is shared.
// ORACLE-WORKAROUND(30): the front is a program of its own (and the hub another, `src/crew_hub.nv`), because the PostgreSQL driver and Polaris cannot be in one program; one program would do when item 30 is fixed
// ORACLE-WORKAROUND(25): the module is declared `module server.front` (without the package prefix) and imported as `crew_harness.server.front`: a module two folders under the source root cannot be declared with the full path; declare it with the prefix when item 25 is fixed
module server.front

import crew_harness.acp.{AgentLink, connect}
import polaris.{Router, MethodRouter, ServerRequest, ServerResponse, WebSocketUpgrade, StatusCode, HttpError}
import polaris.static.{Static, serve_path}
import polaris.ws.{Frame, OpCode, frame_len_hint}
import polaris.net.{ServerPolicy}
import polaris.serve.{serve_addr}
import std.encoding.json.{JsonValue, JsonObject}
import std.concurrency.nvchan.{Chan, ChanTx, ChanRx}
import std.fs.{DirFs, Path, Fs, real_fs}
import std.io.{stderr}
import std.net.{TcpStream, real_net}
import std.os.{exit_process}

// What the router tells a writer: 1 - a text, 2 - a pong, 3 - close.
type WsOut { kind int, text str }

// A page that comes to the router (or goes: `gone`): its number and the channel to its writer.
type Reg { id int, out ChanTx[WsOut], gone bool }

type Peer { id int, out ChanTx[WsOut] }

fn ws_out(kind int, text str) -> WsOut => { kind, text }

fn log_line(text str) Io -> () {
    mut err = stderr()
    ro written = err.write("${text}\n".bytes())
}

// ----- the pages: one fiber reads, one writes -----

// Write the whole of `data`; false - the socket does not take it.
fn write_whole(mut wr TcpStream, data []u8) Net -> bool {
    match wr.write_all(data) {
        Ok(done) => true
        Err(e) => false
    }
}

fn frame_bytes(op OpCode, payload []u8) -> []u8 => Frame.new(true, op, payload).encode(false)

fn write_pump(consume wr TcpStream, source ChanRx[WsOut]) Net -> () {
    mut writing = true
    while writing {
        match source.recv() {
            Some(item) => {
                if item.kind == 1 {
                    if !write_whole(wr, frame_bytes(OpCode.Text, item.text.bytes())) { writing = false }
                } else if item.kind == 2 {
                    if !write_whole(wr, frame_bytes(OpCode.Pong, []u8.new())) { writing = false }
                } else {
                    ro sent = write_whole(wr, frame_bytes(OpCode.Close, []u8.new()))
                    writing = false
                }
            }
            None => { writing = false }
        }
    }
    wr.close()
}

// A text of the page goes to the hub as one line; a text with a line break cannot (it is not what the page sends).
fn pass_on(id int, bytes []u8, hub_tx ChanTx[str]) -> () {
    match bytes.to_str() {
        Ok(text) => {
            if !text.contains("\n") && !text.contains("\r") {
                ro sent = hub_tx.send("msg\t${id}\t${text}")
            }
        }
        Err(e) => ()
    }
}

fn read_pump(consume rd TcpStream, id int, hub_tx ChanTx[str], out ChanTx[WsOut]) Net -> () {
    mut buf []u8 = []u8.new()
    mut chunk []u8 = []u8.new()
    chunk.resize(65536, 0 as u8)
    mut message []u8 = []u8.new()
    mut is_text = false
    mut running = true
    while running {
        if frame_len_hint(buf).is_some() {
            match rd.read(chunk) {
                Ok(0) => {
                    running = false
                }
                Ok(n) => { buf.append(chunk[..n]) }
                Err(e) => {
                    running = false
                }
            }
            if buf.len() > 16777216 { running = false }
        } else {
            match Frame.decode(buf) {
                Err(e) => {
                    running = false
                }
                Ok((frame, used)) => {
                    ro rest []u8 = buf[used..buf.len()]
                    buf = rest
                    match frame.opcode() {
                        OpCode.Ping => { ro sent = out.send(ws_out(2, "")) }
                        OpCode.Pong => ()
                        OpCode.Close => {
                            ro sent = out.send(ws_out(3, ""))
                            running = false
                        }
                        OpCode.Text => {
                            message = frame.payload()
                            is_text = true
                            if frame.fin() {
                                pass_on(id, message, hub_tx)
                                message = []u8.new()
                            }
                        }
                        OpCode.Binary => {
                            message = []u8.new()
                            is_text = false
                        }
                        OpCode.Continuation => {
                            message.append(frame.payload())
                            if frame.fin() {
                                if is_text { pass_on(id, message, hub_tx) }
                                message = []u8.new()
                            }
                            if message.len() > 16777216 { running = false }
                        }
                    }
                }
            }
        }
    }
    rd.close()
}

fn serve_page(stream TcpStream, hub_tx ChanTx[str], reg_tx ChanTx[Reg]) Net -> () {
    consume conn = stream
    ro id = conn.peer_port()
    // ORACLE-WORKAROUND(56): the stream of the hook has a copy held by the server loop, so it cannot be split into halves (`into_split()` panics): the writer gets a second owner of the same socket (`share`), the socket is closed by the last one; split the stream when item 56 is fixed
    consume wr = conn.share()
    ro outbound = Chan[WsOut].new(4096)
    ro registered = reg_tx.send(Reg { id, out: outbound.tx, gone: false })
    ro opened = hub_tx.send("open\t${id}")
    supervised {
        spawn consume wr { write_pump(wr, outbound.rx) }
        read_pump(conn, id, hub_tx, outbound.tx)
        // the page is gone: the writer ends when its channel is closed
        outbound.tx.close()
    }
    ro left = reg_tx.send(Reg { id, out: outbound.tx, gone: true })
    ro closed = hub_tx.send("close\t${id}")
}

// ----- the router fiber: the lines of the hub to the pages -----

fn peer_of(id int, out ChanTx[WsOut]) -> Peer => { id, out }

// Tell a page; false - it cannot be told now (its channel is closed or full): it is skipped, it is dropped when it says it is gone.
fn tell(p Peer, text str) -> bool => p.out.try_send(ws_out(1, text))

fn route_line(peers []Peer, line str) Io -> () {
    ro at = match line.find("	") {
        Some(a) => a
        None => return
    }
    ro head = line[..at]
    ro text = line[at + 1..]
    ro conn = match head.to_int() {
        Ok(n) => n
        Err(e) => return
    }
    for p in peers {
        if conn == 0 || conn == p.id {
            if !tell(p, text) { log_line("page ${p.id} cannot be told now") }
        }
    }
}

fn route_loop(link AgentLink, reg_rx ChanRx[Reg]) Io Time Os -> () {
    mut peers = []Peer.new()
    mut running = true
    while running {
        mut busy = false
        mut more = true
        while more {
            match reg_rx.try_recv() {
                Some(r) => {
                    busy = true
                    mut kept = []Peer.new()
                    for p in peers {
                        // a page that comes with the number of a page that went takes the old one out; a page that says it is gone takes out itself
                        // (the number is the peer port of the socket: a port is not used again while the old socket is still closing)
                        if p.id != r.id { kept.push(p) }
                    }
                    if !r.gone { kept.push(peer_of(r.id, r.out)) }
                    peers = kept
                }
                None => { more = false }
            }
        }
        more = true
        while more {
            match link.inb.try_recv() {
                Some(item) => {
                    busy = true
                    if item.kind == "line" {
                        if item.text != "ready" { route_line(peers, item.text) }
                    } else if item.kind == "stderr" {
                        log_line("hub: ${item.text}")
                    } else if item.kind == "exit" {
                        log_line("the hub ended (code ${item.code}): the server ends")
                        exit_process(1)
                    }
                }
                None => { more = false }
            }
        }
        if !busy { 3.to_millis().sleep() }
    }
}

// ----- HTTP -----

const CSP = "default-src 'self'; img-src 'self' blob:; connect-src 'self' ws://localhost:* ws://127.0.0.1:*"

fn with_headers(mut resp ServerResponse) -> ServerResponse {
    resp.header("Content-Security-Policy", CSP)
    resp.header("Cache-Control", "no-store")
    resp
}

// A browser lets ANY page open a WebSocket to 127.0.0.1; the sessions are the owner's, with an agent that works on his files, so a request
// whose `Origin` is not this server is refused (a client that is not a browser, as the tests, sends no `Origin`).
fn origin_allowed(req ServerRequest, port int) -> bool {
    match req.header("Origin") {
        None => true
        Some(origin) => origin == "http://127.0.0.1:${port}" || origin == "http://localhost:${port}"
    }
}

fn ws_route(hub_tx ChanTx[str], reg_tx ChanTx[Reg], port int) -> fn(ServerRequest) -> ServerResponse {
    fn(req ServerRequest) -> ServerResponse {
        if !origin_allowed(req, port) {
            return ServerResponse.text(403, "origin not allowed")
        }
        match WebSocketUpgrade.from_request(req) {
            Ok(up) => {
                mut resp = up.accept_response(None)
                resp.upgrade(fn(stream TcpStream) Net -> () {
                    with Net = real_net() { serve_page(stream, hub_tx, reg_tx) }
                })
                resp
            }
            Err(e) => e.into_response()
        }
    }
}

fn files_route(web_dir str) -> fn(ServerRequest) -> ServerResponse {
    ro files = DirFs.new(Path.from_bytes(web_dir.bytes()))
    fn(req ServerRequest) -> ServerResponse {
        ro wanted = req.param("path") ?? ""
        mut resp = serve_path(files, Static.new(), wanted, req)
        // a status of 500 or more is told to stderr, so that a 503 of the page is traced to its source (task 192)
        if resp.status_code() >= 500 { log_line("front: ${resp.status_code()} GET ${req.path()}") }
        with_headers(resp)
    }
}

fn agents_json(agents []AgentChoice) -> str {
    mut rows = []JsonValue.new()
    for agent in agents {
        mut choice = JsonObject.new()
        ro id_set = choice.insert("id", JsonValue.str(agent.id))
        ro label_set = choice.insert("label", JsonValue.str(agent.label))
        rows.push(JsonValue.object(choice))
    }
    mut result = JsonObject.new()
    ro list_set = result.insert("agents", JsonValue.array(rows))
    JsonValue.object(result).to_str()
}

fn agents_route(agents []AgentChoice) -> fn(ServerRequest) -> ServerResponse {
    fn(req ServerRequest) -> ServerResponse {
        mut resp = ServerResponse.text(StatusCode.OK, agents_json(agents))
        resp.header("Content-Type", "application/json; charset=utf-8")
        with_headers(resp)
    }
}

// ----- the voice: POST /api/stt and GET /api/stt/status (task 192f) -----

// A line that cannot be in a WAV file by chance, so the audio never closes the form early.
const STT_BOUNDARY = "----crew-harness-stt-6b1f0d9a47c2e853"

fn json_reply(status int, text str) -> ServerResponse {
    mut resp = ServerResponse.text(status, text)
    resp.header("Content-Type", "application/json; charset=utf-8")
    with_headers(resp)
}

fn stt_failure(status int, reason str) -> ServerResponse => json_reply(status, stt_error_json(reason))

// The audio of the body to the recognizer, the text of the answer to the page. 400 - not an audio we take, 413 - too big, 503 - the recognizer is not there,
// 502 - it is there and did not give a text.
fn stt_recognize(target SttTarget, audio []u8, language str) -> ServerResponse {
    if audio.len() == 0 { return stt_failure(400, "the body is empty: send a WAV file") }
    if audio.len() > STT_MAX_AUDIO { return stt_failure(413, "the audio is too long") }
    if !stt_is_wav(audio) { return stt_failure(400, "the body must be a WAV file (16 kHz, mono, 16 bit)") }
    if !stt_language_ok(language) { return stt_failure(400, "the language must be 2 to 8 letters, as ru, en or auto") }
    ro exchanged = with Net = real_net() { stt_exchange(target, stt_request(target, STT_BOUNDARY, audio, language)) }
    match exchanged {
        Err(reason) => stt_failure(503, reason)
        Ok(raw) => match stt_parse_reply(raw) {
            Err(reason) => stt_failure(502, reason)
            Ok(reply) => {
                if reply.status != 200 { return stt_failure(502, "the recognizer answered with the status ${reply.status}") }
                match stt_text_of(reply.body) {
                    Err(reason) => stt_failure(502, reason)
                    Ok(text) => json_reply(200, stt_text_json(text))
                }
            }
        }
    }
}

fn stt_route(url str, default_language str, port int) -> fn(ServerRequest) -> ServerResponse {
    fn(req ServerRequest) -> ServerResponse {
        if !origin_allowed(req, port) { return stt_failure(403, "origin not allowed") }
        match stt_target(url) {
            Err(reason) => stt_failure(503, reason)
            Ok(target) => {
                ro asked = req.query_param("lang") ?? ""
                ro language = if asked.byte_len() > 0 { asked } else { default_language }
                stt_recognize(target, req.body_bytes(), language)
            }
        }
    }
}

// Does the recognizer answer `GET /` with 200? (Only the bytes of the status line are looked at: this runs in the prober fiber.)
fn stt_alive(url str) Net -> bool {
    match stt_target(url) {
        Err(reason) => false
        Ok(target) => match stt_exchange(target, stt_probe_request(target)) {
            Err(reason) => false
            Ok(raw) => stt_status_is_200(raw)
        }
    }
}

// A question to the prober: where to put the answer (Oracle 0.1.0 does not compile a channel of channel ends, so the end is in a record).
type SttAsk { reply ChanTx[bool] }

// The prober is a fiber of its own (`run_front` starts it): it takes the channel of an answer, probes the recognizer and tells the answer.
// A refused connection takes about two seconds on Windows, so the route waits for the answer up to one second and says "not available" after it.
fn stt_prober(url str, asks ChanRx[SttAsk]) Net -> () {
    mut running = true
    while running {
        match asks.recv() {
            Some(ask) => {
                ro alive = stt_alive(url)
                ro sent = ask.reply.send(alive)
            }
            None => { running = false }
        }
    }
}

// The state word of the manager (see sttproc.nv); the manager that is busy and does not answer within a second is "starting".
fn stt_manager_state(mgr_asks ChanTx[SttMgrAsk]) -> str {
    ro answer = Chan[str].new(1)
    mut state = "starting"
    mut waiting = mgr_asks.try_send(SttMgrAsk { reply: answer.tx })
    mut waited = 0
    while waiting {
        match answer.rx.try_recv() {
            Some(a) => {
                state = a
                waiting = false
            }
            None => {
                if waited >= 1000 {
                    waiting = false
                } else {
                    5.to_millis().sleep()
                    waited += 5
                }
            }
        }
    }
    state
}

fn stt_probed(asks ChanTx[SttAsk]) -> bool {
    ro answer = Chan[bool].new(1)
    mut alive = false
    mut waiting = asks.try_send(SttAsk { reply: answer.tx })
    mut waited = 0
    while waiting {
        match answer.rx.try_recv() {
            Some(a) => {
                alive = a
                waiting = false
            }
            None => {
                if waited >= 1000 {
                    waiting = false
                } else {
                    5.to_millis().sleep()
                    waited += 5
                }
            }
        }
    }
    alive
}

// `GET /api/stt/status`: our own recognizer says its state; a foreign one (or an unmanaged one) is probed at its address.
fn stt_status_route(mgr_asks ChanTx[SttMgrAsk], asks ChanTx[SttAsk], model str) -> fn(ServerRequest) -> ServerResponse {
    fn(req ServerRequest) -> ServerResponse {
        ro state = stt_manager_state(mgr_asks)
        ro shown = if state == "probe" { if stt_probed(asks) { "ready" } else { "not_running" } } else { state }
        json_reply(200, stt_state_json(shown, model))
    }
}

// ----- the pictures of the messages: POST /api/session-image/<session> and GET /api/session-image/<session>/<n> (task 192) -----

fn image_reply(r ImageReply) -> ServerResponse {
    mut resp = ServerResponse.bytes(r.status, r.mime, r.body)
    resp.header("X-Content-Type-Options", "nosniff")
    with_headers(resp)
}

fn image_put_route(data_dir str, limit int, port int) -> fn(ServerRequest) -> ServerResponse {
    fn(req ServerRequest) -> ServerResponse {
        if !origin_allowed(req, port) { return json_reply(403, "{\"error\":\"origin not allowed\"}") }
        ro session = req.param("id") ?? ""
        ro content_type = req.header("Content-Type") ?? ""
        image_reply(img_put(data_dir, session, content_type, req.body_bytes(), limit))
    }
}

fn image_get_route(data_dir str) -> fn(ServerRequest) -> ServerResponse {
    fn(req ServerRequest) -> ServerResponse {
        ro session = req.param("id") ?? ""
        ro number = req.param("n") ?? ""
        image_reply(img_get(data_dir, session, number))
    }
}

fn build_router(web_dir str, port int, hub_tx ChanTx[str], reg_tx ChanTx[Reg], agents []AgentChoice, stt_url str, stt_language str, stt_model str, stt_asks ChanTx[SttAsk], stt_mgr ChanTx[SttMgrAsk], data_dir str, image_limit int) -> Result[Router, HttpError] {
    mut router = Router.new()
    ro r1 = router.get("/", files_route(web_dir))?
    ro r2 = router.get("/health", fn(req ServerRequest) -> ServerResponse => ServerResponse.text(StatusCode.OK, "ok"))?
    ro r3 = router.get("/ws", ws_route(hub_tx, reg_tx, port))?
    ro r4 = router.get("/api/agents", agents_route(agents))?
    ro r4a = router.post("/api/stt", stt_route(stt_url, stt_language, port))?
    ro r4b = router.get("/api/stt/status", stt_status_route(stt_mgr, stt_asks, stt_model))?
    ro r4c = router.post("/api/session-image/{id}", image_put_route(data_dir, image_limit, port))?
    ro r4d = router.get("/api/session-image/{id}/{n}", image_get_route(data_dir))?
    // the projects of the control panel and the choice of a folder (task 192m)
    mut all_projects = MethodRouter.new()
    all_projects.get(projects_list_route(data_dir, port))
    all_projects.post(projects_post_route(data_dir, port))
    ro r4m = router.route("/api/projects", all_projects)?
    mut one_project = MethodRouter.new()
    one_project.get(projects_get_route(data_dir, port))
    one_project.put(projects_put_route(data_dir, port))
    one_project.delete(projects_delete_route(data_dir, port))
    ro r4n = router.route("/api/projects/{id}", one_project)?
    ro r4h = router.get("/api/fs/list", fs_list_route(data_dir, port))?
    ro r4i = router.get("/api/fs/git", fs_git_route(port))?
    ro r5 = router.get("/{*path}", files_route(web_dir))?
    Ok(router)
}

/// Start the hub, then serve the page and `/ws` on 127.0.0.1 at the port of the settings; returns only if the server ends.
/// `config_file` is passed to the hub as its settings file ("" - it reads the environment alone).
export fn run_front(settings FrontSettings, config_file str) Proc Net Time Detach Io Os Fs -> () {
    mut hub_args = []str.new()
    for a in settings.hub_args { hub_args.push(a) }
    if config_file.byte_len() > 0 { hub_args.push(config_file) }
    match connect(settings.hub_program, hub_args, "") {
        Err(reason) => {
            log_line("the hub cannot be started: ${reason}")
            exit_process(2)
        }
        Ok(link) => {
            ro registrations = Chan[Reg].new(256)
            detach { route_loop(link, registrations.rx) }
            ro stt_asks = Chan[SttAsk].new(16)
            detach { with Net = real_net() { stt_prober(settings.stt_url, stt_asks.rx) } }
            // the recognizer is a part of the panel (task 192l): started here, ended with the front (sttproc.nv)
            ro stt_mgr = Chan[SttMgrAsk].new(16)
            ro stt_cfg = SttConfig { managed: settings.stt_managed, dir: settings.stt_dir, model: settings.stt_model, language: settings.stt_language, url: settings.stt_url, pid_file: "${settings.data_dir}/stt.pid" }
            detach { with Net = real_net(), Fs = real_fs() { stt_manage(stt_cfg, stt_mgr.rx) } }
            match build_router(settings.web_dir, settings.port, link.out, registrations.tx, settings.agents, settings.stt_url, settings.stt_language, settings.stt_model, stt_asks.tx, stt_mgr.tx, settings.data_dir, settings.max_image_bytes) {
                Err(e) => {
                    log_line("the routes cannot be set: ${e}")
                    exit_process(2)
                }
                Ok(router) => {
                    log_line("listening on http://127.0.0.1:${settings.port}/ - Ctrl+C to stop (hub: ${settings.hub_program}, page: ${settings.web_dir})")
                    // the voice is a WAV in the body of a request: up to 25 MiB, read for up to 30 s (the default is 1 MiB and 5 s)
                    // a picture is a body too: the larger of the two limits
                    mut policy = ServerPolicy.new()
                    policy.max_body_bytes(if settings.max_image_bytes > STT_MAX_AUDIO { settings.max_image_bytes } else { STT_MAX_AUDIO })
                    policy.read_deadline(30.to_seconds())
                    match serve_addr("127.0.0.1:${settings.port}", router, policy) {
                        Ok(done) => ()
                        Err(e) => {
                            log_line("the server cannot listen on port ${settings.port}: ${e}")
                            exit_process(2)
                        }
                    }
                }
            }
        }
    }
}
