// front_settings.nv - the part of the settings that the front needs: the port, the folder of the page, the command of the hub.
//
// The front reads only these; the hub reads and checks all the settings (the same file, the same environment) and says so on its
// stderr when they are wrong. The front cannot use `crew_harness.server.ServerSettings`: that module holds the hub, which holds the
// PostgreSQL driver (see the mark 30 below).
// The keys and the variables are those of src/server/settings.nv: port / CREW_SERVER_PORT, web_dir / CREW_SERVER_WEB_DIR,
// hub {program, args} / CREW_SERVER_HUB, stt {url, language} / CREW_SERVER_STT_URL, CREW_SERVER_STT_LANGUAGE, the file by the argument or CREW_SERVER_CONFIG;
// the recognizer as a part of the panel (task 192l): stt {managed, dir, model} / CREW_SERVER_STT_MANAGED, CREW_SERVER_STT_DIR, CREW_SERVER_STT_MODEL, data_dir / CREW_SERVER_DATA_DIR (the pid file).
// pictures (task 192): max_image_bytes / CREW_SERVER_MAX_IMAGE_BYTES (`/api/session-image`).
// ORACLE-WORKAROUND(30): the front reads its own part of the settings, because the module of the settings holds the hub, which holds the PostgreSQL driver, and the driver and Polaris cannot be in one program; use `ServerSettings` when item 30 is fixed
// ORACLE-WORKAROUND(25): the module is declared `module server.front` (without the package prefix) and imported as `crew_harness.server.front`: a module two folders under the source root cannot be declared with the full path; declare it with the prefix when item 25 is fixed
module server.front

import std.text
import std.encoding.json.{Json, JsonValue, JsonObject}
import std.fs.{Fs, read_text, Path}
import std.os.{Os, env}
import crew_harness.config.{ConfigLayout, legacy_layout, layout_in, layout_with_data_dir, crew_home, work_dir_now, find_project_dir, file_layers, env_layer, arg_layer, merge_layers, normalize_layer, file_text, tools_dir_now}

/// FrontSettings: where to listen, where the page is, how to start the hub, where the recognizer of the voice listens (`stt_url`, a local http address) and its default language.
export type AgentChoice { id str, label str }
/// The recognizer is a part of the control panel (task 192l): `stt_managed` - the front starts and ends it itself, `stt_dir` - the folder of the tool (bin/, models/),
/// `stt_model` - the model (models/ggml-<model>.bin), `data_dir` - where the pid file `stt.pid` is written.
export type FrontSettings { port int, web_dir str, hub_program str, hub_args []str, agents []AgentChoice, stt_url str, stt_language str, stt_managed bool, stt_dir str, stt_model str, data_dir str, max_image_bytes int, layout ConfigLayout, preset str, reviewer_order []str }

fn fs_env(key str) Os -> Option[str] {
    match env(key) {
        Some(v) => if v.byte_len() > 0 { Some(v) } else { None }
        None => None
    }
}

fn fs_words(text str) -> []str {
    mut out = []str.new()
    for part in text.split(" ") {
        if part.byte_len() > 0 { out.push(part) }
    }
    out
}

fn fs_rest(words []str) -> []str {
    mut rest = []str.new()
    mut i = 1
    while i < words.len() {
        rest.push(words[i])
        i += 1
    }
    rest
}

fn fs_strings(v JsonValue) -> []str {
    mut out = []str.new()
    match v.array() {
        Some(items) => {
            for item in items {
                match item.str() {
                    Some(s) => out.push(s)
                    None => ()
                }
            }
        }
        None => ()
    }
    out
}

fn fs_default_agents() -> []AgentChoice => [AgentChoice { id: "opencode", label: "OpenCode" }]
fn fs_agents(base []AgentChoice) Os -> []AgentChoice {
    match fs_env("CREW_SERVER_AGENT") {
        Some(_) => [AgentChoice { id: "opencode", label: "OpenCode" }]
        None => base
    }
}
fn fs_defaults() -> FrontSettings => { port: 8099, web_dir: "src/web", hub_program: "target/crew-hub.exe", hub_args: []str.new(), agents: fs_default_agents(), stt_url: "http://127.0.0.1:8178/inference", stt_language: "auto", stt_managed: true, stt_dir: "", stt_model: "small", data_dir: "crew-data", max_image_bytes: 10485760, layout: legacy_layout("crew-data"), preset: "default", reviewer_order: ["codex", "claude", "kimi", "opencode"] }

// The voice never leaves this machine: a recognizer address that is not a local http one is the default (the hub says what is wrong).
fn fs_stt_url(url str, fallback str) -> str {
    if url.starts_with("http://127.0.0.1:") || url.starts_with("http://localhost:") { url } else { fallback }
}

// The limit of a picture: a value out of 1 KB to 100 MB is the fallback (the hub says what is wrong).
fn fs_image_limit(n int, fallback int) -> int {
    if n < 1024 || n > 104857600 { fallback } else { n }
}

// The settings of a file (the keys that are there; a wrong value is the default - the hub says what is wrong).
fn fs_from_file(text str) -> FrontSettings {
    ro base = fs_defaults()
    ro value = match Json.parse(text) {
        Ok(v) => v
        Err(e) => return base
    }
    ro o = match value.object() {
        Some(x) => x
        None => return base
    }
    ro port = match o.get("port") {
        Some(v) => v.int() ?? base.port
        None => base.port
    }
    ro web_dir = match o.get("web_dir") {
        Some(v) => v.str() ?? base.web_dir
        None => base.web_dir
    }
    ro hub = match o.get("hub") {
        Some(h) => h.object()
        None => None
    }
    ro hub_program = match hub {
        Some(ho) => match ho.get("program") {
            Some(p) => p.str() ?? base.hub_program
            None => base.hub_program
        }
        None => base.hub_program
    }
    ro hub_args = match hub {
        Some(ho) => match ho.get("args") {
            Some(a) => fs_strings(a)
            None => base.hub_args
        }
        None => base.hub_args
    }
    ro agents = match o.get("agents") {
        Some(v) => match v.array() {
            Some(items) => {
                mut choices = []AgentChoice.new()
                for item in items {
                    match item.object() {
                        Some(agent) => {
                            ro id = match agent.get("id") { Some(x) => x.str() ?? "", None => "" }
                            ro label = match agent.get("label") { Some(x) => x.str() ?? id, None => id }
                            if id.byte_len() > 0 { choices.push(AgentChoice { id, label }) }
                        }
                        None => ()
                    }
                }
                if choices.len() > 0 { choices } else { base.agents }
            }
            None => base.agents
        }
        None => base.agents
    }
    ro voice_o = normalize_layer(o)
    ro stt = match voice_o.get("voice") {
        Some(t) => t.object()
        None => None
    }
    ro stt_url = match stt {
        Some(to) => match to.get("url") {
            Some(u) => fs_stt_url(u.str() ?? base.stt_url, base.stt_url)
            None => base.stt_url
        }
        None => base.stt_url
    }
    ro stt_language = match stt {
        Some(to) => match to.get("language") {
            Some(l) => match l.str() {
                Some(text) => if text.byte_len() > 0 { text } else { base.stt_language }
                None => base.stt_language
            }
            None => base.stt_language
        }
        None => base.stt_language
    }
    ro stt_managed = match stt {
        Some(to) => match to.get("managed") {
            Some(m) => m.bool() ?? base.stt_managed
            None => base.stt_managed
        }
        None => base.stt_managed
    }
    ro stt_dir = match stt {
        Some(to) => match to.get("dir") {
            Some(d) => d.str() ?? base.stt_dir
            None => base.stt_dir
        }
        None => base.stt_dir
    }
    ro stt_model = match stt {
        Some(to) => match to.get("model") {
            Some(m) => match m.str() {
                Some(text) => if stt_model_ok(text) { text } else { base.stt_model }
                None => base.stt_model
            }
            None => base.stt_model
        }
        None => base.stt_model
    }
    ro data_dir = match o.get("data_dir") {
        Some(v) => match v.str() {
            Some(text) => if text.byte_len() > 0 { text } else { base.data_dir }
            None => base.data_dir
        }
        None => base.data_dir
    }
    ro max_image_bytes = match o.get("max_image_bytes") {
        Some(v) => fs_image_limit(v.int() ?? base.max_image_bytes, base.max_image_bytes)
        None => base.max_image_bytes
    }
    ro preset = match o.get("preset") {
        Some(v) => match v.str() {
            Some(text) => if text.byte_len() > 0 { text } else { base.preset }
            None => base.preset
        }
        None => base.preset
    }
    ro reviewer_order = match o.get("route_reviewer_order") {
        Some(v) => {
            ro list = fs_strings(v)
            if list.len() > 0 { list } else { base.reviewer_order }
        }
        None => base.reviewer_order
    }
    { port, web_dir, hub_program, hub_args, agents, stt_url, stt_language, stt_managed, stt_dir, stt_model, data_dir, max_image_bytes, layout: base.layout, preset, reviewer_order }
}

// The folder of the recognizer when no setting names it (task 192.12): an install of the older place (`%LOCALAPPDATA%/crew-harness/stt`) that is still there is used;
// else `CREW_TOOLS_DIR/whisper` or `<home>/tools/whisper`; with no root at all, the older place.
fn fs_default_stt_dir(layout ConfigLayout) Os Fs -> str {
    ro old = match fs_env("LOCALAPPDATA") {
        Some(local) => "${local.replace("\\", "/")}/crew-harness/stt"
        None => ""
    }
    if old.byte_len() > 0 {
        match file_text("${old}/bin/whisper-server.exe") {
            Some(t) => return old
            None => ()
        }
    }
    ro tools = tools_dir_now(layout)
    if tools.byte_len() > 0 { return "${tools}/whisper" }
    old
}

/// The settings of the front in the root of the instance named by CREW_HOME (or the folder of the user): see `front_settings_in`.
export fn front_settings(file str) Os Fs -> Result[FrontSettings, str] => front_settings_in(file, crew_home(""), []str.new())

/// The settings of the front by the same layers as the hub (task 192.12, `server_settings_in` of src/server/settings.nv): the defaults, `<home>/config/config.json`, the server file `file`
/// (or CREW_SERVER_CONFIG), `.crew-harness/config.json` and `local.json` of the project, secrets.json, the variables CREW_*, the words `key=value` of `sets` (the arguments `--set`).
export fn front_settings_in(file str, home str, sets []str) Os Fs -> Result[FrontSettings, str] {
    ro name = if file.byte_len() > 0 { file } else { fs_env("CREW_SERVER_CONFIG") ?? "" }
    if name.byte_len() > 0 && file_text(name).is_none() { return Err("the settings file ${name} cannot be read") }
    ro project = find_project_dir(work_dir_now(), home)
    ro at = layout_in(home, project)
    mut layers = file_layers(at, name)?
    layers.push(env_layer())
    layers.push(arg_layer(sets))
    ro merged = merge_layers(layers)
    ro base = fs_from_file(JsonValue.object(merged).to_str())
    ro data_set = match merged.get("data_dir") {
        Some(v) => (v.str() ?? "").byte_len() > 0
        None => false
    }
    ro layout = if data_set { layout_with_data_dir(home, base.data_dir, project) } else if home.byte_len() > 0 { at } else { legacy_layout(base.data_dir) }
    // a variable with a wrong number is named, as the hub does
    match fs_env("CREW_SERVER_PORT") {
        Some(text) => match text.to_int() {
            Ok(n) => ()
            Err(e) => return Err("CREW_SERVER_PORT must be a whole number")
        }
        None => ()
    }
    if base.port < 1 || base.port > 65535 { return Err("the port must be 1 to 65535") }
    ro hub_words = match fs_env("CREW_SERVER_HUB") {
        Some(command) => fs_words(command)
        None => []str.new()
    }
    ro hub_program = if hub_words.len() > 0 { hub_words[0] } else { base.hub_program }
    ro hub_args = if hub_words.len() > 0 { fs_rest(hub_words) } else { base.hub_args }
    ro stt_dir = if base.stt_dir.byte_len() > 0 { base.stt_dir } else { fs_default_stt_dir(layout) }
    Ok({ port: base.port, web_dir: base.web_dir, hub_program, hub_args, agents: fs_agents(base.agents), stt_url: base.stt_url, stt_language: base.stt_language, stt_managed: base.stt_managed, stt_dir, stt_model: base.stt_model, data_dir: layout.sessions, max_image_bytes: base.max_image_bytes, layout, preset: base.preset, reviewer_order: base.reviewer_order })
}
