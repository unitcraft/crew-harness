// front_settings_test.nv - the settings of the front: the port, the folder of the page, the command of the hub; a file and the
// environment over it (the keys are those of src/server/settings.nv).
// ORACLE-WORKAROUND(25): the module is declared `module server.front` (without the package prefix): a module two folders under the source root cannot be declared with the full path; declare it with the prefix when item 25 is fixed
module server.front

import std.os.{Os, MockOs, mock_os, real_os, temp_dir, pid}
import std.fs.{Fs, real_fs, write_text, create_dir_all, Path}

fn front_file(name str, text str) -> Path {
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("crew-front-settings-${id}")
    ro path = dir.join(name)
    with Fs = real_fs() {
        ro made = create_dir_all(dir)
        ro written = write_text(path, text)
    }
    path
}

test "front settings: no file and no environment means the defaults" {
    mut empty = MockOs.new()
    match with Os = mock_os(empty), Fs = real_fs() { front_settings("") } {
        Ok(s) => {
            assert(s.port == 8099)
            assert(s.web_dir == "src/web")
            assert(s.hub_program == "target/crew-hub.exe")
            assert(s.hub_args.len() == 0)
        }
        Err(e) => assert(false)
    }
}

test "front settings: the keys of a file, the environment over them" {
    ro path = front_file("front.json", "{\"port\":8123,\"web_dir\":\"web\",\"hub\":{\"program\":\"h.exe\",\"args\":[\"x\"]},\"store\":\"pg\"}")
    mut none = MockOs.new()
    match with Os = mock_os(none), Fs = real_fs() { front_settings(path.display()) } {
        Ok(s) => {
            assert(s.port == 8123)
            assert(s.web_dir == "web")
            assert(s.hub_program == "h.exe")
            assert(s.hub_args.len() == 1 && s.hub_args[0] == "x")
        }
        Err(e) => assert(false)
    }
    mut state = MockOs.new()
    state.put_env("CREW_SERVER_PORT", "9002")
    state.put_env("CREW_SERVER_WEB_DIR", "elsewhere")
    state.put_env("CREW_SERVER_HUB", "other.exe a b")
    match with Os = mock_os(state), Fs = real_fs() { front_settings(path.display()) } {
        Ok(s) => {
            assert(s.port == 9002)
            assert(s.web_dir == "elsewhere")
            assert(s.hub_program == "other.exe")
            assert(s.hub_args.len() == 2 && s.hub_args[1] == "b")
        }
        Err(e) => assert(false)
    }
}

test "front settings: a missing file, a bad port" {
    mut none = MockOs.new()
    match with Os = mock_os(none), Fs = real_fs() { front_settings("C:/work/no-such-settings.json") } {
        Ok(s) => assert(false)
        Err(e) => assert(e.contains("no-such-settings"))
    }
    mut bad = MockOs.new()
    bad.put_env("CREW_SERVER_PORT", "many")
    match with Os = mock_os(bad), Fs = real_fs() { front_settings("") } {
        Ok(s) => assert(false)
        Err(e) => assert(e.contains("CREW_SERVER_PORT"))
    }
    mut zero = MockOs.new()
    zero.put_env("CREW_SERVER_PORT", "0")
    match with Os = mock_os(zero), Fs = real_fs() { front_settings("") } {
        Ok(s) => assert(false)
        Err(e) => assert(e.contains("port"))
    }
}
