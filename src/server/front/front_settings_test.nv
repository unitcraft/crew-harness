// front_settings_test.nv - the settings of the front: the port, the folder of the page, the command of the hub; a file and the
// environment over it (the keys are those of src/server/settings.nv).
// ORACLE-WORKAROUND(25): the module is declared `module server.front` (without the package prefix): a module two folders under the source root cannot be declared with the full path; declare it with the prefix when item 25 is fixed
module server.front

import std.os.{Os, MockOs, mock_os, real_os, temp_dir, pid}
import std.fs.{Fs, real_fs, write_text, create_dir_all, Path}

fn front_file(name str, text str) -> Path {
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("crew-front-settings-${id}")
    ro path = dir.join(name)
    with Fs = real_fs() {
        ro made = create_dir_all(dir)
        ro written = write_text(path, text)
    }
    path
}

test "front settings: no file and no environment means the defaults" {
    mut empty = MockOs.new()
    match with Os = mock_os(empty), Fs = real_fs() { front_settings("") } {
        Ok(s) => {
            assert(s.port == 8099)
            assert(s.web_dir == "src/web")
            assert(s.hub_program == "target/crew-hub.exe")
            assert(s.hub_args.len() == 0)
        }
        Err(e) => assert(false)
    }
}

test "front settings: the keys of a file, the environment over them" {
    ro path = front_file("front.json", "{\"port\":8123,\"web_dir\":\"web\",\"hub\":{\"program\":\"h.exe\",\"args\":[\"x\"]},\"agents\":[{\"id\":\"opencode\",\"label\":\"OpenCode\",\"program\":\"private.exe\",\"args\":[\"acp\"]},{\"id\":\"kimi\",\"label\":\"Kimi Code\",\"program\":\"kimi.cmd\",\"args\":[\"acp\"]}],\"store\":\"pg\"}")
    mut none = MockOs.new()
    match with Os = mock_os(none), Fs = real_fs() { front_settings(path.display()) } {
        Ok(s) => {
            assert(s.port == 8123)
            assert(s.web_dir == "web")
            assert(s.hub_program == "h.exe")
            assert(s.hub_args.len() == 1 && s.hub_args[0] == "x")
            assert(s.agents.len() == 2)
            assert(s.agents[0].id == "opencode" && s.agents[0].label == "OpenCode")
            assert(s.agents[1].id == "kimi" && s.agents[1].label == "Kimi Code")
        }
        Err(e) => assert(false)
    }
    mut state = MockOs.new()
    state.put_env("CREW_SERVER_PORT", "9002")
    state.put_env("CREW_SERVER_WEB_DIR", "elsewhere")
    state.put_env("CREW_SERVER_HUB", "other.exe a b")
    state.put_env("CREW_SERVER_AGENT", "override-agent acp")
    match with Os = mock_os(state), Fs = real_fs() { front_settings(path.display()) } {
        Ok(s) => {
            assert(s.port == 9002)
            assert(s.web_dir == "elsewhere")
            assert(s.hub_program == "other.exe")
            assert(s.hub_args.len() == 2 && s.hub_args[1] == "b")
            assert(s.agents.len() == 1 && s.agents[0].id == "opencode")
        }
        Err(e) => assert(false)
    }
}

test "front settings: a missing file, a bad port" {
    mut none = MockOs.new()
    match with Os = mock_os(none), Fs = real_fs() { front_settings("C:/work/no-such-settings.json") } {
        Ok(s) => assert(false)
        Err(e) => assert(e.contains("no-such-settings"))
    }
    mut bad = MockOs.new()
    bad.put_env("CREW_SERVER_PORT", "many")
    match with Os = mock_os(bad), Fs = real_fs() { front_settings("") } {
        Ok(s) => assert(false)
        Err(e) => assert(e.contains("CREW_SERVER_PORT"))
    }
    mut zero = MockOs.new()
    zero.put_env("CREW_SERVER_PORT", "0")
    match with Os = mock_os(zero), Fs = real_fs() { front_settings("") } {
        Ok(s) => assert(false)
        Err(e) => assert(e.contains("port"))
    }
}

test "front settings: the recognizer of the voice, local only; the file, the environment over it" {
    mut empty = MockOs.new()
    match with Os = mock_os(empty), Fs = real_fs() { front_settings("") } {
        Ok(s) => {
            assert(s.stt_url == "http://127.0.0.1:8178/inference")
            assert(s.stt_language == "auto")
        }
        Err(e) => assert(false)
    }
    ro path = front_file("stt.json", "{\"stt\":{\"url\":\"http://localhost:9000/inference\",\"language\":\"ru\"}}")
    mut none = MockOs.new()
    match with Os = mock_os(none), Fs = real_fs() { front_settings(path.display()) } {
        Ok(s) => {
            assert(s.stt_url == "http://localhost:9000/inference")
            assert(s.stt_language == "ru")
        }
        Err(e) => assert(false)
    }
    mut state = MockOs.new()
    state.put_env("CREW_SERVER_STT_URL", "http://127.0.0.1:9100/inference")
    state.put_env("CREW_SERVER_STT_LANGUAGE", "en")
    match with Os = mock_os(state), Fs = real_fs() { front_settings(path.display()) } {
        Ok(s) => {
            assert(s.stt_url == "http://127.0.0.1:9100/inference")
            assert(s.stt_language == "en")
        }
        Err(e) => assert(false)
    }
    // an address that is not local is the default: the voice does not leave the machine
    ro far = front_file("stt-far.json", "{\"stt\":{\"url\":\"http://example.com:9000/inference\"}}")
    match with Os = mock_os(empty), Fs = real_fs() { front_settings(far.display()) } {
        Ok(s) => assert(s.stt_url == "http://127.0.0.1:8178/inference")
        Err(e) => assert(false)
    }
    mut far_env = MockOs.new()
    far_env.put_env("CREW_SERVER_STT_URL", "http://example.com:1/x")
    match with Os = mock_os(far_env), Fs = real_fs() { front_settings("") } {
        Ok(s) => assert(s.stt_url == "http://127.0.0.1:8178/inference")
        Err(e) => assert(false)
    }
}

test "front settings: the recognizer is managed by default; the folder, the model, the data folder" {
    mut empty = MockOs.new()
    match with Os = mock_os(empty), Fs = real_fs() { front_settings("") } {
        Ok(s) => {
            assert(s.stt_managed)
            assert(s.stt_model == "small")
            assert(s.data_dir == "crew-data")
            assert(s.stt_dir == "")
        }
        Err(e) => assert(false)
    }
    // the default folder: CREW_STT_DIR (the installer's), else LOCALAPPDATA/crew-harness/stt
    mut local = MockOs.new()
    local.put_env("LOCALAPPDATA", "C:/work/local")
    match with Os = mock_os(local), Fs = real_fs() { front_settings("") } {
        Ok(s) => assert(s.stt_dir == "C:/work/local/crew-harness/stt")
        Err(e) => assert(false)
    }
    mut installer = MockOs.new()
    installer.put_env("LOCALAPPDATA", "C:/work/local")
    installer.put_env("CREW_STT_DIR", "C:/work/stt")
    match with Os = mock_os(installer), Fs = real_fs() { front_settings("") } {
        Ok(s) => assert(s.stt_dir == "C:/work/stt")
        Err(e) => assert(false)
    }
    ro path = front_file("stt-managed.json", "{\"data_dir\":\"C:/work/data\",\"stt\":{\"managed\":false,\"dir\":\"C:/work/from-file\",\"model\":\"medium\"}}")
    match with Os = mock_os(installer), Fs = real_fs() { front_settings(path.display()) } {
        Ok(s) => {
            assert(!s.stt_managed)
            assert(s.stt_dir == "C:/work/from-file")
            assert(s.stt_model == "medium")
            assert(s.data_dir == "C:/work/data")
        }
        Err(e) => assert(false)
    }
    mut env = MockOs.new()
    env.put_env("CREW_SERVER_STT_MANAGED", "true")
    env.put_env("CREW_SERVER_STT_DIR", "C:/work/from-env")
    env.put_env("CREW_SERVER_STT_MODEL", "small")
    env.put_env("CREW_SERVER_DATA_DIR", "C:/work/data-env")
    match with Os = mock_os(env), Fs = real_fs() { front_settings(path.display()) } {
        Ok(s) => {
            assert(s.stt_managed)
            assert(s.stt_dir == "C:/work/from-env")
            assert(s.stt_model == "small")
            assert(s.data_dir == "C:/work/data-env")
        }
        Err(e) => assert(false)
    }
    mut off = MockOs.new()
    off.put_env("CREW_SERVER_STT_MANAGED", "false")
    match with Os = mock_os(off), Fs = real_fs() { front_settings("") } {
        Ok(s) => assert(!s.stt_managed)
        Err(e) => assert(false)
    }
    // a model that could leave the folder is the default
    ro odd = front_file("stt-odd.json", "{\"stt\":{\"model\":\"../x\",\"managed\":\"yes\"}}")
    match with Os = mock_os(empty), Fs = real_fs() { front_settings(odd.display()) } {
        Ok(s) => {
            assert(s.stt_model == "small")
            assert(s.stt_managed)
        }
        Err(e) => assert(false)
    }
}
