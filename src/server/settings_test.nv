// settings_test.nv - the settings of the session server: a JSON file and the environment over it; the password is in no
// text that can be printed.
module crew_harness.server

import std.os.{Os, MockOs, mock_os, real_os, temp_dir, pid}
import std.fs.{Fs, real_fs, read_text, write_text, create_dir_all, Path}

fn full_settings_text() -> str => "{\"port\":8123,\"data_dir\":\"C:/work/crew-data\",\"store\":\"pg\",\"pg\":{\"host\":\"localhost\",\"port\":55432,\"database\":\"crew_x\",\"user\":\"crew_login\",\"password\":\"file-test-pw\"},\"agents\":[{\"id\":\"opencode\",\"label\":\"OpenCode\",\"program\":\"opencode\",\"args\":[\"acp\"]},{\"id\":\"fake\",\"program\":\"node\",\"args\":[\"a.mjs\",\"--live\"]}],\"idle_term_seconds\":60,\"workdir\":\"C:/work/project\",\"web_dir\":\"web\",\"hub\":{\"program\":\"target/hub.exe\",\"args\":[\"x\"]}}"

fn must_settings(text str) -> ServerSettings {
    match parse_server_settings(text) {
        Ok(s) => s
        Err(e) => panic("settings: ${e}")
    }
}

fn settings_file(name str, text str) -> Path {
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("crew-server-settings-${id}")
    ro path = dir.join(name)
    with Fs = real_fs() {
        ro made = create_dir_all(dir)
        ro written = write_text(path, text)
    }
    path
}

fn is_error(result Result[ServerSettings, str]) -> bool {
    match result {
        Ok(s) => false
        Err(e) => true
    }
}

test "settings: an empty object has the defaults, opencode acp among them" {
    ro s = must_settings("{}")
    assert(s.port == 8099)
    assert(s.store == "files")
    assert(s.data_dir == "crew-data")
    assert(s.idle_term_ms == 900000)
    assert(s.web_dir == "src/web")
    assert(s.agents.len() == 1)
    assert(s.agents[0].id == "opencode")
    assert(s.agents[0].program == default_opencode_program())
    assert(s.agents[0].args.len() == 1)
    assert(s.agents[0].args[0] == "acp")
}

test "settings: every key of a file is read" {
    ro s = must_settings(full_settings_text())
    assert(s.port == 8123)
    assert(s.data_dir == "C:/work/crew-data")
    assert(s.store == "pg")
    assert(s.pg.port == 55432 && s.pg.database == "crew_x" && s.pg.user == "crew_login")
    assert(s.agents.len() == 2)
    assert(s.agents[0].label == "OpenCode")
    assert(s.agents[1].id == "fake")
    assert(s.agents[1].label == "fake")
    assert(s.agents[1].args.len() == 2 && s.agents[1].args[1] == "--live")
    assert(s.idle_term_ms == 60000)
    assert(s.workdir == "C:/work/project")
    assert(s.web_dir == "web")
    assert(s.hub_program == "target/hub.exe")
    assert(s.hub_args.len() == 1)
}

test "settings: an agent is found by its id" {
    ro s = must_settings(full_settings_text())
    match s.agent("fake") {
        Some(a) => assert(a.program == "node")
        None => assert(false)
    }
    assert(s.agent("nobody") == None)
}

test "settings: a wrong file is an error that does not print the content" {
    assert(is_error(parse_server_settings("not json password=never-printed")))
    assert(is_error(parse_server_settings("[1]")))
    assert(is_error(parse_server_settings("{\"port\":\"x\"}")))
    assert(is_error(parse_server_settings("{\"port\":0}")))
    assert(is_error(parse_server_settings("{\"store\":\"redis\"}")))
    assert(is_error(parse_server_settings("{\"agents\":[]}")))
    assert(is_error(parse_server_settings("{\"agents\":[{\"program\":\"x\"}]}")))
    assert(is_error(parse_server_settings("{\"agents\":[{\"id\":\"a\"}]}")))
    assert(is_error(parse_server_settings("{\"idle_term_seconds\":0}")))
    match parse_server_settings("{\"pg\":{\"password\":\"never-printed\",\"port\":\"x\"}}") {
        Ok(s) => assert(false)
        Err(e) => assert(!e.contains("never-printed"))
    }
}

test "settings: the description has no password" {
    ro s = must_settings(full_settings_text())
    ro text = s.describe()
    assert(text.contains("8123"))
    assert(text.contains("pg"))
    assert(text.contains("opencode"))
    assert(!text.contains("file-test-pw"))
}

test "settings: pg without a password does not pass the check, files need none" {
    ro files = must_settings("{}")
    match files.check() {
        Ok(done) => ()
        Err(e) => assert(false)
    }
    ro pg = must_settings("{\"store\":\"pg\"}")
    match pg.check() {
        Ok(done) => assert(false)
        Err(e) => assert(e.contains("password"))
    }
    ro ok = must_settings(full_settings_text())
    match ok.check() {
        Ok(done) => ()
        Err(e) => assert(false)
    }
}

test "settings: the environment is over the file" {
    ro path = settings_file("server.json", full_settings_text())
    mut state = MockOs.new()
    state.put_env("CREW_SERVER_PORT", "9001")
    state.put_env("CREW_SERVER_STORE", "files")
    state.put_env("CREW_SERVER_DATA_DIR", "C:/work/other")
    state.put_env("CREW_SERVER_AGENT", "node fake.mjs --live")
    state.put_env("CREW_SERVER_WORKDIR", "C:/work/elsewhere")
    state.put_env("CREW_SERVER_IDLE_SECONDS", "5")
    state.put_env("CREW_PG_PASSWORD", "env-pw")
    match with Os = mock_os(state), Fs = real_fs() { server_settings(path.display()) } {
        Ok(s) => {
            assert(s.port == 9001)
            assert(s.store == "files")
            assert(s.data_dir == "C:/work/other")
            assert(s.agents.len() == 1)
            assert(s.agents[0].id == "opencode")
            assert(s.agents[0].program == "node")
            assert(s.agents[0].args.len() == 2 && s.agents[0].args[0] == "fake.mjs")
            assert(s.workdir == "C:/work/elsewhere")
            assert(s.idle_term_ms == 5000)
            assert(s.pg.password == "env-pw")
            assert(s.pg.database == "crew_x")
        }
        Err(e) => assert(false)
    }
}

test "settings: the file is named by the argument or by CREW_SERVER_CONFIG, no file means the defaults" {
    ro path = settings_file("named.json", "{\"port\":8456}")
    mut empty = MockOs.new()
    match with Os = mock_os(empty), Fs = real_fs() { server_settings("") } {
        Ok(s) => assert(s.port == 8099)
        Err(e) => assert(false)
    }
    mut named = MockOs.new()
    named.put_env("CREW_SERVER_CONFIG", path.display())
    match with Os = mock_os(named), Fs = real_fs() { server_settings("") } {
        Ok(s) => assert(s.port == 8456)
        Err(e) => assert(false)
    }
    match with Os = mock_os(empty), Fs = real_fs() { server_settings("${path.display()}.missing") } {
        Ok(s) => assert(false)
        Err(e) => assert(e.contains("missing"))
    }
    mut bad = MockOs.new()
    bad.put_env("CREW_SERVER_PORT", "many")
    match with Os = mock_os(bad), Fs = real_fs() { server_settings("") } {
        Ok(s) => assert(false)
        Err(e) => assert(e.contains("CREW_SERVER_PORT"))
    }
}

test "settings: the example file of the repository is a valid configuration" {
    ro text = with Fs = real_fs() {
        match read_text(Path.from_bytes("src/server/server.example.json".bytes())) {
            Ok(t) => t
            Err(e) => ""
        }
    }
    assert(text.byte_len() > 0)
    ro s = must_settings(text)
    assert(s.agents.len() >= 1)
    match s.check() {
        Ok(done) => ()
        Err(e) => assert(false)
    }
}

test "settings: the example of the store pg has no password and is refused until the environment gives one" {
    ro text = with Fs = real_fs() {
        match read_text(Path.from_bytes("src/server/server-pg.example.json".bytes())) {
            Ok(t) => t
            Err(e) => ""
        }
    }
    assert(text.byte_len() > 0)
    ro s = must_settings(text)
    assert(s.store == "pg")
    assert(s.pg.port == 15432)
    assert(s.pg.database == "crew")
    assert(s.pg.user == "crew_service")
    assert(s.pg.password == "")
    match s.check() {
        Ok(done) => assert(false)
        Err(e) => assert(e.contains("pg"))
    }
}

test "settings: acp_trace is on by default, the file turns it off, the environment is over the file" {
    assert(must_settings("{}").acp_trace)
    assert(!must_settings("{\"acp_trace\":false}").acp_trace)
    assert(is_error(parse_server_settings("{\"acp_trace\":\"no\"}")))
    ro path = settings_file("trace.json", "{\"acp_trace\":false}")
    mut state = MockOs.new()
    state.put_env("CREW_SERVER_ACP_TRACE", "true")
    match with Os = mock_os(state), Fs = real_fs() { server_settings(path.display()) } {
        Ok(s) => assert(s.acp_trace)
        Err(e) => assert(false)
    }
    mut off = MockOs.new()
    off.put_env("CREW_SERVER_ACP_TRACE", "false")
    match with Os = mock_os(off), Fs = real_fs() { server_settings("") } {
        Ok(s) => assert(!s.acp_trace)
        Err(e) => assert(false)
    }
}

test "settings: stt has the local whisper server by default, the file sets it, the environment is over the file" {
    ro d = must_settings("{}")
    assert(d.stt_url == "http://127.0.0.1:8178/inference")
    assert(d.stt_language == "auto")
    ro s = must_settings("{\"stt\":{\"url\":\"http://localhost:9000/inference\",\"language\":\"ru\"}}")
    assert(s.stt_url == "http://localhost:9000/inference")
    assert(s.stt_language == "ru")
    ro half = must_settings("{\"stt\":{\"language\":\"en\"}}")
    assert(half.stt_url == "http://127.0.0.1:8178/inference")
    assert(half.stt_language == "en")
    assert(is_error(parse_server_settings("{\"stt\":\"x\"}")))
    assert(is_error(parse_server_settings("{\"stt\":{\"url\":5}}")))
    assert(is_error(parse_server_settings("{\"stt\":{\"language\":\"\"}}")))
    // the audio never leaves this machine: the address must be a local http one
    assert(is_error(parse_server_settings("{\"stt\":{\"url\":\"http://example.com:8178/inference\"}}")))
    assert(is_error(parse_server_settings("{\"stt\":{\"url\":\"https://127.0.0.1:8178/inference\"}}")))
    ro path = settings_file("stt.json", "{\"stt\":{\"url\":\"http://127.0.0.1:9001/inference\",\"language\":\"ru\"}}")
    mut state = MockOs.new()
    state.put_env("CREW_SERVER_STT_URL", "http://127.0.0.1:9002/inference")
    state.put_env("CREW_SERVER_STT_LANGUAGE", "en")
    match with Os = mock_os(state), Fs = real_fs() { server_settings(path.display()) } {
        Ok(s) => {
            assert(s.stt_url == "http://127.0.0.1:9002/inference")
            assert(s.stt_language == "en")
        }
        Err(e) => assert(false)
    }
    mut bad = MockOs.new()
    bad.put_env("CREW_SERVER_STT_URL", "http://example.com/inference")
    match with Os = mock_os(bad), Fs = real_fs() { server_settings("") } {
        Ok(s) => assert(false)
        Err(e) => assert(e.contains("stt"))
    }
}

test "settings: the folder of the machines is machines_dir of the file, CREW_SERVER_MACHINES_DIR over it, empty by default (task 248)" {
    assert(must_settings("{}").machines_dir == "")
    assert(must_settings("{\"machines_dir\":\"C:/work/kit/machines/product\"}").machines_dir == "C:/work/kit/machines/product")
    assert(is_error(parse_server_settings("{\"machines_dir\":5}")))
    ro path = settings_file("machines.json", "{\"machines_dir\":\"C:/work/kit/machines/product\"}")
    mut env = MockOs.new()
    env.put_env("CREW_SERVER_MACHINES_DIR", "C:/work/other/machines")
    match with Os = mock_os(env), Fs = real_fs() { server_settings(path.display()) } {
        Ok(s) => assert(s.machines_dir == "C:/work/other/machines")
        Err(e) => panic(e)
    }
}

test "settings: max_image_bytes is 10 MB, the file sets it, the environment is over" {
    assert(must_settings("{}").max_image_bytes == 10485760)
    assert(must_settings("{\"max_image_bytes\":2048}").max_image_bytes == 2048)
    assert(is_error(parse_server_settings("{\"max_image_bytes\":\"big\"}")))
    assert(is_error(parse_server_settings("{\"max_image_bytes\":10}")))
    ro path = settings_file("img.json", "{\"max_image_bytes\":4096}")
    mut state = MockOs.new()
    state.put_env("CREW_SERVER_MAX_IMAGE_BYTES", "8192")
    match with Os = mock_os(state), Fs = real_fs() { server_settings(path.display()) } {
        Ok(s) => assert(s.max_image_bytes == 8192)
        Err(e) => assert(false)
    }
}

test "settings: ask_form is on by default, the file turns it off, the environment is over the file; the wait for an answer has a term" {
    assert(must_settings("{}").ask_form)
    assert(!must_settings("{\"ask_form\":false}").ask_form)
    assert(is_error(parse_server_settings("{\"ask_form\":\"no\"}")))
    assert(must_settings("{}").ask_timeout_ms == 1800000)
    assert(must_settings("{\"ask_timeout_seconds\":60}").ask_timeout_ms == 60000)
    assert(is_error(parse_server_settings("{\"ask_timeout_seconds\":0}")))
    ro path = settings_file("ask.json", "{\"ask_form\":false}")
    mut state = MockOs.new()
    state.put_env("CREW_SERVER_ASK_FORM", "true")
    match with Os = mock_os(state), Fs = real_fs() { server_settings(path.display()) } {
        Ok(s) => assert(s.ask_form)
        Err(e) => assert(false)
    }
    mut off = MockOs.new()
    off.put_env("CREW_SERVER_ASK_FORM", "false")
    match with Os = mock_os(off), Fs = real_fs() { server_settings("") } {
        Ok(s) => assert(!s.ask_form)
        Err(e) => assert(false)
    }
    mut timed = MockOs.new()
    timed.put_env("CREW_SERVER_ASK_TIMEOUT_SECONDS", "90")
    match with Os = mock_os(timed), Fs = real_fs() { server_settings("") } {
        Ok(s) => assert(s.ask_timeout_ms == 90000)
        Err(e) => assert(false)
    }
}

test "settings: an agent asks the owner by its own tool (native) unless the file says mcp or off" {
    ro s = must_settings("{\"agents\":[{\"id\":\"a\",\"program\":\"x\"},{\"id\":\"b\",\"program\":\"x\",\"ask\":\"mcp\"},{\"id\":\"c\",\"program\":\"x\",\"ask\":\"off\"}]}")
    assert(s.agents[0].ask == "native")
    assert(s.agents[1].ask == "mcp")
    assert(s.agents[2].ask == "off")
    assert(is_error(parse_server_settings("{\"agents\":[{\"id\":\"a\",\"program\":\"x\",\"ask\":\"always\"}]}")))
}

test "settings: the modes of work have defaults and can be set" {
    ro plain = must_settings("{}")
    assert(plain.routes_dir == "doc/routes")
    assert(plain.route_reviewer_order == ["codex", "claude", "kimi", "opencode"])
    assert(plain.route_task_limit == 12)
    assert(plain.route_task_messages == 40)
    assert(plain.route_fix_attempts == 2)
    assert(plain.route_worktree_ask)
    assert(plain.route_overlap_seconds == 30)
    assert(plain.route_keep_days == 30)
    assert(plain.context_drop_percent == 40)
    assert(plain.route_confirm_word == "задача" && plain.route_over_limit_word == "сверх" && plain.route_max_active == 3 && plain.route_tool && !plain.route_auto_propose)
    ro set = must_settings("{\"routes_dir\":\"my/routes\",\"route_reviewer_order\":[\"kimi\"],\"route_task_limit\":5,\"route_task_messages\":9,\"route_fix_attempts\":3,\"route_worktree_ask\":false,\"route_overlap_seconds\":10,\"route_keep_days\":0}")
    assert(set.routes_dir == "my/routes")
    assert(set.route_reviewer_order == ["kimi"])
    assert(set.route_task_limit == 5 && set.route_task_messages == 9 && set.route_fix_attempts == 3)
    assert(!set.route_worktree_ask)
    assert(set.route_overlap_seconds == 10)
    assert(set.route_keep_days == 0)
    ro words = must_settings("{\"route_confirm_word\":\"go\",\"route_over_limit_word\":\"more\",\"route_max_active\":0,\"route_tool\":false,\"route_auto_propose\":true}")
    assert(words.route_confirm_word == "go" && words.route_over_limit_word == "more" && words.route_max_active == 0 && !words.route_tool && words.route_auto_propose)
    assert(is_error(parse_server_settings("{\"route_reviewer_order\":\"kimi\"}")))
}
