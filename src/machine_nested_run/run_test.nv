// run_test.nv - the scenarios `nested-steps-*.alula.test.json` (task 119): the session `dialog_steps` calls the agent step of the methodology as its nested machine, run together by the runner of the
// package (`run_nested_test`). The parents and the nested machine of the examples of the language are run in the package (task 158).
module crew_harness.machine_nested_run

import std.text
import alula.machine.{text_of_file, NamedText}
import alula.machine_run.{AlulaMachine, NestedRegistry, load_alula_machine, parse_test, run_nested_test, run_ok, report_text, Test, TestRun, check_registry}
import crew_harness.machines.{methodology_registry, machine_files, test_files}

fn machine_of(name str) -> AlulaMachine {
    match load_alula_machine(text_of_file(machine_files(), "${name}.alula.json"), methodology_registry()) {
        Ok(m) => m
        Err(e) => panic("the machine ${name} does not load: ${e}")
    }
}

// The agent step as the session calls it.
fn registry() -> NestedRegistry => NestedRegistry.empty().add("agent_step", machine_of("agent_step"))

fn scenario_of(file NamedText) -> Test {
    match parse_test(file.text) {
        Ok(sc) => sc
        Err(e) => panic("the scenario ${file.name} does not parse: ${e.path}: ${e.message}")
    }
}

fn run_file(file NamedText) -> TestRun {
    ro sc = scenario_of(file)
    run_nested_test(machine_of(sc.machine), registry(), sc)
}

// Every scenario whose name starts with the prefix runs and agrees with its file; the number of the files is returned.
fn run_group(prefix str) -> int {
    mut n = 0
    mut reports = []str.new()
    for f in test_files() {
        if !f.name.starts_with(prefix) { continue }
        ro run = run_file(f)
        if !run_ok(run) { reports.push("${f.name}: ${report_text(run)}") }
        n += 1
    }
    if reports.len() > 0 { panic(reports.join("\n")) }
    n
}

test "ns pair fits" {
    assert(check_registry(machine_of("dialog_steps"), registry()).len() == 0)
    assert(check_registry(machine_of("agent_step"), registry()).len() == 0)
}

test "ns steps scenarios" {
    assert(run_group("nested-steps-") == 6)
}
