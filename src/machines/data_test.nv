// data_test.nv - the data of the machines of the product (task 158): the lists of the files in `data.nv` hold every file of the folder `machines/product/`, the names follow the Alula rule, the registry
// of the product loads, and every machine loads with it. The machines of the methodology left the product with task 249.
module crew_harness.machines

import alula.machine.{NamedText, text_of_file, find_primitive, journal_find, is_machine_json_name, is_table_name}
import alula.machine_run.{load_alula_machine}

fn dt_names(files []NamedText) -> []str {
    mut out = []str.new()
    for f in files { out.push(f.name) }
    out
}

fn dt_same(left []str, right []str) -> bool {
    if left.len() != right.len() { return false }
    for l in left { if !right.contains(l) { return false } }
    for r in right { if !left.contains(r) { return false } }
    true
}

fn dt_with_prefix(files []NamedText, prefix str) -> []NamedText {
    mut out = []NamedText.new()
    for f in files {
        if f.name.starts_with(prefix) { out.push(f) }
    }
    out
}

test "dt the lists of the files hold every file of the folders" {
    assert(dt_same(dt_names(machine_files()), data_dir_names("product_machines")))
    assert(dt_same(dt_names(table_files()), data_dir_names("product_tables")))
    assert(dt_same(dt_names(test_files()), data_dir_names("product_scenarios")))
    assert(dt_same(dt_names(library_files()), data_dir_names("product_libraries")))
    assert(dt_same(dt_names(translation_files()), dt_names(library_files())))
    assert(data_dir_names("elsewhere").len() == 0)
}

fn dt_count_ending(names []str, suffix str) -> int {
    mut n = 0
    for name in names { if name.ends_with(suffix) { n += 1 } }
    n
}

test "dt the one extension of a table is alula md" {
    // task 169: the old extension `.alula.txt` (the work-around of the guard of the links) is gone from the folder of the machines and from the list of the tables
    assert(dt_count_ending(data_dir_names("product_files"), ".alula.txt") == 0)
    ro tables = dt_names(table_files())
    assert(dt_count_ending(tables, ".alula.txt") == 0)
    assert(dt_count_ending(tables, ".alula.md") == tables.len())
    assert(dt_count_ending(data_dir_names("product_tables"), ".alula.md") == data_dir_names("product_tables").len())
    assert(tables.contains("chat.alula.md"))
    assert(chat_table_text().byte_len() > 0)
}

test "dt the numbers of the files" {
    assert(machine_files().len() == 2)
    assert(table_files().len() == 2)
    assert(library_files().len() == 1)
    assert(test_files().len() == 81)
    assert(dt_with_prefix(test_files(), "chat-").len() + dt_with_prefix(test_files(), "dialog-").len() + dt_with_prefix(test_files(), "free-input-").len() == 81)
    assert(dt_with_prefix(test_files(), "agent-step-").len() == 0)
    assert(dt_with_prefix(test_files(), "nested-steps-").len() == 0)
}

test "dt the names are the names of Alula" {
    for f in machine_files() { assert(is_machine_json_name(f.name)) }
    for f in table_files() { assert(is_table_name(f.name)) }
    for f in test_files() { assert(f.name.ends_with(".alula.test.json")) }
}

test "dt the machines of the product load with the registry of the product" {
    for name in ["chat.alula.json", "dialog.alula.json"] {
        match load_alula_machine(text_of_file(machine_files(), name), product_registry()) {
            Ok(m) => assert(m.def.states.len() >= 3)
            Err(e) => panic("${name}: ${e}")
        }
    }
}

test "dt the registry of the product is the language and the journal of the product" {
    ro reg = product_registry()
    assert(reg.primitives.len() == 1)
    assert(find_primitive(reg, "new_id").is_some())
    assert(find_primitive(reg, "time_now").is_none())
    assert(journal_find(reg.journal, "user_message").is_some())
    assert(journal_find(reg.journal, "turn_failed").is_none())
}
