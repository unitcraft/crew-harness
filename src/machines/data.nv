/// The registry of the methodology as text (`machines/methodology/registry.md`): the 58 primitives (the parse of a reply is three functions, one per role), the sets of the types of the signatures.
export fn methodology_registry_text() -> str => embed_str("../../machines/methodology/registry.md")

/// The table of the journal codes of the methodology (`machines/methodology/journal.md`).
export fn methodology_journal_text() -> str => embed_str("../../machines/methodology/journal.md")

/// The table of the journal codes of the product (`machines/product/journal.md`).
export fn product_journal_text() -> str => embed_str("../../machines/product/journal.md")

/// The registry of the methodology as data: the primitives and the sets of the types (`host_types(data, "session")`, `host_types(data, "runner")`).
export fn methodology_registry_data() -> HostRegistryData {
    match parse_registry_table(methodology_registry_text()) {
        Ok(data) => data
        Err(errors) => panic("the registry of the methodology is wrong: ${errors.join(" | ")}")
    }
}

/// The registry of the host "methodology": the language, the 58 primitives of the methodology and the codes of its journal.
export fn methodology_registry() -> Registry {
    match load_host(methodology_registry_text(), methodology_journal_text()) {
        Ok(reg) => reg
        Err(errors) => panic("the registry of the methodology is wrong: ${errors.join(" | ")}")
    }
}

/// The registry of the host "product": the language (the machines of the product call no primitive of their own) and the codes of the journal of the product.
export fn product_registry() -> Registry {
    match load_host("", product_journal_text()) {
        Ok(reg) => reg
        Err(errors) => panic("the registry of the product is wrong: ${errors.join(" | ")}")
    }
}

/// The table of the journal codes of both owners as one file (`journal.md` beside machines of both): the table of the methodology and the rows of the table of the product that it does not hold.
export fn all_journal_text() -> str {
    ro have = parse_journal(methodology_journal_text())
    mut text = methodology_journal_text().trim_ascii()
    for line in product_journal_text().split("\n") {
        ro cells = line.split("|")
        mut codes = []str.new()
        for c in cells { codes.push(c.trim_ascii()) }
        if codes.len() < 3 { continue }
        ro code = codes[2].replace("`", "")
        if line.starts_with("| ") && code != "Код события" && !code.starts_with("---") && journal_find(have, code).is_none() { text = "${text}\n${line}" }
    }
    "${text}\n"
}

/// The registry of the methodology and of the product together: the primitives of the methodology and the codes of both journals (a code that both tables hold - the four codes of the pair `dialog_steps` - once).
/// For the tests that run machines of both owners with one registry.
export fn all_registry() -> Registry {
    mut rows = parse_journal(methodology_journal_text())
    for row in parse_journal(product_journal_text()) {
        if journal_find(rows, row.code).is_none() { rows.push(row) }
    }
    match host_registry(methodology_registry_data(), rows) {
        Ok(reg) => reg
        Err(errors) => panic("the registry of both owners is wrong: ${errors.join(" | ")}")
    }
}

/// The machines of the methodology that a caller may call, each under the name of its machine: "Шаг агента" (`agent_step`), "Запуск сессии" (`session_start`, task 121) and "Проверка цикла"
/// (`cycle_check`, task 122), loaded from the JSON files compiled into the program. The runner of tasks (`task_runner`, task 123) calls the last two; the second calls the first and the third the
/// second, so the runner of the pairs runs several levels (task 123: the runner is recursive).
export fn methodology_nested() -> NestedRegistry {
    mut reg = NestedRegistry.empty()
    for name in ["agent_step", "session_start", "cycle_check"] {
        match load_alula_machine(text_of_file(machine_files(), "${name}.alula.json"), methodology_registry()) {
            Ok(m) => { reg = reg.add(m.def.name, m) }
            Err(e) => panic("the machine ${name} of the registry of the methodology does not load: ${e}")
        }
    }
    reg
}
