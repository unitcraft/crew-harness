/// The names of the files that the folders hold (read at compile time with `embed_dir`): `product_machines`, `methodology_machines`, `product_tables`, `methodology_tables` (the files of the folder itself),
/// `product_libraries` and `methodology_libraries` (`libs/…`), `product_scenarios`, `methodology_scenarios`; a test compares them with the lists above, so a file that is added to a folder and not to its list is found. `product_files` and `methodology_files` are every file of the folder
/// (a test proves there is no `*.alula.txt` among them: the one extension of a table is `.alula.md`, task 169).
export fn data_dir_names(dir str) -> []str {
    if dir == "product_machines" { return only_ending(embed_dir("../../machines/product").paths(), [".alula.json"]) }
    if dir == "methodology_machines" { return only_ending(embed_dir("../../machines/methodology").paths(), [".alula.json"]) }
    if dir == "product_tables" { return only_top(only_ending(embed_dir("../../machines/product").paths(), [".alula.md"])) }
    if dir == "methodology_tables" { return only_top(only_ending(embed_dir("../../machines/methodology").paths(), [".alula.md"])) }
    if dir == "product_libraries" { return only_libs(only_ending(embed_dir("../../machines/product").paths(), [".alula.md"])) }
    if dir == "methodology_libraries" { return only_libs(only_ending(embed_dir("../../machines/methodology").paths(), [".alula.md"])) }
    if dir == "product_files" { return embed_dir("../../machines/product").paths() }
    if dir == "methodology_files" { return embed_dir("../../machines/methodology").paths() }
    if dir == "product_scenarios" { return embed_dir("../../machines/product/tests").paths() }
    if dir == "methodology_scenarios" { return embed_dir("../../machines/methodology/tests").paths() }
    []str.new()
}

// The names of the files of the folder itself: `embed_dir` reads the folder recursively, the libraries lie in `libs/` beside the machines (Alula 2.26, section 9).
fn only_top(names []str) -> []str {
    mut out = []str.new()
    for n in names {
        if !n.contains("/") { out.push(n) }
    }
    out
}

// The names of the libraries beside the machines (`libs/…`).
fn only_libs(names []str) -> []str {
    mut out = []str.new()
    for n in names {
        if n.starts_with("libs/") { out.push(n) }
    }
    out
}

fn only_ending(names []str, suffixes []str) -> []str {
    mut out = []str.new()
    for n in names {
        for suffix in suffixes {
            if n.ends_with(suffix) { out.push(n) }
        }
    }
    out
}

/// The libraries that the tables connect (Alula 2.26, section 9; task 240), by the path beside a machine (`libs/pause.alula.md`, as the line `- Файл:` of a connection names it): of the
/// methodology «Пауза» and the arithmetic of the cycle with their English twins (the files of `libs/` of the package 0.9.0: the script of the migration put the Russian ones beside the machines,
/// the English ones are for the English sample of the agent step), of the product «Отмена запроса» (`machines/product/libs/`: the signal of the protocol of the cancel). A test that translates
/// a table passes them to the translator (with the called machines: `translation_files`).
export fn library_files() -> []NamedText => [
    NamedText { name: "libs/cycle_arithmetic.alula.md", text: embed_str("../../machines/methodology/libs/cycle_arithmetic.alula.md") },
    NamedText { name: "libs/cycle_arithmetic.en.alula.md", text: embed_str("../../machines/methodology/libs/cycle_arithmetic.en.alula.md") },
    NamedText { name: "libs/pause.alula.md", text: embed_str("../../machines/methodology/libs/pause.alula.md") },
    NamedText { name: "libs/pause.en.alula.md", text: embed_str("../../machines/methodology/libs/pause.en.alula.md") },
    NamedText { name: "libs/call_cancel.alula.md", text: embed_str("../../machines/product/libs/call_cancel.alula.md") }
]

/// The called machines of the methodology (Alula 0.27, AL-146): a party `machine <имя>` names no types, the translator takes the input and the result from the file of the called machine
/// beside the caller (`machine: <имя>` in its header). `agent_step` is called by `session_start`, `session_start` by `cycle_check` and `task_runner`, `cycle_check` by `task_runner`,
/// `meeting` by `cycle_check`: the file of the methodology as it is (its commit 1db4005, task 247), a called machine only: it has no tree, the program does not build it alone.
export fn callee_files() -> []NamedText => [
    NamedText { name: "agent_step.alula.md", text: embed_str("../../machines/methodology/agent_step.alula.md") },
    NamedText { name: "session_start.alula.md", text: embed_str("../../machines/methodology/session_start.alula.md") },
    NamedText { name: "cycle_check.alula.md", text: embed_str("../../machines/methodology/cycle_check.alula.md") },
    NamedText { name: "meeting.alula.md", text: embed_str("../../machines/methodology/meeting.alula.md") }
]

/// The files that a translation of a table is given: the libraries and the called machines.
export fn translation_files() -> []NamedText {
    mut out = library_files()
    for f in callee_files() { out.push(f) }
    out
}

/// The libraries put into the folder `dir` (`/m` -> `/m/libs/pause.alula.md`): for the program `alula` that a test runs on a folder of files.
export fn library_files_in(dir str) -> []NamedText {
    mut out = []NamedText.new()
    for f in library_files() { out.push(NamedText { name: "${dir}/${f.name}", text: f.text }) }
    out
}

/// Does a table call the machine of the file `callee` (`agent_step.alula.md`)? `session_start` calls the agent step by its Russian name `шаг_агента`.
fn calls_machine(text str, callee str) -> bool {
    ro name = callee.replace(".alula.md", "")
    if name == "agent_step" && text.contains("| machine шаг_агента") { return true }
    text.contains("| machine ${name}")
}

/// The called machines put into the folder `dir`: those that a table of the folder among `files` calls by a party `machine <имя>` (as the program `alula` reads the machine files beside
/// it), but for the files already there: a test that writes its own (changed) table keeps it. A machine that no table there calls is not put (the program would read it too).
export fn callee_files_in(dir str, files []NamedText) -> []NamedText {
    mut out = []NamedText.new()
    for c in callee_files() {
        ro name = "${dir}/${c.name}"
        mut there = false
        mut called = false
        for f in files {
            if f.name == name { there = true }
            if f.name.starts_with("${dir}/") && f.name.ends_with(".alula.md") && calls_machine(f.text, c.name) { called = true }
        }
        if called && !there { out.push(NamedText { name, text: c.text }) }
    }
    out
}

/// Does the machine connect a library (a tree with `"file": "libs/…"` among its connections, or a table with the line `- Файл: libs/…`)? On the package 0.9.0 such a machine does not go
/// through the English file (task 239, the test c222 of the package): the English text keeps the path of the Russian file of the library, and a library is read in the language of the machine
/// only (section 9). The circles of the tests go in Russian for it.
export fn connects_library(text str) -> bool => text.replace(" ", "").contains("\"file\":\"libs/") || text.contains("\n- Файл: libs/")

/// The text written by `render` of the package 0.9.0 with the event of a part in the form of 2.26: the generator writes `часть(agent_chunk { content: кусок })` (`part(agent_chunk { … })` in English),
/// the name of the part in brackets, which the translator of the same version refuses (since 2.26 the type of the part is named by the column `части` of the party: `часть { content: кусок }`).
/// A circle of the tests mends this one form and compares the rest (task 240; a finding for the package 0.9.1).
export fn part_mended(text str) -> str {
    mut lines = []str.new()
    for line in text.split("\n") {
        mut l = line
        for word in ["часть", "part"] {
            ro open = "| ${word}(agent_chunk { "
            if l.contains(open) {
                l = l.replace(open, "| ${word} { ")
                ro at = l.find(" }) |") ?? -1
                if at >= 0 { l = "${l[..at]} } |${l[at + 5..]}" }
            }
        }
        lines.push(l)
    }
    lines.join("\n")
}

