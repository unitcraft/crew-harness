// data.nv - the machines of the product and the machines of the methodology (kept here until task 159) as data, compiled into the program and the tests with `embed_str` (a path is read relative to this file):
// the JSON `kind: machine`, the tables, the scenarios, the registry of the primitives and the table of the journal codes of each owner (`machines/product/`, `machines/methodology/`). The package `alula` knows
// only the language (one primitive, 35 codes, spec 7a); the rest is registered here: `product_registry()` and `methodology_registry()` are the language and the data of the owner.
module crew_harness.machines

import alula.machine.{NamedText, Registry, text_of_file, HostRegistryData, parse_registry_table, load_host, host_registry, parse_journal, journal_find}
import alula.machine_run.{NestedRegistry, load_alula_machine}

/// The machines as JSON, by the name of the file (`chat.alula.json`): the product and the methodology.
export fn machine_files() -> []NamedText => [
    NamedText { name: "agent_step.alula.json", text: embed_str("../../machines/methodology/agent_step.alula.json") },
    NamedText { name: "chat.alula.json", text: embed_str("../../machines/product/chat.alula.json") },
    NamedText { name: "cycle_check.alula.json", text: embed_str("../../machines/methodology/cycle_check.alula.json") },
    NamedText { name: "dialog.alula.json", text: embed_str("../../machines/product/dialog.alula.json") },
    NamedText { name: "dialog_steps.alula.json", text: embed_str("../../machines/methodology/dialog_steps.alula.json") },
    NamedText { name: "session_start.alula.json", text: embed_str("../../machines/methodology/session_start.alula.json") },
    NamedText { name: "task_runner.alula.json", text: embed_str("../../machines/methodology/task_runner.alula.json") }
]

