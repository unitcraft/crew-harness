// data.nv - the machines of the product as data for the tests, read from the disk of the tree (`tree_text`, task 248: nothing is compiled in): the JSON `kind: machine`, the tables, the scenarios, the library and
// the table of the journal codes of the product (`machines/product/`). The package `alula` knows only the language (one primitive, 35 codes, spec 7a); `product_registry()` is the language and the codes
// of the product. The machines of the methodology left the product with task 249 (it closes task 159, their move): they live in the set of the methodology (its repository, `alula-machines/`).
module crew_harness.machines

// ORACLE-WORKAROUND(32): `std.fs` is imported first in the first file of the unit (the machines are read from the disk, task 248), or `.join` on a `[]str` is E_RECV_METHOD_MISMATCH (spikes/env/README.md, task 116 (e)); drop when item 32 is fixed
import std.fs.{Path}
import alula.machine.{NamedText, Registry, text_of_file, load_host}
import crew_harness.product_machines.{tree_text, tree_paths}

/// The machines as JSON, by the name of the file (`chat.alula.json`).
export fn machine_files() -> []NamedText => [
    NamedText { name: "chat.alula.json", text: tree_text("machines/product/chat.alula.json") },
    NamedText { name: "dialog.alula.json", text: tree_text("machines/product/dialog.alula.json") }
]

/// The machines written as tables, by the name of the file (`chat.alula.md`).
export fn table_files() -> []NamedText => [
    NamedText { name: "chat.alula.md", text: tree_text("machines/product/chat.alula.md") },
    NamedText { name: "dialog.alula.md", text: tree_text("machines/product/dialog.alula.md") }
]

