/// The names of the files that the folder of the product holds (read from the disk of the tree, `tree_paths`): `product_machines`, `product_tables` (the files of the folder itself), `product_libraries`
/// (`libs/…`), `product_scenarios`; a test compares them with the lists above, so a file that is added to the folder and not to its list is found. `product_files` is every file of the folder
/// (a test proves there is no `*.alula.txt` among them: the one extension of a table is `.alula.md`, task 169).
export fn data_dir_names(dir str) -> []str {
    if dir == "product_machines" { return only_ending(tree_paths("machines/product"), [".alula.json"]) }
    if dir == "product_tables" { return only_top(only_ending(tree_paths("machines/product"), [".alula.md"])) }
    if dir == "product_libraries" { return only_libs(only_ending(tree_paths("machines/product"), [".alula.md"])) }
    if dir == "product_files" { return tree_paths("machines/product") }
    if dir == "product_scenarios" { return tree_paths("machines/product/tests") }
    []str.new()
}

// The names of the files of the folder itself: `tree_paths` reads the folder recursively, the libraries lie in `libs/` beside the machines (Alula 2.26, section 9).
fn only_top(names []str) -> []str {
    mut out = []str.new()
    for n in names {
        if !n.contains("/") { out.push(n) }
    }
    out
}

// The names of the libraries beside the machines (`libs/…`).
fn only_libs(names []str) -> []str {
    mut out = []str.new()
    for n in names {
        if n.starts_with("libs/") { out.push(n) }
    }
    out
}

fn only_ending(names []str, suffixes []str) -> []str {
    mut out = []str.new()
    for n in names {
        for suffix in suffixes {
            if n.ends_with(suffix) { out.push(n) }
        }
    }
    out
}

/// The library that the tables connect (Alula 2.26, section 9; task 240), by the path beside a machine (`libs/call_cancel.alula.md`, as the line `- Файл:` of a connection names it): «Отмена запроса»
/// of the product (`machines/product/libs/`: the signal of the protocol of the cancel). A test that translates a table passes it to the translator (`translation_files`).
export fn library_files() -> []NamedText => [
    NamedText { name: "libs/call_cancel.alula.md", text: tree_text("machines/product/libs/call_cancel.alula.md") }
]

/// The files that a translation of a table is given: the libraries (the machines of the product call no other machine, so there is no called machine beside them).
export fn translation_files() -> []NamedText => library_files()

/// The libraries put into the folder `dir` (`/m` -> `/m/libs/call_cancel.alula.md`): for the program `alula` that a test runs on a folder of files.
export fn library_files_in(dir str) -> []NamedText {
    mut out = []NamedText.new()
    for f in library_files() { out.push(NamedText { name: "${dir}/${f.name}", text: f.text }) }
    out
}

/// Does the machine connect a library (a tree with `"file": "libs/…"` among its connections, or a table with the line `- Файл: libs/…`)? On the package 0.9.0 such a machine does not go
/// through the English file (task 239, the test c222 of the package): the English text keeps the path of the Russian file of the library, and a library is read in the language of the machine
/// only (section 9). The circles of the tests go in Russian for it.
export fn connects_library(text str) -> bool => text.replace(" ", "").contains("\"file\":\"libs/") || text.contains("\n- Файл: libs/")

/// The text written by `render` of the package 0.9.0 with the event of a part in the form of 2.26: the generator writes `часть(agent_chunk { content: кусок })` (`part(agent_chunk { … })` in English),
/// the name of the part in brackets, which the translator of the same version refuses (since 2.26 the type of the part is named by the column `части` of the party: `часть { content: кусок }`).
/// A circle of the tests mends this one form and compares the rest (task 240; a finding for the package 0.9.1).
export fn part_mended(text str) -> str {
    mut lines = []str.new()
    for line in text.split("\n") {
        mut l = line
        for word in ["часть", "part"] {
            ro open = "| ${word}(agent_chunk { "
            if l.contains(open) {
                l = l.replace(open, "| ${word} { ")
                ro at = l.find(" }) |") ?? -1
                if at >= 0 { l = "${l[..at]} } |${l[at + 5..]}" }
            }
        }
        lines.push(l)
    }
    lines.join("\n")
}

/// The text of the machine of the chat session (`machines/product/chat.alula.json`).
export fn chat_machine_text() -> str => text_of_file(machine_files(), "chat.alula.json")

/// The text of the machine of the many-turn chat session (`machines/product/dialog.alula.json`), the translation of `dialog.alula.md`: the machine that the session server runs.
export fn dialog_machine_text() -> str => text_of_file(machine_files(), "dialog.alula.json")

/// The text of the chat machine written as tables (`machines/product/chat.alula.md`).
export fn chat_table_text() -> str => text_of_file(table_files(), "chat.alula.md")

/// The text of the many-turn chat machine written as tables (`machines/product/dialog.alula.md`).
export fn dialog_table_text() -> str => text_of_file(table_files(), "dialog.alula.md")

/// The table of the journal codes of the product (`machines/product/journal.md`).
export fn product_journal_text() -> str => tree_text("machines/product/journal.md")

/// The registry of the host "product": the language (the machines of the product call no primitive of their own) and the codes of the journal of the product.
export fn product_registry() -> Registry {
    match load_host("", product_journal_text()) {
        Ok(reg) => reg
        Err(errors) => panic("the registry of the product is wrong: ${errors.join(" | ")}")
    }
}
