/// The names of the files that the folders hold (read at compile time with `embed_dir`): `product_machines`, `methodology_machines`, `product_tables`, `methodology_tables`, `product_scenarios`,
/// `methodology_scenarios`; a test compares them with the lists above, so a file that is added to a folder and not to its list is found.
export fn data_dir_names(dir str) -> []str {
    if dir == "product_machines" { return only_ending(embed_dir("../../machines/product").paths(), [".alula.json"]) }
    if dir == "methodology_machines" { return only_ending(embed_dir("../../machines/methodology").paths(), [".alula.json"]) }
    if dir == "product_tables" { return only_ending(embed_dir("../../machines/product").paths(), [".alula.md", ".alula.txt"]) }
    if dir == "methodology_tables" { return only_ending(embed_dir("../../machines/methodology").paths(), [".alula.md", ".alula.txt"]) }
    if dir == "product_scenarios" { return embed_dir("../../machines/product/scenarios").paths() }
    if dir == "methodology_scenarios" { return embed_dir("../../machines/methodology/scenarios").paths() }
    []str.new()
}

fn only_ending(names []str, suffixes []str) -> []str {
    mut out = []str.new()
    for n in names {
        for suffix in suffixes {
            if n.ends_with(suffix) { out.push(n) }
        }
    }
    out
}

/// The text of the machine of the chat session (`machines/product/chat.alula.json`).
export fn chat_machine_text() -> str => text_of_file(machine_files(), "chat.alula.json")

/// The text of the machine of the many-turn chat session (`machines/product/dialog.alula.json`), the translation of `dialog.alula.md`: the machine that the session server runs.
export fn dialog_machine_text() -> str => text_of_file(machine_files(), "dialog.alula.json")

/// The text of the machine of the agent step (`machines/methodology/agent_step.alula.json`), the translation of its table.
export fn agent_step_machine_text() -> str => text_of_file(machine_files(), "agent_step.alula.json")

/// The text of the agent step written as tables (`machines/methodology/agent_step.alula.txt`).
export fn agent_step_table_text() -> str => text_of_file(table_files(), "agent_step.alula.txt")

/// The text of the machine of the cycle check (`machines/methodology/cycle_check.alula.json`), the translation of `cycle_check.alula.md` (task 122).
export fn cycle_check_machine_text() -> str => text_of_file(machine_files(), "cycle_check.alula.json")

/// The text of the machine "Task runner" (`machines/methodology/task_runner.alula.json`), the translation of its table (task 123).
export fn task_runner_machine_text() -> str => text_of_file(machine_files(), "task_runner.alula.json")

/// The text of the task runner written as tables (`machines/methodology/task_runner.alula.md`).
export fn task_runner_table_text() -> str => text_of_file(table_files(), "task_runner.alula.md")

/// The text of the cycle check written as tables (`machines/methodology/cycle_check.alula.md`).
export fn cycle_check_table_text() -> str => text_of_file(table_files(), "cycle_check.alula.md")

/// The text of the chat machine written as tables (`machines/product/chat.alula.md`).
export fn chat_table_text() -> str => text_of_file(table_files(), "chat.alula.md")

/// The text of the many-turn chat machine written as tables (`machines/product/dialog.alula.md`).
export fn dialog_table_text() -> str => text_of_file(table_files(), "dialog.alula.md")

/// The text of the machine "Session start" (`machines/methodology/session_start.alula.json`), the translation of its table (task 121): the machine the runner calls for every session.
export fn session_start_machine_text() -> str => text_of_file(machine_files(), "session_start.alula.json")

/// The text of the machine "Session start" written as tables (`machines/methodology/session_start.alula.md`).
export fn session_start_table_text() -> str => text_of_file(table_files(), "session_start.alula.md")

/// The copy of the sample of the agent step of the specification (`machines/methodology/agent-step-sample.txt`, the same text as `spec/samples/agent-step.alula.md` of the package, links aside).
export fn agent_step_sample_text() -> str => embed_str("../../machines/methodology/agent-step-sample.txt")

/// The registry of the methodology as text (`machines/methodology/registry.md`): the 56 primitives, the roles of the parse, the sets of the types of the signatures.
export fn methodology_registry_text() -> str => embed_str("../../machines/methodology/registry.md")

/// The table of the journal codes of the methodology (`machines/methodology/journal.md`).
export fn methodology_journal_text() -> str => embed_str("../../machines/methodology/journal.md")

/// The table of the journal codes of the product (`machines/product/journal.md`).
export fn product_journal_text() -> str => embed_str("../../machines/product/journal.md")

/// The registry of the methodology as data: the primitives, the roles and the sets of the types (`host_types(data, "session")`, `host_types(data, "runner")`).
export fn methodology_registry_data() -> HostRegistryData {
    match parse_registry_table(methodology_registry_text()) {
        Ok(data) => data
        Err(errors) => panic("the registry of the methodology is wrong: ${errors.join(" | ")}")
    }
}

/// The registry of the host "methodology": the language, the 56 primitives of the methodology and the codes of its journal.
export fn methodology_registry() -> Registry {
    match load_host(methodology_registry_text(), methodology_journal_text()) {
        Ok(reg) => reg
        Err(errors) => panic("the registry of the methodology is wrong: ${errors.join(" | ")}")
    }
}

/// The registry of the host "product": the language (the machines of the product call no primitive of their own) and the codes of the journal of the product.
export fn product_registry() -> Registry {
    match load_host("", product_journal_text()) {
        Ok(reg) => reg
        Err(errors) => panic("the registry of the product is wrong: ${errors.join(" | ")}")
    }
}

/// The table of the journal codes of both owners as one file (`journal.md` beside machines of both): the table of the methodology and the rows of the table of the product that it does not hold.
export fn all_journal_text() -> str {
    ro have = parse_journal(methodology_journal_text())
    mut text = methodology_journal_text().trim_ascii()
    for line in product_journal_text().split("\n") {
        ro cells = line.split("|")
        mut codes = []str.new()
        for c in cells { codes.push(c.trim_ascii()) }
        if codes.len() < 3 { continue }
        ro code = codes[2].replace("`", "")
        if line.starts_with("| ") && code != "Код события" && !code.starts_with("---") && journal_find(have, code).is_none() { text = "${text}\n${line}" }
    }
    "${text}\n"
}

/// The registry of the methodology and of the product together: the primitives of the methodology and the codes of both journals (a code that both tables hold - the four codes of the pair `dialog_steps` - once).
/// For the tests that run machines of both owners with one registry.
export fn all_registry() -> Registry {
    mut rows = parse_journal(methodology_journal_text())
    for row in parse_journal(product_journal_text()) {
        if journal_find(rows, row.code).is_none() { rows.push(row) }
    }
    match host_registry(methodology_registry_data(), rows) {
        Ok(reg) => reg
        Err(errors) => panic("the registry of both owners is wrong: ${errors.join(" | ")}")
    }
}

/// The machines of the methodology that a caller may call, each under the name of its machine: "Шаг агента" (`agent_step`), "Запуск сессии" (`session_start`, task 121) and "Проверка цикла"
/// (`cycle_check`, task 122), loaded from the JSON files compiled into the program. The runner of tasks (`task_runner`, task 123) calls the last two; the second calls the first and the third the
/// second, so the runner of the pairs runs several levels (task 123: the runner is recursive).
export fn methodology_nested() -> NestedRegistry {
    mut reg = NestedRegistry.empty()
    for name in ["agent_step", "session_start", "cycle_check"] {
        match load_alula_machine(text_of_file(machine_files(), "${name}.alula.json"), methodology_registry()) {
            Ok(m) => { reg = reg.add(m.def.name, m) }
            Err(e) => panic("the machine ${name} of the registry of the methodology does not load: ${e}")
        }
    }
    reg
}
