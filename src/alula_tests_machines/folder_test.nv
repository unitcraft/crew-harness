// folder_test.nv - task 116: `alula test` on the folder `src/machine/` (the machines and the scenarios of the product) passes every scenario; `alula run` passes every scenario
// of the agent step one by one (the rows are taken by the scenarios: task 109), of the chat, of the small machines; a scenario that is changed is a report.
module crew_harness.alula_tests_machines

import std.fs.{Path}
import std.text
import alula.machine.{NamedText, text_of_file}
import crew_harness.machines.{agent_step_table_text, chat_table_text, machine_files, test_files, table_files}

test "ps scenario families" {
    // the families of the folder (the total grows with the machines: task 114 added the 37 of the dialog)
    assert(tests_with("agent-step-").len() == 83)
    assert(tests_with("chat-").len() == 39)
    assert(tests_with("dialog-").len() == 37)
    assert(tests_with("nested-steps-").len() == 6)
    assert(tests_with("cycle-").len() == 102)
    assert(tests_with("session-").len() == 63)
    assert(tests_with("runner-").len() == 260)
    assert(test_files().len() == 595)
}

// ---- nested machines (task 119): a parent and the machines it calls are found in the folder ------------------------------------------------------------

test "ps test folder from a table only" {
    // no JSON of the chat in the folder: the machine is read from its table
    mut files = [NamedText { name: "/c/chat.alula.md", text: chat_table_text() }]
    for s in tests_with("chat-") { files.push(NamedText { name: "/c/${s.name}", text: s.text }) }
    ro ran = run_with(["test", "/c"], files)
    assert(ran.err == "")
    assert(ran.out == "39 of 39 tests passed\n")
    assert(ran.code == 0)
}

test "ps test folder agent step table" {
    // the table of the agent step (format 2.5, the copy `.txt`) runs the scenarios like its JSON
    mut files = [NamedText { name: "/a/agent_step.alula.md", text: agent_step_table_text() }]
    mut n = 0
    for s in tests_with("agent-step-flow") {
        files.push(NamedText { name: "/a/${s.name}", text: s.text })
        n += 1
    }
    ro ran = run_with(["test", "/a"], files)
    assert(ran.err == "")
    assert(ran.out == "${n} of ${n} tests passed\n")
    assert(ran.code == 0)
}

test "ps run agent step one by one a" {
    ro all = tests_with("agent-step-agent")
    assert(all.len() == 9)
    assert(run_all("agent_step.alula.json", text_of_file(machine_files(), "agent_step.alula.json"), all) == "")
}

test "ps run agent step one by one b" {
    ro all = tests_with("agent-step-b")
    assert(all.len() == 4)
    assert(run_all("agent_step.alula.json", text_of_file(machine_files(), "agent_step.alula.json"), all) == "")
}

test "ps run agent step one by one c" {
    ro all = tests_with("agent-step-c")
    assert(all.len() == 7)
    assert(run_all("agent_step.alula.json", text_of_file(machine_files(), "agent_step.alula.json"), all) == "")
}

test "ps run agent step one by one e" {
    ro all = tests_with("agent-step-e")
    assert(all.len() == 13)
    assert(run_all("agent_step.alula.json", text_of_file(machine_files(), "agent_step.alula.json"), all) == "")
}

test "ps run agent step one by one f" {
    ro all = tests_with("agent-step-f")
    assert(all.len() > 10)
    assert(run_all("agent_step.alula.json", text_of_file(machine_files(), "agent_step.alula.json"), all) == "")
}

test "ps run agent step one by one rest" {
    mut rest = []NamedText.new()
    for s in tests_with("agent-step-") {
        ro name = s.name["agent-step-".byte_len()..]
        if !(name.starts_with("agent") || name.starts_with("b") || name.starts_with("c") || name.starts_with("e") || name.starts_with("f")) { rest.push(s) }
    }
    assert(rest.len() > 0)
    assert(run_all("agent_step.alula.json", text_of_file(machine_files(), "agent_step.alula.json"), rest) == "")
}

test "ps run chat one by one" {
    ro all = tests_with("chat-")
    assert(all.len() == 39)
    assert(run_all("chat.alula.json", text_of_file(machine_files(), "chat.alula.json"), all) == "")
}

test "ps run chat from its table" {
    ro all = tests_with("chat-m")
    assert(all.len() > 0)
    assert(run_all("chat.alula.md", chat_table_text(), all) == "")
}

test "ps changed agent step scenario" {
    ro original = text_of_file(test_files(), "agent-step-flow-happy.alula.test.json")
    ro changed = original.replace("\"outcome\": \"answer", "\"outcome\": \"refusal")
    ro files = [
        NamedText { name: "/g/agent_step.alula.json", text: text_of_file(machine_files(), "agent_step.alula.json") },
        NamedText { name: "/g/happy.alula.test.json", text: changed }
    ]
    ro ran = run_with(["run", "/g/agent_step.alula.json", "/g/happy.alula.test.json"], files)
    assert(changed != original)
    assert(ran.code == 1)
    assert(ran.out.contains("difference(s)"))
}
