// folder_test.nv - task 116: `alula test` on the folder of the machines of the product passes every scenario; `alula run` passes every scenario of the chat and of the dialog one by one
// (the rows are taken by the scenarios: task 109); a scenario that is changed is a report. The scenarios of the agent step left the product with the methodology (task 249).
module crew_harness.alula_tests_machines

import std.fs.{Path}
import std.text
import alula.machine.{NamedText, text_of_file}
import crew_harness.machines.{chat_table_text, dialog_table_text, machine_files, test_files, table_files}

test "ps scenario families" {
    // the families of the folder (task 114 added the 37 of the dialog, task 151 the 5 of the free input)
    assert(tests_with("chat-").len() == 39)
    assert(tests_with("dialog-").len() == 37)
    assert(tests_with("free-input-").len() == 5)
    assert(tests_with("agent-step-").len() == 0)
    assert(test_files().len() == 81)
}

test "ps test folder from a table only" {
    // no JSON of the chat in the folder: the machine is read from its table
    mut files = [NamedText { name: "/c/chat.alula.md", text: chat_table_text() }]
    for s in tests_with("chat-") { files.push(NamedText { name: "/c/${s.name}", text: s.text }) }
    ro ran = run_with(["test", "/c"], files)
    assert(ran.err == "")
    assert(ran.out == "39 of 39 tests passed\n")
    assert(ran.code == 0)
}

test "ps test folder dialog table" {
    // the table of the dialog runs its scenarios like its JSON
    mut files = [NamedText { name: "/a/dialog.alula.md", text: dialog_table_text() }]
    for s in tests_with("dialog-") { files.push(NamedText { name: "/a/${s.name}", text: s.text }) }
    ro ran = run_with(["test", "/a"], files)
    assert(ran.err == "")
    assert(ran.out == "37 of 37 tests passed\n")
    assert(ran.code == 0)
}

test "ps run dialog one by one" {
    ro all = tests_with("dialog-")
    assert(all.len() == 37)
    assert(run_all("dialog.alula.json", text_of_file(machine_files(), "dialog.alula.json"), all) == "")
}

test "ps run chat one by one" {
    ro all = tests_with("chat-")
    assert(all.len() == 39)
    assert(run_all("chat.alula.json", text_of_file(machine_files(), "chat.alula.json"), all) == "")
}

test "ps run chat from its table" {
    ro all = tests_with("chat-m")
    assert(all.len() > 0)
    assert(run_all("chat.alula.md", chat_table_text(), all) == "")
}

test "ps changed chat scenario" {
    ro original = text_of_file(test_files(), "chat-chunks-and-done.alula.test.json")
    ro changed = original.replace("\"outcome\": \"answer", "\"outcome\": \"refusal")
    ro files = [
        NamedText { name: "/g/chat.alula.json", text: text_of_file(machine_files(), "chat.alula.json") },
        NamedText { name: "/g/c.alula.test.json", text: changed }
    ]
    ro ran = run_with(["run", "/g/chat.alula.json", "/g/c.alula.test.json"], files)
    assert(changed != original)
    assert(ran.code == 1)
    assert(ran.out.contains("difference(s)"))
}
