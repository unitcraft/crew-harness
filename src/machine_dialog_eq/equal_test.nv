// equal_test.nv - the proof of equality of the many-turn chat (task 114): the machine written as data (`dialog.alula.json`, run by `AlulaMachine`) and the machine on Nova
// (`dialog_session`, `src/chat`) give the same sequence on the same scenarios - the state, the events of the journal, the data, the queue - at the level of the machine (one step) and
// of the engine (journal lines with the envelope, sent and cancelled requests, the outcome, the acknowledgements). The scenarios are the files `dialog-*` of `machines/product/tests`:
// the single-turn scenarios of `chat_engine_test.nv` moved to the many-turn machine and the scenarios of `dialog_test.nv`.
module crew_harness.machine_dialog_eq

// ORACLE-WORKAROUND(32): `std.fs` is imported first in the first file of the unit (the machines are read from the disk, task 248), or `.join` on a `[]str` is E_RECV_METHOD_MISMATCH (spikes/env/README.md, task 116 (e)); drop when item 32 is fixed
import std.fs.{Path}
// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import std.encoding.json.{Json, JsonObject}
import alula.machine.{Int}
import crew_harness.product_machines.{test_files, product_registry, dialog_machine_text}
import alula.engine.{Incoming, EventKind, Order, StepEnvironment, FailCode, journal_line, fail_code_word}
import crew_harness.chat.{ChatState, ChatSession, dialog_session, encode_chat_state}
import alula.machine_run.{AlulaState, AlulaMachine, ProjectValue, Test, StepTrace, ScEvent, load_alula_machine_with, alula_step, ScriptedHost, drive_test, parse_test, test_incoming, state_data_fields}
import alula.machine_table.{fail_code_names}

const TERM = 30000

// ORACLE-WORKAROUND(51): the table of the project is built by a function, not by a literal inside the `match` that loads the machine; write it in place when item 51 is fixed
fn term_values() -> []ProjectValue => [ProjectValue { key: "проект.срок_бездействия", value: Int(TERM) }]

fn table_dialog() -> AlulaMachine {
    match load_alula_machine_with(dialog_machine_text(), product_registry(), term_values()) {
        Ok(m) => m
        Err(e) => panic("the dialog machine does not load: ${e}")
    }
}

fn nova_dialog() -> ChatSession => dialog_session(TERM)

// The scenarios of the many-turn machine that both machines can run: the files `dialog-*` but the ones that name a way only the table has.
fn dialog_scenarios() -> []Test {
    mut out = []Test.new()
    for f in test_files() {
        if !f.name.starts_with("dialog-") { continue }
        match parse_test(f.text) {
            Ok(sc) => {
                if sc.machine == "DialogSession" && !sc.name.starts_with("(table only)") { out.push(sc) }
            }
            Err(e) => panic("${f.name}: ${e.path}: ${e.message}")
        }
    }
    out
}

fn text_field(o JsonObject, key str) -> str {
    match o.get(key) {
        Some(v) => match v.str() {
            Some(s) => s
            None => ""
        }
        None => ""
    }
}

// The datum view that both machines can show: the name of the state and what that state holds. Idle holds nothing, Awaiting the message and the reply.
fn nova_view(encoded str) -> str {
    match Json.parse(encoded) {
        Ok(j) => match j.object() {
            Some(o) => {
                ro name = text_field(o, "state")
                if name == "Awaiting" { return "Awaiting|${text_field(o, "user")}|${text_field(o, "reply")}" }
                if name == "Idle" { return "Idle||" }
                name
            }
            None => "?"
        }
        Err(e) => "?"
    }
}

fn table_view(encoded str) -> str {
    match Json.parse(encoded) {
        Ok(j) => match j.object() {
            Some(o) => {
                ro name = text_field(o, "state")
                ro data = state_data_fields(encoded)
                if name == "Awaiting" || name == "Idle" { return "${name}|${text_field(data, "user")}|${text_field(data, "reply")}" }
                name
            }
            None => "?"
        }
        Err(e) => "?"
    }
}

fn entry_lines(t StepTrace) -> []str {
    mut out = []str.new()
    for e in t.entries { out.push(journal_line(e)) }
    out
}

fn same_list(xs []str, ys []str) -> bool {
    if xs.len() != ys.len() { return false }
    mut i = 0
    while i < xs.len() {
        if xs[i] != ys[i] { return false }
        i += 1
    }
    true
}

// The two traces of a step compared; "" when equal, else what differs.
fn trace_diff(nova StepTrace, table StepTrace) -> str {
    if nova.state != table.state { return "state ${nova.state} / ${table.state}" }
    if nova_view(nova.encoded) != table_view(table.encoded) { return "data ${nova_view(nova.encoded)} / ${table_view(table.encoded)}" }
    if !same_list(nova.journal, table.journal) { return "journal ${nova.journal.join(";")} / ${table.journal.join(";")}" }
    if !same_list(entry_lines(nova), entry_lines(table)) { return "journal lines ${entry_lines(nova).join(";")} / ${entry_lines(table).join(";")}" }
    if !same_list(nova.open, table.open) { return "open ${nova.open.join(",")} / ${table.open.join(",")}" }
    if !same_list(nova.sent, table.sent) { return "sent ${nova.sent.join(",")} / ${table.sent.join(",")}" }
    if !same_list(nova.cancelled, table.cancelled) { return "cancelled ${nova.cancelled.join(",")} / ${table.cancelled.join(",")}" }
    if !same_list(nova.queue, table.queue) { return "queue ${nova.queue.join(",")} / ${table.queue.join(",")}" }
    if !same_list(nova.acked, table.acked) { return "acked ${nova.acked.join(",")} / ${table.acked.join(",")}" }
    if nova.outcome != table.outcome { return "outcome ${nova.outcome} / ${table.outcome}" }
    if nova.number != table.number { return "step number ${nova.number} / ${table.number}" }
    ""
}

// ---- the machine level: one step on each machine ----------------------------------------------------------------------

// The orders as text, as in the tests of the chat.
fn order_text(orders []Order) -> str {
    mut parts = []str.new()
    for o in orders {
        match o {
            Send(order) => parts.push("send:${order.party}:${order.input}:${order.idle_term}")
            Note(event) => {
                mut ps = []str.new()
                for p in event.params { ps.push("${p.name}=${p.value}") }
                parts.push("log:${event.code}(${ps.join(";")})")
            }
            Cancel(order) => parts.push("cancel:${order.party}")
            Save => parts.push("save")
            Finish(c) => match c.failure {
                Some(code) => parts.push("finish:refusal:${code.name()}:${c.text}")
                None => parts.push("finish:answer:${c.text}")
            }
        }
    }
    parts.join(",")
}

type Pair { nova_state ChatState, table_state AlulaState, nova_text str, table_text str, nova_moved bool, table_moved bool }

fn first_pair(table AlulaMachine) -> Pair {
    Pair {
        nova_state: nova_dialog().initial(), table_state: table.initial(), nova_text: "", table_text: "",
        nova_moved: false, table_moved: false
    }
}

fn step_pair(table AlulaMachine, p Pair, event Incoming) -> Pair {
    mut ne = StepEnvironment.new()
    ro nt = nova_dialog().step(p.nova_state, event, ne)
    mut te = StepEnvironment.new()
    mut host = ScriptedHost { at: event.at, replies: table.replies, ids: 0 }
    ro tt = alula_step(table, p.table_state, event, te, host)
    ro next_nova = match nt {
        Go(s) => s
        Stay => p.nova_state
    }
    ro nova_moved = match nt {
        Go(s) => true
        Stay => false
    }
    ro next_table = match tt {
        Go(s) => s
        Stay => p.table_state
    }
    ro table_moved = match tt {
        Go(s) => true
        Stay => false
    }
    Pair {
        nova_state: next_nova, table_state: next_table, nova_text: order_text(ne.orders), table_text: order_text(te.orders),
        nova_moved, table_moved
    }
}

fn pair_diff(table AlulaMachine, p Pair) -> str {
    if p.nova_text != p.table_text { return "orders ${p.nova_text} / ${p.table_text}" }
    if p.nova_moved != p.table_moved { return "moved ${p.nova_moved} / ${p.table_moved}" }
    ro nova_text_view = nova_view(encode_chat_state(p.nova_state))
    ro table_text_view = table_view(table.encode_state(p.table_state))
    if nova_text_view != table_text_view { return "state ${nova_text_view} / ${table_text_view}" }
    if nova_dialog().state_name(p.nova_state) != table.state_name(p.table_state) { return "state name" }
    ""
}

fn events_of(sc Test) -> []Incoming {
    mut out = []Incoming.new()
    for s in sc.steps {
        if s.event.kind != "" { out.push(test_incoming(s.event)) }
    }
    out
}

// ORACLE-WORKAROUND(12, 13, 26): `drive_test[ChatState, ChatSession](...)` and `drive_test[AlulaState, AlulaMachine](...)` write the type arguments out here and in the tests below; infer them when items 12 and 13 are fixed
fn first_run_diff(table AlulaMachine, sc Test) -> str {
    ro nova = drive_test[ChatState, ChatSession](nova_dialog(), sc)
    ro tab = drive_test[AlulaState, AlulaMachine](table, sc)
    if nova.len() != tab.len() { return "${sc.name}: ${nova.len()} traces / ${tab.len()}" }
    mut i = 0
    while i < nova.len() {
        ro d = trace_diff(nova[i], tab[i])
        if d != "" { return "${sc.name}, step ${i + 1}: ${d}" }
        i += 1
    }
    ""
}

fn machine_run_diff(table AlulaMachine, sc Test) -> str {
    mut p = first_pair(table)
    mut i = 0
    for e in events_of(sc) {
        p = step_pair(table, p, e)
        ro d = pair_diff(table, p)
        if d != "" { return "${sc.name}, event ${i + 1}: ${d}" }
        i += 1
    }
    ""
}

test "de engine level" {
    ro table = table_dialog()
    ro all = dialog_scenarios()
    assert(all.len() >= 36)
    mut steps = 0
    for sc in all {
        ro d = first_run_diff(table, sc)
        if d != "" { panic(d) }
        steps += sc.steps.len()
    }
    assert(steps == 154)
}

test "de machine level" {
    ro table = table_dialog()
    mut events = 0
    for sc in dialog_scenarios() {
        ro d = machine_run_diff(table, sc)
        if d != "" { panic(d) }
        events += events_of(sc).len()
    }
    assert(events >= 100)
}

fn signal_with_input(name str, input str) -> Incoming => test_incoming(ScEvent { kind: "signal", name, request: "", input, code: "", source: "", party: "", has_at: false, at: 0 })
fn signal_event(name str) -> Incoming => test_incoming(ScEvent { kind: "signal", name, request: "", input: "", code: "", source: "", party: "", has_at: false, at: 0 })
fn chunk_event(request str, text str) -> Incoming => test_incoming(ScEvent { kind: "progress", name: "agent_chunk", request, input: text, code: "", source: "", party: "", has_at: false, at: 0 })
fn named_progress(name str, input str) -> Incoming => test_incoming(ScEvent { kind: "progress", name, request: "agent-1", input, code: "", source: "", party: "", has_at: false, at: 0 })
fn done_event(request str) -> Incoming => test_incoming(ScEvent { kind: "answer", name: "agent_done", request, input: "", code: "", source: "", party: "", has_at: false, at: 0 })
fn refused_event(request str, code str) -> Incoming => test_incoming(ScEvent { kind: "failure", name: "agent_refused", request, input: "", code, source: "", party: "", has_at: false, at: 0 })
fn timeout_event(request str) -> Incoming => test_incoming(ScEvent { kind: "timeout", name: "timeout", request, input: "", code: "", source: "", party: "", has_at: false, at: 0 })

// Every kind of event the machine knows and some it does not, for the machine alone (the engine would discard some of them before they reach it).
fn all_events() -> []Incoming => [
    signal_with_input("user_message", "hello"), signal_with_input("user_message", "привет, мир"), signal_with_input("cancel_request", ""), signal_event("cancel_request"),
    signal_with_input("weather_report", "rain"), chunk_event("agent-1", "part"), named_progress("tool_call", "{}"), named_progress("permission_request", "{}"),
    done_event("agent-1"), refused_event("agent-1", "Timeout"), refused_event("agent-1", "TotallyNew"), timeout_event("agent-1")
]

// The three places of the machine: the start, a turn that is open, a turn that has ended.
fn places(table AlulaMachine) -> []Pair {
    ro start = first_pair(table)
    ro open = step_pair(table, start, signal_with_input("user_message", "first"))
    ro mid = step_pair(table, open, chunk_event("agent-1", "some "))
    ro ended = step_pair(table, mid, done_event("agent-1"))
    [start, open, mid, ended]
}

test "de every event in every place" {
    ro table = table_dialog()
    mut checked = 0
    for p in places(table) {
        assert(pair_diff(table, p) == "")
        for e in all_events() {
            ro after = step_pair(table, p, e)
            ro d = pair_diff(table, after)
            if d != "" { panic("${nova_dialog().state_name(p.nova_state)}, ${e.name}: ${d}") }
            checked += 1
        }
    }
    assert(checked == 48)
}

test "de every code" {
    ro table = table_dialog()
    for code in FailCode.all() {
        mut p = first_pair(table)
        p = step_pair(table, p, signal_with_input("user_message", "hi"))
        assert(pair_diff(table, p) == "")
        p = step_pair(table, p, refused_event("agent-1", code.name()))
        assert(pair_diff(table, p) == "")
        assert(p.nova_text == p.table_text)
        assert(p.table_text.contains("agent_refused(code=${fail_code_word(code)})"))
        assert(!p.table_text.contains("finish"))
        assert(table.state_name(p.table_state) == "Idle")
    }
}

test "de many turns on the machine alone" {
    ro table = table_dialog()
    mut p = first_pair(table)
    mut turn = 0
    while turn < 5 {
        p = step_pair(table, p, signal_with_input("user_message", "m${turn}"))
        ro opened = pair_diff(table, p)
        if opened != "" { panic("turn ${turn}, the message: ${opened}") }
        assert(table.state_name(p.table_state) == "Awaiting")
        // the events of a turn answer the request of that turn: since Alula 2.26 the open requests are data of the machine (the library `контракт`), and the machine itself drops an answer
        // to a closed request, which the machine on Nova leaves to the engine
        ro request = "agent-${turn + 1}"
        p = step_pair(table, p, chunk_event(request, "r${turn}"))
        assert(pair_diff(table, p) == "")
        if turn == 0 { p = step_pair(table, p, done_event(request)) }
        if turn == 1 { p = step_pair(table, p, refused_event(request, "ModelRefused")) }
        if turn == 2 { p = step_pair(table, p, timeout_event(request)) }
        if turn == 3 { p = step_pair(table, p, signal_event("cancel_request")) }
        if turn == 4 { p = step_pair(table, p, done_event(request)) }
        assert(pair_diff(table, p) == "")
        assert(table.state_name(p.table_state) == "Idle")
        turn += 1
    }
}

test "de names" {
    ro table = table_dialog()
    assert(nova_dialog().name() == table.name())
    assert(table.name() == "DialogSession")
    assert(nova_dialog().state_name(nova_dialog().initial()) == table.state_name(table.initial()))
    assert(nova_view(encode_chat_state(nova_dialog().initial())) == table_view(table.encode_state(table.initial())))
}

test "de state text" {
    ro table = table_dialog()
    for bad in ["", "not json", "{\"state\":\"Mystery\"}", "{\"state\":1}", "[]"] {
        assert(nova_dialog().decode_state(bad) == None)
        assert(table.decode_state(bad) == None)
    }
    mut p = first_pair(table)
    for e in events_of(dialog_scenarios()[0]) { p = step_pair(table, p, e) }
    ro text = table.encode_state(p.table_state)
    match table.decode_state(text) {
        Some(back) => assert(table.encode_state(back) == text)
        None => assert(false)
    }
    // a state of the single-turn session is not a state of the dialog machine
    assert(table.decode_state("{\"state\":\"Done\",\"started\":true,\"input\":null,\"data\":null}") == None)
}

test "de closed list" {
    mut engine_names = []str.new()
    for c in FailCode.all() { engine_names.push(c.name()) }
    assert(same_list(engine_names, fail_code_names()))
}

test "de same twice" {
    ro table = table_dialog()
    for sc in dialog_scenarios() {
        ro first = drive_test[AlulaState, AlulaMachine](table, sc)
        ro second = drive_test[AlulaState, AlulaMachine](table, sc)
        assert(first.len() == second.len())
        mut i = 0
        while i < first.len() {
            assert(first[i].encoded == second[i].encoded)
            assert(same_list(entry_lines(first[i]), entry_lines(second[i])))
            i += 1
        }
    }
}

fn scenario_named(name str) -> Test {
    for sc in dialog_scenarios() {
        if sc.name.contains(name) { return sc }
    }
    panic("no scenario with ${name}")
}

test "de death between" {
    ro table = table_dialog()
    ro sc = scenario_named("death after the commit of the second turn")
    ro nova = drive_test[ChatState, ChatSession](nova_dialog(), sc)
    ro tab = drive_test[AlulaState, AlulaMachine](table, sc)
    assert(tab[2].sent.len() == 1)
    assert(tab[2].queue.len() == 1)
    assert(tab[3].sent.len() == 1)
    assert(tab[4].sent.len() == 2)
    assert(tab[4].sent[1] == "agent-2")
    assert(tab[6].sent.len() == 2)
    assert(tab[6].open.len() == 1)
    mut i = 0
    while i < nova.len() {
        assert(trace_diff(nova[i], tab[i]) == "")
        i += 1
    }
}

test "de other side" {
    ro table = table_dialog()
    ro sc = scenario_named("the cancel arrives in the window")
    ro nova = drive_test[ChatState, ChatSession](nova_dialog(), sc)
    ro tab = drive_test[AlulaState, AlulaMachine](table, sc)
    assert(tab[0].queue.len() == 1)
    assert(tab[1].state == "Idle")
    assert(tab[1].queue.len() == 2)
    assert(tab[1].outcome == "none")
    assert(tab[2].sent.len() == 1)
    assert(tab[2].cancelled.len() == 1)
    mut i = 0
    while i < nova.len() {
        assert(trace_diff(nova[i], tab[i]) == "")
        i += 1
    }
}

test "de restart agrees" {
    ro table = table_dialog()
    for part in ["restart after the request", "restart after the answer", "a restart acknowledges", "restart in the middle", "death after the cancel"] {
        ro sc = scenario_named(part)
        assert(first_run_diff(table, sc) == "")
    }
}

test "de ack agrees" {
    ro table = table_dialog()
    for part in ["is acknowledged after the commit", "discarded event with a key", "the agent answers while the process is dead"] {
        ro sc = scenario_named(part)
        ro nova = drive_test[ChatState, ChatSession](nova_dialog(), sc)
        ro tab = drive_test[AlulaState, AlulaMachine](table, sc)
        assert(tab[tab.len() - 1].acked.len() >= 1)
        assert(same_list(nova[nova.len() - 1].acked, tab[tab.len() - 1].acked))
    }
}

test "de the way only the table has" {
    // the signal close_session ends the session in the table; the machine on Nova does not know it (an event of an unknown name is a note)
    ro table = table_dialog()
    mut p = first_pair(table)
    p = step_pair(table, p, signal_with_input("close_session", ""))
    assert(p.nova_text == "log:event_unknown(name=close_session)")
    assert(p.table_text == "log:session_closed(),finish:answer:closed,save")
    assert(table.state_name(p.table_state) == "Closed")
    assert(nova_dialog().state_name(p.nova_state) == "Idle")
    // the scenario of the way is not in the shared list
    mut named = 0
    for f in test_files() {
        if f.name == "dialog-closed-table-only.alula.test.json" { named += 1 }
    }
    assert(named == 1)
    for sc in dialog_scenarios() { assert(!sc.name.starts_with("(table only)")) }
}
