// inject_test.nv - the deaths and the old journals that a scenario file cannot write (task 114): the tests of `dialog_test.nv` and `chat_engine_test.nv` that put lines into the journal by hand or
// ask for the history run on both machines of the many-turn chat (`dialog_session` on Nova and `PortolanMachine` over `dialog.portolan.json`) and give the same observations.
module crew_harness.machine_dialog_eq

import std.text
import std.encoding.json.{JsonValue, JsonObject}
import crew_harness.machine.{standard_registry, dialog_machine_text, Int}
import crew_harness.engine.{Machine, Engine, MemoryWorld, Incoming, JournalEntry, Journal, Store, Link, start_engine, resume_engine, memory_journal, memory_store, memory_link, memory_time, journal_line, journal_event, param}
import crew_harness.chat.{ChatState, ChatSession, dialog_session, user_says, user_cancels, agent_chunk, agent_done}
import crew_harness.machine_run.{PortolanState, PortolanMachine, ProjectValue, load_portolan_machine_with}

fn ij_values() -> []ProjectValue => [ProjectValue { key: "проект.срок_бездействия", value: Int(30000) }]

fn ij_table() -> PortolanMachine {
    match load_portolan_machine_with(dialog_machine_text(), standard_registry(), ij_values()) {
        Ok(m) => m
        Err(e) => panic("the dialog machine does not load: ${e}")
    }
}

fn ij_nova() -> ChatSession => dialog_session(30000)

fn ij_begin[S, M Machine[S]](machine M, mut world MemoryWorld) -> Engine[M, S] {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        start_engine[S, M](machine, "dlg-1")
    }
}

fn ij_resumed[S, M Machine[S]](machine M, mut world MemoryWorld) -> Engine[M, S] {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        match resume_engine[S, M](machine, "dlg-1") {
            Some(e) => e
            None => panic("no snapshot to resume from")
        }
    }
}

fn ij_feed[S, M Machine[S]](mut e Engine[M, S], mut world MemoryWorld, event Incoming) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.feed(event)
    }
}

fn ij_accept[S, M Machine[S]](mut e Engine[M, S], mut world MemoryWorld, event Incoming) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.on_arrival(event)
    }
}

fn ij_dispatch[S, M Machine[S]](mut e Engine[M, S], mut world MemoryWorld) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.dispatch()
    }
}

fn ij_pump[S, M Machine[S]](mut e Engine[M, S], mut world MemoryWorld) -> int {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.pump()
    }
}

fn ij_name[S, M Machine[S]](machine M, e Engine[M, S]) -> str => machine.state_name(e.state())

fn ij_count(world MemoryWorld, code str) -> int {
    mut n = 0
    for entry in world.journal_entries() {
        if entry.event.code == code { n += 1 }
    }
    n
}

// What the world shows after a run: the lines of the journal with the envelope, the requests sent and cancelled, the keys acknowledged.
fn ij_world_text(world MemoryWorld) -> str {
    mut parts = []str.new()
    for line in world.journal { parts.push(line) }
    mut sent = []str.new()
    for r in world.sent { sent.push(r.id) }
    parts.push("sent=${sent.join(",")}")
    parts.push("cancelled=${world.cancelled.join(",")}")
    parts.push("acked=${world.acked.join(",")}")
    parts.join("\n")
}

fn ij_same(a []str, b []str) -> bool {
    if a.len() != b.len() { return false }
    mut i = 0
    while i < a.len() {
        if a[i] != b[i] { return false }
        i += 1
    }
    true
}

// ---- death between the journal line and the snapshot of the answer (dialog_test.nv) --------------------------------------------------

fn dead_answer_line(trace str, step int) -> JournalEntry => {
    trace, step, cause: "answered-9", state: "Awaiting", request: "agent-1", at: 1500,
    event: journal_event("event_accepted", [param("kind", "answered"), param("name", "agent_done"), param("source", "acp-1")])
}

fn dead_answer_run[S, M Machine[S]](machine M) -> []str {
    mut world = MemoryWorld.at(1000)
    mut e1 = ij_begin[S, M](machine, world)
    ij_feed[S, M](e1, world, user_says("one"))
    // the lines of the step of the answer are written, the snapshot of that step is not: the step did not commit
    world.journal.push(journal_line(dead_answer_line(e1.trace(), e1.step_number() + 1)))
    world.deliver(Incoming.from_source("acp-1", agent_done("agent-1")))
    mut e2 = ij_resumed[S, M](machine, world)
    mut out = []str.new()
    out.push(ij_name[S, M](machine, e2))
    out.push("pumped=${ij_pump[S, M](e2, world)}")
    out.push(ij_name[S, M](machine, e2))
    out.push("discarded=${ij_count(world, "reply_discarded")}")
    out.push(ij_world_text(world))
    out
}

test "ij death between the line and the snapshot of the answer" {
    ro nova = dead_answer_run[ChatState, ChatSession](ij_nova())
    ro table = dead_answer_run[PortolanState, PortolanMachine](ij_table())
    assert(ij_same(nova, table))
    assert(table[0] == "Awaiting")
    assert(table[1] == "pumped=1")
    assert(table[2] == "Idle")
    assert(table[3] == "discarded=0")
}

// ---- dead step lines are not committed after the next restart (chat_engine_test.nv) -------------------------------------------------

fn dead_event_line(trace str, step int, key str) -> JournalEntry => {
    trace, step, cause: "progress-9", state: "Awaiting", request: "agent-1", at: 1500,
    event: journal_event("event_accepted", [param("kind", "progress"), param("name", "agent_chunk"), param("source", key)])
}

fn dead_lines_run[S, M Machine[S]](machine M) -> []str {
    mut world = MemoryWorld.at(1000)
    mut e1 = ij_begin[S, M](machine, world)
    ij_feed[S, M](e1, world, user_says("hi"))
    world.journal.push(journal_line(dead_event_line(e1.trace(), e1.step_number() + 1, "acp-1")))
    mut e2 = ij_resumed[S, M](machine, world)
    ro n2 = ij_pump[S, M](e2, world)
    mut out = []str.new()
    out.push("acked=${world.acked.len()}")
    mut e3 = ij_resumed[S, M](machine, world)
    ro n3 = ij_pump[S, M](e3, world)
    out.push("acked=${world.acked.len()}")
    ij_accept[S, M](e3, world, Incoming.from_source("acp-1", agent_chunk("agent-1", "again")))
    mut e4 = ij_resumed[S, M](machine, world)
    ro n4 = ij_pump[S, M](e4, world)
    out.push("acked=${world.acked.len()}")
    out.push(ij_world_text(world))
    out
}

test "ij dead step lines are not committed" {
    ro nova = dead_lines_run[ChatState, ChatSession](ij_nova())
    ro table = dead_lines_run[PortolanState, PortolanMachine](ij_table())
    assert(ij_same(nova, table))
    assert(table[0] == "acked=0")
    assert(table[1] == "acked=0")
    assert(table[2] == "acked=1")
}

// ---- a restart over a journal of the old form (chat_engine_test.nv) --------------------------------------------------------------------

fn old_kind(code str) -> str {
    if code == "machine_started" { return "start" }
    if code == "event_accepted" { return "event" }
    if code == "reply_discarded" { return "discarded" }
    if code == "request_ordered" { return "request" }
    if code == "request_sent" { return "sent" }
    if code == "request_closed" { return "closed" }
    if code == "cancel_ordered" { return "cancel" }
    if code == "snapshot_ordered" { return "snapshot" }
    if code == "machine_finished" { return "finish" }
    if code == "engine_resumed" { return "restart" }
    "note"
}

fn jput(mut o JsonObject, key str, value JsonValue) -> () {
    ro replaced = o.insert(key, value)
}

fn old_line(entry JournalEntry) -> str {
    mut o = JsonObject.new()
    jput(o, "trace", JsonValue.str(entry.trace))
    jput(o, "step", JsonValue.int(entry.step))
    jput(o, "cause", JsonValue.str(entry.cause))
    jput(o, "state", JsonValue.str(entry.state))
    jput(o, "request", JsonValue.str(entry.request))
    jput(o, "at", JsonValue.int(entry.at))
    jput(o, "kind", JsonValue.str(old_kind(entry.event.code)))
    ro source = match entry.event.value_of("source") {
        Some(key) => " src=${key}"
        None => ""
    }
    jput(o, "text", JsonValue.str("${entry.event.value_of("kind") ?? "x"}/${entry.event.value_of("name") ?? "y"}${source}"))
    JsonValue.object(o).to_str()
}

fn old_journal_run[S, M Machine[S]](machine M) -> []str {
    mut world = MemoryWorld.at(1000)
    mut e1 = ij_begin[S, M](machine, world)
    ij_feed[S, M](e1, world, user_says("hi"))
    ij_accept[S, M](e1, world, Incoming.from_source("acp-1", agent_chunk("agent-1", "one ")))
    mut old = []str.new()
    for entry in world.journal_entries() { old.push(old_line(entry)) }
    world.journal = old
    mut e2 = ij_resumed[S, M](machine, world)
    ij_dispatch[S, M](e2, world)
    ro n = ij_pump[S, M](e2, world)
    mut out = []str.new()
    out.push("sent=${world.sent.len()}")
    out.push("open=${e2.open_ids().len()}")
    out.push("acked=${world.acked.join(",")}")
    out.push("restarts=${ij_count(world, "engine_resumed")}")
    out.push(ij_name[S, M](machine, e2))
    out
}

test "ij an old journal is read" {
    ro nova = old_journal_run[ChatState, ChatSession](ij_nova())
    ro table = old_journal_run[PortolanState, PortolanMachine](ij_table())
    assert(ij_same(nova, table))
    assert(table[0] == "sent=1")
    assert(table[1] == "open=1")
    assert(table[2] == "acked=acp-1")
    assert(table[3] == "restarts=1")
    assert(table[4] == "Awaiting")
}

// ---- the history of two turns survives a restart (dialog_test.nv) --------------------------------------------------------------------

fn history_run[S, M Machine[S]](machine M) -> []str {
    mut world = MemoryWorld.at(1000)
    mut e1 = ij_begin[S, M](machine, world)
    ij_feed[S, M](e1, world, user_says("one"))
    ij_feed[S, M](e1, world, agent_chunk("agent-1", "A"))
    ij_feed[S, M](e1, world, agent_done("agent-1"))
    ij_feed[S, M](e1, world, user_says("two"))
    ij_feed[S, M](e1, world, agent_chunk("agent-2", "B"))
    ro live = e1.take_events()
    mut e2 = ij_resumed[S, M](machine, world)
    ro again = with Journal = memory_journal(world) { e2.history() }
    mut out = []str.new()
    out.push("live=${live.len()} again=${again.len()}")
    for ev in again {
        out.push("${ev.id}|${ev.step}|${ev.name}|${ev.request ?? "-"}|${ev.input}|${ev.at}")
    }
    for ev in live {
        out.push("live ${ev.id}|${ev.step}|${ev.name}|${ev.request ?? "-"}|${ev.input}|${ev.at}")
    }
    out
}

test "ij the history of two turns" {
    ro nova = history_run[ChatState, ChatSession](ij_nova())
    ro table = history_run[PortolanState, PortolanMachine](ij_table())
    assert(ij_same(nova, table))
    assert(table[0] == "live=5 again=5")
    assert(table.len() == 11)
    assert(table[1].contains("|one|"))
    assert(table[4].contains("|two|"))
    assert(table[5].contains("|agent-2|B|"))
}

// ---- determinism: two worlds, the same journal; the two machines, the same journal -----------------------------------------------------

fn determinism_run[S, M Machine[S]](machine M) -> str {
    mut world = MemoryWorld.at(5000)
    mut e = ij_begin[S, M](machine, world)
    ij_feed[S, M](e, world, user_says("привет"))
    world.advance(40)
    ij_feed[S, M](e, world, agent_chunk("agent-1", "part"))
    world.advance(40)
    ij_feed[S, M](e, world, agent_done("agent-1"))
    world.advance(40)
    ij_feed[S, M](e, world, user_says("ещё"))
    world.advance(40)
    ij_feed[S, M](e, world, user_cancels())
    ij_world_text(world)
}

test "ij determinism" {
    ro a = determinism_run[PortolanState, PortolanMachine](ij_table())
    ro b = determinism_run[PortolanState, PortolanMachine](ij_table())
    ro c = determinism_run[ChatState, ChatSession](ij_nova())
    assert(a == b)
    assert(a == c)
    assert(a.contains("привет"))
    assert(a.contains("cancelled=agent-2"))
}

// ---- the dialog machine is not the single-turn machine --------------------------------------------------------------------------------

test "ij the session stays open after the cancel" {
    mut world = MemoryWorld.at(1000)
    ro machine = ij_table()
    mut e = ij_begin[PortolanState, PortolanMachine](machine, world)
    ij_feed[PortolanState, PortolanMachine](e, world, user_says("one"))
    ij_feed[PortolanState, PortolanMachine](e, world, user_cancels())
    assert(!e.is_finished())
    match e.outcome() {
        Some(r) => assert(false)
        None => ()
    }
    assert(ij_name[PortolanState, PortolanMachine](machine, e) == "Idle")
    ij_feed[PortolanState, PortolanMachine](e, world, user_says("two"))
    assert(ij_name[PortolanState, PortolanMachine](machine, e) == "Awaiting")
    assert(world.sent.len() == 2)
    assert(world.sent[1].id == "agent-2")
}
