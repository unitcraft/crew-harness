// config_migrate.nv - `crew-harness migrate [--from <data_dir>] [--dry-run]`: the old flat folder into the new layout (task 192.12, ADR-0016).
//
// The old layout kept everything in `data_dir`: `projects.json`, `agents.json`, `last_dir.txt`, `stt.pid`, `serve.*.log`, `agent-config/` and a folder per session.
// The new one: `data/projects.json`, `data/sessions/<id>/`, `state/{last_dir.txt, stt.pid, serve.*.log}`, `cache/{agents.json, agent-config/}`.
// Nothing moves without the command. The small files are copied to `state/migrate-backup-<stamp>/` first; the folders of the sessions are MOVED (a rename,
// no copy: they can be large); a target that is there already is never overwritten. The report is printed and written to `state/migrate-report-<stamp>.txt`.
// The server must be stopped: it holds some of these files open.
module crew_harness.config

import std.text
import std.fs.{Fs, Path, read_dir, rename, copy_file, create_dir_all, try_exists, metadata, write_atomic}

/// Step: one thing to do. `kind` is `move` or `skip`; `what` is a short name for the report; `note` says why a step is skipped.
export type Step { kind str, what str, from str, to str, note str }

/// Plan: the old folder, the steps and the notes (lines for the owner).
export type Plan { from str, steps []Step, notes []str, error str }

fn present(path str) Fs -> bool {
    match try_exists(Path.from_bytes(path.bytes())) {
        Ok(b) => b
        Err(e) => false
    }
}

fn is_folder(path str) Fs -> bool {
    match metadata(Path.from_bytes(path.bytes())) {
        Ok(m) => m.is_dir()
        Err(e) => false
    }
}

fn move_step(what str, from str, to str) Fs -> Step {
    if present(to) { return Step { kind: "skip", what, from, to, note: "the target is there already; nothing is overwritten" } }
    Step { kind: "move", what, from, to, note: "" }
}

fn session_folder_ok(name str) -> bool {
    ro b = name.bytes()
    if b.len() == 0 || b.len() > 128 || b[0] == (46 as u8) { return false }
    for c in b {
        ro letter = (c >= (97 as u8) && c <= (122 as u8)) || (c >= (65 as u8) && c <= (90 as u8))
        ro digit = c >= (48 as u8) && c <= (57 as u8)
        if !(letter || digit || c == (46 as u8) || c == (45 as u8) || c == (95 as u8)) { return false }
    }
    true
}

/// What would move from the old folder `from` into the layout. A layout that is itself flat (or the same folder) gives an error.
export fn plan_migration(from str, layout ConfigLayout) Fs -> Plan {
    ro src = trim_slash(from)
    mut steps = []Step.new()
    mut notes = []str.new()
    if layout.legacy || layout.home.byte_len() == 0 {
        return Plan { from: src, steps, notes, error: "no root of the instance: give --home <folder> or set CREW_HOME (the new layout needs a root)" }
    }
    if src == layout.data || src == layout.sessions || src == layout.state || src == layout.cache {
        return Plan { from: src, steps, notes, error: "${src} is a folder of the new layout already" }
    }
    if !is_folder(src) {
        return Plan { from: src, steps, notes, error: "the old data folder ${src} is not there" }
    }
    if present("${src}/projects.json") { steps.push(move_step("projects.json", "${src}/projects.json", "${layout.data}/projects.json")) }
    if present("${src}/agents.json") { steps.push(move_step("agents.json", "${src}/agents.json", "${layout.cache}/agents.json")) }
    if present("${src}/agent-config") { steps.push(move_step("agent-config/", "${src}/agent-config", "${layout.cache}/agent-config")) }
    if present("${src}/last_dir.txt") { steps.push(move_step("last_dir.txt", "${src}/last_dir.txt", "${layout.state}/last_dir.txt")) }
    if present("${src}/stt.pid") { steps.push(move_step("stt.pid", "${src}/stt.pid", "${layout.state}/stt.pid")) }
    match read_dir(Path.from_bytes(src.bytes())) {
        Err(e) => return Plan { from: src, steps, notes, error: "${src} cannot be read" }
        Ok(entries) => {
            mut flat = 0
            for e in entries {
                match e.name_str() {
                    None => ()
                    Some(name) => {
                        if e.is_file() && name.starts_with("serve.") && name.ends_with(".log") {
                            steps.push(move_step(name, "${src}/${name}", "${layout.state}/${name}"))
                        } else if e.is_file() && (name.ends_with(".journal") || name.ends_with(".snapshot")) {
                            flat += 1
                        } else if e.is_dir() && session_folder_ok(name) && (present("${src}/${name}/snapshot") || present("${src}/${name}/journal")) {
                            steps.push(move_step("session ${name}", "${src}/${name}", "${layout.sessions}/${name}"))
                        }
                    }
                }
            }
            if flat > 0 { notes.push("${flat} files of the oldest flat form (<id>.journal, <id>.snapshot) are left: start the hub once on the old data_dir (it moves them into folders), then migrate again") }
        }
    }
    if steps.len() == 0 { notes.push("nothing to move") }
    Plan { from: src, steps, notes, error: "" }
}

fn step_line(s Step, dry bool) -> str {
    if s.kind == "skip" { return "  skip   ${s.what}: ${s.note} (${s.to})" }
    ro verb = if dry { "would move" } else { "move" }
    "  ${verb}  ${s.what}: ${s.from} -> ${s.to}"
}

/// The plan as text (for `--dry-run`).
export fn plan_text(p Plan, dry bool) -> str {
    mut lines = []str.new()
    lines.push(if dry { "migrate (dry run, nothing is moved) from ${p.from}" } else { "migrate from ${p.from}" })
    for s in p.steps { lines.push(step_line(s, dry)) }
    for n in p.notes { lines.push("  note: ${n}") }
    lines.join("\n")
}

fn parent_dir(path str) -> str {
    match path.rfind("/") {
        Some(at) => path[..at]
        None => ""
    }
}

fn make_parent(path str) Fs -> bool {
    ro dir = parent_dir(path)
    if dir.byte_len() == 0 { return true }
    match create_dir_all(Path.from_bytes(dir.bytes())) {
        Ok(done) => true
        Err(e) => false
    }
}

/// Migration: how many steps were done, how many failed, the report.
export type MigrationResult { moved int, failed int, text str }

/// Do the plan: back the small files up, then move. `stamp` makes the names of the backup and the report (the time in milliseconds).
export fn run_migration(p Plan, layout ConfigLayout, stamp str) Fs -> MigrationResult {
    mut lines = []str.new()
    mut moved = 0
    mut failed = 0
    lines.push("migrate from ${p.from}")
    ro backup = "${layout.state}/migrate-backup-${stamp}"
    for s in p.steps {
        if s.kind == "skip" {
            lines.push(step_line(s, false))
        } else {
            // a small file is copied to the backup first; a folder (a session, agent-config) is moved as it is
            if !is_folder(s.from) {
                ro copy_to = "${backup}/${s.what}"
                if make_parent(copy_to) {
                    match copy_file(Path.from_bytes(s.from.bytes()), Path.from_bytes(copy_to.bytes())) {
                        Ok(n) => ()
                        Err(e) => lines.push("  warning: the backup of ${s.what} failed")
                    }
                }
            }
            if !make_parent(s.to) {
                lines.push("  FAILED ${s.what}: the folder of ${s.to} cannot be made")
                failed += 1
            } else {
                match rename(Path.from_bytes(s.from.bytes()), Path.from_bytes(s.to.bytes())) {
                    Ok(done) => {
                        lines.push("  moved  ${s.what}: ${s.from} -> ${s.to}")
                        moved += 1
                    }
                    Err(e) => {
                        lines.push("  FAILED ${s.what}: cannot be moved to ${s.to} (another disk, or the file is in use: stop the server)")
                        failed += 1
                    }
                }
            }
        }
    }
    for n in p.notes { lines.push("  note: ${n}") }
    lines.push("result: ${moved} moved, ${failed} failed; the backup of the small files: ${backup}")
    ro text = lines.join("\n")
    if make_parent("${layout.state}/migrate-report-${stamp}.txt") {
        match write_atomic(Path.from_bytes("${layout.state}/migrate-report-${stamp}.txt".bytes()), "${text}\n".bytes()) {
            Ok(done) => ()
            Err(e) => ()
        }
    }
    MigrationResult { moved, failed, text }
}
