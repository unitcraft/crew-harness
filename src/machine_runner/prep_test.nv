// prep_test.nv - the destination `возврат_подготовки` of the format (rule 24, task 123): the row leads to the state that the datum `preparation_return` names; the target is read BEFORE the actions of
// the row, the jump empties the datum; an empty datum is a defect of the executor. The datum is written by the preparation of the executor only, so a probe machine takes it from its input.
module crew_harness.machine_runner

import std.text
import alula.machine_text.{translate_checked_with}
import alula.machine_run.{AlulaMachine, load_alula_machine, parse_test, run_test, run_ok, report_text}
import crew_harness.machines.{methodology_registry, translation_files}

fn probe_text() -> str {
    ro head = "# Машина: Проба возврата\n\n- machine: back_probe\n- revision: 1\n- alula_version: 0.27\n\n## Вход\n\n| имя | тип | примечание |\n|---|---|---|\n| возврат_подготовки | ?Состояние | куда вернуться |\n\n"
    ro data = "## Данные\n\n| имя | тип | начальное | не убывает |\n|---|---|---|---|\n| возврат_подготовки | ?Состояние | вход.возврат_подготовки | — |\n| остановка | \"\" \\| \"after\" | \"\" | — |\n\n"
    ro states = "## Состояния\n\nНачальное состояние: РЕШИТЬ\n\n### РЕШИТЬ — развилка\n\n| Условие | Действия | Куда |\n|---|---|---|\n| остановка == \"after\" |  | КОНЕЦ |\n| есть(возврат_подготовки) | остановка = \"after\" | возврат_подготовки |\n| иначе | ошибка_машины(\"fork_no_match\", fork: \"Decide\") |  |\n\n### КОНЕЦ — конец\n\n### ОШИБКА — конец\n- При входе:\n  - журнал(запись_перехода);\n  - журнал(все_данные)\n\n"
    ro ends = "## Выход\n\n- Результат: строка\n\n| конец | когда | ответ |\n|---|---|---|\n| КОНЕЦ | истина | Ответ(остановка) |\n| ОШИБКА | истина | Отказ(FailCode.NoResult, текст_записи(запись_перехода)) |\n"
    "${head}${data}${states}${ends}"
}

fn probe() -> AlulaMachine {
    ro report = translate_checked_with(probe_text(), methodology_registry(), translation_files())
    if report.errors.len() > 0 { panic(notes_of(report).join(" ## ")) }
    match load_alula_machine(report.json, methodology_registry()) {
        Ok(m) => m
        Err(e) => panic("the probe is not made: ${e}")
    }
}

fn run_probe(input str, expect str) -> bool {
    ro text = "{\"kind\":\"test\",\"machine\":\"back_probe\",\"name\":\"probe\",\"start_at\":1000,\"steps\":[{\"do\":\"feed\",\"event\":{\"kind\":\"start\",\"request\":\"up-1\",\"input\":${input}},\"expect\":${expect}}]}"
    match parse_test(text) {
        Ok(sc) => {
            ro run = run_test(probe(), sc)
            if !run_ok(run) { panic(report_text(run)) }
            true
        }
        Err(e) => panic("${e.path}: ${e.message}")
    }
}

test "pr the row leads to the state of the datum and empties it" {
    assert(run_probe("{\"preparation_return\":\"End\"}", "{\"state\":\"End\",\"data\":{\"stop_reason\":\"after\",\"preparation_return\":null},\"outcome\":\"answer:after\"}"))
}

test "pr without the datum the else row is taken" {
    assert(run_probe("{}", "{\"state\":\"Errored\"}"))
}
