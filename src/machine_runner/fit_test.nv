// fit_test.nv - the task runner as a machine that calls: the types of the calls are those of the machines it calls (`check_nested`), the whole tree of the calls is in the registry of the product but
// the meeting (task 124), a wrong type of the call is found, and the runner of the pairs is recursive (task 123): `check_registry` checks every level.
module crew_harness.machine_runner

import std.text
import alula.machine_table.{MachineDef, NestedProblem, check_nested, load_machine}
import alula.machine_run.{NestedRegistry, check_registry, registry_gaps, load_alula_machine}
import crew_harness.machines.{methodology_nested, methodology_registry, task_runner_machine_text}

fn problems_text(list []NestedProblem) -> str {
    mut out = []str.new()
    for p in list { out.push("${p.path}: ${p.message}") }
    out.join(" ## ")
}

fn callee_def(name str) -> MachineDef {
    ro reg = methodology_nested()
    match reg.find(name) {
        Some(m) => m.def
        None => panic("no machine ${name} in the registry of the product")
    }
}

// Since Alula 0.27 (AL-146) the runner declares no copies of the types of the called machines: the tree keeps the fields of the input and the types that came from them, so a wrong type
// is a tree of the runner that disagrees with the called machine (a callee changed after the runner was built).
fn runner_tree_with(old str, new str) -> MachineDef {
    ro text = task_runner_machine_text()
    assert(text.contains(old))
    match load_machine(text.replace(old, new), methodology_registry()) {
        Ok(d) => d
        Err(issues) => panic("the changed runner does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

test "ft the launch fits" {
    assert(problems_text(check_nested(runner_def(), "session_start", callee_def("session_start"))) == "")
}

test "ft the cycle check fits" {
    assert(problems_text(check_nested(runner_def(), "cycle_check", callee_def("cycle_check"))) == "")
}

test "ft the registry has the tree of the calls" {
    ro reg = methodology_nested()
    for n in ["agent_step", "session_start", "cycle_check"] {
        match reg.find(n) {
            Some(m) => assert(m.def.name == n)
            None => panic("no ${n}")
        }
    }
}

test "ft the registry check is recursive" {
    ro reg = methodology_nested()
    match load_alula_machine(task_runner_machine_text(), methodology_registry()) {
        Ok(m) => {
            // the runner calls the launch, which calls the agent step; and the cycle check, which calls the launch: every level is checked and none is an issue
            ro issues = check_registry(m, reg)
            if issues.len() > 0 { panic(issues.join(" ## ")) }
            assert(issues.len() == 0)
            // the one machine of the tree that the registry lacks is the meeting of the cycle check (task 124); it is a gap, not an issue
            ro gaps = registry_gaps(m, reg)
            assert(gaps.len() == 1)
            assert(gaps[0] == "meeting (called by cycle_check)")
        }
        Err(e) => panic("the runner is not made: ${e}")
    }
}

test "ft the machine of the first level must be in the registry" {
    match load_alula_machine(task_runner_machine_text(), methodology_registry()) {
        Ok(m) => {
            ro empty = NestedRegistry.empty()
            ro issues = check_registry(m, empty)
            assert(issues.len() == 2)
            assert(issues[0].contains("is not in the registry"))
        }
        Err(e) => panic("the runner is not made: ${e}")
    }
}

test "ft a wrong type of the launch is found" {
    ro def = runner_tree_with("\"nested\":\"session_start\",\"input\":[{\"name\":\"session\",\"type\":\"text\"}", "\"nested\":\"session_start\",\"input\":[{\"name\":\"session\",\"type\":\"int\"}")
    ro found = problems_text(check_nested(def, "session_start", callee_def("session_start")))
    assert(found.contains("session"))
}

test "ft a wrong type of the review is found" {
    ro def = runner_tree_with("{\"name\":\"ReviewResult\",\"fields\":[{\"name\":\"verdict\",\"type\":\"Verdict\"}", "{\"name\":\"ReviewResult\",\"fields\":[{\"name\":\"verdict\",\"type\":\"text\"}")
    ro found = problems_text(check_nested(def, "cycle_check", callee_def("cycle_check")))
    assert(found.contains("verdict") || found.contains("result"))
}

test "ft the input is the contract" {
    ro def = runner_def()
    assert(def.input.fields.len() == 3)
    assert(def.input.fields[0].name == "task_dir")
    assert(def.input.fields[1].name == "repo_dir")
    assert(def.input.fields[2].name == "delivery_mode")
    ro launch = callee_def("session_start")
    assert(launch.input.fields.len() == 10)
    ro review = callee_def("cycle_check")
    assert(review.input.fields.len() == 15)
}
