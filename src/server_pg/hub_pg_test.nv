test "pg: an agent that refuses to start" {
    ro db = new_test_db("hub_broken")
    ro report = scenario_broken_agent(kit_pg("pgbroken", 30000, db.app))
    ro stored = test_count(db.admin, "select count(distinct id) from crew.machine_snapshot")
