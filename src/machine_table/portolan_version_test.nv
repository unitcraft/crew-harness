// portolan_version_test.nv - task 113: the key of the version of the language in the tree is `portolan_version` (the old `table_format` is read as a synonym).
module crew_harness.machine_table

import std.text
import crew_harness.machine.{text_of_file, schema_files}

fn with_key(key str, value str) -> str => tiny().replace("\"format\":\"machine/2\",", "\"format\":\"machine/2\",\"${key}\":\"${value}\",")

test "pv key" {
    assert(ok_text(with_key("portolan_version", "2.10")))
    assert(ok_text(with_key("portolan_version", "2.5")))
    assert(ok_text(with_key("portolan_version", "2.9")))
}

test "pv synonym" {
    assert(ok_text(with_key("table_format", "2.7")))
    assert(ok_text(with_key("table_format", "2.10")))
    ro both = tiny().replace("\"format\":\"machine/2\",", "\"format\":\"machine/2\",\"portolan_version\":\"2.10\",\"table_format\":\"2.10\",")
    assert(says(both, "both"))
}

test "pv versions" {
    assert(portolan_versions().len() == 6)
    assert(portolan_versions().contains("2.10"))
    assert(portolan_versions().contains("2.8"))
    assert(says(with_key("portolan_version", "2.11"), "portolan_version"))
    assert(says(with_key("portolan_version", "2.4"), "must be 2.5"))
    ro number = tiny().replace("\"format\":\"machine/2\",", "\"format\":\"machine/2\",\"portolan_version\":2.10,")
    assert(says(number, "portolan_version"))
}

test "pv schema" {
    ro schema = text_of_file(schema_files(), "machine-2.schema.json")
    assert(schema.contains("\"portolan_version\""))
    assert(schema.contains("\"2.10\""))
    assert(top_keys().contains("portolan_version"))
    assert(top_keys().contains("table_format"))
}
