// render_test.nv - task 113: the reverse generator `render_machine(json, language)`: the canonical form of section 1b (the header, the eleven sections, the keys of a state in their order, the
// tables with one space round the bar, the operators of the language), the circles "tree -> file -> tree" in both languages on every machine of the product, and "Russian -> English -> Russian".
// The proofs on the agent step (its types, enumerations and functions) left the product with the methodology (task 249).
module crew_harness.machine_text_render_machines

import std.text
import alula.machine.{text_of_file}
import alula.machine_text_eq.{case_text}
import alula.machine_text.{render_machine, render_machine_with, render, translate_report_with, render_type_in, render_expression_in, render_actions_in}
import crew_harness.machines.{chat_table_text, dialog_table_text, table_files, translation_files, connects_library, part_mended}

fn chat_json() -> str => machine_json("chat.alula.json")

fn calc_json() -> str => machine_json("calc.alula.json")

// ---- the canonical form ----------------------------------------------------------------------------------------------------------

// Alula 2.26: an empty section is not written (the chat has no input), the sections of the chat are its types, its connection and its common events
test "rn empty section not written" {
    ro en = render(chat_json(), "en")
    assert(index_of_line(en, "## Types") > 0)
    assert(!text_has_line(en, "## Input"))
    assert(!text_has_line(en, "—"))
    assert(index_of_line(en, "## Includes") > 0)
    assert(index_of_line(en, "## Common events") > index_of_line(en, "## Includes"))
    // a table has an empty line under the heading
    assert(lines_from(en, index_of_line(en, "## Data"), 3).starts_with("## Data\n\n| name |"))
}

test "rn language word" {
    ro ru = render(chat_json(), "ru")
    ro en = render(chat_json(), "en")
    assert(text_has_line(ru, "## Состояния") && text_has_line(ru, "## Выход"))
    assert(text_has_line(en, "## States") && text_has_line(en, "## Output"))
    assert(!en.contains("Состояния"))
    assert(ru.contains("Начальное состояние: ") && en.contains("Initial state: "))
}

test "rn operators en ascii" {
    ro en = render(calc_json(), "en")
    for sign in ["≥", "≤", "≠", "→", "…", "∈"] { assert(!en.contains(sign)) }
}

test "rn operators ru canon" {
    ro dialog = render(machine_json("dialog.alula.json"), "ru")
    for sign in ["≥", "≤", "≠", "→", "…", "∈"] { assert(!dialog.contains(sign)) }
    assert(dialog.contains("число>=0"))
}

test "rn circle en chat" {
    assert(circle(chat_json(), "en") == "")
}

test "rn circle ru chat" {
    assert(circle(chat_json(), "ru") == "")
}

test "rn circle chat table" {
    // md -> JSON -> md -> JSON on the chat machine written by hand in Russian
    // the checked translation: the tree carries the reads of the states that the check derives (AL-138)
    ro first = json_of(chat_table_text())
    assert(circle(first, "ru") == "")
    assert(circle(first, "en") == "")
}

test "rn ru to en to ru chat" {
    // Alula 2.26 (task 240): the chat connects the library of the cancel `libs/call_cancel.alula.md`; on the package 0.9.0 such a machine does not go through the English file (task 239,
    // `connects_library`): the English text keeps the Russian file and is refused, the Russian circle stays
    // the checked translation: the tree carries the reads of the states that the check derives (AL-138)
    ro first = json_of(chat_table_text())
    assert(connects_library(first))
    ro english = render(first, "en")
    assert(english.contains("- File: libs/call_cancel.alula.md"))
    assert(json_of(english).starts_with("ERROR "))
    ro russian = render(first, "ru")
    // the generator of 0.9.0 writes the part in the form before 2.26 (`part_mended`)
    ro third = json_of(part_mended(russian))
    assert(same_tree(first, third) == "")
    assert(render(third, "ru") == russian)
}

fn lit(v str) -> str => `{"op":"lit","value":${v}}`

test "rn circle product table" {
    ro first = json_of(dialog_table_text())
    assert(!first.starts_with("ERROR "))
    assert(circle(first, "ru") == "")
    assert(circle(first, "en") == "")
}

test "rn circle examples" {
    // the pilot of the package (`agent-step.alula.md`) calls the primitives of the methodology: its registry left the product (task 249)
    // the examples of the format are pieces of a machine, not a machine: they are translated without the checks of the table
    ro examples = translate_report_with(case_text("format-examples.alula.md"), translation_files()).json
    assert(examples.byte_len() > 1000)
    assert(circle_loose(examples, "ru") == "")
    assert(circle_loose(examples, "en") == "")
}
