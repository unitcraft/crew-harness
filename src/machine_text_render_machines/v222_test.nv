// v222_test.nv - task 152: the reverse generator writes Alula 2.22: ranges, methods of the macros, insertions, the literal of a map, `in […]`, `выбор` with commas, blocks, `для x из xs`, the declarations of types and of
// functions, the words of the types in both languages. The circles "tree -> file -> tree" are equal for the machines of the product in both languages.
module crew_harness.machine_text_render_machines

import std.text
import alula.machine_text.{render, render_type_in, render_expression_in, render_actions_in}

test "w222 the types of the product are declared with the word type" {
    ro agent = render(machine_json("agent_step.alula.json"), "ru")
    assert(agent.contains("\nтип AgentModel { id строка, provider строка, variant ?строка }\n"))
}

test "w222 an enumeration with values is in lines" {
    ro agent = render(machine_json("agent_step.alula.json"), "ru")
    assert(agent.contains("\nтип ActionKind перечисление\n  | Read = \"read\"\n"))
}

test "w222 an enumeration with fields is in lines" {
    ro agent = render(machine_json("agent_step.alula.json"), "en")
    assert(agent.contains("\ntype TurnResult enum\n  | Finished { text ?str, artifact ?str, usage TransportUsage }\n"))
}

test "w222 an enumeration without fields is in a line" {
    ro agent = render(machine_json("agent_step.alula.json"), "en")
    assert(agent.contains("\ntype ReplyCheck enum Valid | Violated | Empty\n"))
}

test "w222 a function has the word fn in English" {
    ro agent = render(machine_json("agent_step.alula.json"), "en")
    assert(agent.contains("\nfn сумма_целых("))
}

test "w222 a function has the word функция in Russian" {
    ro agent = render(machine_json("agent_step.alula.json"), "ru")
    assert(agent.contains("\nфункция сумма_целых("))
}

test "w222 no former word of the language is written" {
    for lang in ["ru", "en"] {
        ro agent = render(machine_json("agent_step.alula.json"), lang)
        assert(!agent.contains("\nопределение "))
        assert(!agent.contains("\ndefine "))
        assert(!agent.contains("\nвариант "))
        assert(!agent.contains("\nvariant "))
    }
}

test "w222 the text of the product has no comment sign inside a cell" {
    ro agent = render(machine_json("agent_step.alula.json"), "ru")
    for line in agent.split("\n") {
        if line.starts_with("|") { assert(!line.contains("//")) }
    }
}

// ---- the circles --------------------------------------------------------------------------------------------------------------------------------

test "w222 the circle of the chat machine in both languages" {
    assert(circle(machine_json("chat.alula.json"), "ru") == "")
    assert(circle(machine_json("chat.alula.json"), "en") == "")
}

test "w222 the circle of the agent step in both languages" {
    assert(circle(machine_json("agent_step.alula.json"), "ru") == "")
    assert(circle(machine_json("agent_step.alula.json"), "en") == "")
}
