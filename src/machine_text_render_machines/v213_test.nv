// v213_test.nv - task 149: the reverse generator writes Alula 2.17 (the rules AL-38 ... AL-49): the signals of a party in the column `сигналы` and the event `сигнал(…)`, the keys `Запрос:` and `Читает:`
// (no `Вход:`), no key with an empty value (AL-40), only ASCII signs of the operators (AL-42), every name as it lies in the tree and no brackets of JSON names (1b (ж), AL-46), the parameter
// `сигнал_остановки` of the fragment. The circles "tree -> file -> tree" are equal in both languages.
module crew_harness.machine_text_render_machines

import std.text
import alula.machine_text.{render, render_machine}

// A small tree of 2.14 written by hand: a Cyrillic constant and party name stay as they are (internal names), the data and the states have Latin JSON names, the party has two signals, one with a field.
fn tree13() -> str => `{"format":"machine/2","alula_version":"2.24","machine":"Tiny","version":"1","constants":[{"name":"ПРЕДЕЛ","type":"int>=0","value":{"op":"lit","value":5}}],"data":[{"name":"n","type":"int>=0","initial":{"expr":{"op":"lit","value":0}},"monotonic":{"bound":{"op":"name","name":"ПРЕДЕЛ"}},"writes":"rows"},{"name":"stop","type":"\"\" | \"a\" | \"b\"","initial":{"expr":{"op":"lit","value":""}},"writes":"rows"},{"name":"u_attempt","type":"int>=0","initial":{"expr":{"op":"lit","value":0}},"monotonic":true,"writes":"mechanics"}],"parties":[{"name":"пользователь","id":"user","kind":"human","counter":"u_attempt","signals":[{"name":"go","fields":[{"name":"author","type":"text"}]},{"name":"halt"}]}],"initial":"Wait","states":[{"name":"Wait","kind":"appeal","party":"пользователь","inputs":[{"field":"n","value":{"op":"name","name":"n"},"reads":"executor"}],"rows":[{"n":1,"event":{"kind":"signal","name":"go","bind":{"author":"кто"}},"actions":[{"do":"assign","target":"n","value":{"op":"+","left":{"op":"name","name":"n"},"right":{"op":"lit","value":1}}}],"to":"Decide"},{"n":2,"event":{"kind":"signal","name":"halt"},"actions":[{"do":"assign","target":"stop","value":{"op":"lit","value":"a"}}],"to":"Stopped"}]},{"name":"Decide","kind":"fork","reads":["n"],"rows":[{"n":1,"event":{"kind":"now"},"cond":{"op":">=","left":{"op":"name","name":"n"},"right":{"op":"name","name":"ПРЕДЕЛ"}},"to":"Finished"},{"n":2,"event":{"kind":"now"},"else":true,"to":"Wait"}]},{"name":"Finished","kind":"end","reads":["n"]},{"name":"Stopped","kind":"end","reads":["stop"],"except":{"field":"stop","values":[""]}}],"ends":{"result":"int","rows":[{"state":"Finished","n":1,"when":{"op":"lit","value":true},"answer":{"kind":"answer","value":{"op":"name","name":"n"}}},{"state":"Stopped","n":1,"when":{"op":"==","left":{"op":"name","name":"stop"},"right":{"op":"lit","value":"a"}},"answer":{"kind":"refusal","code":{"op":"variant","type":"FailCode","name":"StoppedByHuman"},"text":{"op":"lit","value":"stopped"}}},{"state":"Stopped","n":2,"when":{"op":"==","left":{"op":"name","name":"stop"},"right":{"op":"lit","value":"b"}},"answer":{"kind":"refusal","code":{"op":"variant","type":"FailCode","name":"NoResult"},"text":{"op":"lit","value":"b"}}}]}}`

fn written(lang str) -> str {
    ro made = render_machine(tree13(), lang)
    if made.notes.len() > 0 { panic(made.notes.join(" ## ")) }
    made.text
}

