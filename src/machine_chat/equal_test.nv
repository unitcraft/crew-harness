// equal_test.nv - the proof of equality: the machine of the chat written as data (`kind: machine`) and the machine on Nova (`src/chat`) give the
// same sequence on the same scenarios - the state, the events of the journal, the data, the queue - at the level of the machine (one step) and of
// the engine (journal lines with the envelope, sent and cancelled requests, the outcome, the acknowledgements).
module crew_harness.machine_chat

// ORACLE-WORKAROUND(32): `std.fs` is imported first in the first file of the unit (its machines are read from the disk, task 248), or `.join` on a `[]str` is E_RECV_METHOD_MISMATCH (spikes/env/README.md, task 116 (e)); drop when item 32 is fixed
import std.fs.{Path}
// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import std.encoding.json.{Json, JsonObject}
import crew_harness.product_machines.{test_files, product_registry, chat_machine_text}
import alula.engine.{Incoming, Order, StepEnvironment, FailCode, journal_line, fail_code_word}
import crew_harness.chat.{ChatState, ChatSession, chat_session, encode_chat_state}
import alula.machine_run.{AlulaState, AlulaMachine, Test, StepTrace, ScEvent, load_alula_machine, alula_step, ScriptedHost, drive_test, parse_test, test_incoming, state_data_fields}
import alula.machine_table.{fail_code_names}

fn table_chat() -> AlulaMachine {
    match load_alula_machine(chat_machine_text(), product_registry()) {
        Ok(m) => m
        Err(e) => panic("the chat machine does not load: ${e}")
    }
}

// The scenarios of the chat, in the order of the files.
fn chat_scenarios() -> []Test {
    mut out = []Test.new()
    for f in test_files() {
        match parse_test(f.text) {
            Ok(sc) => {
                if sc.machine == "ChatSession" { out.push(sc) }
            }
            Err(e) => panic("${f.name}: ${e.path}: ${e.message}")
        }
    }
    out
}

fn text_field(o JsonObject, key str) -> str {
    match o.get(key) {
        Some(v) => match v.str() {
            Some(s) => s
            None => ""
        }
        None => ""
    }
}

// The datum view that both machines can show: the name of the state and what that state holds in the machine on Nova
// (Awaiting: the message and the reply; Done: the reply; Failed: the code).
fn nova_view(encoded str) -> str {
    match Json.parse(encoded) {
        Ok(j) => match j.object() {
            Some(o) => {
                ro name = text_field(o, "state")
                if name == "Awaiting" { return "Awaiting|${text_field(o, "user")}|${text_field(o, "reply")}" }
                if name == "Done" { return "Done|${text_field(o, "reply")}" }
                if name == "Failed" { return "Failed|${text_field(o, "code")}" }
                name
            }
            None => "?"
        }
        Err(e) => "?"
    }
}

fn data_text(data JsonObject, key str) -> str {
    match data.get(key) {
        Some(v) => match v.str() {
            Some(s) => s
            None => ""
        }
        None => ""
    }
}

// The code of a failure in the data of the table machine: `{"$variant":"FailCode","name":"Timeout"}`.
fn code_name(data JsonObject) -> str {
    match data.get("stop_code") {
        Some(v) => match v.object() {
            Some(o) => text_field(o, "name")
            None => ""
        }
        None => ""
    }
}

fn table_view(encoded str) -> str {
    match Json.parse(encoded) {
        Ok(j) => match j.object() {
            Some(o) => {
                ro name = text_field(o, "state")
                ro data = state_data_fields(encoded)
                if name == "Awaiting" { return "Awaiting|${data_text(data, "user")}|${data_text(data, "reply")}" }
                if name == "Done" { return "Done|${data_text(data, "reply")}" }
                if name == "Failed" { return "Failed|${code_name(data)}" }
                name
            }
            None => "?"
        }
        Err(e) => "?"
    }
}

fn entry_lines(t StepTrace) -> []str {
    mut out = []str.new()
    for e in t.entries { out.push(journal_line(e)) }
    out
}

fn same_list(xs []str, ys []str) -> bool {
    if xs.len() != ys.len() { return false }
    mut i = 0
    while i < xs.len() {
        if xs[i] != ys[i] { return false }
        i += 1
    }
    true
}

// The two traces of a step compared; "" when equal, else what differs.
fn trace_diff(nova StepTrace, table StepTrace) -> str {
    if nova.state != table.state { return "state ${nova.state} / ${table.state}" }
    if nova_view(nova.encoded) != table_view(table.encoded) { return "data ${nova_view(nova.encoded)} / ${table_view(table.encoded)}" }
    if !same_list(nova.journal, table.journal) { return "journal ${nova.journal.join(";")} / ${table.journal.join(";")}" }
    if !same_list(entry_lines(nova), entry_lines(table)) { return "journal lines ${entry_lines(nova).join(";")} / ${entry_lines(table).join(";")}" }
    if !same_list(nova.open, table.open) { return "open ${nova.open.join(",")} / ${table.open.join(",")}" }
    if !same_list(nova.sent, table.sent) { return "sent ${nova.sent.join(",")} / ${table.sent.join(",")}" }
    if !same_list(nova.cancelled, table.cancelled) { return "cancelled ${nova.cancelled.join(",")} / ${table.cancelled.join(",")}" }
    if !same_list(nova.queue, table.queue) { return "queue ${nova.queue.join(",")} / ${table.queue.join(",")}" }
    if !same_list(nova.acked, table.acked) { return "acked ${nova.acked.join(",")} / ${table.acked.join(",")}" }
    if nova.outcome != table.outcome { return "outcome ${nova.outcome} / ${table.outcome}" }
    if nova.number != table.number { return "step number ${nova.number} / ${table.number}" }
    ""
}

// ---- the machine level: one step on each machine ----------------------------------------------------------------------

// The orders as text, as in the tests of the chat.
fn order_text(orders []Order) -> str {
    mut parts = []str.new()
    for o in orders {
        match o {
            Send(order) => parts.push("send:${order.party}:${order.input}:${order.idle_term}")
            Note(event) => {
                mut ps = []str.new()
                for p in event.params { ps.push("${p.name}=${p.value}") }
                parts.push("log:${event.code}(${ps.join(";")})")
            }
            Cancel(order) => parts.push("cancel:${order.party}")
            Save => parts.push("save")
            Finish(c) => match c.failure {
                Some(code) => parts.push("finish:refusal:${code.name()}:${c.text}")
                None => parts.push("finish:answer:${c.text}")
            }
        }
    }
    parts.join(",")
}

type Pair { nova_state ChatState, table_state AlulaState, nova_text str, table_text str, nova_moved bool, table_moved bool }

fn first_pair(table AlulaMachine) -> Pair {
    Pair {
        nova_state: chat_session().initial(), table_state: table.initial(), nova_text: "", table_text: "",
        nova_moved: false, table_moved: false
    }
}

fn step_pair(table AlulaMachine, p Pair, event Incoming) -> Pair {
    mut ne = StepEnvironment.new()
    ro nt = chat_session().step(p.nova_state, event, ne)
    mut te = StepEnvironment.new()
    mut host = ScriptedHost { at: event.at, replies: table.replies, ids: 0 }
    ro tt = alula_step(table, p.table_state, event, te, host)
    ro next_nova = match nt {
        Go(s) => s
        Stay => p.nova_state
    }
    ro nova_moved = match nt {
        Go(s) => true
        Stay => false
    }
    ro next_table = match tt {
        Go(s) => s
        Stay => p.table_state
    }
    ro table_moved = match tt {
        Go(s) => true
        Stay => false
    }
    Pair {
        nova_state: next_nova, table_state: next_table, nova_text: order_text(ne.orders), table_text: order_text(te.orders),
        nova_moved, table_moved
    }
}

fn pair_diff(table AlulaMachine, p Pair) -> str {
    if p.nova_text != p.table_text { return "orders ${p.nova_text} / ${p.table_text}" }
    if p.nova_moved != p.table_moved { return "moved ${p.nova_moved} / ${p.table_moved}" }
    ro nova_text_view = nova_view(encode_chat_state(p.nova_state))
    ro table_text_view = table_view(table.encode_state(p.table_state))
    if nova_text_view != table_text_view { return "state ${nova_text_view} / ${table_text_view}" }
    if chat_session().state_name(p.nova_state) != table.state_name(p.table_state) { return "state name" }
    ""
}

fn events_of(sc Test) -> []Incoming {
    mut out = []Incoming.new()
    for s in sc.steps {
        if s.event.kind != "" { out.push(test_incoming(s.event)) }
    }
    out
}

// ORACLE-WORKAROUND(12, 13, 26): the type arguments of `drive_test` are written out here and in the tests below; infer them when items 12 and 13 are fixed
fn first_run_diff(sc Test) -> str {
    ro table = table_chat()
    ro nova = drive_test[ChatState, ChatSession](chat_session(), sc)
    ro tab = drive_test[AlulaState, AlulaMachine](table, sc)
    if nova.len() != tab.len() { return "${sc.name}: ${nova.len()} traces / ${tab.len()}" }
    mut i = 0
    while i < nova.len() {
        ro d = trace_diff(nova[i], tab[i])
        if d != "" { return "${sc.name}, step ${i + 1}: ${d}" }
        i += 1
    }
    ""
}

fn machine_run_diff(sc Test) -> str {
    ro table = table_chat()
    mut p = first_pair(table)
    mut i = 0
    for e in events_of(sc) {
        p = step_pair(table, p, e)
        ro d = pair_diff(table, p)
        if d != "" { return "${sc.name}, event ${i + 1}: ${d}" }
        i += 1
    }
    ""
}

test "engine level" {
    ro all = chat_scenarios()
    assert(all.len() >= 39)
    mut steps = 0
    for sc in all {
        ro d = first_run_diff(sc)
        if d != "" { panic(d) }
        steps += sc.steps.len()
    }
    assert(steps >= 100)
}

test "machine level" {
    mut events = 0
    for sc in chat_scenarios() {
        ro d = machine_run_diff(sc)
        if d != "" { panic(d) }
        events += events_of(sc).len()
    }
    assert(events >= 80)
}

test "every code" {
    ro table = table_chat()
    for code in FailCode.all() {
        mut p = first_pair(table)
        p = step_pair(table, p, test_incoming(ScEvent { kind: "signal", name: "user_message", request: "", input: "hi", code: "", source: "", party: "", has_at: false, at: 0 }))
        assert(pair_diff(table, p) == "")
        p = step_pair(table, p, test_incoming(ScEvent { kind: "failure", name: "agent_refused", request: "agent-1", input: "", code: code.name(), source: "", party: "", has_at: false, at: 0 }))
        assert(pair_diff(table, p) == "")
        assert(p.nova_text.contains("finish:refusal:${code.name()}"))
        assert(p.table_text.contains("agent_refused(code=${fail_code_word(code)})"))
    }
}

test "names" {
    ro table = table_chat()
    assert(chat_session().name() == table.name())
    assert(chat_session().state_name(chat_session().initial()) == table.state_name(table.initial()))
    assert(nova_view(encode_chat_state(chat_session().initial())) == table_view(table.encode_state(table.initial())))
}

test "state text" {
    ro table = table_chat()
    for bad in ["", "not json", "{\"state\":\"Mystery\"}", "{\"state\":1}", "[]"] {
        assert(chat_session().decode_state(bad) == None)
        assert(table.decode_state(bad) == None)
    }
    mut p = first_pair(table)
    for e in events_of(chat_scenarios()[0]) { p = step_pair(table, p, e) }
    ro text = table.encode_state(p.table_state)
    match table.decode_state(text) {
        Some(back) => assert(table.encode_state(back) == text)
        None => assert(false)
    }
}

test "closed list" {
    mut engine_names = []str.new()
    for c in FailCode.all() { engine_names.push(c.name()) }
    assert(same_list(engine_names, fail_code_names()))
}

test "same twice" {
    ro table = table_chat()
    for sc in chat_scenarios() {
        ro first = drive_test[AlulaState, AlulaMachine](table, sc)
        ro second = drive_test[AlulaState, AlulaMachine](table, sc)
        assert(first.len() == second.len())
        mut i = 0
        while i < first.len() {
            assert(first[i].encoded == second[i].encoded)
            assert(same_list(entry_lines(first[i]), entry_lines(second[i])))
            i += 1
        }
    }
}

fn scenario_named(name str) -> Test {
    for sc in chat_scenarios() {
        if sc.name.contains(name) { return sc }
    }
    panic("no scenario with ${name}")
}

test "death between" {
    ro table = table_chat()
    ro sc = scenario_named("restart after the commit but before the send")
    ro nova = drive_test[ChatState, ChatSession](chat_session(), sc)
    ro tab = drive_test[AlulaState, AlulaMachine](table, sc)
    assert(tab[0].sent.len() == 0)
    assert(tab[0].queue.len() == 1)
    assert(tab[1].sent.len() == 0)
    assert(tab[2].sent.len() == 1)
    assert(tab[5].sent.len() == 1)
    assert(tab[5].open.len() == 1)
    mut i = 0
    while i < nova.len() {
        assert(trace_diff(nova[i], tab[i]) == "")
        i += 1
    }
}

test "other side" {
    ro table = table_chat()
    ro sc = scenario_named("the cancel arrives in the window")
    ro nova = drive_test[ChatState, ChatSession](chat_session(), sc)
    ro tab = drive_test[AlulaState, AlulaMachine](table, sc)
    assert(tab[0].queue.len() == 1)
    assert(tab[1].state == "Failed")
    assert(tab[1].queue.len() == 2)
    assert(tab[1].outcome == "refusal:StoppedByHuman")
    assert(tab[2].sent.len() == 1)
    assert(tab[2].cancelled.len() == 1)
    mut i = 0
    while i < nova.len() {
        assert(trace_diff(nova[i], tab[i]) == "")
        i += 1
    }
}

test "restart agrees" {
    ro table = table_chat()
    for part in ["restart after the request", "restart after the answer", "a restart acknowledges", "restart in the middle"] {
        ro sc = scenario_named(part)
        assert(first_run_diff(sc) == "")
    }
}

test "ack agrees" {
    ro table = table_chat()
    for part in ["is acknowledged after the commit", "discarded event with a key"] {
        ro sc = scenario_named(part)
        ro nova = drive_test[ChatState, ChatSession](chat_session(), sc)
        ro tab = drive_test[AlulaState, AlulaMachine](table, sc)
        assert(tab[tab.len() - 1].acked.len() == 1)
        assert(same_list(nova[nova.len() - 1].acked, tab[tab.len() - 1].acked))
    }
}
