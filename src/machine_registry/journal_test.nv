// journal_test.nv - the table of the journal codes of the product as data (`machines/product/journal.md`, task 158; it was `journal_product.md` of the package until 0.3.2, AL-31): the codes, the faults
// against the table of the language, the union that the registry of the host holds. The table of the methodology went to the methodology with its machines (task 249).
module crew_harness.machine_registry

// ORACLE-WORKAROUND(32): `std.fs` is imported first in the first file of the unit (the machines are read from the disk, task 248), or `.join` on a `[]str` is E_RECV_METHOD_MISMATCH (spikes/env/README.md, task 116 (e)); drop when item 32 is fixed
import std.fs.{Path}
import alula.machine.{JournalCode, parse_journal, language_journal, journal_find, journal_table_issues}
import crew_harness.machines.{product_registry, product_journal_text}

fn product_rows() -> []JournalCode => parse_journal(product_journal_text())

test "jt product table" {
    ro table = product_rows()
    assert(table.len() == 10)
    for code in ["user_message", "agent_chunk", "agent_done", "agent_refused", "cancelled_while_waiting", "no_answer_in_time", "cancelled_before_request", "session_closed", "turn_answered", "turn_refused"] {
        assert(journal_find(table, code).is_some())
    }
}

test "jt the tables are their own" {
    // no code of the product is a code of the language (35: the format, the fragment Pause, the engine and the executor)
    assert(journal_table_issues(language_journal(), product_rows()).len() == 0)
    for row in product_rows() { assert(journal_find(language_journal(), row.code).is_none()) }
}

test "jt a table of a host cannot repeat a code of the language" {
    ro dup = [JournalCode { machine: "x", code: "human_stop", template: "стоп", params: []str.new(), optional: []str.new() }]
    ro issues = journal_table_issues(language_journal(), dup)
    assert(issues.len() == 1)
    assert(issues[0].contains("human_stop"))
    for code in ["signal_passed", "input_rejected", "machine_error", "machine_data", "fork_no_match", "answer_edited"] {
        ro one = [JournalCode { machine: "x", code, template: "t", params: []str.new(), optional: []str.new() }]
        assert(journal_table_issues(language_journal(), one).len() == 1)
    }
}

test "jt the codes are snake case" {
    ro bad = [JournalCode { machine: "x", code: "BadCode", template: "t", params: []str.new(), optional: []str.new() }]
    assert(journal_table_issues(language_journal(), bad).len() == 1)
}

test "jt the registry of a host names the union" {
    assert(product_registry().journal.len() == 35 + product_rows().len())
    assert(journal_find(product_registry().journal, "signal_passed").is_some())
    assert(journal_find(product_registry().journal, "user_message").is_some())
    assert(journal_find(product_registry().journal, "turn_failed").is_none())
}
