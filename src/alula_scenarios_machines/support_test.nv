// support_test.nv - helpers of the proofs of `alula run` and `alula test` (task 116) on the folder `src/machine/`: the program is run over the memory file system with the arguments, the standard output and the
// standard error captured.
module crew_harness.alula_scenarios_machines

import std.fs.{Path, MemFs, mock_fs, write_text, read_text, create_dir_all}
import std.text
import std.io.{IoCapture, mock_io}
import std.os.{MockOs, mock_os}
import alula.machine.{NamedText, text_of_file}
import alula.alula_cli.{execute}
import crew_harness.machines.{methodology_registry_text, all_journal_text}
import crew_harness.machines.{machine_files, scenario_files, table_files}

/// Ran: what a run of the program left.
type Ran { code int, out str, err str }

fn run_with(argv []str, files []NamedText) -> Ran {
    mut os = MockOs.new()
    os.push_arg("alula")
    for a in argv { os.push_arg(a) }
    mut fs = MemFs.new()
    mut cap = IoCapture.new([]u8.new())
    mut code = -1
    with Os = mock_os(os), Fs = mock_fs(fs), Io = mock_io(cap) {
        for f in files {
            make_parents(f.name)
            ro written = write_text(Path.posix(f.name), f.text)
        }
        // the host of the machines beside the files of every folder that has none (the program reads `registry.md` and `journal.md` from the folder of the file)
        for dir in host_dirs(files) {
            ro registry = write_text(Path.posix("${dir}/registry.md"), methodology_registry_text())
            ro journal = write_text(Path.posix("${dir}/journal.md"), all_journal_text())
        }
        code = execute()
    }
    Ran { code, out: cap.out_bytes().to_str_lossy(), err: cap.err_bytes().to_str_lossy() }
}

// The folders of the files; a folder that holds a file named `registry.md` has its host already.
fn host_dirs(files []NamedText) -> []str {
    mut out = []str.new()
    mut has_host = []str.new()
    for f in files {
        if f.name.ends_with("/registry.md") { has_host.push(dir_of(f.name)) }
    }
    for f in files {
        ro dir = dir_of(f.name)
        if dir != "" && !has_host.contains(dir) && !out.contains(dir) { out.push(dir) }
    }
    out
}

fn dir_of(name str) -> str {
    mut parts = []str.new()
    for p in name.split("/") { parts.push(p) }
    mut kept = []str.new()
    mut i = 0
    while i + 1 < parts.len() {
        kept.push(parts[i])
        i += 1
    }
    kept.join("/")
}

// Does a file of the folder belong to a machine of the methodology (the agent step, the cycle check, the session start, the task runner)?
fn for_methodology(files []NamedText, dir str) -> bool {
    for f in files {
        if dir_of(f.name) != dir { continue }
        for word in ["agent_step", "cycle_check", "session_start", "task_runner", "dialog_steps"] {
            if f.name.contains(word) { return true }
        }
    }
    false
}

// Every folder above the file is there.
// ORACLE-WORKAROUND(55): the memory file system makes only the LAST folder of `create_dir_all`, so every folder above the file is made one by one; make the path in one call when item 55 is fixed
fn make_parents(path str) Fs -> () {
    mut names = []str.new()
    for part in path.split("/") { names.push(part) }
    mut acc = ""
    mut i = 0
    while i + 1 < names.len() {
        if names[i] != "" {
            acc = "${acc}/${names[i]}"
            ro made = create_dir_all(Path.posix(acc))
        }
        i += 1
    }
}

fn one(name str, text str) -> []NamedText => [NamedText { name, text }]

// The scenarios of the folder whose names start with `prefix`.
fn scenarios_with(prefix str) -> []NamedText {
    mut out = []NamedText.new()
    for f in scenario_files() {
        if f.name.starts_with(prefix) { out.push(f) }
    }
    out
}

// `alula run` of every scenario in `list` on the machine in the file `machine_name`; "" when all are `ok`, else the first that is not and what it printed.
fn run_all(machine_name str, machine_text str, list []NamedText) -> str {
    for s in list {
        ro ran = run_with(["run", "/r/${machine_name}", "/r/${s.name}"], [NamedText { name: "/r/${machine_name}", text: machine_text }, NamedText { name: "/r/${s.name}", text: s.text }])
        if ran.code != 0 || ran.out != "ok\n" { return "${s.name}: code ${ran.code} ${ran.out} ${ran.err}" }
    }
    ""
}
