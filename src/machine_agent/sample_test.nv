// sample_test.nv - the sample of the methodology (spec/samples/agent-step.alula.md of the package, copied as it is into `machines/methodology/agent-step-sample.txt`) and the machine of the agent step of the product:
// the JSON of the product table is the JSON of the sample but for the keys of the project, the table is the sample but for the keys of the project and the JSON name `usage`. The translation of the sample
// itself (no errors, the numbers, the names of the reference) is proved in the package (task 158).
module crew_harness.machine_agent

// ORACLE-WORKAROUND(32): `import std.text` is needed in `nova build` for `[]str.join` (a `nova test` build has it already); drop the import when item 32 is fixed
import std.text
import alula.machine_text.{translate_checked_with, TranslateReport}
import crew_harness.machines.{methodology_registry, agent_step_table_text, agent_step_machine_text, agent_step_sample_text, library_files}

fn lf(text str) -> str => text.replace("\r\n", "\n")

fn sample() -> str => lf(agent_step_sample_text())

fn sample_report() -> TranslateReport => translate_checked_with(sample(), methodology_registry(), library_files())

fn sample_json() -> str => sample_report().json

fn report_of(text str) -> TranslateReport => translate_checked_with(text, methodology_registry(), library_files())

test "sm project keys" {
    ro json = sample_json()
    assert(!json.contains("project_key"))
    ro product = agent_step_machine_text()
    assert(product.contains("\"project_key\":\"пауза_повтора\""))
    assert(product.contains("\"project_key\":\"политика_разрешений\""))
}

fn with_keys(text str) -> str {
    mut out = []str.new()
    for line in text.split("\n") {
        if line.starts_with("| ПАУЗА_ПОВТОРА |") {
            out.push("${line[..line.byte_len() - 5]}проект.пауза_повтора |")
        } else if line.starts_with("| ПОЛИТИКА_РАЗРЕШЕНИЙ |") {
            out.push("${line[..line.byte_len() - 5]}проект.политика_разрешений |")
        } else {
            out.push(line)
        }
    }
    out.join("\n")
}

// The rows of `## Имена` of the product: the sample's `transport_usage` of the datum and the JSON name `usage` of the field `расход` of the five answers (the scenarios of the product say `usage`).
fn product_rows() -> str => "| расход | transport_usage |\n| ИтогХода.Закончен.расход | usage |\n| ИтогХода.Обрезан.расход | usage |\n| ИтогХода.ПределЗапросов.расход | usage |\n| ИтогХода.МодельОтказалась.расход | usage |\n| ИтогХода.Отменён.расход | usage |\n"

fn with_usage(text str) -> str => text.replace("| расход | transport_usage |\n", product_rows())

test "sm product is sample" {
    // the product table is the sample but for the keys of the project and the JSON name `usage` of the field `расход` (the sample says `transport_usage`; the scenarios of the product say `usage`)
    ro keyed = with_usage(with_keys(sample()))
    assert(keyed != sample())
    assert(lf(agent_step_table_text()) == keyed)
}

test "sm json differs by keys" {
    ro product = agent_step_machine_text()
    ro plain = product.replace(",\"project_key\":\"пауза_повтора\"", "").replace(",\"project_key\":\"политика_разрешений\"", "")
    assert(plain != product)
    assert(plain == report_of(with_usage(sample())).json)
    assert(translate_checked_with(agent_step_table_text(), methodology_registry(), library_files()).json == product)
}
