// agent_test.nv - the machine "Agent step" of the product: the table `machines/agent_step.alula.md` (format 2.7: the sample of the methodology and the keys of the project) translates without a note, its translation is the committed
// file `agent_step.alula.json`, the machine passes the checks of the load and is made; the same table without the list markers (format 2.5) gives the same tree.
module crew_harness.machine_agent

import std.text
import alula.machine_table.{load_machine}
import alula.machine_run.{load_alula_machine}
import alula.machine_text.{translate_checked_with, translate_report_with, TranslateReport, error_text, render_summary}
import crew_harness.machines.{methodology_registry, agent_step_machine_text, agent_step_table_text, translation_files}

fn agent_report() -> TranslateReport => translate_checked_with(agent_step_table_text(), methodology_registry(), translation_files())

fn errors_text(report TranslateReport) -> str {
    mut parts = []str.new()
    for e in report.errors { parts.push(error_text(e, "agent_step.alula.md")) }
    parts.join(" ## ")
}

test "ag clean" {
    ro report = agent_report()
    if report.errors.len() > 0 { panic(errors_text(report)) }
    assert(report.errors.len() == 0)
    assert(report.rows_noted == 0)
    // Alula 2.26: no column `№`, no rows of the counters of the parties and of the data of the engine, no rows of the request that only the engine read (the bound as for the other machines)
    assert(report.rows_total > 100)
}

test "ag file is translation" {
    assert(agent_report().json == agent_step_machine_text())
    // Alula 2.26 (AL-138): the tree carries the reads of the states that the check derives, with the hidden reads of the external functions of the registry of the host; the translation
    // without the registry does not know them, so only the checked translation is the committed file
    assert(translate_report_with(agent_step_table_text(), translation_files()).errors.len() == 0)
}

test "ag loads" {
    match load_machine(agent_step_machine_text(), methodology_registry()) {
        Ok(def) => {
            assert(def.name == "agent_step")
            assert(def.version == "1")
            assert(def.states.len() == 14)
            assert(def.common.len() == 6)
            assert(def.parties.len() == 3)
            assert(def.data.len() == 22)
            assert(def.definitions.len() == 16)
            assert(def.end_rows.len() == 13)
            assert(def.primitives.len() == 2)
            assert(def.request_limit.len() == 1)
            assert(def.initial == "Start")
            assert(def.error_end == "Errored")
        }
        Err(issues) => panic("the agent step does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

test "ag builds" {
    match load_alula_machine(agent_step_machine_text(), methodology_registry()) {
        Ok(m) => {
            assert(m.name() == "agent_step")
            assert(m.limit == 1)
            assert(m.state_name(m.initial()) == "Start")
        }
        Err(e) => panic("the agent step is not made: ${e}")
    }
}

test "ag summary" {
    ro text = render_summary(agent_step_machine_text())
    assert(text.starts_with("machine agent_step (version 1): 14 states, 47 rows, "))
    assert(text.contains("  AgentTurn (appeal): 9 rows, 18 actions"))
    assert(text.contains("common events: 6 rows"))
    assert(text.contains("ends: 13 rows"))
}

// The table without the list markers and with the old continuation lines (the form before 2.26).
fn without_markers(text str) -> str {
    mut lines = []str.new()
    for line in text.split("\n") {
        if line.starts_with("  - ") {
            lines.push("           ${line[4..]}")
        } else if line.starts_with("- ") {
            lines.push(line[2..])
        } else {
            lines.push(line)
        }
    }
    lines.join("\n")
}

// Alula 2.26 (AL-137): a key line is an item of a list; the same table without the markers is refused, the key line named.
test "ag markers required" {
    ro plain = without_markers(agent_step_table_text())
    assert(plain != agent_step_table_text())
    ro report = translate_checked_with(plain, methodology_registry(), translation_files())
    assert(report.errors.len() > 0)
    assert(errors_text(report).contains("AL-137"))
}
