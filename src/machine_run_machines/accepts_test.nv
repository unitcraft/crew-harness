// accepts_test.nv - task 126: the question "does the state take this signal?" (`AlulaMachine.accepts_signal`), the hub asks it in place of the name of a state.
module crew_harness.machine_run_machines

import alula.machine.{text_of_file, Null}
import alula.engine.{Incoming, EventKind, StepEnvironment}
import crew_harness.machines.{machine_files, product_registry}
import alula.machine_run.{AlulaMachine, AlulaState, load_alula_machine}

fn ac_load(file str) -> AlulaMachine {
    match load_alula_machine(text_of_file(machine_files(), file), product_registry()) {
        Ok(m) => m
        Err(e) => panic("${file} does not load: ${e}")
    }
}

fn ac_dialog() -> AlulaMachine => ac_load("dialog.alula.json")

fn ac_chat() -> AlulaMachine => ac_load("chat.alula.json")

fn ac_feed(m AlulaMachine, s AlulaState, e Incoming) -> AlulaState {
    mut environment = StepEnvironment.new()
    match m.step(s, e, environment) {
        Go(next) => next
        Stay => s
    }
}

fn ac_in(m AlulaMachine, s AlulaState, name str, input str) -> AlulaState => ac_feed(m, s, stamped(EventKind.Input, name, None, input))

fn ac_open(m AlulaMachine) -> AlulaState => ac_in(m, m.initial(), "user_message", "hi")

fn ac_named(s AlulaState, name str) -> AlulaState => { name, started: s.started, input: s.input, data: s.data, taken: []str.new() }

test "ac dialog: Idle takes a message" {
    ro m = ac_dialog()
    assert(m.accepts_signal(m.initial(), "user_message"))
}

test "ac dialog: Idle takes the signal that closes the session" {
    ro m = ac_dialog()
    assert(m.accepts_signal(m.initial(), "close_session"))
}

test "ac dialog: Idle has no row for the cancel" {
    ro m = ac_dialog()
    assert(!m.accepts_signal(m.initial(), "cancel_request"))
}

test "ac dialog: a name the table does not know is not taken" {
    ro m = ac_dialog()
    assert(!m.accepts_signal(m.initial(), "session_created"))
    assert(!m.accepts_signal(m.initial(), "permission_decision"))
    assert(!m.accepts_signal(m.initial(), ""))
}

test "ac dialog: a turn is open after a message, the state is not the initial one" {
    ro m = ac_dialog()
    ro open = ac_open(m)
    assert(m.state_name(open) != m.state_name(m.initial()))
}

test "ac dialog: an open turn does not take a message" {
    ro m = ac_dialog()
    assert(!m.accepts_signal(ac_open(m), "user_message"))
}

test "ac dialog: an open turn takes the cancel, a signal of the table" {
    ro m = ac_dialog()
    assert(m.accepts_signal(ac_open(m), "cancel_request"))
}

test "ac dialog: an open turn does not take the signal that closes the session" {
    ro m = ac_dialog()
    assert(!m.accepts_signal(ac_open(m), "close_session"))
}

test "ac dialog: a part of an answer is not a signal" {
    ro m = ac_dialog()
    assert(!m.accepts_signal(ac_open(m), "agent_chunk"))
}

test "ac dialog: after the cancel the session takes a message again" {
    ro m = ac_dialog()
    ro back = ac_in(m, ac_open(m), "cancel_request", "")
    assert(m.accepts_signal(back, "user_message"))
    assert(!m.accepts_signal(back, "cancel_request"))
}

test "ac dialog: the end takes nothing" {
    ro m = ac_dialog()
    ro closed = ac_in(m, m.initial(), "close_session", "")
    assert(!m.accepts_signal(closed, "user_message"))
    assert(!m.accepts_signal(closed, "close_session"))
    assert(!m.accepts_signal(closed, "cancel_request"))
}

test "ac dialog: a state that is not in the table takes nothing" {
    ro m = ac_dialog()
    assert(!m.accepts_signal(ac_named(m.initial(), "NoSuchState"), "user_message"))
}

test "ac dialog: a machine that has not started takes no signal" {
    ro m = ac_dialog()
    ro s = m.initial()
    ro idle AlulaState = { name: s.name, started: false, input: s.input, data: s.data, taken: []str.new() }
    assert(!m.accepts_signal(idle, "user_message"))
}

test "ac dialog: the answer does not depend on the names of the states" {
    ro m = ac_dialog()
    ro open = ac_open(m)
    assert(m.accepts_signal(m.initial(), "user_message") != m.accepts_signal(open, "user_message"))
    assert(m.accepts_signal(m.initial(), "cancel_request") != m.accepts_signal(open, "cancel_request"))
}

test "ac chat: the first state takes a message and a cancel signal" {
    ro m = ac_chat()
    assert(m.accepts_signal(m.initial(), "user_message"))
    assert(m.accepts_signal(m.initial(), "cancel_request"))
}

test "ac chat: an open request takes the cancel and not a message" {
    ro m = ac_chat()
    ro open = ac_open(m)
    assert(!m.accepts_signal(open, "user_message"))
    assert(m.accepts_signal(open, "cancel_request"))
}

test "ac chat: the end takes nothing" {
    ro m = ac_chat()
    ro done = ac_feed(m, ac_open(m), stamped(EventKind.Answered, "agent_done", Some("agent-1"), ""))
    assert(!m.accepts_signal(done, "user_message"))
    assert(!m.accepts_signal(done, "cancel_request"))
}
