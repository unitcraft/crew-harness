// params_test.nv - P-9 of format 2.7: the interpreter takes the table "key -> value" of the project; a key is `проект.<ключ>` of the column "project override"; a key that the column
// does not have refuses the load; the value is checked against the type of the parameter. The `params` of a scenario go through the same table. P-8: the data of a signal.
module crew_harness.machine_run_machines

import std.text
import alula.machine.{Value, Int, Text, Float, Null, List, text_of_file}
import alula.machine_table.{MachineDef, load_machine}
import crew_harness.machines.{scenario_files, all_registry}
import alula.machine_run.{AlulaMachine, ProjectValue, alula_machine_with, parse_scenario, run_ok, run_scenario}

fn calc_def() -> MachineDef {
    match load_machine(machine_text("calc.alula.json"), all_registry()) {
        Ok(def) => def
        Err(issues) => panic("calc does not load")
    }
}

fn given(key str, value Value) -> []ProjectValue => [ProjectValue { key, value }]

fn calc_with(params []ProjectValue) -> Result[AlulaMachine, str] => alula_machine_with(calc_def(), all_registry(), params)

fn refusal(params []ProjectValue) -> str {
    match calc_with(params) {
        Ok(m) => "built"
        Err(e) => e
    }
}

fn policy_text() -> str => text_of_file(scenario_files(), "agent-step-policy-1.scenario.test.json")

test "pp agent keys" {
    ro sc = scenario_of("agent-step-policy-1.scenario.test.json")
    assert(sc.params.len() == 1)
    assert(sc.params[0].name == "проект.политика_разрешений")
    assert(run_ok(agent_run("agent-step-policy-1.scenario.test.json")))
    ro wrong = policy_text().replace("проект.политика_разрешений", "проект.другое")
    assert(wrong != policy_text())
    assert(parse_err(wrong) == "ok")
}

test "pp agent full dict" {
    ro m = build_from(agent_text())
    match alula_machine_with(m.def, all_registry(), given("проект.политика_разрешений", Int(1))) {
        Ok(b) => panic("built")
        Err(e) => assert(e.contains("the parameter ПОЛИТИКА_РАЗРЕШЕНИЙ"))
    }
    match alula_machine_with(m.def, all_registry(), given("проект.пауза_повтора", Int(5000))) {
        Ok(b) => assert(b.name() == "agent_step")
        Err(e) => panic(e)
    }
    match alula_machine_with(m.def, all_registry(), given("проект.пауза_повтора", Int(-1))) {
        Ok(b) => panic("built")
        Err(e) => assert(e.contains("the parameter ПАУЗА_ПОВТОРА"))
    }
}

// ---- P-8: the data of a signal ----------------------------------------------------------------------------------

fn malformed_in(file str, old str, new str) -> bool {
    ro text = text_of_file(scenario_files(), file).replace(old, new)
    if text == text_of_file(scenario_files(), file) { panic("nothing to replace in ${file}") }
    match parse_scenario(text) {
        Ok(sc) => {
            ro run = run_scenario(build_from(agent_text()), sc)
            for t in run.traces {
                for j in t.journal {
                    if j.starts_with("event_malformed") { return true }
                }
            }
            false
        }
        Err(e) => panic("the scenario does not read")
    }
}

test "pp several fields" {
    ro sc = scenario_of("agent-step-pause-1.scenario.test.json")
    assert(sc.steps[1].event.kind == "signal")
    assert(sc.steps[1].event.input.starts_with("{"))
    assert(sc.steps[1].event.input.contains("\"author\""))
    assert(run_ok(agent_run("agent-step-pause-1.scenario.test.json")))
}

test "pp one field" {
    ro sc = scenario_of("agent-step-common-3.scenario.test.json")
    assert(sc.steps[1].event.kind == "signal")
    assert(sc.steps[1].event.name == "cancel_request")
    assert(sc.steps[1].event.input == "other-1")
    assert(run_ok(agent_run("agent-step-common-3.scenario.test.json")))
}

test "pp no fields" {
    ro sc = scenario_of("agent-step-pause-2.scenario.test.json")
    assert(sc.steps[2].event.kind == "signal")
    assert(sc.steps[2].event.name == "halt")
    assert(sc.steps[2].event.input == "")
    assert(run_ok(agent_run("agent-step-pause-2.scenario.test.json")))
}

test "pp wrong shape" {
    assert(malformed_in("agent-step-pause-1.scenario.test.json", "{\"human_word\": \"w\", \"author\": \"ann\", \"source\": \"console\"}", "\"w\""))
    assert(!malformed_in("agent-step-common-3.scenario.test.json", "\"input\": \"other-1\"", "\"input\": \"x-1\""))
}
