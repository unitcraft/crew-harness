/// The schemas of `schema/` (`machine-2.schema.json`, `scenario-0.schema.json`).
export fn schema_files() -> []NamedText => [
    NamedText { name: "machine-2.schema.json", text: embed_str("schema/machine-2.schema.json") },
    NamedText { name: "scenario-0.schema.json", text: embed_str("schema/scenario-0.schema.json") }
]

/// The text of the file with the name; the empty text when there is none.
export fn text_of_file(files []NamedText, name str) -> str {
    for f in files {
        if f.name == name { return f.text }
    }
    ""
}

/// The text of the machine of the chat session (`machines/chat.machine.json`).
export fn chat_machine_text() -> str => text_of_file(machine_files(), "chat.machine.json")

/// The names of the files that the directories hold (read at compile time with `embed_dir`): a test compares them with the lists above, so a
/// file that is added to a directory and not to its list is found.
export fn data_dir_names(dir str) -> []str {
    if dir == "machines" { return embed_dir("machines").paths() }
    if dir == "scenarios" { return embed_dir("scenarios").paths() }
    if dir == "schema" { return embed_dir("schema").paths() }
    []str.new()
}
