// data.nv - the data files that live beside the core and are compiled into the binary: the schemas (`schema/`), the machines written as
// JSON (`machines/`) and the scenarios (`scenarios/`). `embed_str` reads a file at compile time, relative to this file, so the tests and the
// product need no file system to find them. The lists of the files are written here by hand (a new file is a new line; a test of the unit
// `machine_run` fails when a scenario file of the directory is missing from the list - see README.md, "Data").
module crew_harness.machine

/// NamedText: a file of a data directory: its name and its text.
export type NamedText { name str, text str }

/// The machines of `machines/`, by the name of the file (`chat.portolan.json`).
export fn machine_files() -> []NamedText => [
    NamedText { name: "agent_step.portolan.json", text: embed_str("machines/agent_step.portolan.json") },
    NamedText { name: "actions.portolan.json", text: embed_str("machines/actions.portolan.json") },
    NamedText { name: "calc.portolan.json", text: embed_str("machines/calc.portolan.json") },
    NamedText { name: "callee.portolan.json", text: embed_str("machines/callee.portolan.json") },
    NamedText { name: "caller.portolan.json", text: embed_str("machines/caller.portolan.json") },
    NamedText { name: "chat.portolan.json", text: embed_str("machines/chat.portolan.json") },
    NamedText { name: "cycle_check.portolan.json", text: embed_str("machines/cycle_check.portolan.json") },
    NamedText { name: "dialog.portolan.json", text: embed_str("machines/dialog.portolan.json") },
    NamedText { name: "dialog_steps.portolan.json", text: embed_str("machines/dialog_steps.portolan.json") },
    NamedText { name: "fan.portolan.json", text: embed_str("machines/fan.portolan.json") },
    NamedText { name: "gate.portolan.json", text: embed_str("machines/gate.portolan.json") },
    NamedText { name: "lenses.portolan.json", text: embed_str("machines/lenses.portolan.json") },
    NamedText { name: "session_start.portolan.json", text: embed_str("machines/session_start.portolan.json") },
    NamedText { name: "variants.portolan.json", text: embed_str("machines/variants.portolan.json") }
]

/// The machines written as tables in Russian (format 2.5 to 2.7) in `machines/`, by the name of the file (`chat.portolan.md`); the translator of `src/machine_text`
/// turns them into the JSON above.
export fn table_files() -> []NamedText => [
    NamedText { name: "agent_step.portolan.txt", text: embed_str("machines/agent_step.portolan.txt") },
    NamedText { name: "callee.portolan.md", text: embed_str("machines/callee.portolan.md") },
    NamedText { name: "caller.portolan.md", text: embed_str("machines/caller.portolan.md") },
    NamedText { name: "chat.portolan.md", text: embed_str("machines/chat.portolan.md") },
    NamedText { name: "cycle_check.portolan.md", text: embed_str("machines/cycle_check.portolan.md") },
    NamedText { name: "dialog.portolan.md", text: embed_str("machines/dialog.portolan.md") },
    NamedText { name: "dialog_steps.portolan.md", text: embed_str("machines/dialog_steps.portolan.md") },
    NamedText { name: "fan.portolan.md", text: embed_str("machines/fan.portolan.md") },
    NamedText { name: "session_start.portolan.md", text: embed_str("machines/session_start.portolan.md") }
]

