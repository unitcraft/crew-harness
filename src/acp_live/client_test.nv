// client_test.nv - the handler of the effect `Link` over a FAKE ACP agent (src/acp/testdata/fake_agent.mjs, Node):
// an ordinary answer in chunks, tools, a permission and the decision, a cancel of the turn, a dead process,
// silence, a repeated final answer, a line torn in the middle of a letter, a line without a line break at the end.
module crew_harness.acp_live

import crew_harness.acp.{AcpConfig, AcpClient, open_client, acp_link}
import alula.engine.{Link, Incoming, EventKind, PartyRequest, FailCode}
import std.fs.{Fs, real_fs, Path, try_exists}
import std.os.{Os, real_os, cwd}

// ----- helpers -----

// the root of the repository: the nearest folder upward from the working directory that has nova.toml
fn repo_root() -> Path {
    mut dir = with Os = real_os() {
        match cwd() {
            Ok(p) => p
            Err(e) => panic("no working directory")
        }
    }
    mut hops = 0
    while hops < 12 {
        ro marker = dir.join("nova.toml")
        ro found = with Fs = real_fs() {
            match try_exists(marker) {
                Ok(b) => b
                Err(e) => false
            }
        }
        if found { return dir }
        match dir.parent() {
            Some(par) => { dir = par }
            None => break
        }
        hops += 1
    }
    panic("nova.toml was not found above the working directory")
}

fn fake_agent_path() -> str => repo_root().join("src").join("acp").join("testdata").join("fake_agent.mjs").display()

fn fake_config(extra []str) -> AcpConfig {
    mut args = []str.new()
    args.push(fake_agent_path())
    for a in extra { args.push(a) }
    { program: "node", args, cwd: repo_root().display(), inbox_path: "" }
}

fn start_with(config AcpConfig) Proc Detach Time -> AcpClient {
    match open_client(config) {
        Ok(c) => c
        Err(e) => panic("cannot start the fake agent: ${e}")
    }
}

fn start(extra []str) Proc Detach Time -> AcpClient => start_with(fake_config(extra))

fn req(id str, text str) -> PartyRequest[str] => {
    id, attempt: 1, party: "agent", input: text, idle_term: 0, trace: "t1", step: 1
}

fn now_ms() Time -> int => Time.now().unix_millis()

fn is_final(e Incoming) -> bool => e.kind == EventKind.Answered || e.kind == EventKind.Refused

// events until a final one (an answer or a refusal) arrived, or `limit_ms` passed
fn collect_turn(limit_ms int) Link Time -> []Incoming {
    mut out = []Incoming.new()
    ro deadline = now_ms() + limit_ms
    while now_ms() < deadline {
        match Link.receive() {
            Some(e) => {
                out.push(e)
                if is_final(e) { return out }
            }
            None => 10.to_millis().sleep()
        }
    }
    out
}

// everything that arrives within `quiet_ms` of silence
fn collect_quiet(quiet_ms int) Link Time -> []Incoming {
    mut out = []Incoming.new()
    mut last = now_ms()
    while now_ms() < last + quiet_ms {
        match Link.receive() {
            Some(e) => {
                out.push(e)
                last = now_ms()
            }
            None => 10.to_millis().sleep()
        }
    }
    out
}

// events until one with this name arrived (it is the last in the list), or `limit_ms` passed
fn collect_until(name str, limit_ms int) Link Time -> []Incoming {
    mut out = []Incoming.new()
    ro deadline = now_ms() + limit_ms
    while now_ms() < deadline {
        match Link.receive() {
            Some(e) => {
                out.push(e)
                if e.name == name { return out }
            }
            None => 10.to_millis().sleep()
        }
    }
    out
}

fn names_of(events []Incoming) -> []str {
    mut out = []str.new()
    for e in events { out.push(e.name) }
    out
}

fn text_of(events []Incoming) -> str {
    mut out = ""
    for e in events {
        if e.name == "agent_chunk" { out = "${out}${e.input}" }
    }
    out
}

fn with_name(events []Incoming, name str) -> []Incoming {
    mut out = []Incoming.new()
    for e in events {
        if e.name == name { out.push(e) }
    }
    out
}

fn request_of(e Incoming) -> str {
    match e.request {
        Some(r) => r
        None => "<none>"
    }
}

fn last_of(events []Incoming) -> Incoming => events[events.len() - 1]

fn wait_phase(mut client AcpClient, phase str, limit_ms int) Time -> bool {
    ro deadline = now_ms() + limit_ms
    while now_ms() < deadline {
        client.poll()
        if client.phase() == phase { return true }
        10.to_millis().sleep()
    }
    client.phase() == phase
}

// ----- an ordinary answer -----

test "agent: ordinary turn, chunks, end" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "hello мир"))
        ro events = collect_turn(10000)
        assert(events.len() >= 4)
        assert(text_of(events) == "Echo: hello мир")
        for e in events { assert(request_of(e) == "agent-1") }
        ro last = last_of(events)
        assert(last.kind == EventKind.Answered)
        assert(last.name == "agent_done")
        assert(events[0].kind == EventKind.Progress)
        assert(events[0].name == "agent_chunk")
    }
    assert(client.phase() == "ready")
    assert(client.session_id() == "sess_fake_1")
    assert(client.agent_name() == "fake-agent")
    assert(client.model_name() == "Fake Model")
    client.close()
}

test "agent: events carry different source keys" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "a b"))
        ro events = collect_turn(10000)
        mut keys = []str.new()
        for e in events {
            assert(e.id.byte_len() > 0)
            assert(!keys.contains(e.id))
            keys.push(e.id)
        }
        assert(keys.len() == events.len())
    }
    client.close()
}

test "agent: config_option_update replaces the reported model" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "model-change"))
        ro events = collect_turn(10000)
        mut found = false
        for event in events {
            if event.name == "agent_model" {
                found = true
                assert(event.input.contains("Second Model"))
            }
        }
        assert(found)
    }
    assert(client.model_name() == "Second Model")
    client.close()
}

test "agent: a mode chosen by the owner goes to the agent and comes back as agent_model" {
    mut client = start([])
    with Link = acp_link(client) {
        ro deadline = now_ms() + 10000
        while client.phase() != "ready" && now_ms() < deadline {
            match Link.receive() {
                Some(e) => ()
                None => 10.to_millis().sleep()
            }
        }
        assert(client.phase() == "ready")
        assert(client.options().contains("\"modes\""))
        assert(client.options().contains("\"mode\":\"default\""))
        assert(!client.select_option("mode", "nobody-offered-this"))
        assert(client.select_option("mode", "plan"))
        ro events = collect_until("agent_model", 10000)
        ro last = last_of(events)
        assert(last.name == "agent_model")
        assert(last.input.contains("\"mode\":\"plan\""))
    }
    client.close()
}

test "agent: config_option_update from another session is ignored" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "foreign-model"))
        ro events = collect_turn(10000)
        for event in events { assert(event.input != "Foreign Model") }
    }
    assert(client.model_name() == "Fake Model")
    client.close()
}

test "agent: no files, no terminal at initialize" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "caps"))
        ro events = collect_turn(10000)
        ro text = text_of(events)
        assert(text.contains("\"readTextFile\":false"))
        assert(text.contains("\"writeTextFile\":false"))
        assert(text.contains("\"terminal\":false"))
    }
    client.close()
}

test "agent: second turn in the same session" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "first"))
        ro a = collect_turn(10000)
        assert(text_of(a) == "Echo: first")
        Link.send(req("agent-2", "second"))
        ro b = collect_turn(10000)
        assert(text_of(b) == "Echo: second")
        assert(request_of(b[0]) == "agent-2")
    }
    client.close()
}

test "agent: two requests go one by one" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "one"))
        Link.send(req("agent-2", "two"))
        ro a = collect_turn(10000)
        ro b = collect_turn(10000)
        assert(text_of(a) == "Echo: one")
        for e in a { assert(request_of(e) == "agent-1") }
        assert(text_of(b) == "Echo: two")
        for e in b { assert(request_of(e) == "agent-2") }
    }
    client.close()
}

// ----- the projection on a live stream -----

test "agent: tools, plan, usage, thought, unknown" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "tools"))
        ro events = collect_turn(10000)
        ro names = names_of(events)
        assert(names.len() == 9)
        assert(names[0] == "acp_skipped")       // available_commands_update
        assert(names[1] == "tool_call")
        assert(names[2] == "tool_call_update")
        assert(names[3] == "plan")
        assert(names[4] == "usage_update")
        assert(names[5] == "agent_thought")
        assert(names[6] == "acp_skipped")       // hologram_chunk: unknown
        assert(names[7] == "agent_chunk")
        assert(names[8] == "agent_done")
        assert(events[6].input.contains("hologram_chunk"))
        assert(events[1].input.contains("call_001"))
        assert(events[4].input.contains("53000"))
        assert(text_of(events) == "Готово")
    }
    client.close()
}

test "agent: torn letter, emoji, two lines in one write" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "fragment"))
        ro events = collect_turn(10000)
        assert(text_of(events) == "Привет, мир 🙂 раз два")
        assert(last_of(events).kind == EventKind.Answered)
    }
    client.close()
}

test "agent: final answer without line break" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "noeol"))
        ro events = collect_turn(10000)
        assert(text_of(events) == "last words")
        assert(last_of(events).kind == EventKind.Answered)
        // and the process that ended after it is not a lost connection of anything: no request is open
        ro more = collect_quiet(300)
        for e in more { assert(e.kind != EventKind.Refused) }
    }
    client.close()
}

// ----- stop reasons and errors -----

test "agent: stop reasons and error codes" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "refuse"))
        ro a = collect_turn(10000)
        assert(last_of(a).kind == EventKind.Refused)
        assert(last_of(a).input == "ModelRefused")
        Link.send(req("agent-2", "maxtokens"))
        ro b = collect_turn(10000)
        assert(last_of(b).input == "MaxTokens")
        Link.send(req("agent-3", "maxrequests"))
        ro c = collect_turn(10000)
        assert(last_of(c).input == "MaxTurnRequests")
        Link.send(req("agent-4", "error"))
        ro d = collect_turn(10000)
        assert(last_of(d).kind == EventKind.Refused)
        assert(last_of(d).input == "NoResult")
        // the session is alive after all of them
        Link.send(req("agent-5", "still here"))
        ro e = collect_turn(10000)
        assert(text_of(e) == "Echo: still here")
    }
    client.close()
}

test "agent: fs and terminal requests get -32601" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "fs"))
        ro events = collect_turn(10000)
        assert(text_of(events) == "fs: -32601 terminal: -32601")
        assert(last_of(events).kind == EventKind.Answered)
    }
    client.close()
}

// ----- the permission -----

test "agent: permission waits for the owner's event" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "permission"))
        ro before = collect_until("permission_request", 10000)
        ro asked = last_of(before)
        assert(asked.name == "permission_request")
        assert(asked.kind == EventKind.Progress)
        assert(request_of(asked) == "agent-1")
        assert(asked.input.contains("\"request\":\"100\""))
        assert(asked.input.contains("Записать result.md"))
        assert(asked.input.contains("allow-once"))
        assert(client.pending_permissions().len() == 1)
        // nobody decided: the agent waits, the client does not decide for the owner
        ro quiet = collect_quiet(300)
        assert(quiet.len() == 0)
        assert(client.pending_permissions().len() == 1)
        // the decision of the owner arrives as an event
        ro decision Incoming = { id: "input-9", trace: "t1", step: 9, kind: EventKind.Input, name: "permission_decision", request: None, input: "{\"request\":\"100\",\"decision\":\"allow\"}", at: 0 }
        assert(client.decide_event(decision))
        ro after = collect_turn(10000)
        assert(text_of(after) == "permission: selected:allow-once")
        assert(last_of(after).kind == EventKind.Answered)
        assert(client.pending_permissions().len() == 0)
    }
    client.close()
}

test "agent: owner refuses: reject_once" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "permission"))
        ro before = collect_until("permission_request", 10000)
        assert(client.decide("100", "deny"))
        ro after = collect_turn(10000)
        assert(text_of(after) == "permission: selected:reject-once")
    }
    client.close()
}

test "agent: decision for an unasked key is refused" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "permission"))
        ro before = collect_until("permission_request", 10000)
        assert(!client.decide("999", "allow"))
        assert(client.pending_permissions().len() == 1)
        assert(client.decide("100", "deny"))
        assert(!client.decide("100", "deny"))
        ro after = collect_turn(10000)
        assert(last_of(after).kind == EventKind.Answered)
    }
    client.close()
}

test "agent: cancel answers open permissions cancelled" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "permission"))
        ro before = collect_until("permission_request", 10000)
        Link.cancel("agent-1")
        ro after = collect_turn(10000)
        assert(text_of(after) == "permission: cancelled")
        assert(last_of(after).kind == EventKind.Refused)
        assert(last_of(after).input == "StoppedByHuman")
        assert(client.pending_permissions().len() == 0)
    }
    client.close()
}

// ----- the cancel of a turn -----

test "agent: cancel, late chunk, next turn works" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "slow"))
        ro first = collect_until("agent_chunk", 10000)
        assert(text_of(first) == "started")
        Link.cancel("agent-1")
        ro rest = collect_turn(10000)
        assert(text_of(rest) == "late chunk after cancel")
        for e in rest { assert(request_of(e) == "agent-1") }
        assert(last_of(rest).kind == EventKind.Refused)
        assert(last_of(rest).input == "StoppedByHuman")
        Link.send(req("agent-2", "cancelcount"))
        ro next = collect_turn(10000)
        assert(text_of(next) == "cancels: 1")
        assert(request_of(next[0]) == "agent-2")
    }
    client.close()
}

test "agent: cancel of a queued request removes it" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "one"))
        Link.send(req("agent-2", "two"))
        Link.cancel("agent-2")
        ro a = collect_turn(10000)
        assert(text_of(a) == "Echo: one")
        ro rest = collect_quiet(400)
        assert(rest.len() == 0)
    }
    client.close()
}

// ----- the process dies, is silent, does not answer the handshake -----

test "agent: process dies mid-turn: ConnectionLost" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "crash"))
        ro events = collect_turn(10000)
        assert(text_of(events) == "about to crash")
        ro last = last_of(events)
        assert(last.kind == EventKind.Refused)
        assert(last.name == "agent_refused")
        assert(last.input == "ConnectionLost")
        assert(request_of(last) == "agent-1")
        assert(client.phase() == "dead")
        Link.send(req("agent-2", "anything"))
        ro again = collect_turn(2000)
        assert(again.len() == 1)
        assert(again[0].input == "ConnectionLost")
        assert(request_of(again[0]) == "agent-2")
    }
    client.close()
}

test "agent: process dies with a queue: all refused" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "crash"))
        Link.send(req("agent-2", "queued"))
        ro a = collect_turn(10000)
        assert(last_of(a).input == "ConnectionLost")
        ro b = collect_turn(10000)
        assert(b.len() == 1)
        assert(request_of(b[0]) == "agent-2")
        assert(b[0].input == "ConnectionLost")
    }
    client.close()
}

test "agent: silent agent gives nothing" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "silent"))
        ro quiet = collect_quiet(500)
        assert(quiet.len() == 0)
        Link.cancel("agent-1")
        ro after = collect_quiet(300)
        assert(after.len() == 0)
    }
    client.close()
}

test "agent: no initialize answer: waits, cancel removes" {
    mut client = start(["--no-initialize"])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "hello"))
        ro quiet = collect_quiet(400)
        assert(quiet.len() == 0)
        assert(client.phase() == "initializing")
        Link.cancel("agent-1")
        ro after = collect_quiet(200)
        assert(after.len() == 0)
    }
    client.close()
}

test "agent: no session/new answer: phase opening" {
    mut client = start(["--no-session"])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "hello"))
        // node needs a moment to start; the phase is reached when the agent has answered initialize
        assert(wait_phase(client, "opening", 15000))
        ro quiet = collect_quiet(400)
        assert(quiet.len() == 0)
        assert(client.phase() == "opening")
    }
    client.close()
}

test "agent: initialize error: refused, failed" {
    mut client = start(["--auth-error"])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "hello"))
        ro events = collect_turn(10000)
        assert(events.len() == 1)
        assert(events[0].kind == EventKind.Refused)
        assert(events[0].input == "NoResult")
        assert(client.phase() == "failed")
        Link.send(req("agent-2", "again"))
        ro again = collect_turn(2000)
        assert(again.len() == 1)
        assert(again[0].kind == EventKind.Refused)
    }
    client.close()
}

test "client: missing program is an Err" {
    ro config AcpConfig = { program: "crew-harness-no-such-agent-xyz", args: []str.new(), cwd: repo_root().display(), inbox_path: "" }
    match open_client(config) {
        Ok(c) => assert(false)
        Err(e) => assert(e.byte_len() > 0)
    }
}

test "client: stderr tail is kept" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "x"))
        ro events = collect_turn(10000)
        assert(last_of(events).kind == EventKind.Answered)
    }
    assert(client.stderr_tail().contains("fake-agent: ready"))
    client.close()
}

test "client: close ends the process, no refusal" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "silent"))
        ro quiet = collect_quiet(300)
        assert(quiet.len() == 0)
        client.close()
        assert(client.phase() == "closed")
        ro after = collect_quiet(300)
        assert(after.len() == 0)
    }
}

// ----- a repeated final answer, late events -----

test "agent: repeated final answer, late chunk are notes" {
    mut client = start([])
    with Link = acp_link(client) {
        Link.send(req("agent-1", "dup"))
        ro events = collect_turn(10000)
        assert(text_of(events) == "onceonce")
        assert(last_of(events).kind == EventKind.Answered)
        ro rest = collect_quiet(400)
        mut finals = 0
        for e in rest {
            if is_final(e) { finals += 1 }
            assert(e.kind == EventKind.Input)
            assert(e.name == "acp_note")
        }
        assert(finals == 0)
        assert(rest.len() >= 1)
    }
    client.close()
}
