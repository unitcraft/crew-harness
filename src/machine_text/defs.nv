// defs.nv - the files of definitions (format section 8): `# Определения: <имя>`, `definitions_version: N`, `format: 2.5`, the sections `## Типы`, `## Константы`,
// `## Определения` (all three, an empty one is `—`), only pure definitions. A machine includes a file by the line `определения: <имя> версия <N> хеш <hex12>`; the hash is
// the first twelve letters of the SHA-256 of the file after the normalization of the format (a BOM dropped, line feeds as LF, no spaces at the end of a line, one LF at
// the end of the file), and the tree of the machine gets a copy of what the file brings (types, constants, definitions).
module crew_harness.machine_text

import std.text
import std.crypto.sha256.{Sha256}
import crew_harness.machine.{NamedText}

/// The registry of the files of definitions that come with the translator: the name of the include line and the text of the file.
fn defs_files() -> []NamedText => [
    NamedText { name: "арифметика_цикла", text: embed_str("defs/cycle-arithmetic.portolan.md") }
]

/// The text of the file of definitions of the registry with the name; the empty text when there is none.
export fn defs_file_text(name str) -> str {
    for f in defs_files() {
        if f.name == name { return f.text }
    }
    ""
}

// ---- the hash ----------------------------------------------------------------------------------------------------------------------------

fn trim_end_blanks(line str) -> str {
    ro cs = tx_chars(line)
    mut end = cs.len()
    while end > 0 && (cs[end - 1] == " " || cs[end - 1] == "\t") { end -= 1 }
    tx_slice(cs, 0, end)
}

/// The text of a file of definitions as it is hashed (section 8): no BOM, LF only, no spaces or tabs at the end of a line, one LF at the end.
export fn normalize_definitions(text str) -> str {
    mut body = text
    ro points = text.to_code_points()
    if points.len() > 0 && points[0] == 65279 {
        mut rest = []str.new()
        mut first = true
        for c in text.chars() {
            if first {
                first = false
            } else {
                rest.push("${c}")
            }
        }
        body = rest.join("")
    }
    ro unified = body.replace("\r\n", "\n").replace("\r", "\n")
    mut lines = []str.new()
    for raw in unified.split("\n") { lines.push(trim_end_blanks(raw)) }
    while lines.len() > 0 && lines[lines.len() - 1] == "" {
        mut shorter = []str.new()
        mut k = 0
        while k < lines.len() - 1 {
            shorter.push(lines[k])
            k += 1
        }
        lines = shorter
    }
    "${lines.join("\n")}\n"
}

/// The hash of a file of definitions: twelve hexadecimal letters (section 8).
export fn definitions_hash(text str) -> str {
    ro full = Sha256.hash_str(normalize_definitions(text).bytes())
    full[..12]
}

// ---- the file ----------------------------------------------------------------------------------------------------------------------------

/// TxDefsDoc: what a file of definitions brings: its version and the JSON of its types, constants and definitions.
type TxDefsDoc { version str, types TxTypes, constants []TxJ, definitions []TxJ }

fn defs_header(entries []TxEntry, mut cx TxCx) -> str {
    mut version = ""
    mut format = ""
    if entries.len() == 0 || entries[0].kind != EN_HEAD || entries[0].level != 1 || !entries[0].text.starts_with("Определения:") {
        note(cx, struct_error(1, 1, "файл определений начинается со строки `# Определения: <имя>`"))
    }
    mut i = 1
    while i < entries.len() && entries[i].kind != EN_HEAD {
        ro e = entries[i]
        if kv_colon(e) >= 0 {
            ro line = kv_read(entries, i)
            if line.key == "definitions_version" {
                version = line.segs[0].text
            } else if line.key == "format" {
                format = line.segs[0].text
            } else {
                note(cx, struct_error(e.line, 1, "в шапке файла определений бывают строки definitions_version, format"))
            }
            i += line.taken
        } else {
            note(cx, struct_error(e.line, e.indent + 1, "лишняя строка в шапке файла определений"))
            i += 1
        }
    }
    mut version_ok = false
    match version.to_int() {
        Ok(n) => { version_ok = true }
        Err(err) => ()
    }
    if !version_ok { note(cx, struct_error(1, 1, "в шапке нет строки `definitions_version: <целое>`")) }
    if format != "2.5" && format != "2.6" && format != "2.7" { note(cx, struct_error(1, 1, "формат файла определений должен быть 2.5, 2.6 или 2.7, найдено: ${format}")) }
    version
}

fn names_in_order(sections []TxSection) -> bool {
    mut want = ["Типы", "Константы", "Определения"]
    if sections.len() != 3 { return false }
    mut k = 0
    while k < 3 {
        if sections[k].name != want[k] { return false }
        k += 1
    }
    true
}

// Does the text of the section call a primitive (`вызвать`)? A file of definitions has pure definitions only.
fn section_calls(entries []TxEntry, sec TxSection) -> Option[TxEntry] {
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_TEXT {
            match tx_lex(e.text, e.line, e.indent + 1) {
                Ok(tokens) => {
                    for t in tokens {
                        if t_is_word(t, "вызвать") { return Some(e) }
                    }
                }
                Err(err) => ()
            }
        }
        i += 1
    }
    None
}

/// The file of definitions read: the version and the pieces of the JSON. The errors go to `cx` with the lines of the file.
fn defs_read(file_text str, mut cx TxCx) -> TxDefsDoc {
    ro entries = tx_classify(lines_of(file_text))
    ro version = defs_header(entries, cx)
    ro sections = sections_of(entries, cx)
    if !names_in_order(sections) {
        note(cx, struct_error(1, 1, "в файле определений три раздела по порядку: Типы, Константы, Определения (пустой раздел — `—`)"))
    }
    mut types = TxTypes { records: []TxJ.new(), variants: []TxJ.new() }
    mut constants = []TxJ.new()
    mut definitions = []TxJ.new()
    match section_of(sections, "Типы") {
        Some(sec) => { types = decl_types(entries, sec, cx) }
        None => ()
    }
    match section_of(sections, "Константы") {
        Some(sec) => { constants = decl_constants(entries, sec, cx) }
        None => ()
    }
    match section_of(sections, "Определения") {
        Some(sec) => {
            match section_calls(entries, sec) {
                Some(e) => note(cx, struct_error(e.line, e.indent + 1, "в файле определений нет `вызвать`: только чистые определения"))
                None => ()
            }
            defs_register(entries, sec, cx)
            definitions = decl_definitions(entries, sec, cx)
        }
        None => ()
    }
    TxDefsDoc { version, types, constants, definitions }
}

// ---- the include lines --------------------------------------------------------------------------------------------------------------------

/// TxDefsCall: a line `определения: имя версия N хеш H`.
type TxDefsCall { name str, version str, hash str, line int, col int }

fn defs_call_read(line TxKv, e TxEntry) -> Result[TxDefsCall, TranslateError] {
    mut p = lex_segs(line.segs)?
    ro n = p_tok(p)
    if n.kind != TK_NAME { return Err(p_fail(p, "после `определения:` ожидается имя файла")) }
    p_adv(p)
    p_expect_word(p, "версия")?
    ro v = p_tok(p)
    if v.kind != TK_INT { return Err(p_fail(p, "после `версия` ожидается целое число")) }
    p_adv(p)
    p_expect_word(p, "хеш")?
    // the hash can start with a digit: it is read from the text of the line, not from the words
    ro raw = line.segs[0].text
    ro at = raw.rfind("хеш") ?? -1
    mut hash = ""
    if at >= 0 { hash = raw[at + ("хеш").byte_len()..].trim_ascii() }
    if hash.byte_len() != 12 || !is_hex(hash) { return Err(tx_err(e.line, line.segs[0].col, "syntax", "после `хеш` ожидается 12 шестнадцатеричных знаков")) }
    Ok(TxDefsCall { name: n.text, version: v.text, hash, line: e.line, col: n.col })
}

fn is_hex(s str) -> bool {
    for c in s.chars() {
        ro one = "${c}"
        ro ok = (one >= "0" && one <= "9") || (one >= "a" && one <= "f")
        if !ok { return false }
    }
    true
}

fn defs_file_named(name str, registry []NamedText) -> Option[NamedText] {
    for f in registry {
        if f.name == name { return Some(f) }
    }
    None
}

/// TxIncluded: the files of definitions included by a machine: the JSON of what they bring and the `includes` of the tree.
type TxIncluded { types TxTypes, constants []TxJ, definitions []TxJ, includes []TxJ }

/// The include lines of the section `## Подключения` against the registry: the file by the name, the version, the hash; the copy of what it brings.
fn defs_includes(entries []TxEntry, sec TxSection, registry []NamedText, mut cx TxCx) -> TxIncluded {
    mut records = []TxJ.new()
    mut variants = []TxJ.new()
    mut constants = []TxJ.new()
    mut definitions = []TxJ.new()
    mut includes = []TxJ.new()
    mut names = []str.new()
    mut i = sec.first
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_TEXT && kv_colon(e) >= 0 {
            ro line = kv_read(entries, i)
            if line.key == "определения" {
                match defs_call_read(line, e) {
                    Ok(call) => {
                        match defs_file_named(call.name, registry) {
                            None => note(cx, tx_err(call.line, call.col, "name", "файла определений `${call.name}` нет в реестре подключаемых файлов"))
                            Some(file) => {
                                if names.contains(call.name) { note(cx, tx_err(call.line, call.col, "structure", "файл определений `${call.name}` подключён дважды")) }
                                names.push(call.name)
                                ro before = cx.errors.len()
                                ro doc = defs_read(file.text, cx)
                                // the errors of the file belong to the line of the include
                                mut kept = []TranslateError.new()
                                mut k = 0
                                for err in cx.errors {
                                    if k < before {
                                        kept.push(err)
                                    } else {
                                        kept.push(TranslateError { line: call.line, col: call.col, kind: err.kind, message: "в файле определений ${call.name}: ${err.message}", quote: "" })
                                    }
                                    k += 1
                                }
                                cx.errors = kept
                                if doc.version != call.version {
                                    note(cx, tx_err(call.line, call.col, "check", "версия файла ${call.name} — ${doc.version}, а в подключении ${call.version}"))
                                }
                                ro actual = definitions_hash(file.text)
                                if actual != call.hash {
                                    note(cx, tx_err(call.line, call.col, "check", "хеш файла ${call.name} — ${actual}, а в подключении ${call.hash}"))
                                }
                                for r in doc.types.records { records.push(r) }
                                for v in doc.types.variants { variants.push(v) }
                                for c in doc.constants { constants.push(c) }
                                for d in doc.definitions { definitions.push(d) }
                                includes.push(jobj([kv("name", js(call.name)), kv("version", js(call.version)), kv("hash", js(call.hash))]))
                            }
                        }
                    }
                    Err(err) => note(cx, err)
                }
            }
            i += line.taken
        } else {
            i += 1
        }
    }
    TxIncluded { types: TxTypes { records, variants }, constants, definitions, includes }
}
