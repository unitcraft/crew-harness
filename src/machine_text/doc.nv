// doc.nv - the structure of a file of a machine: the header, the sections `##`, the lines `Ключ: значение` with their continuation lines, the tables
// with the check of their columns.
module crew_harness.machine_text

import std.text

/// TxSection: a section `## Имя`: the name, the line of the heading and the entries [first, last) that belong to it (the heading itself is not among them).
type TxSection { name str, line int, first int, last int }

/// TxSeg: a piece of text of a line with its place; the value of a `Ключ: значение` line is one piece and the pieces of its continuation lines.
type TxSeg { text str, line int, col int }

/// TxKv: a line `Ключ: значение`: the key, the pieces of the value, and the number of the entries it takes.
type TxKv { key str, segs []TxSeg, line int, taken int }

fn kv_keys() -> []str => [
    "Начальное состояние", "Сторона", "Срок тишины", "Правит", "Возвратов формы", "Вход", "При приёме", "При входе", "Кроме", "Результат",
    "Предел запросов", "Инвариант", "machine", "machine_version", "format", "definitions_version", "fragment", "определения"
]

/// Is the text a line `Ключ: значение` with a known key? Returns the index of the colon in characters, or -1.
fn kv_colon_text(text str) -> int {
    ro cs = tx_chars(text)
    mut i = 0
    while i < cs.len() {
        if cs[i] == ":" {
            ro key = tx_slice(cs, 0, i).trim_ascii()
            if kv_keys().contains(key) { return i }
            return -1
        }
        if cs[i] == "(" || cs[i] == "=" || cs[i] == "|" { return -1 }
        i += 1
    }
    -1
}

/// Is the entry a line `Ключ: значение` with a known key? Returns the index of the colon in characters, or -1.
fn kv_colon(entry TxEntry) -> int {
    if entry.kind != EN_TEXT || entry.indent != 0 { return -1 }
    kv_colon_text(entry.text)
}

/// The line `Ключ: значение` at `at` of the entries with its continuation lines (the following free lines that are indented).
fn kv_read(entries []TxEntry, at int) -> TxKv {
    ro entry = entries[at]
    ro colon = kv_colon(entry)
    ro cs = tx_chars(entry.text)
    ro key = tx_slice(cs, 0, colon).trim_ascii()
    mut segs = []TxSeg.new()
    ro rest = tx_slice(cs, colon + 1, cs.len())
    mut lead = 0
    ro rcs = tx_chars(rest)
    while lead < rcs.len() && tx_is_space(rcs[lead]) { lead += 1 }
    segs.push(TxSeg { text: tx_slice(rcs, lead, rcs.len()), line: entry.line, col: entry.indent + entry.shift + colon + 1 + lead + 1 })
    mut taken = 1
    while at + taken < entries.len() {
        ro next = entries[at + taken]
        if next.kind != EN_TEXT || next.indent == 0 { break }
        // a continuation line may be an item of a nested list (`  - действие;`, format 2.6): the marker is not a part of the text
        mut item_lead = 0
        if next.text.starts_with("- ") {
            item_lead = 1
            ro ncs = tx_chars(next.text)
            while item_lead < ncs.len() && tx_is_space(ncs[item_lead]) { item_lead += 1 }
        }
        segs.push(TxSeg { text: tx_slice(tx_chars(next.text), item_lead, tx_chars(next.text).len()), line: next.line, col: next.indent + item_lead + 1 })
        taken += 1
    }
    TxKv { key, segs, line: entry.line, taken }
}

/// The tokens of the pieces, one after another; the end of the text is the end of the last piece.
fn lex_segs(segs []TxSeg) -> Result[TxP, TranslateError] {
    mut all = []TxTok.new()
    mut end_line = 1
    mut end_col = 1
    for seg in segs {
        ro tokens = tx_lex(seg.text, seg.line, seg.col)?
        for t in tokens { all.push(t) }
        end_line = seg.line
        end_col = seg.col + seg.text.chars().count()
    }
    Ok(p_new(all, end_line, end_col))
}

/// The tokens of a cell.
fn cell_p(cell TxCell, line int) -> Result[TxP, TranslateError] {
    ro tokens = tx_lex(cell.text, line, cell.col)?
    Ok(p_new(tokens, line, cell.col + cell.text.chars().count()))
}

/// The tokens of the free line of an entry.
fn entry_p(entry TxEntry) -> Result[TxP, TranslateError] {
    ro tokens = tx_lex(entry.text, entry.line, entry.indent + entry.shift + 1)?
    Ok(p_new(tokens, entry.line, entry.indent + entry.shift + 1 + entry.text.chars().count()))
}

fn note(mut cx TxCx, e TranslateError) -> () {
    cx.errors.push(e)
}

fn struct_error(line int, col int, message str) -> TranslateError => tx_err(line, col, "structure", message)

// ---- the sections ----------------------------------------------------------------------------------------------------------------

fn section_names() -> []str => [
    "Типы", "Константы", "Параметры", "Вход", "Данные", "Стороны", "Сигналы", "Части ответа", "Определения", "Подключения", "Общие события",
    "Состояния", "Концы", "Примитивы"
]

/// The sections of the file after the first heading, in order. A heading of another name, or a repeated one, is an error.
fn sections_of(entries []TxEntry, mut cx TxCx) -> []TxSection {
    mut out = []TxSection.new()
    mut i = 0
    while i < entries.len() {
        if entries[i].kind == EN_HEAD && entries[i].level == 2 {
            ro name = entries[i].text
            mut last = i + 1
            while last < entries.len() && !(entries[last].kind == EN_HEAD && entries[last].level <= 2) { last += 1 }
            if name.starts_with("Раскрытие фрагмента") {
                // a reference for the reader (format 2.7, P-2): the reader skips it whole
                i = last
                continue
            }
            if !section_names().contains(name) {
                note(cx, struct_error(entries[i].line, 4, "неизвестный раздел `${name}`: бывают ${section_names().join(", ")}"))
            } else {
                for seen in out {
                    if seen.name == name { note(cx, struct_error(entries[i].line, 4, "раздел `${name}` повторён")) }
                }
                out.push(TxSection { name, line: entries[i].line, first: i + 1, last })
            }
            i = last
        } else {
            i += 1
        }
    }
    out
}

fn section_of(sections []TxSection, name str) -> Option[TxSection] {
    for s in sections {
        if s.name == name { return Some(s) }
    }
    None
}

// ---- the tables ------------------------------------------------------------------------------------------------------------------

/// The text of a header cell for the comparison: lower case, one space between words.
fn header_norm(s str) -> str {
    mut out = []str.new()
    for c in s.chars() { out.push(tx_lower("${c}")) }
    out.join("")
}

fn table_lead_words() -> []str => ["поле запроса", "№", "событие", "конец", "имя", "сторона"]

/// Does the row start another table (its first cell is the first cell of a header)? Two tables may follow each other without a line between them.
fn row_starts_table(e TxEntry) -> bool => e.kind == EN_ROW && e.cells.len() > 0 && table_lead_words().contains(e.cells[0].text)

/// TxRows: the body rows of a table and the line of its header.
type TxRows { rows []TxEntry, header_line int }

/// The rows of the table that starts at the entry `at` (its header) and stops at the first entry that is not a row or is the header of another table
/// (`stop_words` are the first cells of headers). The columns of the header must be `expected`; every body row must have as many cells.
fn tab_read(entries []TxEntry, at int, last int, expected []str, mut cx TxCx) -> TxRows {
    mut rows = []TxEntry.new()
    ro head = entries[at]
    mut ok = head.cells.len() == expected.len()
    if ok {
        mut k = 0
        while k < expected.len() {
            if header_norm(head.cells[k].text) != header_norm(expected[k]) { ok = false }
            k += 1
        }
    }
    if !ok {
        note(cx, struct_error(head.line, 1, "столбцы таблицы: ${expected.join(" | ")}"))
    }
    mut i = at + 1
    while i < last && entries[i].kind == EN_ROW && !row_starts_table(entries[i]) {
        if entries[i].cells.len() != expected.len() {
            note(cx, struct_error(entries[i].line, 1, "в строке ${entries[i].cells.len()} ячеек, а в таблице их ${expected.len()}"))
        } else {
            rows.push(entries[i])
        }
        i += 1
    }
    TxRows { rows, header_line: head.line }
}

/// The index of the first entry after the table that starts at `at`.
fn tab_end(entries []TxEntry, at int, last int) -> int {
    mut i = at + 1
    while i < last && entries[i].kind == EN_ROW && !row_starts_table(entries[i]) { i += 1 }
    i
}

/// The body of a section that is a single table: its rows. A section that is only `—` has no rows; any other free line is an error.
fn section_table(entries []TxEntry, sec TxSection, expected []str, mut cx TxCx) -> []TxEntry {
    mut rows = []TxEntry.new()
    mut i = sec.first
    mut seen = false
    while i < sec.last {
        ro e = entries[i]
        if e.kind == EN_ROW && !seen {
            ro t = tab_read(entries, i, sec.last, expected, cx)
            for r in t.rows { rows.push(r) }
            seen = true
            i = tab_end(entries, i, sec.last)
        } else if e.kind == EN_TEXT && e.text == "—" {
            i += 1
        } else {
            note(cx, struct_error(e.line, e.indent + 1, "лишняя строка в разделе `${sec.name}`"))
            i += 1
        }
    }
    rows
}
