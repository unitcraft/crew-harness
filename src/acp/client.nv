// client.nv - the ACP client over stdio and the handler of the effect `Link` on it.
//
// What it speaks (Agent Client Protocol, JSON-RPC 2.0, one message per line): `initialize`, `session/new`,
// `session/prompt` and `session/cancel` of ours; `session/update` (chunks, tools, plans, usage) and `session/request_permission`
// of the agent. Files and terminal of the client are NOT declared at `initialize`; if the agent asks for them anyway (`fs/*`,
// `terminal/*`, any method we do not know) it gets the error -32601 "method not found" and a note for the journal.
//
// The client does not run anything by itself: the handler's operations (`send`, `receive`, `cancel`, `ack`) and `poll` do the
// work, driven by the pump of the engine. `receive` first takes what the fibers around the process have brought
// (`poll`: the handshake moves on, lines become events), then hands out one event or None - it never waits.
//
// The phases: `initializing` (initialize sent), `opening` (session/new sent), `ready`, `dead` (the process ended),
// `failed` (the agent refused the handshake), `closed` (we closed it).
//
// Acknowledgement (see README, "How an event is acknowledged"): every event gets a source key `acp-<n>` in `Incoming.id`. It is
// written to the inbox file (when the config has one) BEFORE it is handed out. `receive` moves it to "taken"; `ack(key)` -
// which the engine calls after the commit of the step - forgets it. A restart hands out again, first, what was not
// acknowledged. The numbers never go back, not even after the file is compacted, so a key is never used for two events.
module crew_harness.acp

import alula.engine.{Link, Incoming, EventKind, PartyRequest, FailCode}
import crew_harness.storage.{append_line, read_lines, replace_file, encode_image}
import crew_harness.projects.{EnvEntry}
import std.encoding.json.{Json, JsonValue, JsonObject}
import std.fs.{Fs, real_fs, Path, read}

/// AcpConfig: how to start the agent. `program` and `args` - the command (by default `opencode acp`); `cwd` - the absolute
/// folder of the session (`session/new` needs it, and the process is started there); `inbox_path` - the file of the
/// unacknowledged events, "" - none (the events live in memory only).
export type AcpConfig { program str, args []str, cwd str, inbox_path str }

/// The default config: `opencode acp` in the folder `cwd`, no inbox file.
export fn default_config(cwd str) -> AcpConfig => { program: "opencode", args: ["acp"], cwd, inbox_path: "" }

/// AcpImage: a picture that goes with the next prompt: the file it was kept in (storage/images.nv), its type and the name the owner saw.
export type AcpImage { path str, mime str, name str }

type AcpQueued { request str, text str, images []AcpImage, pre str }

type AcpOption { id str, kind str }

type AcpPending { key str, id JsonValue, options []AcpOption }

// A question of the agent that waits for the owner (task 192i): the key of the request, its JSON-RPC id and the parameters of the call
// (the answer is made from them again, `question_response`).
type AcpAsk { key str, id JsonValue, params JsonValue }

/// AskSetup: what the client offers the agent for its questions (task 192i). `form`: say at `initialize` that the client shows a form
/// (`clientCapabilities.elicitation.form`), so the agents use their own tool of questions and `elicitation/create` comes; `mcp_url` and
/// `mcp_token`: the MCP server of the hub with the tool `ask_user_question`, handed to the agent in `session/new` when it can use an HTTP
/// server (`agentCapabilities.mcpCapabilities.http`); "" - none. `hint`: a short note put before the first prompt when the server was handed over, so that
/// the agent knows to use the tool ("" - none); the note is not in the journal and not in the feed.
export type AskSetup { form bool, mcp_url str, mcp_token str, hint str }

/// Nothing offered: the agent is asked nothing and gets no tool.
export fn no_ask() -> AskSetup => { form: false, mcp_url: "", mcp_token: "", hint: "" }

type AcpSet { rpc int, setting str, value str, owner bool }

/// AcpPreset: a choice of the owner (task 192t): `setting` is `mode`, `model` or `effort`, `value` the id the agent offered. The hub keeps them in the
/// journal and hands them to every agent it starts for the session (`set_presets`); the client asks the agent for them once `session/new` is answered.
export type AcpPreset { setting str, value str }

/// AcpDrop: a preset the agent did not take because it does not offer the value (any more): what was wanted, and the id the agent holds instead.
export type AcpDrop { setting str, value str, used str }

type AcpInboxItem { seq int, event Incoming }

/// AcpClient: one agent process, one session. Mutable: `poll`, `decide` and the operations of the handler change it.
export type AcpClient {
    config AcpConfig,
    link AgentLink,
    phase str,
    next_rpc int,
    init_rpc int,
    new_rpc int,
    prompt_rpc int,
    session str,
    agent str,
    model_name str,
    modes JsonValue,
    models JsonValue,
    choices_cfg JsonValue,
    mode_now str,
    model_now str,
    sets []AcpSet,
    queue []AcpQueued,
    active str,
    permissions []AcpPending,
    ask AskSetup,
    asks []AcpAsk,
    mcp_http bool,
    hint_due bool,
    ready []AcpInboxItem,
    taken []AcpInboxItem,
    next_seq int,
    stderr str,
    exit_code int,
    last_error str,
    trace AcpTrace,
    images_ok bool,
    attached []AcpImage,
    prelude str,
    presets []AcpPreset,
    settled []AcpPreset,
    dropped []AcpDrop,
    marker MarkerState
}

const STDERR_KEEP = 4000

fn parse_value(text str) -> JsonValue {
    match Json.parse(text) {
        Ok(v) => v
        Err(e) => panic("a constant that is not JSON: ${text}")
    }
}

fn initialize_params(form bool) -> JsonValue {
    if form {
        return parse_value("{\"protocolVersion\":1,\"clientCapabilities\":{\"fs\":{\"readTextFile\":false,\"writeTextFile\":false},\"terminal\":false,\"elicitation\":{\"form\":{}}},\"clientInfo\":{\"name\":\"crew-harness\",\"title\":\"CrewHarness\",\"version\":\"0.1.0\"}}")
    }
    parse_value("{\"protocolVersion\":1,\"clientCapabilities\":{\"fs\":{\"readTextFile\":false,\"writeTextFile\":false},\"terminal\":false},\"clientInfo\":{\"name\":\"crew-harness\",\"title\":\"CrewHarness\",\"version\":\"0.1.0\"}}")
}

// The MCP server of the hub as `session/new` wants it: an HTTP server with the token in the header `Authorization`.
fn mcp_servers_params(url str, token str) -> JsonValue {
    mut header = JsonObject.new()
    put(header, "name", JsonValue.str("Authorization"))
    put(header, "value", JsonValue.str("Bearer ${token}"))
    mut server = JsonObject.new()
    put(server, "type", JsonValue.str("http"))
    put(server, "name", JsonValue.str("crew"))
    put(server, "url", JsonValue.str(url))
    put(server, "headers", JsonValue.array([JsonValue.object(header)]))
    JsonValue.array([JsonValue.object(server)])
}

fn new_session_params(cwd str, servers JsonValue) -> JsonValue {
    mut o = JsonObject.new()
    put(o, "cwd", JsonValue.str(cwd))
    put(o, "mcpServers", servers)
    JsonValue.object(o)
}

/// The block of a picture of the prompt (ACP content block `image`): the type, the MIME type, the base64 of the bytes.
export fn image_block(mime str, data str) -> JsonValue {
    mut block = JsonObject.new()
    put(block, "type", JsonValue.str("image"))
    put(block, "mimeType", JsonValue.str(mime))
    put(block, "data", JsonValue.str(data))
    JsonValue.object(block)
}

fn prompt_params(session str, text str, pictures []JsonValue) -> JsonValue {
    mut block = JsonObject.new()
    put(block, "type", JsonValue.str("text"))
    put(block, "text", JsonValue.str(text))
    mut blocks = []JsonValue.new()
    // a message of pictures alone has no text block: an empty one is refused by some agents
    if text.byte_len() > 0 || pictures.len() == 0 { blocks.push(JsonValue.object(block)) }
    for picture in pictures { blocks.push(picture) }
    mut o = JsonObject.new()
    put(o, "sessionId", JsonValue.str(session))
    put(o, "prompt", JsonValue.array(blocks))
    JsonValue.object(o)
}

fn session_params(session str) -> JsonValue {
    mut o = JsonObject.new()
    put(o, "sessionId", JsonValue.str(session))
    JsonValue.object(o)
}

fn outcome_result(outcome str, option str) -> JsonValue {
    mut inner = JsonObject.new()
    put(inner, "outcome", JsonValue.str(outcome))
    if option.byte_len() > 0 { put(inner, "optionId", JsonValue.str(option)) }
    mut o = JsonObject.new()
    put(o, "outcome", JsonValue.object(inner))
    JsonValue.object(o)
}

fn field(v JsonValue, key str) -> Option[JsonValue] {
    ro o = v.object()?
    o.get(key)
}

fn field_text(v JsonValue, key str) -> Option[str] {
    ro f = field(v, key)?
    f.str()
}

fn field_int(v JsonValue, key str) -> Option[int] {
    ro f = field(v, key)?
    f.int()
}

// ----- the inbox file: lines of JSON, "seq" (the next number), "event" and "ack" -----

fn kind_of_name(name str) -> Option[EventKind] {
    if name == "input" { return Some(EventKind.Input) }
    if name == "progress" { return Some(EventKind.Progress) }
    if name == "answered" { return Some(EventKind.Answered) }
    if name == "refused" { return Some(EventKind.Refused) }
    if name == "expired" { return Some(EventKind.Expired) }
    None
}

fn event_line(seq int, e Incoming) -> str {
    mut o = JsonObject.new()
    put(o, "t", JsonValue.str("event"))
    put(o, "seq", JsonValue.int(seq))
    put(o, "kind", JsonValue.str(e.kind.name()))
    put(o, "name", JsonValue.str(e.name))
    match e.request {
        Some(r) => put(o, "request", JsonValue.str(r))
        None => put(o, "request", JsonValue.null())
    }
    put(o, "input", JsonValue.str(e.input))
    JsonValue.object(o).to_str()
}

fn ack_line(seq int) -> str {
    mut o = JsonObject.new()
    put(o, "t", JsonValue.str("ack"))
    put(o, "seq", JsonValue.int(seq))
    JsonValue.object(o).to_str()
}

fn seq_line(next int) -> str {
    mut o = JsonObject.new()
    put(o, "t", JsonValue.str("seq"))
    put(o, "next", JsonValue.int(next))
    JsonValue.object(o).to_str()
}

fn key_of(seq int) -> str => "acp-${seq}"

fn item_of(seq int, event Incoming) -> AcpInboxItem => { seq, event }

// The event of a line of the inbox file; None - the line is not an event.
fn parse_event_line(v JsonValue) -> Option[AcpInboxItem] {
    ro seq = field_int(v, "seq")?
    ro kind = kind_of_name(field_text(v, "kind")?)?
    ro name = field_text(v, "name")?
    ro input = field_text(v, "input")?
    ro request = match field(v, "request") {
        Some(r) => r.str()
        None => None
    }
    ro raw = Incoming.incoming(kind, name, request, input)
    Some(item_of(seq, Incoming.from_source(key_of(seq), raw)))
}

/// What a restart finds in the inbox file: the events nobody acknowledged, in the order of their numbers, and the next number.
type AcpRecovered { items []AcpInboxItem, next int }

fn recovered_of(items []AcpInboxItem, next int) -> AcpRecovered => { items, next }

fn recover_inbox(path str) Fs -> AcpRecovered {
    mut items = []AcpInboxItem.new()
    mut acked = []int.new()
    mut next = 1
    for line in read_lines(Path.from_bytes(path.bytes())) {
        match Json.parse(line) {
            Err(e) => ()
            Ok(v) => {
                ro tag = field_text(v, "t") ?? ""
                if tag == "seq" {
                    ro n = field_int(v, "next") ?? 1
                    if n > next { next = n }
                } else if tag == "ack" {
                    ro seq = field_int(v, "seq") ?? 0
                    acked.push(seq)
                } else if tag == "event" {
                    match parse_event_line(v) {
                        Some(item) => {
                            items.push(item)
                            if item.seq + 1 > next { next = item.seq + 1 }
                        }
                        None => ()
                    }
                }
            }
        }
    }
    mut open = []AcpInboxItem.new()
    for item in items {
        if !acked.contains(item.seq) { open.push(item) }
    }
    recovered_of(open, next)
}

// Compact the inbox file: the next number and the unacknowledged events only.
fn compact_inbox(path str, recovered AcpRecovered) Fs -> () {
    mut lines = []str.new()
    lines.push(seq_line(recovered.next))
    for item in recovered.items { lines.push(event_line(item.seq, item.event)) }
    ro done = replace_file(Path.from_bytes(path.bytes()), "${lines.join("\n")}\n")
}

// The first 200 bytes of a line for a note.
// ORACLE-WORKAROUND(32): a function, not a pattern variable named `text` in the place of use: a variable bound by a pattern and named `text` is taken for the module `std.text` as soon as any module of the program imports it; inline it when item 32 is fixed
fn shortened(line str) -> str {
    if line.byte_len() > 200 { line[..200] } else { line }
}

fn tail_of(text str) -> str {
    ro n = text.byte_len()
    if n <= STDERR_KEEP { return text }
    ro at = n - STDERR_KEEP
    text[at..]
}

// ----- opening -----

/// Start the agent process and the handshake (`initialize` goes out at once; `session/new` follows when the agent answers,
/// on the next `poll`). With an inbox file, the events that were not acknowledged before come back first.
export fn open_client(config AcpConfig) Proc Detach Time -> Result[AcpClient, str] => open_client_traced(config, "", 0)

/// `open_client` that also writes every line of the exchange with the agent, both ways, to the file `trace_path` (see trace.nv; ""
/// - no record); the file is rotated at `trace_limit` bytes. The record begins with the `initialize` that goes out at the start.
export fn open_client_traced(config AcpConfig, trace_path str, trace_limit int) Proc Detach Time -> Result[AcpClient, str] =>
    open_client_asking(config, trace_path, trace_limit, no_ask())

/// `open_client_traced` that also offers the agent the means to ask the owner (see `AskSetup`).
export fn open_client_asking(config AcpConfig, trace_path str, trace_limit int, ask AskSetup) Proc Detach Time -> Result[AcpClient, str] =>
    open_client_full(config, trace_path, trace_limit, ask, []EnvEntry.new())

/// `open_client_traced` that also gives the agent process the environment variables `env` (task 192m: the variables of the project of the
/// session, over the environment of this process). The values go to the environment block of the process and nowhere else: not to the trace,
/// the inbox, the journal or a log.
export fn open_client_env(config AcpConfig, trace_path str, trace_limit int, env []EnvEntry) Proc Detach Time -> Result[AcpClient, str] =>
    open_client_full(config, trace_path, trace_limit, no_ask(), env)

/// The whole of it: the trace, the means to ask the owner and the environment of the process.
export fn open_client_full(config AcpConfig, trace_path str, trace_limit int, ask AskSetup, env []EnvEntry) Proc Detach Time -> Result[AcpClient, str] {
    match connect_env(config.program, config.args, config.cwd, env) {
        Err(reason) => Err(reason)
        Ok(link) => {
            mut ready = []AcpInboxItem.new()
            mut next = 1
            if config.inbox_path.byte_len() > 0 {
                with Fs = real_fs() {
                    ro recovered = recover_inbox(config.inbox_path)
                    compact_inbox(config.inbox_path, recovered)
                    ready = recovered.items
                    next = recovered.next
                }
            }
            mut client = AcpClient {
                config, link, phase: "initializing", next_rpc: 0, init_rpc: -1, new_rpc: -1, prompt_rpc: -1,
                session: "", agent: "", model_name: "", modes: JsonValue.null(), models: JsonValue.null(), choices_cfg: JsonValue.null(), mode_now: "", model_now: "", sets: []AcpSet.new(), queue: []AcpQueued.new(), active: "", permissions: []AcpPending.new(), ask, asks: []AcpAsk.new(), mcp_http: false, hint_due: false,
                ready, taken: []AcpInboxItem.new(), next_seq: next, stderr: "", exit_code: -2, last_error: "", trace: trace_open(trace_path, trace_limit),
                images_ok: false, attached: []AcpImage.new(), prelude: "", presets: []AcpPreset.new(), settled: []AcpPreset.new(), dropped: []AcpDrop.new(), marker: marker_start()
            }
            client.init_rpc = client.next_id()
            client.say(rpc_request_line(client.init_rpc, "initialize", initialize_params(ask.form)))
            Ok(client)
        }
    }
}

fn AcpClient mut @next_id() -> int {
    ro id = @next_rpc
    @next_rpc = id + 1
    id
}

// A line to the process; false - the process does not take it (closed).
fn AcpClient mut @say(line str) -> () {
    @trace.record("out", line)
    ro queued = @link.out.try_send(line)
}

// ----- events: the source key, the file, the queues -----

fn AcpClient mut @push(event Incoming) -> () {
    ro seq = @next_seq
    @next_seq = seq + 1
    ro stamped = Incoming.from_source(key_of(seq), event)
    if @config.inbox_path.byte_len() > 0 {
        with Fs = real_fs() {
            ro written = append_line(Path.from_bytes(@config.inbox_path.bytes()), event_line(seq, stamped))
            if !written { panic("the inbox cannot be written: ${@config.inbox_path}") }
        }
    }
    @ready.push(item_of(seq, stamped))
}

fn AcpClient mut @note(text str) -> () {
    @push(Incoming.signal("acp_note", text))
}

fn AcpClient mut @refuse(request str, code FailCode) -> () {
    @push(refused_event(request, code))
}

// ----- the end of the process, the failure of the handshake -----

fn AcpClient mut @refuse_everything(code FailCode) -> () {
    // the questions that wait for the owner end with the turn: the page is told, the process is not (it is gone or going)
    @resolve_asks(false)
    if @active.byte_len() > 0 {
        @refuse(@active, code)
        @active = ""
        @prompt_rpc = -1
    }
    ro waiting = @queue
    @queue = []AcpQueued.new()
    for q in waiting { @refuse(q.request, code) }
    @permissions = []AcpPending.new()
}

fn AcpClient mut @process_ended() -> () {
    if @phase == "dead" || @phase == "failed" || @phase == "closed" { return }
    @phase = "dead"
    @refuse_everything(FailCode.ConnectionLost)
}

fn AcpClient mut @fail_handshake(why str) -> () {
    @last_error = why
    @phase = "failed"
    @refuse_everything(FailCode.NoResult)
    @link.stop()
}

// ----- one line of the agent -----

fn AcpClient mut @on_result(id JsonValue, result JsonValue) -> () {
    ro key = rpc_key(id)
    if key == "${@init_rpc}" && @phase == "initializing" {
        // the agent takes pictures in a prompt only if it says so at `initialize` (promptCapabilities.image); otherwise they are not sent
        @images_ok = match field(result, "agentCapabilities") {
            Some(caps) => match field(caps, "promptCapabilities") {
                Some(prompt_caps) => match field(prompt_caps, "image") {
                    Some(flag) => flag.bool() ?? false
                    None => false
                }
                None => false
            }
            None => false
        }
        @agent = match field(result, "agentInfo") {
            Some(info) => field_text(info, "name") ?? ""
            None => ""
        }
        @mcp_http = match field(result, "agentCapabilities") {
            Some(caps) => match field(caps, "mcpCapabilities") {
                Some(mcp) => (field(mcp, "http") ?? JsonValue.null()).bool() ?? false
                None => false
            }
            None => false
        }
        mut servers = JsonValue.array([]JsonValue.new())
        if @ask.mcp_url.byte_len() > 0 {
            if @mcp_http {
                servers = mcp_servers_params(@ask.mcp_url, @ask.mcp_token)
                @hint_due = @ask.hint.byte_len() > 0
            } else {
                @note("the tool ask_user_question is not offered: the agent ${@agent} does not take an HTTP MCP server (mcpCapabilities.http)")
            }
        }
        @phase = "opening"
        @new_rpc = @next_id()
        @say(rpc_request_line(@new_rpc, "session/new", new_session_params(@config.cwd, servers)))
        return
    }
    if key == "${@new_rpc}" && @phase == "opening" {
        @model_name = match field(result, "configOptions") {
            Some(options) => model_name_of(options)
            None => ""
        }
        @modes = field(result, "modes") ?? JsonValue.null()
        @models = field(result, "models") ?? JsonValue.null()
        @choices_cfg = field(result, "configOptions") ?? JsonValue.null()
        @model_name = @options_model()
        match field_text(result, "sessionId") {
            Some(session) => {
                @session = session
                @phase = "ready"
                @apply_presets()
            }
            None => @fail_handshake("session/new answered without a sessionId")
        }
        return
    }
    if @prompt_rpc >= 0 && key == "${@prompt_rpc}" {
        ro reason = field_text(result, "stopReason") ?? ""
        ro request = @active
        @flush_answer(request)
        @active = ""
        @prompt_rpc = -1
        // the tokens of the turn go before its end (when the agent says them), so that they belong to the turn on the page
        match turn_usage_projection(result, reason) {
            Some(used) => @push(progress_event(request, used))
            None => ()
        }
        @push(stop_event(request, reason))
        return
    }
    if @settle_set(key, result) { return }
    @note("a response nobody waits for: id ${key}")
}

fn AcpClient mut @on_failure(id JsonValue, code int, message str) -> () {
    ro key = rpc_key(id)
    ro why = "${code} ${message}"
    if key == "${@init_rpc}" && @phase == "initializing" {
        @fail_handshake("initialize failed: ${why}")
        return
    }
    if key == "${@new_rpc}" && @phase == "opening" {
        @fail_handshake("session/new failed: ${why}")
        return
    }
    if @prompt_rpc >= 0 && key == "${@prompt_rpc}" {
        ro request = @active
        @flush_answer(request)
        @active = ""
        @prompt_rpc = -1
        @last_error = "session/prompt failed: ${why}"
        @refuse(request, FailCode.NoResult)
        return
    }
    if @fail_set(key, why) { return }
    @note("an error response nobody waits for: id ${key}: ${why}")
}

fn AcpClient mut @on_update(params JsonValue) -> () {
    ro session = field_text(params, "sessionId") ?? ""
    if @session.byte_len() > 0 && session != @session {
        @note("an update of another session: ${session}")
        return
    }
    ro update = match field(params, "update") {
        Some(u) => u
        None => JsonValue.null()
    }
    ro projected = project_update(update)
    if field_text(update, "sessionUpdate") == Some("current_mode_update") {
        @mode_now = field_text(update, "currentModeId") ?? ""
        @push_options()
        return
    }
    if projected.name == "agent_model" {
        // a full replacement of the options (an empty list is "the selector is gone")
        @choices_cfg = field(update, "configOptions") ?? JsonValue.null()
        @push_options()
        return
    }
    if projected.name == "agent_chunk" && @active.byte_len() > 0 {
        // task 192.9: the fallback marker `[[crew_task_list]] {json}` is cut out of the answer and given as an event of its own
        @push_answer_part(@active, marker_feed(@marker, projected.input, false))
        return
    }
    @push(progress_event(@active, projected))
}

// The shown part of an answer and the markers cut out of it (task 192.9).
fn AcpClient mut @push_answer_part(request str, step MarkerStep) -> () {
    @marker = step.state
    if step.out.byte_len() > 0 { @push(progress_event(request, Projection { name: "agent_chunk", input: step.out })) }
    for line in step.found {
        mut o = JsonObject.new()
        put(o, "text", JsonValue.str(line))
        @push(progress_event(request, Projection { name: "crew_marker", input: JsonValue.object(o).to_str() }))
    }
}

// The end of a turn: what was held back is shown (a marker that is not closed is dropped).
fn AcpClient mut @flush_answer(request str) -> () {
    if request.byte_len() > 0 { @push_answer_part(request, marker_feed(@marker, "", true)) }
    @marker = marker_start()
}

// The summary of the choices now (task 192): model, effort, mode.
fn AcpClient @options_json() -> str => options_summary(@modes, @models, @choices_cfg, @mode_now, @model_now)

fn AcpClient @options_model() -> str {
    match Json.parse(@options_json()) {
        Ok(value) => field_text(value, "model") ?? ""
        Err(e) => ""
    }
}

fn AcpClient mut @push_options() -> () {
    @model_name = @options_model()
    @push(progress_event(@active, model_projection(@options_json())))
}

// The answer of the agent to a choice of the owner: `session/set_config_option` brings the whole set of options, the older
// `session/set_mode` and `session/set_model` bring nothing and the choice is kept here. True - the answer was of that kind.
fn AcpClient mut @settle_set(key str, result JsonValue) -> bool {
    mut found = -1
    mut index = 0
    for s in @sets {
        if "${s.rpc}" == key { found = index }
        index += 1
    }
    if found < 0 { return false }
    ro done = @sets[found]
    mut rest = []AcpSet.new()
    for s in @sets {
        if s.rpc != done.rpc { rest.push(s) }
    }
    @sets = rest
    match field(result, "configOptions") {
        Some(options) => { @choices_cfg = options }
        None => {
            if done.setting == "mode" { @mode_now = done.value }
            if done.setting == "model" { @model_now = done.value }
        }
    }
    // a choice of the owner that the agent took is told to the hub, which keeps it (the ones the client made itself are not)
    if done.owner { @settled.push(AcpPreset { setting: done.setting, value: done.value }) }
    @push_options()
    true
}

fn AcpClient mut @fail_set(key str, why str) -> bool {
    mut found = false
    mut rest = []AcpSet.new()
    for s in @sets {
        if "${s.rpc}" == key { found = true } else { rest.push(s) }
    }
    if !found { return false }
    @sets = rest
    @note("the agent refused a choice: ${why}")
    true
}

/// The owner chose `value` for `setting` (`mode`, `model` or `effort`): the agent is asked, by the method it supports. False - the
/// agent has not offered that value (or the session is not ready): nothing is sent. The new choice arrives as an event `agent_model`.
export fn AcpClient mut @select_option(setting str, value str) -> bool => @send_set(setting, value, true)

// The request for a choice; `owner` - it is a choice the owner made just now (the hub keeps it), not one asked again after a start.
fn AcpClient mut @send_set(setting str, value str, owner bool) -> bool {
    if @phase != "ready" { return false }
    match setting_call(setting, value, @modes, @models, @choices_cfg) {
        None => false
        Some(call) => {
            ro id = @next_id()
            @sets.push(AcpSet { rpc: id, setting, value, owner })
            mut o = JsonObject.new()
            put(o, "sessionId", JsonValue.str(@session))
            if call.method == "session/set_config_option" {
                put(o, "configId", JsonValue.str(call.config_id))
                put(o, "value", JsonValue.str(value))
            } else if call.method == "session/set_mode" {
                put(o, "modeId", JsonValue.str(value))
            } else {
                put(o, "modelId", JsonValue.str(value))
            }
            @say(rpc_request_line(id, call.method, JsonValue.object(o)))
            true
        }
    }
}

// The id that is chosen now for `setting`, in the summary of the agent ("" - none).
fn AcpClient @current_of(setting str) -> str {
    match Json.parse(@options_json()) {
        Ok(value) => field_text(value, if setting == "model" { "model_id" } else { setting }) ?? ""
        Err(e) => ""
    }
}

// The choices of the owner kept for this session come back to the new agent: each one that differs from what the agent holds is asked for,
// one the agent does not offer is dropped (the hub tells the owner).
fn AcpClient mut @apply_presets() -> () {
    ro list = @presets
    @presets = []AcpPreset.new()
    for p in list {
        if @current_of(p.setting) == p.value { continue }
        if !@send_set(p.setting, p.value, false) {
            @dropped.push(AcpDrop { setting: p.setting, value: p.value, used: @current_of(p.setting) })
        }
    }
}

/// The choices of the owner for the agent that is just started (before `session/new` is answered); see `AcpPreset`.
export fn AcpClient mut @set_presets(list []AcpPreset) -> () {
    @presets = list
}

/// How many requests for a choice wait for the agent's answer.
export fn AcpClient @sets_pending() -> int => @sets.len()

/// The choices of the owner that the agent took since the last call (the hub writes them to the journal).
export fn AcpClient mut @take_settled() -> []AcpPreset {
    ro out = @settled
    @settled = []AcpPreset.new()
    out
}

/// The presets the agent does not offer, since the last call.
export fn AcpClient mut @take_dropped() -> []AcpDrop {
    ro out = @dropped
    @dropped = []AcpDrop.new()
    out
}

/// The choices now as the JSON object of the page event `session_model` (see `options_summary`).
export fn AcpClient @options() -> str => @options_json()

fn AcpClient mut @on_permission(id JsonValue, params JsonValue) -> () {
    if @active.byte_len() == 0 {
        // nobody is asked: no request is open, there is no owner to ask - the answer is "cancelled"
        @say(rpc_result_line(id, outcome_result("cancelled", "")))
        @note("a permission request while no turn is open: answered cancelled")
        return
    }
    mut options = []AcpOption.new()
    match field(params, "options") {
        Some(list) => match list.array() {
            Some(items) => {
                for item in items {
                    options.push(AcpOption { id: field_text(item, "optionId") ?? "", kind: field_text(item, "kind") ?? "" })
                }
            }
            None => ()
        }
        None => ()
    }
    // task 192.9: a call of the tool of the hub itself (Kimi Code asks leave for every MCP tool) is allowed once, the owner is not asked
    if @ask.mcp_url.byte_len() > 0 {
        ro call_title = match field(params, "toolCall") {
            Some(c) => field_text(c, "title") ?? ""
            None => ""
        }
        if is_crew_tool_title(call_title) {
            for o in options {
                if o.kind == "allow_once" {
                    @say(rpc_result_line(id, outcome_result("selected", o.id)))
                    return
                }
            }
        }
    }
    ro projection = project_permission(id, params)
    @permissions.push(AcpPending { key: rpc_key(id), id, options })
    @push(progress_event(@active, projection))
}

// A question of the agent (task 192i): `elicitation/create` in the mode `form`, when we said at `initialize` that we show one. It becomes the
// event `question_request`; the agent waits for the owner. What is not a set of questions (a url, a form of another kind) is declined.
fn AcpClient mut @on_elicitation(id JsonValue, params JsonValue) -> () {
    if !@ask.form {
        @say(rpc_error_line(id, -32601, "method not supported: elicitation/create"))
        @note("a request that is not supported: elicitation/create")
        return
    }
    if @active.byte_len() == 0 {
        @say(rpc_result_line(id, question_cancel_response()))
        @note("a question of the agent while no turn is open: answered cancelled")
        return
    }
    match project_question(id, params) {
        None => {
            @say(rpc_result_line(id, question_decline_response()))
            @note("an elicitation that is not a set of questions: declined")
        }
        Some(projection) => {
            @asks.push(AcpAsk { key: rpc_key(id), id, params })
            @push(progress_event(@active, projection))
        }
    }
}

// The questions that wait for the owner are over (the turn is cancelled, the agent withdrew them, the process is gone): the page is told
// `question_resolved` for each; `reply` - the agent is answered "cancel" (it is alive and waits).
fn AcpClient mut @resolve_asks(reply bool) -> () {
    ro open = @asks
    @asks = []AcpAsk.new()
    for a in open {
        if reply { @say(rpc_result_line(a.id, question_cancel_response())) }
        mut o = JsonObject.new()
        put(o, "request", JsonValue.str(a.key))
        @push(progress_event(@active, Projection { name: "question_resolved", input: JsonValue.object(o).to_str() }))
    }
}

fn AcpClient mut @on_call(id JsonValue, method str, params JsonValue) -> () {
    if method == "session/request_permission" {
        @on_permission(id, params)
        return
    }
    if method == "elicitation/create" {
        @on_elicitation(id, params)
        return
    }
    @say(rpc_error_line(id, -32601, "method not supported: ${method}"))
    @note("a request that is not supported: ${method}")
}

// The agent withdrew a request of its own (`$/cancel_request`); of those we know, only a question can be open.
fn AcpClient mut @on_withdrawn(params JsonValue) -> () {
    ro key = match field(params, "requestId") {
        Some(v) => rpc_key(v)
        None => ""
    }
    mut found = -1
    mut index = 0
    for a in @asks {
        if a.key == key { found = index }
        index += 1
    }
    if found < 0 { return }
    ro gone = @asks[found]
    mut rest = []AcpAsk.new()
    for a in @asks {
        if a.key != key { rest.push(a) }
    }
    @asks = rest
    @say(rpc_result_line(gone.id, question_cancel_response()))
    mut o = JsonObject.new()
    put(o, "request", JsonValue.str(gone.key))
    @push(progress_event(@active, Projection { name: "question_resolved", input: JsonValue.object(o).to_str() }))
}

fn AcpClient mut @on_line(text str) -> () {
    match parse_rpc(text) {
        RpcResult { id, result } => @on_result(id, result)
        RpcFailure { id, code, message } => @on_failure(id, code, message)
        RpcNote { method, params } => {
            if method == "session/update" {
                @on_update(params)
            } else if method == "$/cancel_request" {
                @on_withdrawn(params)
            } else {
                @note("a notification that is not used: ${method}")
            }
        }
        RpcCall { id, method, params } => @on_call(id, method, params)
        RpcGarbage { text } => @note("a line that is not JSON-RPC: ${shortened(text)}")
    }
}

fn AcpClient mut @take(item Inbound) -> () {
    if item.kind == "line" {
        @trace.record("in", item.text)
        @on_line(item.text)
    } else if item.kind == "stderr" {
        @stderr = tail_of("${@stderr}${item.text}\n")
    } else if item.kind == "exit" {
        @exit_code = item.code
    } else if item.kind == "eof" {
        @process_ended()
    }
}

// Send the next waiting prompt when the session is open and no turn is in flight.
fn AcpClient mut @drive() -> () {
    if @phase != "ready" || @prompt_rpc >= 0 || @queue.len() == 0 { return }
    ro next = @queue.remove(0)
    @active = next.request
    @prompt_rpc = @next_id()
    // the note about the tool of questions goes before the first prompt only
    // the hidden note of the hub (the mode of work, task 192q) goes first; it is in neither the feed nor the journal
    mut text = if @hint_due { "${@ask.hint}\n\n${next.text}" } else { next.text }
    @hint_due = false
    if next.pre.byte_len() > 0 { text = "${next.pre}\n\n${text}" }
    mut pictures = []JsonValue.new()
    if next.images.len() > 0 {
        if @images_ok {
            mut unreadable = 0
            for image in next.images {
                match with Fs = real_fs() { read_picture(image.path) } {
                    Some(data) => pictures.push(image_block(image.mime, data))
                    None => { unreadable += 1 }
                }
            }
            if unreadable > 0 { text = "${text}\n[изображений не удалось прочитать: ${unreadable}]" }
        } else {
            // not sent: the text goes with a note, the owner is told in the feed (the event `images_skipped`)
            text = "${text}\n[приложено изображений: ${next.images.len()}, агент их не принимает]"
            @push(Incoming.signal("images_skipped", skipped_text(@agent, next.images.len())))
        }
    }
    @say(rpc_request_line(@prompt_rpc, "session/prompt", prompt_params(@session, text, pictures)))
}

/// A hidden note for the NEXT request that is sent to the agent (task 192q): it is put before its text in the prompt and is forgotten after.
export fn AcpClient mut @set_prelude(text str) -> () {
    @prelude = text
}

// The base64 of a picture file, None when it cannot be read.
fn read_picture(path str) Fs -> Option[str] {
    match read(Path.from_bytes(path.bytes())) {
        Ok(bytes) => Some(encode_image(bytes))
        Err(e) => None
    }
}

fn skipped_text(agent str, count int) -> str {
    mut o = JsonObject.new()
    put(o, "agent", JsonValue.str(agent))
    put(o, "count", JsonValue.int(count))
    JsonValue.object(o).to_str()
}

/// The pictures of the NEXT message: the prompt that is queued next takes them. Called by the hub right before it feeds the message.
export fn AcpClient mut @attach_images(images []AcpImage) -> () {
    @attached = images
}

/// Does the agent take pictures in a prompt (its `initialize` said `promptCapabilities.image`)? False before the handshake is over.
export fn AcpClient @accepts_images() -> bool => @images_ok

/// Take what the fibers around the process have brought: the handshake moves on, lines become events, the next
/// waiting prompt goes out. Never waits.
export fn AcpClient mut @poll() -> () {
    if @phase == "closed" { return }
    mut more = true
    while more && @phase != "closed" {
        match @link.inb.try_recv() {
            Some(item) => @take(item)
            None => { more = false }
        }
    }
    @drive()
}

// ----- the handler of the effect Link -----

fn AcpClient mut @enqueue(request PartyRequest[str]) -> () {
    if @phase == "dead" || @phase == "closed" {
        @refuse(request.id, FailCode.ConnectionLost)
        return
    }
    if @phase == "failed" {
        @refuse(request.id, FailCode.NoResult)
        return
    }
    @queue.push(AcpQueued { request: request.id, text: request.input, images: @attached, pre: @prelude })
    @attached = []AcpImage.new()
    @prelude = ""
    @poll()
}

fn AcpClient mut @cancel_request(request_id str) -> () {
    mut rest = []AcpQueued.new()
    mut removed = false
    for q in @queue {
        if q.request == request_id { removed = true } else { rest.push(q) }
    }
    @queue = rest
    if removed { return }
    if @active != request_id || @phase == "dead" || @phase == "closed" || @phase == "failed" { return }
    @say(rpc_notification_line("session/cancel", session_params(@session)))
    // the protocol: every request for permission that is still open of a cancelled turn is answered "cancelled"
    ro open = @permissions
    @permissions = []AcpPending.new()
    for p in open { @say(rpc_result_line(p.id, outcome_result("cancelled", ""))) }
    @resolve_asks(true)
}

fn AcpClient mut @next_event() -> Option[Incoming] {
    @poll()
    if @ready.len() == 0 { return None }
    ro item = @ready.remove(0)
    @taken.push(item)
    Some(item.event)
}

fn AcpClient mut @acknowledge(source str) -> () {
    mut found = -1
    mut kept_taken = []AcpInboxItem.new()
    for item in @taken {
        if item.event.id == source { found = item.seq } else { kept_taken.push(item) }
    }
    @taken = kept_taken
    mut kept_ready = []AcpInboxItem.new()
    for item in @ready {
        if item.event.id == source { found = item.seq } else { kept_ready.push(item) }
    }
    @ready = kept_ready
    if found < 0 || @config.inbox_path.byte_len() == 0 { return }
    with Fs = real_fs() {
        ro written = append_line(Path.from_bytes(@config.inbox_path.bytes()), ack_line(found))
        if !written { panic("the inbox cannot be written: ${@config.inbox_path}") }
    }
}

/// The handler of `Link` over a client. `send` queues the request (one turn at a time, in the order of sending),
/// `receive` takes what has come and hands out one event or None, `cancel` cancels a waiting or a running turn,
/// `ack` forgets an event the engine has committed.
export fn acp_link(mut client AcpClient) -> Effect[Link] {
    effect Link {
        send(request) -> () {
            client.enqueue(request)
        }
        receive() -> Option[Incoming] => client.next_event()
        cancel(request_id) -> () {
            client.cancel_request(request_id)
        }
        ack(source) -> () {
            client.acknowledge(source)
        }
    }
}

// ----- the owner's decision -----

fn option_for(options []AcpOption, wanted []str) -> Option[str] {
    for kind in wanted {
        for o in options {
            if o.kind == kind { return Some(o.id) }
        }
    }
    None
}

/// The decision of the owner about a request for permission, by the key of the request (`request` of the permission event).
/// `decision` is "allow", "deny" or the id of one of the options; true - the agent was answered. A key nobody asked, a
/// request already answered, a decision no option fits: false, nothing is sent and the request stays open.
export fn AcpClient mut @decide(key str, decision str) -> bool {
    mut found = -1
    mut index = 0
    for p in @permissions {
        if p.key == key { found = index }
        index += 1
    }
    if found < 0 { return false }
    ro pending = @permissions[found]
    mut chosen Option[str] = None
    if decision == "allow" {
        chosen = option_for(pending.options, ["allow_once", "allow_always"])
    } else if decision == "deny" {
        chosen = option_for(pending.options, ["reject_once", "reject_always"])
    } else {
        for o in pending.options {
            if o.id == decision { chosen = Some(o.id) }
        }
    }
    match chosen {
        None => false
        Some(option) => {
            mut rest = []AcpPending.new()
            for p in @permissions {
                if p.key != key { rest.push(p) }
            }
            @permissions = rest
            @say(rpc_result_line(pending.id, outcome_result("selected", option)))
            true
        }
    }
}

/// The same from an engine event named `permission_decision` whose input is `{"request": key, "decision": ...}`;
/// any other event is not a decision (false).
export fn AcpClient mut @decide_event(event Incoming) -> bool {
    if event.name != "permission_decision" { return false }
    ro value = match Json.parse(event.input) {
        Ok(v) => v
        Err(e) => return false
    }
    ro key = field_text(value, "request") ?? ""
    ro decision = field_text(value, "decision") ?? ""
    if key.byte_len() == 0 || decision.byte_len() == 0 { return false }
    @decide(key, decision)
}

// ----- the owner's answer to a question -----

/// The answer of the owner to a question of the agent, by the key of the request (`request` of the event `question_request`):
/// `answer` is `{request, skipped, answers:[{index, selected:[label], other}]}`. True - the agent was answered (a skip is `decline`); a key
/// nobody asked, a request already answered: false, nothing is sent.
export fn AcpClient mut @answer(key str, answer JsonValue) -> bool {
    mut found = -1
    mut index = 0
    for a in @asks {
        if a.key == key { found = index }
        index += 1
    }
    if found < 0 { return false }
    ro pending = @asks[found]
    mut rest = []AcpAsk.new()
    for a in @asks {
        if a.key != key { rest.push(a) }
    }
    @asks = rest
    @say(rpc_result_line(pending.id, question_response(pending.params, answer)))
    true
}

/// The same from an engine event named `question_answer` whose input is the answer of the page; any other event is not one (false).
export fn AcpClient mut @answer_event(event Incoming) -> bool {
    if event.name != "question_answer" { return false }
    ro value = match Json.parse(event.input) {
        Ok(v) => v
        Err(e) => return false
    }
    ro key = field_text(value, "request") ?? ""
    if key.byte_len() == 0 { return false }
    @answer(key, value)
}

/// The owner cancelled the turn: the questions that wait for him are withdrawn - the agent is answered "cancel" - and their keys are given back, so
/// that the caller can tell the page (the engine does not show an event of a request it has already closed).
export fn AcpClient mut @withdraw_questions() -> []str {
    ro open = @asks
    @asks = []AcpAsk.new()
    mut keys = []str.new()
    for a in open {
        @say(rpc_result_line(a.id, question_cancel_response()))
        keys.push(a.key)
    }
    keys
}

/// The keys of the questions that wait for the owner.
export fn AcpClient @pending_questions() -> []str {
    mut keys = []str.new()
    for a in @asks { keys.push(a.key) }
    keys
}

/// Does the agent take an HTTP MCP server (from its answer to `initialize`)?
export fn AcpClient @takes_mcp_http() -> bool => @mcp_http

// ----- closing and looking -----

/// Close the client: the process tree is killed and the fibers around it are waited for (two seconds at most); nothing comes
/// out of a closed client any more.
export fn AcpClient mut @close() Time -> () {
    if @phase == "closed" { return }
    @phase = "closed"
    @link.stop()
    // Wait (for two seconds at most) until the fibers around the process are over: the process is gone ("exit" - the last thing the
    // watcher tells) and its stdout is closed ("eof"). A caller that goes on, or a program that ends, while they are still
    // finishing meets the exit-time hangs (see README, "Oracle 0.1.0").
    // ORACLE-WORKAROUND(19): `close` waits (two seconds at most) for the end of the process and of its stdout before it returns: a binary whose fibers are still finishing does not exit and a pipe write now and then does not come back; do not wait when item 19 is fixed
    mut seen_exit = false
    mut seen_eof = false
    mut spins = 0
    while !(seen_exit && seen_eof) && spins < 200 {
        match @link.inb.try_recv() {
            Some(item) => {
                if item.kind == "exit" {
                    seen_exit = true
                    @exit_code = item.code
                } else if item.kind == "eof" {
                    seen_eof = true
                }
            }
            None => {
                10.to_millis().sleep()
                spins += 1
            }
        }
    }
}

/// The phase: initializing, opening, ready, dead, failed or closed.
export fn AcpClient @phase() -> str => @phase

/// The id of the session of the agent ("" until `session/new` is answered).
export fn AcpClient @session_id() -> str => @session

/// The name of the agent from its answer to `initialize`.
export fn AcpClient @agent_name() -> str => @agent

/// The explicitly reported current model name from ACP configOptions; empty means not reported.
export fn AcpClient @model_name() -> str => @model_name

/// The last part of what the agent wrote to its stderr.
export fn AcpClient @stderr_tail() -> str => @stderr

/// The reason of the last failure ("" - none): a refused handshake, an error answer to a prompt.
export fn AcpClient @last_error() -> str => @last_error

/// The number of events that were not acknowledged: handed out or waiting to be.
export fn AcpClient @unacked() -> int => @taken.len() + @ready.len()

/// The source keys of those events: handed out first, then waiting.
export fn AcpClient @unacked_keys() -> []str {
    mut keys = []str.new()
    for item in @taken { keys.push(item.event.id) }
    for item in @ready { keys.push(item.event.id) }
    keys
}

/// The keys of the requests for permission that wait for the owner.
export fn AcpClient @pending_permissions() -> []str {
    mut keys = []str.new()
    for p in @permissions { keys.push(p.key) }
    keys
}
