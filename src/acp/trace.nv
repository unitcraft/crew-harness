// trace.nv - the raw record of the exchange with the agent (task 192c).
//
// Every line of the JSON-RPC exchange goes to a file `<data_dir>/<session>/acp.jsonl`, one record per line:
//   {"t": <unix milliseconds>, "dir": "out"|"in", "line": "<the line of the exchange as it is, a string>"}
// `out` is what the client writes to the stdin of the agent, `in` is what it reads from the stdout of the agent. Nothing is cut
// out: the file holds the whole talk and the output of the tools (the README of the server says so), except the bytes of a picture: a block
// `{"type":"image",...,"data":"<base64>"}` is written with `"data":"<image N bytes>"` (task 192, the pictures are kept as files, see
// storage/images.nv; a trace that held them would grow by megabytes per message). The file is only appended
// to; at more than the limit (50 MB) the file becomes `acp.1.jsonl` beside it (an older one is replaced) and a new file is begun.
// A failed write never stops the session: one line to the log of the hub (the stderr) and the trace of this session is off.
module crew_harness.acp

import std.encoding.json.{JsonValue, JsonObject}
import std.fs.{Fs, real_fs, File, Path, rename, metadata, remove_file, read}
import std.io.{write_all, stderr}

/// The limit of one trace file: 50 MB.
export const TRACE_LIMIT = 52428800

/// AcpTrace: the state of the record of one session. `on` false - nothing is written.
export type AcpTrace { path str, size int, limit int, on bool, lines int }

/// No trace.
export fn trace_off() -> AcpTrace => { path: "", size: 0, limit: 0, on: false, lines: 0 }

fn trace_size(path Path) Fs -> int {
    match metadata(path) {
        Ok(meta) => meta.len()
        Err(e) => 0
    }
}

/// The record into `path`, rotating at `limit` bytes; the size of a file that is already there is taken into account.
export fn trace_open(path str, limit int) -> AcpTrace {
    if path.byte_len() == 0 { return trace_off() }
    ro size = with Fs = real_fs() { trace_size(Path.from_bytes(path.bytes())) }
    ro lines = if size > 0 { with Fs = real_fs() { trace_count_lines(Path.from_bytes(path.bytes())) } } else { 0 }
    { path, size, limit, on: true, lines }
}

// The number of the lines already in the file (task 192.11: the view of the request names the lines of a turn in `acp.jsonl`); 0 when it cannot be read.
fn trace_count_lines(path Path) Fs -> int {
    match read(path) {
        Ok(bytes) => {
            mut n = 0
            for b in bytes { if b == (10 as u8) { n += 1 } }
            n
        }
        Err(e) => 0
    }
}

/// How many lines the file of the session holds now (the next line to be written is this number + 1).
export fn AcpTrace @line_count() -> int => @lines

/// The name of the rotated file: `<session>/acp.jsonl` -> `<session>/acp.1.jsonl`.
export fn trace_rotated_name(path str) -> str {
    ro suffix = ".jsonl"
    if path.byte_len() > suffix.byte_len() && path[(path.byte_len() - suffix.byte_len())..] == suffix {
        "${path[..(path.byte_len() - suffix.byte_len())]}.1${suffix}"
    } else {
        "${path}.1"
    }
}

/// The number of bytes a base64 text stands for (the padding `=` at the end is not counted).
export fn trace_image_bytes(data str) -> int {
    ro n = data.byte_len()
    mut pad = 0
    if n > 0 && data[n - 1..] == "=" { pad += 1 }
    if n > 1 && data[n - 2..n - 1] == "=" { pad += 1 }
    n / 4 * 3 - pad
}

/// A line of the exchange with the bytes of every picture replaced: `"data":"<base64>"` -> `"data":"<image N bytes>"`. A line without a picture block
/// (the usual one) is returned as it is, without being looked into.
export fn trace_redact_images(line str) -> str {
    if !line.contains("\"type\":\"image\"") { return line }
    ro key = "\"data\":\""
    consume sb = StringBuilder.new()
    mut rest = line
    mut more = true
    while more {
        match rest.find(key) {
            None => {
                sb.append(rest)
                more = false
            }
            Some(at) => {
                sb.append(rest[..at + key.byte_len()])
                ro after = rest[at + key.byte_len()..]
                match after.find("\"") {
                    None => {
                        sb.append(after)
                        more = false
                    }
                    Some(end) => {
                        sb.append("<image ${trace_image_bytes(after[..end])} bytes>")
                        rest = after[end..]
                    }
                }
            }
        }
    }
    sb.into_str()
}

fn trace_record(at int, dir str, line str) -> str {
    mut o = JsonObject.new()
    ro a = o.insert("t", JsonValue.int(at))
    ro b = o.insert("dir", JsonValue.str(dir))
    ro c = o.insert("line", JsonValue.str(line))
    JsonValue.object(o).to_str()
}

fn trace_warn(text str) -> () {
    mut err = stderr()
    ro written = err.write("crew-hub: ${text}\n".bytes())
}

fn trace_rotate(path str) Fs -> () {
    ro now = Path.from_bytes(path.bytes())
    ro old = Path.from_bytes(trace_rotated_name(path).bytes())
    ro removed = remove_file(old)
    match rename(now, old) {
        Ok(done) => ()
        Err(e) => ()
    }
}

fn trace_append(path str, text str) Fs -> bool {
    match File.append(Path.from_bytes(path.bytes())) {
        Err(e) => false
        Ok(consume f) => {
            mut ok = false
            match write_all(f, text.bytes()) {
                Ok(done) => { ok = true }
                Err(e) => ()
            }
            match f.close() {
                Ok(done) => ()
                Err(e) => { ok = false }
            }
            ok
        }
    }
}

/// Write one record. `dir` is "out" or "in". A failure switches the trace of this session off (one line to the log).
export fn AcpTrace mut @record(dir str, line str) Time -> () {
    if !@on { return }
    ro at = Time.now().unix_millis()
    ro text = "${trace_record(at, dir, trace_redact_images(line))}\n"
    ro n = text.byte_len()
    with Fs = real_fs() {
        if @size > 0 && @size + n > @limit {
            trace_rotate(@path)
            @size = 0
            @lines = 0
        }
        if trace_append(@path, text) {
            @size = @size + n
            @lines = @lines + 1
        } else {
            @on = false
            trace_warn("the ACP trace cannot be written (${@path}), it is off for this session")
        }
    }
}
