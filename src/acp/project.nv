// project.nv - the projection "ACP -> engine event -> page event": pure functions, the table is in README.md.
//
// ACP -> engine. `project_update` turns the `update` of a `session/update` into a name and an input of an engine event;
// `progress_event` puts it into an `Incoming` (kind Progress, bound to the request in flight). What the table does not
// know is NOT dropped: it becomes the event `acp_skipped` (the engine journals every event), without an error.
// The ends of a turn are `stop_event` (the stop reason of `session/prompt`) and `refused_event` (a failure with a code).
//
// Engine -> page. `page_event` turns a stamped `Incoming` into the JSON line of the page (task 093, "the format of the
// event": `{ id, trace, step, kind, input, time }`, `input` an object): `name` becomes `kind`, `at` becomes `time`, the
// `input` text becomes an object. An event the page has no kind for gives None. The `turn` code of the turn is given by
// the caller: the page names a turn by the code of its `user_message`.
module crew_harness.acp

import alula.engine.{Incoming, EventKind, FailCode}
import std.encoding.json.{Json, JsonValue, JsonObject}

/// Projection: the name and the input of the engine event that an update of ACP becomes.
export type Projection { name str, input str }

fn get_of(v JsonValue, key str) -> Option[JsonValue] {
    ro o = v.object()?
    o.get(key)
}

fn text_field(v JsonValue, key str) -> Option[str] {
    ro field = get_of(v, key)?
    field.str()
}

fn int_field(v JsonValue, key str) -> Option[int] {
    ro field = get_of(v, key)?
    field.int()
}

fn proj(name str, input str) -> Projection => { name, input }

fn skipped(what str) -> Projection => proj("acp_skipped", what)

/// The key of a JSON-RPC id as text: a number as it is, a string without quotes.
export fn rpc_key(id JsonValue) -> str {
    match id.str() {
        Some(s) => s
        None => id.to_str()
    }
}

/// The kinds of tools the page knows; the rest (including `switch_mode`) is `other`.
export fn tool_kind(acp_kind str) -> str {
    if acp_kind == "read" || acp_kind == "edit" || acp_kind == "delete" || acp_kind == "move" || acp_kind == "search" {
        return acp_kind
    }
    if acp_kind == "execute" || acp_kind == "think" || acp_kind == "fetch" { return acp_kind }
    "other"
}

fn known_status(status str) -> bool => status == "pending" || status == "in_progress" || status == "completed" || status == "failed"

// The text of the content of a tool call: the texts of the content blocks, a line for a diff and for a terminal, one per line.
fn detail_of(content JsonValue) -> str {
    ro items = match content.array() {
        Some(list) => list
        None => return ""
    }
    mut parts = []str.new()
    for item in items {
        ro kind = text_field(item, "type") ?? ""
        if kind == "content" {
            match get_of(item, "content") {
                Some(block) => match text_field(block, "text") {
                    Some(text) => parts.push(text)
                    None => ()
                }
                None => ()
            }
        } else if kind == "diff" {
            parts.push("diff: ${text_field(item, "path") ?? "?"}")
        } else if kind == "terminal" {
            parts.push("terminal: ${text_field(item, "terminalId") ?? "?"}")
        }
    }
    parts.join("\n")
}

fn chunk_projection(update JsonValue, name str, label str) -> Projection {
    match get_of(update, "content") {
        None => skipped("${label}: no content")
        Some(block) => {
            ro kind = text_field(block, "type") ?? "?"
            match text_field(block, "text") {
                Some(text) => if kind == "text" { proj(name, text) } else { skipped("${label}: ${kind}") }
                None => skipped("${label}: ${kind}")
            }
        }
    }
}

fn tool_call_projection(update JsonValue) -> Projection {
    ro id = match text_field(update, "toolCallId") {
        Some(x) => x
        None => return skipped("tool_call: no toolCallId")
    }
    mut o = JsonObject.new()
    put(o, "id", JsonValue.str(id))
    put(o, "title", JsonValue.str(text_field(update, "title") ?? ""))
    put(o, "kind", JsonValue.str(tool_kind(text_field(update, "kind") ?? "other")))
    ro status = text_field(update, "status") ?? "pending"
    put(o, "status", JsonValue.str(if known_status(status) { status } else { "pending" }))
    match get_of(update, "content") {
        Some(content) => {
            ro detail = detail_of(content)
            if detail.byte_len() > 0 { put(o, "detail", JsonValue.str(detail)) }
        }
        None => ()
    }
    proj("tool_call", JsonValue.object(o).to_str())
}

fn tool_call_update_projection(update JsonValue) -> Projection {
    ro id = match text_field(update, "toolCallId") {
        Some(x) => x
        None => return skipped("tool_call_update: no toolCallId")
    }
    mut o = JsonObject.new()
    put(o, "id", JsonValue.str(id))
    match text_field(update, "status") {
        Some(status) => if known_status(status) { put(o, "status", JsonValue.str(status)) }
        None => ()
    }
    match get_of(update, "content") {
        Some(content) => {
            ro detail = detail_of(content)
            if detail.byte_len() > 0 { put(o, "detail", JsonValue.str(detail)) }
        }
        None => ()
    }
    proj("tool_call_update", JsonValue.object(o).to_str())
}

fn usage_projection(update JsonValue) -> Projection {
    ro used = match int_field(update, "used") {
        Some(x) => x
        None => return skipped("usage_update: no used")
    }
    ro size = match int_field(update, "size") {
        Some(x) => x
        None => return skipped("usage_update: no size")
    }
    mut o = JsonObject.new()
    put(o, "used", JsonValue.int(used))
    put(o, "size", JsonValue.int(size))
    match get_of(update, "cost") {
        Some(cost) => if !cost.is_null() { put(o, "cost", cost) }
        None => ()
    }
    proj("usage_update", JsonValue.object(o).to_str())
}

fn first_int(v JsonValue, keys []str) -> int {
    for key in keys {
        match int_field(v, key) {
            Some(n) => { if n >= 0 { return n } }
            None => ()
        }
    }
    -1
}

/// The tokens a turn used (task 192), from the `usage` of the answer of `session/prompt`: the event `turn_usage` with `{new, cached, output, total, reason}`
/// (`new` - the input that was not read from the cache, `cached` - read from the cache, `output`, `total` as the agent counts it; a number the agent
/// did not give is absent, and `reason` is the stop reason). No `usage`, or none of the four numbers in it: None - nothing is shown, nothing made up.
export fn turn_usage_projection(result JsonValue, reason str) -> Option[Projection] {
    ro usage = get_of(result, "usage")?
    if !usage.is_object() { return None }
    ro fresh = first_int(usage, ["inputTokens", "input_tokens"])
    ro cached = first_int(usage, ["cachedReadTokens", "cached_read_tokens", "cachedInputTokens"])
    ro output = first_int(usage, ["outputTokens", "output_tokens"])
    ro total = first_int(usage, ["totalTokens", "total_tokens"])
    if fresh < 0 && cached < 0 && output < 0 && total < 0 { return None }
    mut o = JsonObject.new()
    if fresh >= 0 { put(o, "new", JsonValue.int(fresh)) }
    if cached >= 0 { put(o, "cached", JsonValue.int(cached)) }
    if output >= 0 { put(o, "output", JsonValue.int(output)) }
    if total >= 0 { put(o, "total", JsonValue.int(total)) }
    put(o, "reason", JsonValue.str(reason))
    Some(proj("turn_usage", JsonValue.object(o).to_str()))
}

/// The `update` of a `session/update` as the name and the input of an engine event. What is not in the table is
/// `acp_skipped` with the name of the update as input.
export fn project_update(update JsonValue) -> Projection {
    ro kind = match text_field(update, "sessionUpdate") {
        Some(k) => k
        None => return skipped("no sessionUpdate")
    }
    if kind == "agent_message_chunk" { return chunk_projection(update, "agent_chunk", kind) }
    if kind == "agent_thought_chunk" { return chunk_projection(update, "agent_thought", kind) }
    if kind == "tool_call" { return tool_call_projection(update) }
    if kind == "tool_call_update" { return tool_call_update_projection(update) }
    if kind == "plan" {
        ro entries = match get_of(update, "entries") {
            Some(e) => e
            None => JsonValue.array([]JsonValue.new())
        }
        mut o = JsonObject.new()
        put(o, "entries", entries)
        return proj("plan", JsonValue.object(o).to_str())
    }
    if kind == "usage_update" { return usage_projection(update) }
    if kind == "config_option_update" {
        ro options = match get_of(update, "configOptions") {
            Some(v) => v
            None => JsonValue.array([]JsonValue.new())
        }
        mut o = JsonObject.new()
        put(o, "model", JsonValue.str(model_name_of(options)))
        return proj("agent_model", JsonValue.object(o).to_str())
    }
    skipped(kind)
}

/// The first explicitly reported model selector in the full ACP configOptions set.
/// The currentValue is an opaque id; use its advertised option name when available.
export fn model_name_of(config_options JsonValue) -> str {
    ro options = match config_options.array() {
        Some(items) => items
        None => return ""
    }
    for option in options {
        if text_field(option, "category") != Some("model") || text_field(option, "type") != Some("select") { continue }
        ro value = match text_field(option, "currentValue") {
            Some(current) => current
            None => return ""
        }
        if value.byte_len() == 0 { return "" }
        match get_of(option, "options") {
            Some(values) => match values.array() {
                Some(items) => {
                    for item in items {
                        if text_field(item, "value") == Some(value) { return text_field(item, "name") ?? value }
                        match get_of(item, "options") {
                            Some(nested) => match nested.array() {
                                Some(group_items) => {
                                    for choice in group_items {
                                        if text_field(choice, "value") == Some(value) { return text_field(choice, "name") ?? value }
                                    }
                                }
                                None => ()
                            }
                            None => ()
                        }
                    }
                    value
                }
                None => value
            }
            None => value
        }
    }
    ""
}

// ----- the choices of the session: model, effort, mode (task 192) -----
//
// What the agent offers, as it says it: `configOptions` of `session/new` (selects with the categories `mode`, `model`,
// `thought_level`), or, when there are none, the older `modes` and `models` of the same answer. Nothing is made up: a
// part the agent does not offer is not in the summary, and the page shows no button for it.

/// SettingCall: the request that makes the agent take a choice of the owner: the method, the id of the option (for
/// `session/set_config_option`) and the chosen value.
export type SettingCall { method str, config_id str, value str }

fn choice_of(item JsonValue, id_key str) -> Option[JsonValue] {
    ro id = text_field(item, id_key)?
    mut o = JsonObject.new()
    put(o, "id", JsonValue.str(id))
    put(o, "name", JsonValue.str(text_field(item, "name") ?? id))
    ro description = text_field(item, "description") ?? ""
    if description.byte_len() > 0 { put(o, "description", JsonValue.str(description)) }
    Some(JsonValue.object(o))
}

// The choices of a list: the items with the key `id_key`; a group of a select (`options` inside) is flattened.
fn choices_of(list JsonValue, id_key str) -> []JsonValue {
    mut out = []JsonValue.new()
    ro items = match list.array() {
        Some(x) => x
        None => return out
    }
    for item in items {
        match get_of(item, "options") {
            Some(nested) => match nested.array() {
                Some(group) => {
                    for inner in group {
                        match choice_of(inner, id_key) {
                            Some(c) => out.push(c)
                            None => ()
                        }
                    }
                }
                None => ()
            }
            None => match choice_of(item, id_key) {
                Some(c) => out.push(c)
                None => ()
            }
        }
    }
    out
}

// The select of configOptions with the category (the effort: `thought_level`, or the id `effort`).
fn select_of(config JsonValue, category str) -> Option[JsonValue] {
    ro items = config.array()?
    for option in items {
        if text_field(option, "type") != Some("select") { continue }
        if text_field(option, "category") == Some(category) { return Some(option) }
        if category == "thought_level" && text_field(option, "id") == Some("effort") { return Some(option) }
    }
    None
}

fn field_or_null(v JsonValue, key str) -> JsonValue {
    match get_of(v, key) {
        Some(x) => x
        None => JsonValue.null()
    }
}

fn name_in(choices []JsonValue, id str) -> str {
    if id.byte_len() == 0 { return "" }
    for c in choices {
        if text_field(c, "id") == Some(id) { return text_field(c, "name") ?? id }
    }
    id
}

fn has_choice(choices []JsonValue, id str) -> bool {
    for c in choices {
        if text_field(c, "id") == Some(id) { return true }
    }
    false
}

// One setting of the summary. `legacy_list` and `legacy_current` are the older `modes` / `models` answer of `session/new`.
type Setting { id str, name str, choices []JsonValue }

fn setting_of(config JsonValue, category str, legacy_list JsonValue, legacy_key str, legacy_current str, now str) -> Setting {
    match select_of(config, category) {
        Some(option) => {
            ro choices = match get_of(option, "options") {
                Some(list) => choices_of(list, "value")
                None => []JsonValue.new()
            }
            Setting { id: text_field(option, "currentValue") ?? "", name: text_field(option, "name") ?? "", choices }
        }
        None => {
            ro choices = choices_of(legacy_list, legacy_key)
            mut current = legacy_current
            if now.byte_len() > 0 { current = now }
            Setting { id: current, name: "", choices }
        }
    }
}

fn put_setting(mut o JsonObject, setting Setting, id_key str, list_key str, name_key str) -> () {
    put(o, id_key, JsonValue.str(setting.id))
    if setting.choices.len() > 0 { put(o, list_key, JsonValue.array(setting.choices)) }
    if setting.name.byte_len() > 0 && name_key.byte_len() > 0 { put(o, name_key, JsonValue.str(setting.name)) }
}

/// The summary of what the agent offers and what is chosen now, as the JSON object of the page event `session_model`:
/// `model` (the name, "" when not reported), `model_id`, `models` (`[{id, name}]`), `effort` (the id), `effort_name`, `efforts`,
/// `mode` (the id), `modes` (`[{id, name, description}]`). A list the agent does not offer is absent. `mode_now` and `model_now`
/// are the choices made later than `session/new` told (empty - none); they count only for the older `modes` / `models`.
export fn options_summary(modes JsonValue, models JsonValue, config JsonValue, mode_now str, model_now str) -> str {
    ro model = setting_of(config, "model", field_or_null(models, "availableModels"), "modelId", text_field(models, "currentModelId") ?? "", model_now)
    ro effort = setting_of(config, "thought_level", JsonValue.null(), "id", "", "")
    ro mode = setting_of(config, "mode", field_or_null(modes, "availableModes"), "id", text_field(modes, "currentModeId") ?? "", mode_now)
    mut o = JsonObject.new()
    put(o, "model", JsonValue.str(name_in(model.choices, model.id)))
    if model.id.byte_len() > 0 { put(o, "model_id", JsonValue.str(model.id)) }
    if model.choices.len() > 0 { put(o, "models", JsonValue.array(model.choices)) }
    if effort.choices.len() > 0 { put_setting(o, effort, "effort", "efforts", "effort_name") }
    if mode.choices.len() > 0 { put_setting(o, mode, "mode", "modes", "") }
    JsonValue.object(o).to_str()
}

/// The call that makes the agent take `value` for `setting` (`mode`, `model` or `effort`); None - the agent did not offer
/// that value (or that setting at all): nothing is sent.
export fn setting_call(setting str, value str, modes JsonValue, models JsonValue, config JsonValue) -> Option[SettingCall] {
    if setting != "mode" && setting != "model" && setting != "effort" { return None }
    mut category = "thought_level"
    if setting == "mode" { category = "mode" }
    if setting == "model" { category = "model" }
    match select_of(config, category) {
        Some(option) => {
            ro choices = match get_of(option, "options") {
                Some(list) => choices_of(list, "value")
                None => []JsonValue.new()
            }
            if !has_choice(choices, value) { return None }
            return Some(SettingCall { method: "session/set_config_option", config_id: text_field(option, "id") ?? "", value })
        }
        None => ()
    }
    if setting == "mode" {
        ro list = field_or_null(modes, "availableModes")
        if !has_choice(choices_of(list, "id"), value) { return None }
        return Some(SettingCall { method: "session/set_mode", config_id: "", value })
    }
    if setting == "model" {
        ro list = field_or_null(models, "availableModels")
        if !has_choice(choices_of(list, "modelId"), value) { return None }
        return Some(SettingCall { method: "session/set_model", config_id: "", value })
    }
    None
}

/// The projection that carries the summary to the engine: the same event `agent_model` (the page event `session_model`).
export fn model_projection(summary str) -> Projection => proj("agent_model", summary)

const PERMISSION_DETAIL_CHARS = 300

// The action the dialog names (task 189): a command is "Выполнить команду" (the kind `execute`; claude-agent-acp sends
// no kind and the title is "Bash"), a known kind keeps its token, the rest is an honest "неизвестное действие".
fn permission_action(kind str, title str) -> str {
    if kind == "execute" || title == "Bash" { return "Выполнить команду" }
    if tool_kind(kind) != "other" { return tool_kind(kind) }
    if title.byte_len() > 0 { return "неизвестное действие: ${title}" }
    "неизвестное действие"
}

// A single line longer than the limit is cut with a mark; a multiline text is kept whole (the page scrolls it).
fn shorten_detail(text str) -> str {
    if text.contains("\n") { return text }
    mut total = 0
    mut parts = []str.new()
    for c in text.chars() {
        total += 1
        if total <= PERMISSION_DETAIL_CHARS { parts.push("${c}") }
    }
    if total <= PERMISSION_DETAIL_CHARS { return text }
    ro joined = parts.join("")
    "${joined}… (показаны первые ${PERMISSION_DETAIL_CHARS} знаков из ${total})"
}

// The detail of the dialog: the command of `rawInput.command`, else the first line of the content, else the paths of
// `locations`, else the title or the call id.
fn permission_detail(call JsonValue, title str, call_id str) -> str {
    match get_of(call, "rawInput") {
        Some(raw) => match text_field(raw, "command") {
            Some(command) => if command.byte_len() > 0 { return shorten_detail(command) }
            None => ()
        }
        None => ()
    }
    match get_of(call, "content") {
        Some(content) => {
            ro text = detail_of(content)
            if text.byte_len() > 0 {
                ro cut = text.find("\n") ?? text.byte_len()
                ro first = text[..cut]
                if first.byte_len() > 0 { return shorten_detail(first) }
            }
        }
        None => ()
    }
    match get_of(call, "locations") {
        Some(locations) => match locations.array() {
            Some(items) => {
                mut paths = []str.new()
                for item in items {
                    match text_field(item, "path") {
                        Some(path) => paths.push(path)
                        None => ()
                    }
                }
                if paths.len() > 0 { return shorten_detail(paths.join(", ")) }
            }
            None => ()
        }
        None => ()
    }
    if title.byte_len() > 0 { title } else { call_id }
}

/// A `session/request_permission` of the agent as the name and the input of an engine event. The `request` of the input is
/// the key of the JSON-RPC id: the decision of the owner names it.
///
/// The dialog of the page shows `action` and `detail` as they are (task 189): `action` is the phrase "Выполнить команду"
/// for a command (the kind `execute`; claude-agent-acp sends no kind and the title is "Bash"), the token of a known kind
/// otherwise, and an honest "неизвестное действие" (with the title, when there is one) for the rest - never a bare
/// "other". `detail` is the thing itself: the command of `rawInput.command`, else the first line of the content, else the
/// paths of `locations` (the files a right would touch), else the title or the call id. A single line longer than
/// PERMISSION_DETAIL_CHARS is cut with a mark; a multiline text is kept whole - the page shows it in a scrollable block.
export fn project_permission(rpc_id JsonValue, params JsonValue) -> Projection {
    ro call = match get_of(params, "toolCall") {
        Some(c) => c
        None => JsonValue.null()
    }
    ro call_id = text_field(call, "toolCallId") ?? ""
    ro title = text_field(call, "title") ?? ""
    mut options = []JsonValue.new()
    match get_of(params, "options") {
        Some(list) => match list.array() {
            Some(items) => {
                for item in items {
                    mut option = JsonObject.new()
                    put(option, "id", JsonValue.str(text_field(item, "optionId") ?? ""))
                    put(option, "name", JsonValue.str(text_field(item, "name") ?? ""))
                    put(option, "kind", JsonValue.str(text_field(item, "kind") ?? ""))
                    options.push(JsonValue.object(option))
                }
            }
            None => ()
        }
        None => ()
    }
    mut o = JsonObject.new()
    put(o, "request", JsonValue.str(rpc_key(rpc_id)))
    put(o, "tool_call", JsonValue.str(call_id))
    put(o, "action", JsonValue.str(permission_action(text_field(call, "kind") ?? "", title)))
    put(o, "detail", JsonValue.str(permission_detail(call, title, call_id)))
    put(o, "options", JsonValue.array(options))
    proj("permission_request", JsonValue.object(o).to_str())
}

/// The engine event of a projection. Bound to the request in flight (kind Progress); with no request (`""`) there is
/// nothing to belong to and the engine would discard it, so it is a signal from outside, `acp_note`, that the engine journals.
export fn progress_event(request str, p Projection) -> Incoming {
    if request.byte_len() == 0 {
        if p.name == "agent_model" { return Incoming.signal("agent_model", p.input) }
        return Incoming.signal("acp_note", "${p.name}: ${p.input}")
    }
    Incoming.incoming(EventKind.Progress, p.name, Some(request), p.input)
}

/// A refusal of the request with a code of the closed list.
export fn refused_event(request str, code FailCode) -> Incoming =>
    Incoming.incoming(EventKind.Refused, "agent_refused", Some(request), code.name())

/// The end of a turn by the stop reason of `session/prompt`: `end_turn` is the answer, the others are refusals with the
/// codes of the table; a reason the table does not know is `NoResult`.
export fn stop_event(request str, stop_reason str) -> Incoming {
    if stop_reason == "end_turn" {
        return Incoming.incoming(EventKind.Answered, "agent_done", Some(request), "")
    }
    if stop_reason == "max_tokens" { return refused_event(request, FailCode.MaxTokens) }
    if stop_reason == "max_turn_requests" { return refused_event(request, FailCode.MaxTurnRequests) }
    if stop_reason == "refusal" { return refused_event(request, FailCode.ModelRefused) }
    if stop_reason == "cancelled" { return refused_event(request, FailCode.StoppedByHuman) }
    refused_event(request, FailCode.NoResult)
}

// ----- engine event -> page event -----

/// PageInput: the kind and the input object of a page event.
type PageInput { kind str, input JsonValue }

fn page_input(kind str, input JsonValue) -> Option[PageInput] => Some(PageInput { kind, input })

fn turn_object(turn str) -> JsonObject {
    mut o = JsonObject.new()
    put(o, "turn", JsonValue.str(turn))
    o
}

// The input text of an event as a JSON object; None - it is not one.
fn object_input(e Incoming) -> Option[JsonValue] {
    ro value = match Json.parse(e.input) {
        Ok(v) => v
        Err(err) => return None
    }
    if value.is_object() { Some(value) } else { None }
}

fn text_input(e Incoming, turn str) -> Option[PageInput] {
    mut o = turn_object(turn)
    put(o, "text", JsonValue.str(e.input))
    page_input(e.name, JsonValue.object(o))
}

fn turn_only(kind str, turn str) -> Option[PageInput] => page_input(kind, JsonValue.object(turn_object(turn)))

fn with_turn(kind str, value JsonValue, turn str) -> Option[PageInput] {
    mut o = value.object()?
    put(o, "turn", JsonValue.str(turn))
    page_input(kind, JsonValue.object(o))
}

fn permission_input(value JsonValue, turn str) -> Option[PageInput] {
    mut o = turn_object(turn)
    put(o, "request", JsonValue.str(text_field(value, "request") ?? ""))
    put(o, "action", JsonValue.str(text_field(value, "action") ?? "other"))
    put(o, "detail", JsonValue.str(text_field(value, "detail") ?? ""))
    page_input("permission_request", JsonValue.object(o))
}

// The questions of the agent for the page (task 192i): the turn and what `project_question` made.
fn question_input(value JsonValue, turn str) -> Option[PageInput] {
    mut o = turn_object(turn)
    put(o, "request", JsonValue.str(text_field(value, "request") ?? ""))
    put(o, "tool_call", JsonValue.str(text_field(value, "tool_call") ?? ""))
    put(o, "questions", get_of(value, "questions") ?? JsonValue.array([]JsonValue.new()))
    page_input("question_request", JsonValue.object(o))
}

// The question is over (answered, skipped, withdrawn): the page takes the form away.
fn resolved_input(value JsonValue) -> Option[PageInput] {
    mut o = JsonObject.new()
    put(o, "request", JsonValue.str(text_field(value, "request") ?? ""))
    page_input("question_resolved", JsonValue.object(o))
}

fn refusal_input(reason str, turn str) -> Option[PageInput] {
    mut o = turn_object(turn)
    put(o, "reason", JsonValue.str(reason))
    page_input("agent_refused", JsonValue.object(o))
}

fn page_input_of(e Incoming, turn str) -> Option[PageInput] {
    match e.kind {
        EventKind.Input => {
            if e.name == "agent_model" {
                ro value = object_input(e)?
                return page_input("session_model", value)
            }
            if e.name == "user_message" { return text_input(e, turn) }
            if e.name == "agent_switched" {
                ro value = object_input(e)?
                return page_input("agent_switched", value)
            }
            // the pictures of the message that comes next (task 192): the list {n, name, mime, bytes}, never the bytes
            if e.name == "message_images" {
                ro value = object_input(e)?
                return page_input("message_images", value)
            }
            // the pictures were not sent: the agent does not take them (task 192)
            if e.name == "images_skipped" {
                ro value = object_input(e)?
                return with_turn("images_skipped", value, turn)
            }
            if e.name == "cancel" { return turn_only("cancel", turn) }
            if e.name == "permission_decision" {
                ro value = object_input(e)?
                return page_input("permission_decision", value)
            }
            // a question of the tool of the hub (task 192i): it is the hub's own event, not the agent's
            if e.name == "question_request" {
                ro value = object_input(e)?
                return question_input(value, turn)
            }
            // the answer of the owner to a question of the agent (task 192i): the page only needs to know that it is settled
            if e.name == "question_answer" {
                ro value = object_input(e)?
                return resolved_input(value)
            }
            // the first signal of a session of the server (task 099): its name, the agent, the folder - the input is the page's own
            if e.name == "session_created" {
                ro value = object_input(e)?
                return page_input("session_created", value)
            }
            None
        }
        EventKind.Progress => {
            if e.name == "agent_model" {
                ro value = object_input(e)?
                return page_input("session_model", value)
            }
            if e.name == "agent_chunk" { return text_input(e, turn) }
            if e.name == "tool_call" {
                ro value = object_input(e)?
                return with_turn("tool_call", value, turn)
            }
            if e.name == "turn_usage" {
                ro value = object_input(e)?
                return with_turn("turn_usage", value, turn)
            }
            if e.name == "tool_call_update" || e.name == "usage_update" {
                ro value = object_input(e)?
                return page_input(e.name, value)
            }
            if e.name == "permission_request" {
                ro value = object_input(e)?
                return permission_input(value, turn)
            }
            if e.name == "question_request" {
                ro value = object_input(e)?
                return question_input(value, turn)
            }
            if e.name == "question_resolved" {
                ro value = object_input(e)?
                return resolved_input(value)
            }
            None
        }
        EventKind.Answered => {
            if e.name == "agent_done" { return turn_only("agent_done", turn) }
            None
        }
        EventKind.Refused => {
            if e.name == "agent_refused" { return refusal_input(e.input, turn) }
            None
        }
        EventKind.Expired => refusal_input("Timeout", turn)
    }
}

/// The JSON line of the page for a stamped engine event; None - the page has no kind for it (a plan, a thought, a skipped
/// update, a note, a name nobody knows) or the input is not what the kind needs.
export fn page_event(e Incoming, turn str) -> Option[str] {
    ro page = page_input_of(e, turn)?
    mut o = JsonObject.new()
    put(o, "id", JsonValue.str(e.id))
    put(o, "trace", JsonValue.str(e.trace))
    put(o, "step", JsonValue.int(e.step))
    put(o, "kind", JsonValue.str(page.kind))
    put(o, "input", page.input)
    put(o, "time", JsonValue.int(e.at))
    Some(JsonValue.object(o).to_str())
}
