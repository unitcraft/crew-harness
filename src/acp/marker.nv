// marker.nv - task 192.9: the fallback marker of the tools of the hub in the text of an answer of an agent.
//
// An agent that cannot call the MCP tools `crew_task_list` / `crew_task` writes one line at the end of its answer: `[[crew_task_list]] {json}` (or `[[crew_task]] {json}`).
// The owner must never see it in the feed and the journal must not keep it as text of the answer: the client of ACP cuts it out of the chunks of the answer while they
// travel (the marker may come in parts), and gives the cut marker as an event of its own (`crew_marker`), that the hub reads when the turn is over.
//
// The pure part: `marker_feed` takes the part of the answer that came (and what was held back from the previous part) and says what may be shown, what is held back
// (a marker that is not closed yet, the beginning of a marker name, a line of a code fence that may be followed by a marker), and which markers were found.
// A marker in a code fence is cut together with the lines of the fence (`` ``` `` before it and after it). A marker that never closes (the answer is cut) is dropped.
module crew_harness.acp

/// MarkerState: what is held back between two parts of an answer. `tail`: the text not shown yet (it begins with a marker, or with a fence line before a marker, or is
/// the beginning of a marker name); `fence`: a line of a fence was cut together with a marker, and the closing line of the fence is cut when it comes.
export type MarkerState { tail str, fence bool }

/// MarkerStep: `out` is the text to show now, `state` is what is held back, `found` are the markers cut out, each as one line `[[name]] {json}`.
export type MarkerStep { out str, state MarkerState, found []str }

/// The state before the first part of an answer.
export fn marker_start() -> MarkerState => { tail: "", fence: false }

const MARKER_LIST = "[[crew_task_list]]"
const MARKER_ONE = "[[crew_task]]"

fn is_blank_byte(b u8) -> bool => b == (32 as u8) || b == (9 as u8) || b == (10 as u8) || b == (13 as u8)

// The index of the first byte that is not a space or a line break, from `from`; the length of the text when there is none.
fn skip_blank(s str, from int) -> int {
    ro bytes = s.bytes()
    mut i = from
    while i < bytes.len() && is_blank_byte(bytes[i]) { i += 1 }
    i
}

// The start of the line of a fence ("```" and maybe a word) that is the last line of `s` before a marker (only blanks after it), -1 when it is not.
fn fence_line_start(s str) -> int {
    ro bytes = s.bytes()
    mut e = bytes.len()
    while e > 0 && is_blank_byte(bytes[e - 1]) { e -= 1 }
    mut ls = e
    while ls > 0 && bytes[ls - 1] != (10 as u8) { ls -= 1 }
    if e - ls < 3 || e - ls > 20 { return -1 }
    if s[ls..e].trim_ascii().starts_with("```") { return ls }
    -1
}

// The start of an unfinished last line that may become a line of a fence ("`", "``", "```json" with no line break yet), -1 when it is not.
fn partial_fence_start(s str) -> int {
    ro bytes = s.bytes()
    mut ls = bytes.len()
    while ls > 0 && bytes[ls - 1] != (10 as u8) { ls -= 1 }
    if ls == bytes.len() || bytes.len() - ls > 20 { return -1 }
    ro line = s[ls..].trim_ascii()
    if line.byte_len() == 0 { return -1 }
    if line.starts_with("```") || "```".starts_with(line) { return ls }
    -1
}

// The end (exclusive) of the JSON object that begins at `from` (a `{`), -1 when it is not closed.
fn object_end(s str, from int) -> int {
    ro bytes = s.bytes()
    mut depth = 0
    mut in_str = false
    mut esc = false
    mut i = from
    while i < bytes.len() {
        ro b = bytes[i]
        if in_str {
            if esc { esc = false } else if b == (92 as u8) { esc = true } else if b == (34 as u8) { in_str = false }
        } else if b == (34 as u8) {
            in_str = true
        } else if b == (123 as u8) {
            depth += 1
        } else if b == (125 as u8) {
            depth -= 1
            if depth == 0 { return i + 1 }
        }
        i += 1
    }
    -1
}

// The earliest marker name in `s` from `from`: its index and the name, -1 and "" when there is none.
fn next_marker(s str, from int) -> MarkerAt {
    ro rest = s[from..]
    ro a = rest.find(MARKER_LIST)
    ro b = rest.find(MARKER_ONE)
    match a {
        Some(x) => match b {
            Some(y) => if y < x { MarkerAt { at: from + y, name: MARKER_ONE } } else { MarkerAt { at: from + x, name: MARKER_LIST } }
            None => MarkerAt { at: from + x, name: MARKER_LIST }
        }
        None => match b {
            Some(y) => MarkerAt { at: from + y, name: MARKER_ONE }
            None => MarkerAt { at: -1, name: "" }
        }
    }
}

type MarkerAt { at int, name str }

// How many bytes at the end of `s` (from `from`) may be the beginning of a marker name; 0 when none.
fn name_prefix_len(s str, from int) -> int {
    ro n = s.byte_len() - from
    mut k = if n < MARKER_LIST.byte_len() { n } else { MARKER_LIST.byte_len() }
    while k > 0 {
        ro at = s.byte_len() - k
        if s.is_char_boundary(at) {
            ro suffix = s[at..]
            if MARKER_LIST.starts_with(suffix) || MARKER_ONE.starts_with(suffix) { return k }
        }
        k -= 1
    }
    0
}

// The line of a marker as the hub reads it: the name and the object on one line.
fn marker_line(name str, json str) -> str => "${name} ${json.replace("\r", " ").replace("\n", " ")}"

/// Feed the part `text` of an answer. `last`: the answer is over, nothing is held back (a marker that is not closed is dropped, the rest is shown).
export fn marker_feed(state MarkerState, text str, last bool) -> MarkerStep {
    ro buf = "${state.tail}${text}"
    mut out = ""
    mut found = []str.new()
    mut fence = state.fence
    mut pos = 0
    mut held = ""
    while pos < buf.byte_len() {
        if fence {
            // the closing line of a fence that was cut with a marker
            ro k = skip_blank(buf, pos)
            if k >= buf.byte_len() {
                if last { pos = buf.byte_len() } else { held = buf[pos..]; pos = buf.byte_len() }
                break
            }
            ro rest = buf[k..]
            if rest.starts_with("```") {
                mut stop = k + 3
                ro line_end = rest.find("\n")
                match line_end {
                    Some(n) => { stop = k + n + 1 }
                    None => {
                        // the line of the fence is not over yet: wait for its end, so that a piece does not change what is shown
                        if !last { held = buf[pos..]; pos = buf.byte_len(); break }
                        stop = buf.byte_len()
                    }
                }
                pos = stop
                fence = false
                continue
            }
            if !last && "```".starts_with(rest) {
                held = buf[pos..]
                pos = buf.byte_len()
                break
            }
            fence = false
        }
        ro m = next_marker(buf, pos)
        if m.at < 0 {
            // no marker: show all but a possible beginning of a name or a line of a fence that a marker may follow
            mut cut = buf.byte_len()
            if !last {
                ro keep = name_prefix_len(buf, pos)
                if keep > 0 { cut = buf.byte_len() - keep }
                ro fl0 = fence_line_start(buf[pos..cut])
                ro fl = if fl0 >= 0 { fl0 } else { partial_fence_start(buf[pos..cut]) }
                if fl >= 0 { cut = pos + fl }
            }
            out = "${out}${buf[pos..cut]}"
            held = buf[cut..]
            pos = buf.byte_len()
            break
        }
        // a marker name at m.at: a fence line right before it goes with it
        ro before = buf[pos..m.at]
        ro fl = fence_line_start(before)
        ro shown_to2 = if fl >= 0 { pos + fl } else { m.at }
        ro name_end = m.at + m.name.byte_len()
        ro j = skip_blank(buf, name_end)
        if j >= buf.byte_len() {
            // the name and nothing after it yet
            out = "${out}${buf[pos..shown_to2]}"
            if last { pos = buf.byte_len() } else { held = buf[shown_to2..]; pos = buf.byte_len() }
            break
        }
        if buf.bytes()[j] != (123 as u8) {
            // the name in an ordinary sentence: it is text
            out = "${out}${buf[pos..name_end]}"
            pos = name_end
            continue
        }
        ro e = object_end(buf, j)
        if e < 0 {
            out = "${out}${buf[pos..shown_to2]}"
            if last { pos = buf.byte_len() } else { held = buf[shown_to2..]; pos = buf.byte_len() }
            break
        }
        out = "${out}${buf[pos..shown_to2]}"
        found.push(marker_line(m.name, buf[j..e]))
        fence = fl >= 0
        pos = e
    }
    MarkerStep { out, state: MarkerState { tail: held, fence: fence && !last }, found }
}

/// A tool of the MCP server `crew` of the hub as an agent titles its call (Kimi Code: `mcp__crew__crew_task_list`): such a call is not a request for the owner's leave,
/// the hub offered the tool itself (task 192.9).
export fn is_crew_tool_title(title str) -> bool {
    ro t = title.trim_ascii()
    t == "mcp__crew__crew_task_list" || t == "mcp__crew__crew_task" || t == "mcp__crew__ask_user_question"
}
