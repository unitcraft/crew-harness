// english_test.nv - task 113: the English twin of the sample of the agent step (spec/samples/agent-step.en.alula.md, copied as it is) goes through the translator without
// a hand edit, gives the JSON of the Russian sample (but for the strings and the names of the locals of its author), and runs the 75 scenarios of the agent step.
module crew_harness.machine_agent_en

import std.text
import alula.machine.{NamedText}
import alula.machine_table.{load_machine}
import alula.machine_run.{AlulaMachine, load_alula_machine, parse_test, run_test, run_ok, report_text}
import alula.machine_text.{translate_report, error_text, render_summary, TranslateReport}
import crew_harness.machines.{methodology_registry, agent_step_machine_text, test_files}

fn first_error(report TranslateReport) -> str {
    if report.errors.len() == 0 { return "ok" }
    error_text(report.errors[0], "en-sample")
}

test "ae header" {
    ro json = en_report().json
    assert(json.starts_with("{\"kind\":\"machine\",\"alula_version\":\"0.27\",\"machine\":\"agent_step\",\"revision\":1,\"title\":\"Agent step\""))
}

test "ae loads" {
    match load_machine(en_report().json, methodology_registry()) {
        Ok(def) => {
            assert(def.name == "agent_step")
            assert(def.states.len() == 14)
            assert(def.common.len() == 6)
            assert(def.parties.len() == 3)
            assert(def.data.len() == 22)
            assert(def.definitions.len() == 16)
            assert(def.end_rows.len() == 13)
            assert(def.primitives.len() == 2)
            assert(def.request_limit.len() == 1)
            assert(def.params.len() == 2)
        }
        Err(issues) => panic("the English sample does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

test "ae the keyed sample is the product table" {
    ro keyed = report_of(en_keyed())
    assert(first_error(keyed) == "ok")
    assert(tree_text(keyed.json) == tree_text(ru_in_english(agent_step_machine_text(), keyed.json)))
    assert(keyed.json.contains("\"project_key\":\"пауза_повтора\""))
}

// ---- the words of the language are of one language ------------------------------------------------------------------------------

fn agent_scenarios() -> []NamedText {
    mut out = []NamedText.new()
    for f in test_files() {
        if f.name.starts_with("agent-step-") { out.push(f) }
    }
    out
}

fn en_machine() -> AlulaMachine {
    match load_alula_machine(report_of(en_keyed()).json, methodology_registry()) {
        Ok(m) => m
        Err(e) => panic("the English agent step is not made: ${e}")
    }
}

test "ae scenarios 75" {
    ro all = agent_scenarios()
    assert(all.len() == 83)
    ro m = en_machine()
    mut failed = 0
    mut first = ""
    for f in all {
        match parse_test(f.text) {
            Ok(sc) => {
                ro run = run_test(m, sc)
                if !run_ok(run) {
                    failed += 1
                    if first == "" { first = "${f.name}: ${report_text(run)}" }
                }
            }
            Err(e) => panic("${f.name}: ${e.path}: ${e.message}")
        }
    }
    if first != "" { panic(first) }
    assert(failed == 0)
}
