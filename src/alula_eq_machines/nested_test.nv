// nested_test.nv - task 119: the circles of the program `alula` on the machines of the nested machines (the parent `caller`, the callee, the set parent `fan`, the chat session `dialog_steps`): `compile` -> `render` -> `compile`
// gives an equal JSON in Russian and in English, `convert` ru -> en -> ru gives an equal JSON, and `check` passes them (the words of the party kind `machine`, `Signal`, `State`, the profile, `Предел запросов`).
module crew_harness.alula_eq_machines

import std.text
import alula.machine.{text_of_file}
import crew_harness.machines.{machine_files, table_files}

fn probe_names() -> []str => ["dialog_steps.alula.json"]

test "pn circle dialog steps ru" { assert(circle("dialog_steps.alula.json", "ru") == "") }

test "pn circle dialog steps en" { assert(circle("dialog_steps.alula.json", "en") == "") }

test "pn convert dialog steps" { assert(convert_circle("dialog_steps.alula.json") == "") }

test "pn the tables compile to the json of the product" {
    // the file of Alula of a machine and its JSON in src/machine/machines/ are the same tree
    for name in probe_names() {
        ro base = name.replace(".alula.json", "")
        ro ran = run_with(["compile", "/m/${base}.alula.md"], one("/m/${base}.alula.md", text_of_file(table_files(), "${base}.alula.md")))
        assert(ran.err == "")
        assert(ran.code == 0)
        assert(same_tree(machine_json(name), ran.out) == "")
    }
}

test "pn check the probe machines" {
    for name in probe_names() {
        ro ran = run_with(["check", "/m/${name}"], one("/m/${name}", machine_json(name)))
        assert(ran.err == "")
        assert(ran.code == 0)
        assert(ran.out == "ok\n")
    }
}

test "pn the machines are the files of the product" {
    ro names = probe_names()
    assert(names.len() == 1)
    assert(machine_files().len() == 7)
    for name in names { assert(machine_json(name).byte_len() > 100) }
}
