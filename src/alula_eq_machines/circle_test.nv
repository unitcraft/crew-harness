// circle_test.nv - task 116: the circles of the program `alula` on the machines of the product (the chat and the dialog; the agent step left with the methodology, task 249): `compile` -> `render` -> `compile` gives an
// equal JSON in Russian and in English, and `convert` ru -> en -> ru gives an equal JSON; the commands give what the functions of the translator give.
module crew_harness.alula_eq_machines

import std.fs.{Path}
import std.text
import alula.machine.{NamedText}
import alula.machine_text.{translate_checked_with, render, render_summary}
import crew_harness.machines.{chat_table_text, dialog_table_text, product_registry, translation_files, connects_library, part_mended}

// A circle through the program: the JSON of the machine -> `render` in the language -> `compile` of the file it wrote. "" when the second tree equals the first, else why not.
fn circle(name str, language str) -> str {
    ro json = machine_json(name)
    // a machine that connects a library goes through the English file not (the package 0.9.0, task 239: `connects_library`)
    if language == "en" && connects_library(json) { return "" }
    ro rendered = run_with(["render", "/m/a.alula.json", "--language", language], one("/m/a.alula.json", json))
    if rendered.code != 0 { return "render ${name}: ${rendered.err}" }
    ro back = run_with(["compile", "/m/b.alula.md"], one("/m/b.alula.md", part_mended(rendered.out)))
    if back.code != 0 { return "compile ${name}: ${back.err}" }
    same_tree(json, back.out)
}

// ru -> en -> ru through `convert`, then `compile`: the tree of the machine again. The first file is the machine rendered in Russian.
fn convert_circle(name str) -> str {
    ro json = machine_json(name)
    if connects_library(json) { return "" }
    ro russian = run_with(["render", "/m/a.alula.json"], one("/m/a.alula.json", json))
    if russian.code != 0 { return "render ${name}: ${russian.err}" }
    ro english = run_with(["convert", "/m/b.alula.md", "--language", "en"], one("/m/b.alula.md", russian.out))
    if english.code != 0 { return "convert en ${name}: ${english.err}" }
    if !english.out.contains("- language: en\n") { return "the English file of ${name} has no language line" }
    ro again = run_with(["convert", "/m/c.alula.md", "--language", "ru"], one("/m/c.alula.md", english.out))
    if again.code != 0 { return "convert ru ${name}: ${again.err}" }
    ro back = run_with(["compile", "/m/d.alula.md"], one("/m/d.alula.md", again.out))
    if back.code != 0 { return "compile ${name}: ${back.err}" }
    same_tree(json, back.out)
}

// The same from a file of Alula that the product keeps (the table of the chat): convert to the other language and back; the tree is the one of the file.
fn file_convert_circle(name str, text str) -> str {
    if connects_library(text) { return "" }
    ro first = run_with(["compile", "/m/${name}"], one("/m/${name}", text))
    if first.code != 0 { return "compile ${name}: ${first.err}" }
    ro english = run_with(["convert", "/m/${name}", "--language", "en"], one("/m/${name}", text))
    if english.code != 0 { return "convert en ${name}: ${english.err}" }
    ro again = run_with(["convert", "/m/e.alula.md", "--language", "ru"], one("/m/e.alula.md", english.out))
    if again.code != 0 { return "convert ru ${name}: ${again.err}" }
    ro back = run_with(["compile", "/m/f.alula.md"], one("/m/f.alula.md", again.out))
    if back.code != 0 { return "compile ${name}: ${back.err}" }
    same_tree(first.out, back.out)
}

// ---- compile -> render -> compile ---------------------------------------------------------------------------------------------

test "pe circle chat ru" { assert(circle("chat.alula.json", "ru") == "") }

test "pe circle chat en" { assert(circle("chat.alula.json", "en") == "") }

test "pe the machines are the files of the product" {
    ro names = json_names()
    assert(names.len() == 2)
    for name in names { assert(machine_json(name).byte_len() > 100) }
}

// ---- convert ru -> en -> ru ------------------------------------------------------------------------------------------------------

test "pe convert chat" { assert(convert_circle("chat.alula.json") == "") }

test "pe convert chat table" { assert(file_convert_circle("chat.alula.md", chat_table_text()) == "") }

// ---- the commands are the functions of the translator --------------------------------------------------------------------------

test "pe compile is translate checked" {
    ro text = chat_table_text()
    ro ran = run_with(["compile", "/m/chat.alula.md"], one("/m/chat.alula.md", text))
    ro report = translate_checked_with(text, product_registry(), translation_files())
    assert(report.errors.len() == 0)
    assert(ran.code == 0)
    assert(ran.out == "${report.json}\n")
}

test "pe summary is the function" {
    ro json = machine_json("chat.alula.json")
    ro ran = run_with(["summary", "/m/chat.alula.json"], one("/m/chat.alula.json", json))
    assert(ran.code == 0)
    assert(ran.out == "${render_summary(json)}\n")
    ro from_table = run_with(["summary", "/m/chat.alula.md"], one("/m/chat.alula.md", chat_table_text()))
    assert(from_table.out == "${render_summary(translate_checked_with(chat_table_text(), product_registry(), translation_files()).json)}\n")
}

test "pe check every machine of the product" {
    for name in json_names() {
        ro ran = run_with(["check", "/m/${name}"], one("/m/${name}", machine_json(name)))
        assert(ran.err == "")
        assert(ran.code == 0)
        assert(ran.out == "ok\n")
    }
}

test "pe check the tables of the product" {
    ro chat = run_with(["check", "/m/chat.alula.md"], one("/m/chat.alula.md", chat_table_text()))
    assert(chat.code == 0)
    assert(chat.out == "ok\n")
    ro dialog = run_with(["check", "/m/dialog.alula.md"], one("/m/dialog.alula.md", dialog_table_text()))
    assert(dialog.code == 0)
    assert(dialog.out == "ok\n")
}

test "pe the tree of a table is the tree of the compile" {
    // `compile` of the table of the chat and the written JSON of the chat run the same scenarios (task 108); here: the same machine name and the same states
    ro ran = run_with(["compile", "/m/chat.alula.md"], one("/m/chat.alula.md", chat_table_text()))
    assert(ran.out.contains("\"machine\":\"ChatSession\""))
    ro summary_json = run_with(["summary", "/m/chat.alula.json"], one("/m/chat.alula.json", machine_json("chat.alula.json")))
    ro summary_table = run_with(["summary", "/m/chat.alula.md"], one("/m/chat.alula.md", chat_table_text()))
    assert(summary_json.out == summary_table.out)
}
