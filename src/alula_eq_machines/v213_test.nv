// v213_test.nv - task 149: the machines of the product are written at Alula 2.13 (format 2.14): the keys `Запрос:` and `Читает:`, `сигнал(…)`, the column `сигналы`, ASCII signs, the JSON names in brackets,
// no section of the expansion of a fragment; every JSON is what `compile` makes of its file; the circles `compile -> render -> compile` and `convert ru -> en -> ru` give an equal tree in both languages,
// the line of connection of the fragment has the parameter `сигнал_остановки`.
module crew_harness.alula_eq_machines

import std.text
import alula.machine.{text_of_file}
import crew_harness.machines.{machine_files, table_files, connects_library}

fn all_tables() -> []str => ["chat.alula.md", "cycle_check.alula.md", "dialog.alula.md", "dialog_steps.alula.md", "session_start.alula.md", "task_runner.alula.md", "agent_step.alula.md"]

fn tree_name(name str) -> str => name.replace(".alula.md", ".alula.json")

fn has_line_starting(text str, prefix str) -> bool {
    for line in text.split("\n") {
        if line.starts_with(prefix) { return true }
    }
    false
}

test "v213 tables use the new keys" {
    for name in all_tables() {
        ro text = text_of_file(table_files(), name)
        assert(!has_line_starting(text, "- Вход:"))
        assert(!has_line_starting(text, "Вход:"))
        assert(!text.contains("| слово("))
        assert(!text.contains("слова ворот"))
        assert(!text.contains("Раскрытие фрагмента"))
    }
}

test "v213 tables have no unicode signs" {
    for name in all_tables() {
        // the rows of the tables are code; a paragraph of prose is a comment for the reader and may use any sign
        for line in text_of_file(table_files(), name).split("\n") {
            if !line.starts_with("|") { continue }
            for sign in ["≥", "≤", "≠", "→", "∈", "…"] {
                assert(!line.contains(sign))
            }
        }
    }
}

test "v213 tables write signals" {
    mut with_signals = 0
    for name in all_tables() {
        ro text = text_of_file(table_files(), name)
        if text.contains("| сигнал(") { with_signals += 1 }
    }
    assert(with_signals >= 7)
}

test "v213 tables write request and reads" {
    for name in all_tables() {
        ro text = text_of_file(table_files(), name)
        // Alula 2.26: a key line is a list item (AL-137), the reads of a state are derived by the check and not written (AL-138)
        assert(has_line_starting(text, "- Запрос:"))
        assert(!has_line_starting(text, "Запрос:"))
        assert(!text.contains("Читает:"))
    }
}

test "v213 tables have no empty keys" {
    for name in all_tables() {
        ro text = text_of_file(table_files(), name)
        for key in ["Запрос", "Читает", "Срок тишины", "При входе"] {
            assert(!has_line_starting(text, "- ${key}: —"))
            assert(!has_line_starting(text, "- ${key}: нет"))
        }
    }
}

test "v213 tables say 2.26" {
    for name in all_tables() {
        assert(text_of_file(table_files(), name).contains("format: 2.26\n"))
    }
}

test "v213 compile makes the json of the product" {
    for name in all_tables() {
        // the tree of the chat is kept by hand with Latin names; its table is compared with a tolerance for the names in `chat_test` of `machine_text`
        if name == "chat.alula.md" { continue }
        ro made = run_with(["compile", "/m/${name}"], one("/m/${name}", text_of_file(table_files(), name)))
        if made.code != 0 { panic("compile ${name}: ${made.err}") }
        assert(same_tree(text_of_file(machine_files(), tree_name(name)), made.out) == "")
    }
}

test "v213 check takes every table" {
    for name in all_tables() {
        ro made = run_with(["check", "/m/${name}"], one("/m/${name}", text_of_file(table_files(), name)))
        if made.code != 0 { panic("check ${name}: ${made.err}") }
        assert(made.code == 0)
    }
}

test "v213 the connection of the library has the signal parameter" {
    for name in ["dialog_steps.alula.md", "session_start.alula.md", "cycle_check.alula.md", "agent_step.alula.md"] {
        ro text = text_of_file(table_files(), name)
        // Alula 2.26 (AL-140): the connection is the heading `### Пауза` with the table of the values of the parameters
        assert(text.contains("### Пауза\n- Файл: libs/pause.alula.md\n"))
        assert(text.contains("| сигнал_остановки | "))
        assert(!text.contains("Пауза(сигнал_остановки:"))
        assert(!text.contains("слово_остановки"))
    }
}

test "v213 circle of every machine that includes the fragment" {
    for name in ["dialog_steps.alula.md"] {
        // the Russian circle only: a machine that connects a library does not go through the English file on the package 0.9.0 (task 239, `connects_library`)
        for lang in ["ru"] {
            ro first = run_with(["compile", "/m/${name}"], one("/m/${name}", text_of_file(table_files(), name)))
            if first.code != 0 { panic("compile ${name}: ${first.err}") }
            ro rendered = run_with(["render", "/m/x.alula.json", "--language", lang], one("/m/x.alula.json", first.out))
            if rendered.code != 0 { panic("render ${name}: ${rendered.err}") }
            ro second = run_with(["compile", "/m/y.alula.md"], one("/m/y.alula.md", rendered.out))
            if second.code != 0 { panic("recompile ${name} ${lang}: ${second.err}") }
            assert(same_tree(first.out, second.out) == "")
        }
    }
}

test "v213 convert ru en ru" {
    for name in ["dialog.alula.md", "chat.alula.md"] {
        ro text = text_of_file(table_files(), name)
        ro en = run_with(["convert", "/m/${name}", "--language", "en"], one("/m/${name}", text))
        // 0.9.1 refuses conversion without an English twin of the product library.
        assert(connects_library(text))
        assert(en.code != 0)
        assert(en.err.contains("libs/call_cancel.en.alula.md"))
    }
}
