// v212_test.nv - task 125: the program `alula` and the machines of the product on Alula 2.12: every machine file says `format: 2.12`, every JSON is what `compile` makes of its file, a file of 2.11
// is refused with a message that names 2.12, the circles `compile -> render -> compile` and `convert ru -> en -> ru` give an equal tree with the line of connection of a library (the machines of the
// methodology and their «Пауза» left the product with task 249; the product connects «Отмена запроса»).
module crew_harness.alula_eq_machines

import std.text
import alula.machine.{NamedText, text_of_file}
import crew_harness.machines.{machine_files, table_files}

fn product_tables() -> []str => ["chat.alula.md", "dialog.alula.md"]

fn json_of_table(name str) -> str => name.replace(".alula.md", ".alula.json")

test "v212 table files say 0.27" {
    for name in product_tables() {
        ro text = text_of_file(table_files(), name)
        assert(text.contains("alula_version: 0.27\n"))
        assert(!text.contains("format: 2.11"))
        assert(!text.contains("alula-2.11"))
    }
}

test "v212 compile makes the json of the product" {
    for name in product_tables() {
        // the tree of the chat is kept by hand with Latin names; its table is compared with a tolerance for the names in `chat_test` of `machine_text`
        if name == "chat.alula.md" { continue }
        ro made = run_with(["compile", "/m/${name}"], one("/m/${name}", text_of_file(table_files(), name)))
        if made.code != 0 { panic("compile ${name}: ${made.err}") }
        assert(same_tree(text_of_file(machine_files(), json_of_table(name)), made.out) == "")
    }
}

test "v212 check takes every table" {
    for name in product_tables() {
        ro made = run_with(["check", "/m/${name}"], one("/m/${name}", text_of_file(table_files(), name)))
        if made.code != 0 { panic("check ${name}: ${made.err}") }
        assert(made.code == 0)
    }
}

test "v212 compile refuses 2.11" {
    ro old = text_of_file(table_files(), "dialog.alula.md").replace("alula_version: 0.27", "alula_version: 2.11")
    assert(old.contains("alula_version: 2.11"))
    ro made = run_with(["compile", "/m/dialog.alula.md"], one("/m/dialog.alula.md", old))
    assert(made.code != 0)
    assert(made.err.contains("2.11"))
    assert(made.err.contains("alula_version: 0.27"))
}

test "v212 check refuses 2.11" {
    ro old = text_of_file(table_files(), "chat.alula.md").replace("alula_version: 0.27", "alula_version: 2.11")
    assert(old.contains("alula_version: 2.11"))
    ro made = run_with(["check", "/m/chat.alula.md"], one("/m/chat.alula.md", old))
    assert(made.code != 0)
}

test "v212 render writes 0.27" {
    ro made = run_with(["render", "/m/dialog.alula.json"], one("/m/dialog.alula.json", text_of_file(machine_files(), "dialog.alula.json")))
    assert(made.code == 0)
    assert(made.out.contains("- alula_version: 0.27\n"))
    ro en = run_with(["render", "/m/dialog.alula.json", "--language", "en"], one("/m/dialog.alula.json", text_of_file(machine_files(), "dialog.alula.json")))
    // The product library has no English twin: 0.9.1 refuses to invent one.
    assert(en.code != 0)
    assert(en.err.contains("libs/call_cancel.en.alula.md"))
}

test "v212 json of 2.11 is refused" {
    ro old = text_of_file(machine_files(), "dialog.alula.json").replace("\"alula_version\":\"0.27\"", "\"alula_version\":\"2.11\"")
    ro made = run_with(["render", "/m/dialog.alula.json"], one("/m/dialog.alula.json", old))
    assert(made.code != 0)
}

// Alula 2.26 (AL-140): the connection of a library is a heading with the name of the library, the file beside the machine and its hash
test "v212 the connection of the library in the written file" {
    ro made = run_with(["render", "/m/dialog.alula.json"], one("/m/dialog.alula.json", text_of_file(machine_files(), "dialog.alula.json")))
    assert(made.code == 0)
    assert(made.out.contains("## Подключения\n\n### Отмена запроса\n- Файл: libs/call_cancel.alula.md\n- Хеш: "))
    assert(!made.out.contains("Отмена запроса("))
}

test "v212 circle of every machine that includes the fragment" {
    for name in ["dialog.alula.json"] {
        assert(circle(name, "ru") == "")
        assert(circle(name, "en") == "")
        assert(convert_circle(name) == "")
    }
}
