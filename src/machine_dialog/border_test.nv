// border_test.nv - task 126: the tables of the dialog and of the chat after the border with the code was drawn: the field of the signals is `содержание` (not `текст текст`),
// the cancel of the dialog is declared once (a signal of the machine, not a signal of the party user), the translation says `content`. Alula 2.26 (task 240): the part is the type `КусокОтвета`
// named in the column `части` of the agent, the cancel is the signal of the protocol of a call `отмена_запроса` (`cancel_request`), declared by the library `libs/call_cancel.alula.md` that the
// machine connects, and taken by a common event of the machine in the state of the open turn.
module crew_harness.machine_dialog

import std.text
import alula.machine_text.{translate_checked_with, error_text}
import crew_harness.machines.{product_registry, chat_table_text, dialog_machine_text, dialog_table_text, translation_files}

test "bd dialog: the message and the chunk have the field содержание" {
    ro t = dialog_table_text()
    assert(t.contains("сообщение_пользователя { содержание строка }"))
    assert(t.contains("тип КусокОтвета { содержание строка }"))
    assert(t.contains("| агент | agent | agent(итог строка) | — | — | КусокОтвета | попытка_агента |"))
}

test "bd dialog: the rows name the field" {
    ro t = dialog_table_text()
    assert(t.contains("сигнал(сообщение_пользователя { содержание: сообщение })"))
    assert(t.contains("часть { содержание: кусок }"))
}

test "bd dialog: the field текст текст is gone" {
    ro t = dialog_table_text()
    assert(!t.contains("(текст текст)"))
    assert(!t.contains("текст: сообщение"))
    assert(!t.contains("текст: кусок"))
}

test "bd dialog: the cancel is not a signal of the party user" {
    ro t = dialog_table_text()
    assert(!t.contains("сообщение_пользователя { содержание строка }, отмена"))
    assert(!t.contains("сигнал(отмена)"))
    assert(!t.contains("## Сигналы"))
    assert(!t.contains("слово(отмена)"))
}

test "bd dialog: the cancel is the signal of the protocol and a common event of the open turn takes it" {
    ro t = dialog_table_text()
    assert(t.contains("### Отмена запроса\n- Файл: libs/call_cancel.alula.md\n"))
    assert(t.contains("## Общие события"))
    assert(t.contains("| сигнал(отмена_запроса) | состояние == ОЖИДАНИЕ | журнал(\"cancelled_while_waiting\")"))
}

test "bd dialog: the table translates without errors" {
    ro report = translate_checked_with(dialog_table_text(), product_registry(), translation_files())
    assert(report.errors.len() == 0)
}

test "bd dialog: the translation is the committed file" {
    ro report = translate_checked_with(dialog_table_text(), product_registry(), translation_files())
    assert(report.json == dialog_machine_text())
}

test "bd dialog: the tree has content, not text, in the signals" {
    ro j = dialog_machine_text()
    assert(j.contains("\"name\":\"user_message\",\"fields\":[{\"name\":\"content\",\"type\":\"text\"}]"))
    assert(j.contains("\"name\":\"agent_chunk\",\"fields\":[{\"name\":\"content\",\"type\":\"text\"}]"))
    assert(!j.contains("\"fields\":[{\"name\":\"text\""))
}

test "bd dialog: the tree declares the cancel once, as a signal of the protocol" {
    ro j = dialog_machine_text()
    assert(j.contains("{\"name\":\"cancel_request\",\"fields\":[{\"name\":\"id\",\"type\":\"text\"}]}"))
    assert(j.contains("\"event\":{\"kind\":\"signal\",\"name\":\"cancel_request\"}"))
    assert(!j.contains("{\"name\":\"cancel\"}"))
}

test "bd chat: the message and the chunk have the field содержание" {
    ro t = chat_table_text()
    assert(t.contains("сообщение_пользователя { содержание строка }"))
    assert(t.contains("тип КусокОтвета { содержание строка }"))
    assert(t.contains("| агент | agent | agent(итог строка) | — | — | КусокОтвета | попытка_агента |"))
    assert(t.contains("сигнал(сообщение_пользователя { содержание: сообщение })"))
    assert(t.contains("часть { содержание: кусок }"))
    assert(!t.contains("(текст текст)"))
}

test "bd chat: the cancel before a request and while waiting is the signal of the protocol" {
    ro t = chat_table_text()
    // Alula 2.26 (task 240): one name of the cancel for the code in both states - two common events of the machine, the user says only his message
    assert(t.contains("| сигнал(отмена_запроса) | состояние == ПОКОЙ | журнал(\"cancelled_before_request\")"))
    assert(t.contains("| сигнал(отмена_запроса) | состояние == ОЖИДАНИЕ | журнал(\"cancelled_while_waiting\")"))
    assert(t.contains("| пользователь | user | human(итог ИсходВорот) | — | сообщение_пользователя { содержание строка } | — | — |"))
    assert(!t.contains("сигнал(отмена)"))
}
