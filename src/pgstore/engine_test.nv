// pg_engine_test.nv - the engine with the demo machine over the PostgreSQL handlers of Journal and Store: the same
// stories as in memory (chat_engine_test.nv) must give the same journal, the same snapshot and the same outcome;
// a restart of the process, and the deaths of rule 13 (between the journal and the snapshot, between the commit and the send).
//
// The agent and the clock stay in memory (`MemoryWorld`); only the journal and the snapshots are in the database.
module crew_harness.pgstore

import crew_harness.pgdb.{new_test_db, drop_test_db, test_count}
import crew_harness.engine.{Engine, MemoryWorld, Incoming, FailCode, JournalEntry, Journal, Store, Link, Time, Snapshot, start_engine, resume_engine, memory_journal, memory_store, memory_link, memory_time, decode_snapshot, encode_snapshot, JournalEvent}
import crew_harness.chat.{ChatSession, ChatState, chat_session, encode_chat_state, user_says, user_cancels, agent_chunk, agent_done, agent_refused}

// ----- helpers: one `with` over the four handlers; use_pg picks the database or the memory -----

// ORACLE-WORKAROUND(12, 13, 26): the type arguments of `start_engine` and `resume_engine` are written out here and in the helpers below; infer them when items 12 and 13 are fixed
fn begin(use_pg bool, mut mem MemoryWorld, mut pg PgWorld) -> Engine[ChatSession, ChatState] {
    if use_pg {
        with Journal = pg_journal(pg), Store = pg_store(pg), Link = memory_link(mem), Time = memory_time(mem) {
            start_engine[ChatState, ChatSession](chat_session(), "chat-1")
        }
    } else {
        with Journal = memory_journal(mem), Store = memory_store(mem), Link = memory_link(mem), Time = memory_time(mem) {
            start_engine[ChatState, ChatSession](chat_session(), "chat-1")
        }
    }
}

fn resumed(use_pg bool, mut mem MemoryWorld, mut pg PgWorld) -> Engine[ChatSession, ChatState] {
    if use_pg {
        with Journal = pg_journal(pg), Store = pg_store(pg), Link = memory_link(mem), Time = memory_time(mem) {
            match resume_engine[ChatState, ChatSession](chat_session(), "chat-1") {
                Some(e) => e
                None => panic("no snapshot to resume from")
            }
        }
    } else {
        with Journal = memory_journal(mem), Store = memory_store(mem), Link = memory_link(mem), Time = memory_time(mem) {
            match resume_engine[ChatState, ChatSession](chat_session(), "chat-1") {
                Some(e) => e
                None => panic("no snapshot to resume from")
            }
        }
    }
}

fn feed(use_pg bool, mut e Engine[ChatSession, ChatState], mut mem MemoryWorld, mut pg PgWorld, event Incoming) -> () {
    if use_pg {
        with Journal = pg_journal(pg), Store = pg_store(pg), Link = memory_link(mem), Time = memory_time(mem) {
            e.feed(event)
        }
    } else {
        with Journal = memory_journal(mem), Store = memory_store(mem), Link = memory_link(mem), Time = memory_time(mem) {
            e.feed(event)
        }
    }
}

fn accept_only(use_pg bool, mut e Engine[ChatSession, ChatState], mut mem MemoryWorld, mut pg PgWorld, event Incoming) -> () {
    if use_pg {
        with Journal = pg_journal(pg), Store = pg_store(pg), Link = memory_link(mem), Time = memory_time(mem) {
            e.on_arrival(event)
        }
    } else {
        with Journal = memory_journal(mem), Store = memory_store(mem), Link = memory_link(mem), Time = memory_time(mem) {
            e.on_arrival(event)
        }
    }
}

fn dispatch(use_pg bool, mut e Engine[ChatSession, ChatState], mut mem MemoryWorld, mut pg PgWorld) -> () {
    if use_pg {
        with Journal = pg_journal(pg), Store = pg_store(pg), Link = memory_link(mem), Time = memory_time(mem) {
            e.dispatch()
        }
    } else {
        with Journal = memory_journal(mem), Store = memory_store(mem), Link = memory_link(mem), Time = memory_time(mem) {
            e.dispatch()
        }
    }
}

fn pump(use_pg bool, mut e Engine[ChatSession, ChatState], mut mem MemoryWorld, mut pg PgWorld) -> int {
    if use_pg {
        with Journal = pg_journal(pg), Store = pg_store(pg), Link = memory_link(mem), Time = memory_time(mem) {
            e.pump()
        }
    } else {
        with Journal = memory_journal(mem), Store = memory_store(mem), Link = memory_link(mem), Time = memory_time(mem) {
            e.pump()
        }
    }
}

fn journal_of(use_pg bool, mut mem MemoryWorld, mut pg PgWorld) -> []JournalEntry {
    if use_pg {
        with Journal = pg_journal(pg) { Journal.read_all() }
    } else {
        mem.journal_entries()
    }
}

fn snapshot_of(use_pg bool, mut mem MemoryWorld, mut pg PgWorld) -> Option[Snapshot] {
    if use_pg {
        with Store = pg_store(pg) { Store.load("chat-1") }
    } else {
        mem.snapshots.get("chat-1")
    }
}

fn state_name(e Engine[ChatSession, ChatState]) -> str => chat_session().state_name(e.state())

fn of_code(entries []JournalEntry, code str) -> []JournalEntry {
    mut out = []JournalEntry.new()
    for entry in entries {
        if entry.event.code == code { out.push(entry) }
    }
    out
}

// The parameters of an event are taken by name: jsonb keeps the keys of an object in its own order.
fn same_event(x JournalEvent, y JournalEvent) -> bool {
    if x.code != y.code || x.params.len() != y.params.len() { return false }
    for p in x.params {
        if y.value_of(p.name) != Some(p.value) { return false }
    }
    true
}

fn same_entry(x JournalEntry, y JournalEntry) -> bool =>
    x.trace == y.trace && x.step == y.step && x.cause == y.cause && x.state == y.state
        && x.request == y.request && x.at == y.at && same_event(x.event, y.event)

// ORACLE-WORKAROUND(47): the parameters are `first`, `second` (and `ja`, `jb` below), not `a`, `b`: a unit that imports this module gets the prelude `EmbeddedDir.merge` wrong from the names `a`, `b` of a record type; rename to `a`, `b` when item 47 is fixed
fn same_entries(first []JournalEntry, second []JournalEntry) -> bool {
    if first.len() != second.len() { return false }
    mut i = 0
    while i < first.len() {
        if !same_entry(first[i], second[i]) { return false }
        i += 1
    }
    true
}

// The snapshot as the engine sees it: decoded and encoded again, so the spelling of the JSON text does not matter.
fn snapshot_data(s Option[Snapshot]) -> str {
    match s {
        Some(snapshot) => match decode_snapshot[ChatState, ChatSession](chat_session(), snapshot) {
            Some(state) => encode_snapshot[ChatState, ChatSession](chat_session(), state).data
            None => "<damaged>"
        }
        None => "<none>"
    }
}

// ORACLE-WORKAROUND(10): the answer is read with two nested `match`es, one level each, not `Some(Answer(reply))`: a nested pattern over a generic payload binds a NULL pointer in the C; write the nested pattern when item 10 is fixed
fn answer_text(e Engine[ChatSession, ChatState]) -> str {
    match e.outcome() {
        Some(response) => match response {
            Answer(reply) => reply.result
            Refusal(rejection) => "refused:${rejection.reason.name()}"
        }
        None => ""
    }
}

// The two runs agree on everything the world can see.
fn assert_same(first Engine[ChatSession, ChatState], second Engine[ChatSession, ChatState], ja []JournalEntry, jb []JournalEntry, sa Option[Snapshot], sb Option[Snapshot]) -> () {
    assert(first.step_number() == second.step_number())
    assert(encode_chat_state(first.state()) == encode_chat_state(second.state()))
    assert(first.is_finished() == second.is_finished())
    assert(first.open_ids().len() == second.open_ids().len())
    assert(answer_text(first) == answer_text(second))
    assert(ja.len() > 0)
    assert(same_entries(ja, jb))
    assert(snapshot_data(sa) == snapshot_data(sb))
}

// ----- the stories (the same code runs in memory and on PostgreSQL) -----

fn story_conversation(use_pg bool, mut mem MemoryWorld, mut pg PgWorld) -> Engine[ChatSession, ChatState] {
    mut e = begin(use_pg, mem, pg)
    feed(use_pg, e, mem, pg, user_says("Привет, как дела? Ёжик, щётка, \"кавычки\" и 😀"))
    mem.advance(40)
    feed(use_pg, e, mem, pg, agent_chunk("agent-1", "Здравствуй"))
    mem.advance(40)
    feed(use_pg, e, mem, pg, agent_chunk("agent-1", ", мир"))
    feed(use_pg, e, mem, pg, agent_done("agent-1"))
    feed(use_pg, e, mem, pg, agent_done("agent-1"))
    feed(use_pg, e, mem, pg, agent_done("agent-9"))
    e
}

fn story_cancel(use_pg bool, mut mem MemoryWorld, mut pg PgWorld) -> Engine[ChatSession, ChatState] {
    mut e = begin(use_pg, mem, pg)
    feed(use_pg, e, mem, pg, user_says("hi"))
    mem.advance(5)
    feed(use_pg, e, mem, pg, user_cancels())
    feed(use_pg, e, mem, pg, agent_done("agent-1"))
    e
}

fn story_timeout(use_pg bool, mut mem MemoryWorld, mut pg PgWorld) -> Engine[ChatSession, ChatState] {
    mut e = begin(use_pg, mem, pg)
    feed(use_pg, e, mem, pg, user_says("hi"))
    mem.advance(29000)
    mem.deliver(agent_chunk("agent-1", "a"))
    assert(pump(use_pg, e, mem, pg) == 1)
    mem.advance(31000)
    assert(pump(use_pg, e, mem, pg) == 1)
    mem.deliver(agent_done("agent-1"))
    assert(pump(use_pg, e, mem, pg) == 1)
    e
}

fn story_refusal(use_pg bool, mut mem MemoryWorld, mut pg PgWorld) -> Engine[ChatSession, ChatState] {
    mut e = begin(use_pg, mem, pg)
    feed(use_pg, e, mem, pg, user_says("hi"))
    feed(use_pg, e, mem, pg, agent_refused("agent-1", FailCode.ModelRefused))
    e
}

test "engine on PostgreSQL: a conversation gives the same journal, snapshot and answer as in memory, Cyrillic and all" {
    ro db = new_test_db("e_conversation")
    mut mem_a = MemoryWorld.at(1000)
    mut pg_a = PgWorld.open(db.app, "unused")
    ro in_memory = story_conversation(false, mem_a, pg_a)
    mut mem_b = MemoryWorld.at(1000)
    mut pg_b = PgWorld.open(db.app, "chat-1")
    ro on_pg = story_conversation(true, mem_b, pg_b)
    assert(answer_text(on_pg) == "Здравствуй, мир")
    assert_same(in_memory, on_pg, journal_of(false, mem_a, pg_a), journal_of(true, mem_b, pg_b), snapshot_of(false, mem_a, pg_a), snapshot_of(true, mem_b, pg_b))
    assert(mem_a.sent.len() == mem_b.sent.len())
    // what is in the table is what the engine wrote: one snapshot row per step, lines of every step
    assert(test_count(db.admin, "select count(*) from crew.machine_snapshot") == on_pg.step_number())
    assert(test_count(db.admin, "select count(distinct step) from crew.machine_journal") == on_pg.step_number())
    assert(test_count(db.admin, "select count(*) from crew.machine_journal where entry->'event'->'params'->>'text' like '%Ёжик%'") == 1)
    drop_test_db(db)
}

test "engine on PostgreSQL: a cancel by the user gives the same result as in memory" {
    ro db = new_test_db("e_cancel")
    mut mem_a = MemoryWorld.at(1000)
    mut pg_a = PgWorld.open(db.app, "unused")
    ro in_memory = story_cancel(false, mem_a, pg_a)
    mut mem_b = MemoryWorld.at(1000)
    mut pg_b = PgWorld.open(db.app, "chat-1")
    ro on_pg = story_cancel(true, mem_b, pg_b)
    assert(answer_text(on_pg) == "refused:StoppedByHuman")
    assert_same(in_memory, on_pg, journal_of(false, mem_a, pg_a), journal_of(true, mem_b, pg_b), snapshot_of(false, mem_a, pg_a), snapshot_of(true, mem_b, pg_b))
    assert(mem_b.cancelled.len() == 1)
    assert(of_code(journal_of(true, mem_b, pg_b), "cancel_sent").len() == 1)
    drop_test_db(db)
}

test "engine on PostgreSQL: the idle term gives the same result as in memory" {
    ro db = new_test_db("e_timeout")
    mut mem_a = MemoryWorld.at(1000)
    mut pg_a = PgWorld.open(db.app, "unused")
    ro in_memory = story_timeout(false, mem_a, pg_a)
    mut mem_b = MemoryWorld.at(1000)
    mut pg_b = PgWorld.open(db.app, "chat-1")
    ro on_pg = story_timeout(true, mem_b, pg_b)
    assert(answer_text(on_pg) == "refused:Timeout")
    assert_same(in_memory, on_pg, journal_of(false, mem_a, pg_a), journal_of(true, mem_b, pg_b), snapshot_of(false, mem_a, pg_a), snapshot_of(true, mem_b, pg_b))
    drop_test_db(db)
}

test "engine on PostgreSQL: a refusal of the agent gives the same result as in memory" {
    ro db = new_test_db("e_refusal")
    mut mem_a = MemoryWorld.at(1000)
    mut pg_a = PgWorld.open(db.app, "unused")
    ro in_memory = story_refusal(false, mem_a, pg_a)
    mut mem_b = MemoryWorld.at(1000)
    mut pg_b = PgWorld.open(db.app, "chat-1")
    ro on_pg = story_refusal(true, mem_b, pg_b)
    assert(answer_text(on_pg) == "refused:ModelRefused")
    assert_same(in_memory, on_pg, journal_of(false, mem_a, pg_a), journal_of(true, mem_b, pg_b), snapshot_of(false, mem_a, pg_a), snapshot_of(true, mem_b, pg_b))
    drop_test_db(db)
}

// ----- restart: the process dies, the database stays -----

test "engine on PostgreSQL: restart after the request was opened - a new process, a new PgWorld, no second send, the same result" {
    ro db = new_test_db("e_restart")
    mut mem = MemoryWorld.at(1000)
    mut pg1 = PgWorld.open(db.app, "chat-1")
    mut e1 = begin(true, mem, pg1)
    feed(true, e1, mem, pg1, user_says("привет"))
    assert(mem.sent.len() == 1)
    // the process dies: e1 and pg1 are gone, the database and the agent stay
    mut pg2 = PgWorld.open(db.app, "chat-1")
    mut e2 = resumed(true, mem, pg2)
    assert(state_name(e2) == "Awaiting")
    assert(e2.open_ids().len() == 1)
    assert(e2.trace() == e1.trace())
    assert(e2.step_number() == e1.step_number() + 1)
    dispatch(true, e2, mem, pg2)
    pump(true, e2, mem, pg2)
    assert(mem.sent.len() == 1)
    mem.deliver(agent_chunk("agent-1", "Здравствуй"))
    mem.deliver(agent_done("agent-1"))
    assert(pump(true, e2, mem, pg2) == 2)
    assert(e2.is_finished())
    assert(answer_text(e2) == "Здравствуй")
    assert(mem.sent.len() == 1)
    // the same story in memory without a restart
    mut control_mem = MemoryWorld.at(1000)
    mut control_pg = PgWorld.open(db.app, "unused")
    mut c = begin(false, control_mem, control_pg)
    feed(false, c, control_mem, control_pg, user_says("привет"))
    feed(false, c, control_mem, control_pg, agent_chunk("agent-1", "Здравствуй"))
    feed(false, c, control_mem, control_pg, agent_done("agent-1"))
    assert(answer_text(c) == answer_text(e2))
    assert(encode_chat_state(c.state()) == encode_chat_state(e2.state()))
    // the restart is a line of the journal in the database, and the numbers have no gaps
    ro entries = journal_of(true, mem, pg2)
    assert(of_code(entries, "engine_resumed").len() == 1)
    assert(of_code(entries, "request_sent").len() == 1)
    assert(test_count(db.admin, "select count(distinct step) from crew.machine_journal") == e2.step_number())
    assert(test_count(db.admin, "select max(step) - min(step) + 1 - count(*) from crew.machine_snapshot") == 0)
    drop_test_db(db)
}

test "engine on PostgreSQL: restart after the answer - the session stays finished, nothing is sent, a repeated answer is discarded" {
    ro db = new_test_db("e_restart_done")
    mut mem = MemoryWorld.at(1000)
    mut pg1 = PgWorld.open(db.app, "chat-1")
    mut e1 = begin(true, mem, pg1)
    feed(true, e1, mem, pg1, user_says("hi"))
    feed(true, e1, mem, pg1, agent_chunk("agent-1", "fine"))
    feed(true, e1, mem, pg1, agent_done("agent-1"))
    mut pg2 = PgWorld.open(db.app, "chat-1")
    mut e2 = resumed(true, mem, pg2)
    assert(e2.is_finished())
    assert(state_name(e2) == "Done")
    assert(answer_text(e2) == "fine")
    dispatch(true, e2, mem, pg2)
    feed(true, e2, mem, pg2, agent_done("agent-1"))
    assert(answer_text(e2) == "fine")
    assert(mem.sent.len() == 1)
    assert(of_code(journal_of(true, mem, pg2), "reply_discarded").len() == 1)
    drop_test_db(db)
}

test "engine on PostgreSQL: death between the commit and the send - the request is sent once after the restart, and not twice after another" {
    ro db = new_test_db("e_before_send")
    mut mem = MemoryWorld.at(1000)
    mut pg1 = PgWorld.open(db.app, "chat-1")
    mut e1 = begin(true, mem, pg1)
    accept_only(true, e1, mem, pg1, user_says("hi"))
    assert(mem.sent.len() == 0)
    mut pg2 = PgWorld.open(db.app, "chat-1")
    mut e2 = resumed(true, mem, pg2)
    dispatch(true, e2, mem, pg2)
    assert(mem.sent.len() == 1)
    assert(mem.sent[0].id == "agent-1")
    assert(mem.sent[0].input == "hi")
    dispatch(true, e2, mem, pg2)
    assert(mem.sent.len() == 1)
    mut pg3 = PgWorld.open(db.app, "chat-1")
    mut e3 = resumed(true, mem, pg3)
    dispatch(true, e3, mem, pg3)
    assert(mem.sent.len() == 1)
    drop_test_db(db)
}

test "engine on PostgreSQL: death between the journal write and the snapshot save - the lines of that step are not in the database, the step is made again" {
    ro db = new_test_db("e_death")
    mut mem = MemoryWorld.at(1000)
    mut pg1 = PgWorld.open(db.app, "chat-1")
    mut e1 = begin(true, mem, pg1)
    feed(true, e1, mem, pg1, user_says("hi"))
    ro committed_step = e1.step_number()
    ro committed_state = encode_chat_state(e1.state())
    // the step committed_step + 1 writes its lines through the handler ... and the process dies before the snapshot
    with Journal = pg_journal(pg1) {
        Journal.write(entry_at(committed_step + 1, "event", "progress/agent_chunk"))
        Journal.write(entry_at(committed_step + 1, "note", "agent chunk: lost"))
    }
    assert(test_count(db.admin, "select count(*) from crew.machine_journal where step = ${committed_step + 1}") == 0)
    mut pg2 = PgWorld.open(db.app, "chat-1")
    mut e2 = resumed(true, mem, pg2)
    // the snapshot is the commit point: the machine is where it was after the last commit
    assert(encode_chat_state(e2.state()) == committed_state)
    assert(e2.step_number() == committed_step + 1)
    ro restart = of_code(journal_of(true, mem, pg2), "engine_resumed")
    assert(restart.len() == 1)
    assert(restart[0].event.value_of("ignored_lines") == Some("0"))
    assert(mem.sent.len() == 1)
    assert(e2.open_ids().len() == 1)
    feed(true, e2, mem, pg2, agent_chunk("agent-1", "ok"))
    feed(true, e2, mem, pg2, agent_done("agent-1"))
    assert(e2.is_finished())
    assert(state_name(e2) == "Done")
    assert(answer_text(e2) == "ok")
    drop_test_db(db)
}

test "engine on PostgreSQL: two sessions in one database do not mix" {
    ro db = new_test_db("e_sessions")
    mut mem1 = MemoryWorld.at(1000)
    mut pg1 = PgWorld.open(db.app, "chat-1")
    mut e1 = begin(true, mem1, pg1)
    feed(true, e1, mem1, pg1, user_says("one"))
    mut other = PgWorld.open(db.app, "chat-2")
    assert(load_snapshot(other, "chat-2") == None)
    assert(read_all(other).len() == 0)
    assert(test_count(db.admin, "select count(distinct id) from crew.machine_snapshot") == 1)
    drop_test_db(db)
}
