// settings.nv - the settings of the PostgreSQL connection from a file and from the environment (task 098).
//
// The file is a JSON object with the keys `host`, `port`, `database`, `user`, `password` (a missing key has its default,
// see `parse_pg_config`); its name is the argument or, when that is empty, the variable CREW_PG_CONFIG. The environment is
// over the file, key by key:
//   CREW_PG_HOST, CREW_PG_PORT, CREW_PG_DATABASE, CREW_PG_USER, CREW_PG_PASSWORD
// (an empty variable is the same as an unset one). The password may live in the environment alone, so that no file holds it.
//
// The module is apart from `crew_harness.pgdb` because of `std.os`: a program that holds the engine cannot hold `std.os`
// until the type `Output` of the engine is renamed (Oracle 0.1.0, src/pg/README.md). The program that starts the sessions
// reads the settings here and gives the value `PgConfig` to the handlers.
module crew_harness.pgconf

import crew_harness.pgdb.{PgConfig, parse_pg_config}
import std.os.{Os, env}
import std.fs.{Fs, read_text, Path}

fn env_or(key str, fallback str) Os -> str {
    match env(key) {
        Some(v) => if v.byte_len() > 0 { v } else { fallback }
        None => fallback
    }
}

/// The environment over a base configuration; a port that is not a number is an error.
export fn pg_config_env(base PgConfig) Os -> Result[PgConfig, str] {
    ro host = env_or("CREW_PG_HOST", base.host)
    ro database = env_or("CREW_PG_DATABASE", base.database)
    ro user = env_or("CREW_PG_USER", base.user)
    ro password = env_or("CREW_PG_PASSWORD", base.password)
    ro port_text = env_or("CREW_PG_PORT", "")
    ro port = if port_text.byte_len() == 0 {
        base.port
    } else {
        match port_text.to_int() {
            Ok(n) => n
            Err(e) => return Err("CREW_PG_PORT must be a whole number")
        }
    }
    Ok(PgConfig { host, port, database, user, password })
}

/// The settings: the file `file` (or the one named by CREW_PG_CONFIG when `file` is empty; no file at all means the
/// defaults), then the environment over it. The error never quotes the content of the file.
export fn pg_config(file str) Os Fs -> Result[PgConfig, str] {
    ro name = if file.byte_len() > 0 { file } else { env_or("CREW_PG_CONFIG", "") }
    ro base = if name.byte_len() == 0 {
        parse_pg_config("{}")?
    } else {
        ro text = match read_text(Path.from_bytes(name.bytes())) {
            Ok(t) => t
            Err(e) => return Err("the settings file ${name} cannot be read")
        }
        match parse_pg_config(text) {
            Ok(c) => c
            Err(e) => return Err("${e} (file ${name})")
        }
    }
    pg_config_env(base)
}
