// chat_engine_test.nv - the engine with the demo machine over the in-memory world.
//
// Every property of the engine is shown on the chat session: one request - one answer, restart by a
// repeated entry, cancel, idle term, the journal, the snapshot, UTF-8.
module crew_harness.chat

import std.encoding.json.{JsonValue, JsonObject}
import crew_harness.engine.{Engine, MemoryWorld, Incoming, EventKind, FailCode, PartyResponse, Reply, Rejection, JournalEntry, Journal, Store, Link, start_engine, resume_engine, memory_journal, memory_store, memory_link, memory_time, decode_snapshot, journal_line, journal_event, param}

// ----- helpers: one `with` over the four handlers of a world -----

// ORACLE-WORKAROUND(12, 13, 26): the type arguments of `start_engine` and `resume_engine` are written out here and in the helpers below; infer them when items 12 and 13 are fixed
fn begin(mut world MemoryWorld) -> Engine[ChatSession, ChatState] {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        start_engine[ChatState, ChatSession](chat_session(), "chat-1")
    }
}

fn resumed(mut world MemoryWorld) -> Engine[ChatSession, ChatState] {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        match resume_engine[ChatState, ChatSession](chat_session(), "chat-1") {
            Some(e) => e
            None => panic("no snapshot to resume from")
        }
    }
}

fn has_snapshot(mut world MemoryWorld) -> bool {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        match resume_engine[ChatState, ChatSession](chat_session(), "chat-1") {
            Some(e) => true
            None => false
        }
    }
}

fn feed(mut e Engine[ChatSession, ChatState], mut world MemoryWorld, event Incoming) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.feed(event)
    }
}

fn accept_only(mut e Engine[ChatSession, ChatState], mut world MemoryWorld, event Incoming) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.on_arrival(event)
    }
}

fn dispatch(mut e Engine[ChatSession, ChatState], mut world MemoryWorld) -> () {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.dispatch()
    }
}

fn pump(mut e Engine[ChatSession, ChatState], mut world MemoryWorld) -> int {
    with Journal = memory_journal(world), Store = memory_store(world), Link = memory_link(world), Time = memory_time(world) {
        e.pump()
    }
}

fn state_name(e Engine[ChatSession, ChatState]) -> str => chat_session().state_name(e.state())

// The reply of the final answer, None when the session has no answer.
// ORACLE-WORKAROUND(10): the answer is read with two nested `match`es, one level each, not `Some(Answer(reply))`: a nested pattern over a generic payload binds a NULL pointer in the C; write the nested pattern when item 10 is fixed
fn reply_of(e Engine[ChatSession, ChatState]) -> Option[Reply[str]] {
    match e.outcome() {
        Some(response) => match response {
            Answer(reply) => Some(reply)
            Refusal(rejection) => None
        }
        None => None
    }
}

// The rejection of the final refusal, None when the session has no refusal.
// ORACLE-WORKAROUND(10): the answer is read with two nested `match`es, one level each, not `Some(Answer(reply))`: a nested pattern over a generic payload binds a NULL pointer in the C; write the nested pattern when item 10 is fixed
fn rejection_of(e Engine[ChatSession, ChatState]) -> Option[Rejection] {
    match e.outcome() {
        Some(response) => match response {
            Answer(reply) => None
            Refusal(rejection) => Some(rejection)
        }
        None => None
    }
}

// The text of the answer, "" when there is none; and the refusal reason, "" when there is none.
fn answer_of(e Engine[ChatSession, ChatState]) -> str {
    match reply_of(e) {
        Some(reply) => reply.result
        None => ""
    }
}

fn refusal_of(e Engine[ChatSession, ChatState]) -> str {
    match rejection_of(e) {
        Some(rejection) => rejection.reason.name()
        None => ""
    }
}

fn of_code(entries []JournalEntry, code str) -> []JournalEntry {
    mut out = []JournalEntry.new()
    for entry in entries {
        if entry.event.code == code { out.push(entry) }
    }
    out
}

fn codes_of(entries []JournalEntry, code str) -> int {
    mut n = 0
    for entry in entries {
        if entry.event.code == code { n += 1 }
    }
    n
}

// The encoded state of the machine, to compare states.
fn encoded(e Engine[ChatSession, ChatState]) -> str => encode_chat_state(e.state())

// ----- start and the first request -----

test "engine: start is step 1, saves the first snapshot and writes the start line" {
    mut world = MemoryWorld.at(1000)
    ro e = begin(world)
    assert(e.step_number() == 1)
    assert(world.saves == 1)
    assert(e.trace() == "t1000-chat-1")
    assert(!e.is_finished())
    ro entries = world.journal_entries()
    assert(entries.len() == 1)
    assert(entries[0].event.code == "machine_started")
    assert(entries[0].step == 1)
    assert(entries[0].cause == "start-1")
    assert(entries[0].state == "Idle")
    assert(entries[0].at == 1000)
    assert(entries[0].trace == "t1000-chat-1")
}

test "engine: a user message opens the request agent-1 and sends it once, with the envelope" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hello"))
    assert(state_name(e) == "Awaiting")
    assert(world.sent.len() == 1)
    ro request = world.sent[0]
    assert(request.id == "agent-1")
    assert(request.attempt == 1)
    assert(request.party == "agent")
    assert(request.input == "hello")
    assert(request.idle_term == 30000)
    assert(request.trace == "t1000-chat-1")
    assert(request.step == 2)
    assert(e.open_ids().len() == 1)
    assert(e.open_ids()[0] == "agent-1")
    assert(e.step_number() == 2)
}

test "engine: the event is stamped: id, clock, step" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    world.advance(250)
    feed(e, world, user_says("hello"))
    ro entries = world.journal_entries()
    ro on_event = of_code(entries, "event_accepted")
    assert(on_event.len() == 1)
    assert(on_event[0].cause == "input-2")
    assert(on_event[0].step == 2)
    assert(on_event[0].at == 1250)
}

test "engine: the journal lines of a step carry the state the machine waits in after the step" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hello"))
    feed(e, world, agent_done("agent-1"))
    ro entries = world.journal_entries()
    for entry in entries {
        if entry.step == 1 { assert(entry.state == "Idle") }
        if entry.step == 2 { assert(entry.state == "Awaiting") }
        if entry.step == 3 { assert(entry.state == "Done") }
    }
    assert(of_code(entries, "request_sent")[0].state == "Awaiting")
}

// ----- the answer, the refusal -----

test "engine: chunks and the final answer finish the session with the accumulated text" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    feed(e, world, agent_chunk("agent-1", "Hel"))
    feed(e, world, agent_chunk("agent-1", "lo"))
    assert(state_name(e) == "Awaiting")
    assert(!e.is_finished())
    assert(e.open_ids().len() == 1)
    feed(e, world, agent_done("agent-1"))
    assert(state_name(e) == "Done")
    assert(e.is_finished())
    assert(answer_of(e) == "Hello")
    assert(e.open_ids().len() == 0)
    assert(world.cancelled.len() == 0)
}

test "engine: the outcome is an Answer with request, party, trace, step" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    feed(e, world, agent_chunk("agent-1", "ok"))
    feed(e, world, agent_done("agent-1"))
    match reply_of(e) {
        Some(reply) => {
            assert(reply.result == "ok")
            assert(reply.party == "ChatSession")
            assert(reply.request == "chat-1")
            assert(reply.trace == "t1000-chat-1")
        }
        None => assert(false)
    }
}

test "engine: a refusal of the agent closes the request and ends the session with that reason" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    feed(e, world, agent_refused("agent-1", FailCode.ModelRefused))
    assert(state_name(e) == "Failed")
    assert(e.is_finished())
    assert(refusal_of(e) == "ModelRefused")
    assert(e.open_ids().len() == 0)
}

// ----- one request - one answer -----

test "engine: a second answer to a closed request is discarded and the journal remembers it" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    feed(e, world, agent_chunk("agent-1", "x"))
    feed(e, world, agent_done("agent-1"))
    ro before_step = e.step_number()
    ro before_state = encoded(e)
    feed(e, world, agent_done("agent-1"))
    assert(encoded(e) == before_state)
    assert(answer_of(e) == "x")
    assert(e.step_number() == before_step + 1)
    assert(world.sent.len() == 1)
    ro entries = world.journal_entries()
    assert(codes_of(entries, "reply_discarded") == 1)
    ro discarded = of_code(entries, "reply_discarded")
    assert(discarded[0].request == "agent-1")
    assert(discarded[0].event.value_of("reason") == Some("closed_request"))
    assert(discarded[0].step == before_step + 1)
}

test "engine: a late chunk of a closed request is discarded too, and does not reopen anything" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    feed(e, world, agent_done("agent-1"))
    feed(e, world, agent_chunk("agent-1", "late"))
    assert(answer_of(e) == "")
    assert(e.open_ids().len() == 0)
    assert(codes_of(world.journal_entries(), "reply_discarded") == 1)
}

test "engine: an answer to a request nobody opened is discarded as unknown" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    ro before = encoded(e)
    feed(e, world, agent_done("agent-7"))
    assert(encoded(e) == before)
    assert(e.open_ids().len() == 1)
    ro discarded = of_code(world.journal_entries(), "reply_discarded")
    assert(discarded.len() == 1)
    assert(discarded[0].request == "agent-7")
    assert(discarded[0].event.value_of("reason") == Some("unknown_request"))
}

// ----- cancel -----

test "engine: cancel by the user cancels the open request at the agent and ends the session" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    feed(e, world, user_cancels())
    assert(state_name(e) == "Failed")
    assert(e.is_finished())
    assert(refusal_of(e) == "StoppedByHuman")
    assert(e.open_ids().len() == 0)
    assert(world.cancelled.len() == 1)
    assert(world.cancelled[0] == "agent-1")
    ro entries = world.journal_entries()
    assert(codes_of(entries, "cancel_ordered") == 1)
    assert(codes_of(entries, "cancel_sent") == 1)
}

test "engine: an answer that comes after the cancel is discarded as a reply to a closed request" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    feed(e, world, user_cancels())
    feed(e, world, agent_done("agent-1"))
    assert(refusal_of(e) == "StoppedByHuman")
    assert(answer_of(e) == "")
    ro discarded = of_code(world.journal_entries(), "reply_discarded")
    assert(discarded.len() == 1)
    assert(discarded[0].event.value_of("reason") == Some("closed_request"))
}

test "engine: cancel before any request ends the session and cancels nothing" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_cancels())
    assert(refusal_of(e) == "StoppedByHuman")
    assert(world.cancelled.len() == 0)
    assert(world.sent.len() == 0)
}

// ----- idle term -----

test "engine: a silent agent ends with Timeout and is cancelled" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    world.advance(29000)
    assert(pump(e, world) == 0)
    assert(!e.is_finished())
    world.advance(1001)
    assert(pump(e, world) == 1)
    assert(state_name(e) == "Failed")
    assert(refusal_of(e) == "Timeout")
    assert(e.open_ids().len() == 0)
    assert(world.cancelled.len() == 1)
    assert(world.cancelled[0] == "agent-1")
}

test "engine: a chunk renews the idle term" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    world.advance(29000)
    world.deliver(agent_chunk("agent-1", "a"))
    assert(pump(e, world) == 1)
    world.advance(29000)
    assert(pump(e, world) == 0)
    assert(!e.is_finished())
    world.advance(2000)
    assert(pump(e, world) == 1)
    assert(refusal_of(e) == "Timeout")
}

test "engine: an answer that comes after the timeout is discarded" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    world.advance(31000)
    pump(e, world)
    world.deliver(agent_done("agent-1"))
    pump(e, world)
    assert(refusal_of(e) == "Timeout")
    assert(answer_of(e) == "")
    assert(codes_of(world.journal_entries(), "reply_discarded") == 1)
}

test "engine: pump takes the incoming events of the agent in the order of arrival" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    world.deliver(agent_chunk("agent-1", "one "))
    world.deliver(agent_chunk("agent-1", "two"))
    world.deliver(agent_done("agent-1"))
    assert(pump(e, world) == 3)
    assert(answer_of(e) == "one two")
    assert(pump(e, world) == 0)
}

// ----- restart by a repeated entry -----

test "restart after the request: no second send, same result" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    feed(e1, world, user_says("привет"))
    assert(world.sent.len() == 1)
    // the process dies here: e1 is gone, the world survives
    mut e2 = resumed(world)
    assert(state_name(e2) == "Awaiting")
    assert(e2.open_ids().len() == 1)
    assert(e2.open_ids()[0] == "agent-1")
    assert(e2.trace() == "t1000-chat-1")
    dispatch(e2, world)
    pump(e2, world)
    assert(world.sent.len() == 1)
    world.deliver(agent_chunk("agent-1", "Здравствуй"))
    world.deliver(agent_done("agent-1"))
    assert(pump(e2, world) == 2)
    assert(e2.is_finished())
    assert(answer_of(e2) == "Здравствуй")
    assert(world.sent.len() == 1)

    // the same story without a restart
    mut control = MemoryWorld.at(1000)
    mut c = begin(control)
    feed(c, control, user_says("привет"))
    feed(c, control, agent_chunk("agent-1", "Здравствуй"))
    feed(c, control, agent_done("agent-1"))
    assert(answer_of(c) == answer_of(e2))
    assert(encoded(c) == encoded(e2))
    assert(state_name(c) == state_name(e2))
}

test "restart after the answer: stays finished, nothing sent" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    feed(e1, world, user_says("hi"))
    feed(e1, world, agent_chunk("agent-1", "fine"))
    feed(e1, world, agent_done("agent-1"))
    ro answer = answer_of(e1)
    mut e2 = resumed(world)
    assert(e2.is_finished())
    assert(state_name(e2) == "Done")
    assert(answer_of(e2) == answer)
    assert(e2.open_ids().len() == 0)
    dispatch(e2, world)
    assert(world.sent.len() == 1)
    feed(e2, world, agent_done("agent-1"))
    assert(answer_of(e2) == answer)
    assert(world.sent.len() == 1)
    assert(world.cancelled.len() == 0)
    ro discarded = of_code(world.journal_entries(), "reply_discarded")
    assert(discarded.len() == 1)
    assert(discarded[0].event.value_of("reason") == Some("closed_request"))
}

test "restart after the commit but before the send: the request is sent now, exactly once" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    accept_only(e1, world, user_says("hi"))
    assert(world.sent.len() == 0)
    assert(e1.open_ids().len() == 1)
    // the process dies between the commit and the send
    mut e2 = resumed(world)
    dispatch(e2, world)
    assert(world.sent.len() == 1)
    assert(world.sent[0].id == "agent-1")
    assert(world.sent[0].input == "hi")
    dispatch(e2, world)
    assert(world.sent.len() == 1)
    mut e3 = resumed(world)
    dispatch(e3, world)
    assert(world.sent.len() == 1)
}

test "restart: a step of its own, no gaps, same trace" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    feed(e1, world, user_says("hi"))
    ro before = e1.step_number()
    mut e2 = resumed(world)
    assert(e2.step_number() == before + 1)
    assert(e2.trace() == e1.trace())
    ro restart = of_code(world.journal_entries(), "engine_resumed")
    assert(restart.len() == 1)
    assert(restart[0].step == before + 1)
    assert(restart[0].cause == "restart-3")
}

test "restart: the attempt counter is kept, ids do not repeat" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    feed(e1, world, user_says("hi"))
    mut e2 = resumed(world)
    match world.snapshots.get("chat-1") {
        Some(snapshot) => match decode_snapshot[ChatState, ChatSession](chat_session(), snapshot) {
            Some(state) => {
                assert(state.counters.len() == 1)
                assert(state.counters[0].party == "agent")
                assert(state.counters[0].attempts == 1)
            }
            None => assert(false)
        }
        None => assert(false)
    }
}

test "restart: without a snapshot there is nothing to resume" {
    mut world = MemoryWorld.at(1000)
    assert(!has_snapshot(world))
}

// ----- the journal and the snapshot -----

test "journal: lines parse, one trace, steps without gaps" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    feed(e1, world, user_says("hi"))
    feed(e1, world, agent_chunk("agent-1", "a"))
    mut e2 = resumed(world)
    dispatch(e2, world)
    feed(e2, world, agent_done("agent-1"))
    feed(e2, world, agent_done("agent-1"))
    feed(e2, world, agent_done("agent-9"))
    ro entries = world.journal_entries()
    assert(entries.len() == world.journal.len())
    ro last = e2.step_number()
    mut seen = []int.new()
    mut previous = 0
    for entry in entries {
        assert(entry.trace == e2.trace())
        assert(entry.step >= previous)
        assert(entry.cause.byte_len() > 0)
        assert(entry.state.byte_len() > 0)
        assert(entry.step >= 1 && entry.step <= last)
        previous = entry.step
        if !seen.contains(entry.step) { seen.push(entry.step) }
    }
    assert(seen.len() == last)
    match world.snapshots.get("chat-1") {
        Some(snapshot) => assert(snapshot.step == last)
        None => assert(false)
    }
}

test "journal: request line and send mark carry the request id" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    feed(e, world, agent_done("agent-1"))
    ro entries = world.journal_entries()
    ro requests = of_code(entries, "request_ordered")
    ro sent = of_code(entries, "request_sent")
    assert(requests.len() == 1)
    assert(sent.len() == 1)
    assert(requests[0].request == "agent-1")
    assert(sent[0].request == "agent-1")
    assert(codes_of(entries, "request_closed") == 1)
    assert(codes_of(entries, "machine_finished") == 1)
    assert(world.saves == e.step_number())
}

// ----- UTF-8 -----

test "UTF-8: Cyrillic goes through request, journal, snapshot, answer" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("Привет, как дела? Ёжик, щётка"))
    assert(world.sent[0].input == "Привет, как дела? Ёжик, щётка")
    feed(e, world, agent_chunk("agent-1", "Отлично, "))
    feed(e, world, agent_chunk("agent-1", "спасибо"))
    feed(e, world, agent_done("agent-1"))
    assert(answer_of(e) == "Отлично, спасибо")
    mut in_journal = false
    for line in world.journal {
        if line.contains("Привет, как дела? Ёжик, щётка") { in_journal = true }
    }
    assert(in_journal)
    match world.snapshots.get("chat-1") {
        Some(snapshot) => assert(snapshot.data.contains("Отлично, спасибо"))
        None => assert(false)
    }
    mut e2 = resumed(world)
    assert(answer_of(e2) == "Отлично, спасибо")
}

// ----- determinism -----

test "determinism: two worlds give the same journal and snapshot" {
    mut first = MemoryWorld.at(5000)
    mut ea = begin(first)
    feed(ea, first, user_says("привет"))
    first.advance(40)
    feed(ea, first, agent_chunk("agent-1", "part"))
    first.advance(40)
    feed(ea, first, agent_done("agent-1"))

    mut second = MemoryWorld.at(5000)
    mut eb = begin(second)
    feed(eb, second, user_says("привет"))
    second.advance(40)
    feed(eb, second, agent_chunk("agent-1", "part"))
    second.advance(40)
    feed(eb, second, agent_done("agent-1"))

    assert(first.journal.len() == second.journal.len())
    mut i = 0
    while i < first.journal.len() {
        assert(first.journal[i] == second.journal[i])
        i += 1
    }
    match first.snapshots.get("chat-1") {
        Some(sa) => match second.snapshots.get("chat-1") {
            Some(sb) => assert(sa.data == sb.data)
            None => assert(false)
        }
        None => assert(false)
    }
}

// ----- acknowledgement of incoming events (task 095) -----

test "ack: sent after the commit, key in the journal line" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    ro saves_before = world.saves
    world.deliver(Incoming.from_source("acp-7", agent_chunk("agent-1", "a")))
    assert(pump(e, world) == 1)
    assert(world.acked.len() == 1)
    assert(world.acked[0] == "acp-7")
    // at the moment of the ack the snapshot of the step was already saved (the commit point)
    assert(world.saves_at_ack[0] == saves_before + 1)
    ro on_event = of_code(world.journal_entries(), "event_accepted")
    assert(on_event[on_event.len() - 1].event.value_of("source") == Some("acp-7"))
}

test "ack: an event without a key is not acknowledged" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    world.deliver(agent_chunk("agent-1", "a"))
    assert(pump(e, world) == 1)
    assert(world.acked.len() == 0)
}

test "ack: a discarded event is acknowledged too" {
    mut world = MemoryWorld.at(1000)
    mut e = begin(world)
    feed(e, world, user_says("hi"))
    feed(e, world, agent_done("agent-1"))
    world.deliver(Incoming.from_source("acp-9", agent_chunk("agent-1", "late")))
    assert(pump(e, world) == 1)
    assert(world.acked.len() == 1)
    assert(world.acked[0] == "acp-9")
}

test "ack: restart re-acknowledges the committed key only" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    feed(e1, world, user_says("hi"))
    accept_only(e1, world, Incoming.from_source("acp-1", agent_chunk("agent-1", "one ")))
    // the process dies here: the step of acp-1 is committed, the ack was not made
    assert(world.acked.len() == 0)
    mut e2 = resumed(world)
    pump(e2, world)
    assert(world.acked.len() == 1)
    assert(world.acked[0] == "acp-1")
    // a second restart acknowledges it once more (the ack is idempotent for the handler) and nothing else
    mut e3 = resumed(world)
    pump(e3, world)
    assert(world.acked.len() == 2)
    assert(world.acked[1] == "acp-1")
}

test "ack: an uncommitted event is not acknowledged" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    feed(e1, world, user_says("hi"))
    // taken from the agent, the process dies before accept: nothing in the journal, no ack
    mut e2 = resumed(world)
    pump(e2, world)
    assert(world.acked.len() == 0)
}

// the line of an incoming event written by a step that died before its snapshot
fn dead_event_line(trace str, step int, key str) -> JournalEntry => {
    trace, step, cause: "progress-9", state: "Awaiting", request: "agent-1", at: 1500,
    event: journal_event("event_accepted", [param("kind", "progress"), param("name", "agent_chunk"), param("source", key)])
}

test "ack: dead step lines are not committed after the next restart" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    feed(e1, world, user_says("hi"))
    // a step that did not commit: its journal lines are there, its snapshot is not
    world.journal.push(journal_line(dead_event_line(e1.trace(), e1.step_number() + 1, "acp-1")))
    // the restart takes the number of the dead step for its own line and saves the snapshot of that number
    mut e2 = resumed(world)
    pump(e2, world)
    assert(world.acked.len() == 0)
    // the process dies again before anything else is committed: the old lines now carry a number that the snapshot has,
    // but they stand BEFORE the restart line of that number, so they are still the lines of a step that did not commit
    mut e3 = resumed(world)
    pump(e3, world)
    assert(world.acked.len() == 0)
    // and the event that was really committed afterwards is acknowledged by the next restart
    accept_only(e3, world, Incoming.from_source("acp-1", agent_chunk("agent-1", "again")))
    mut e4 = resumed(world)
    pump(e4, world)
    assert(world.acked.len() == 1)
    assert(world.acked[0] == "acp-1")
}

// ----- a journal of the old form (task 102) -----

// The kind an old engine wrote for the code of a line (the codes of the machine were all notes).
fn old_kind(code str) -> str {
    if code == "machine_started" { return "start" }
    if code == "event_accepted" { return "event" }
    if code == "reply_discarded" { return "discarded" }
    if code == "request_ordered" { return "request" }
    if code == "request_sent" { return "sent" }
    if code == "request_closed" { return "closed" }
    if code == "cancel_ordered" { return "cancel" }
    if code == "snapshot_ordered" { return "snapshot" }
    if code == "machine_finished" { return "finish" }
    if code == "engine_resumed" { return "restart" }
    "note"
}

// The line of an entry in the form of the engine before task 102: `kind` and `text`, the key of the source at the end of the text of an event.
fn old_line(entry JournalEntry) -> str {
    mut o = JsonObject.new()
    put(o, "trace", JsonValue.str(entry.trace))
    put(o, "step", JsonValue.int(entry.step))
    put(o, "cause", JsonValue.str(entry.cause))
    put(o, "state", JsonValue.str(entry.state))
    put(o, "request", JsonValue.str(entry.request))
    put(o, "at", JsonValue.int(entry.at))
    put(o, "kind", JsonValue.str(old_kind(entry.event.code)))
    ro source = match entry.event.value_of("source") {
        Some(key) => " src=${key}"
        None => ""
    }
    put(o, "text", JsonValue.str("${entry.event.value_of("kind") ?? "x"}/${entry.event.value_of("name") ?? "y"}${source}"))
    JsonValue.object(o).to_str()
}

test "old journal: a restart over lines of the old form reads the marks, sends nothing again and re-acknowledges the committed key" {
    mut world = MemoryWorld.at(1000)
    mut e1 = begin(world)
    feed(e1, world, user_says("hi"))
    accept_only(e1, world, Incoming.from_source("acp-1", agent_chunk("agent-1", "one ")))
    assert(world.sent.len() == 1)
    mut old = []str.new()
    for entry in world.journal_entries() { old.push(old_line(entry)) }
    world.journal = old
    mut e2 = resumed(world)
    dispatch(e2, world)
    pump(e2, world)
    assert(world.sent.len() == 1)
    assert(e2.open_ids().len() == 1)
    assert(world.acked.len() == 1)
    assert(world.acked[0] == "acp-1")
    // the new restart line stands after the old lines
    ro restart = of_code(world.journal_entries(), "engine_resumed")
    assert(restart.len() == 1)
}
