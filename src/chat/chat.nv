// chat.nv - the demo machine: a chat session with an agent.
//
// The MVP machine of the product ("a chat session with an agent"); on it the properties of the engine
// are shown. It lives beside the engine, not in it: the engine does not know it (the module `engine` does
// not import `chat`), the machine knows the engine only through its types.
//
// States: Idle (waits for a user message), Awaiting (a request to the agent is open), Done (the agent
// answered), Failed (refused, cancelled by the user, no answer in time).
// Events: UserMessage(text), AgentChunk(text), AgentDone, AgentRefused(code), Cancel, Timeout.
// Orders to the environment: send a request to the agent, write a journal event, save the snapshot, cancel the
// request, finish.
//
// `step` takes the typed state and the event and returns the transition; nothing else is read: no input-output,
// no clock, no random. The typed core is `chat_step` (state and event as sum types); `ChatSession.step` maps the
// incoming event of the engine to a `ChatEvent` and calls the core. The state is encoded only at the border of
// the snapshot (`encode_state`, `decode_state`).
module crew_harness.chat

import alula.engine.{Incoming, EventKind, Environment, Transition, SendOrder, CancelOrder, Conclusion, FailCode, JournalParam, param, journal_event, fail_code_word}
import std.encoding.json.{Json, JsonValue, JsonObject}

/// ChatState: where the session is.
export type ChatState enum
    | Idle
    | Awaiting { user str, reply str }
    | Done { reply str }
    | Failed { code FailCode }

/// ChatEvent: what happens to the session, as the machine understands the events of the engine.
export type ChatEvent enum
    | UserMessage(str)
    | AgentChunk(str)
    | AgentDone
    | AgentRefused(FailCode)
    | Cancel
    | Timeout

/// ChatSession: the machine. `party` is the id of the agent as a party of requests, `idle_term` the idle term in ms.
/// `multi` - the session is open for many turns: the end of a turn (answer, refusal, timeout, cancel) brings it back to Idle
/// instead of ending it; the single-turn session (`multi` false) ends with the first answer or refusal (tasks 091, 095).
export type ChatSession { party str, idle_term int, multi bool }

/// The session with the default agent party and the idle term of 30 seconds.
export fn chat_session() -> ChatSession => { party: "agent", idle_term: 30000, multi: false }

/// The many-turn session (task 099): after an answer, a refusal, a timeout or a cancel of the turn it stays open and takes the
/// next message. `idle_term` is the idle term of a turn in milliseconds.
export fn dialog_session(idle_term int) -> ChatSession => { party: "agent", idle_term, multi: true }

// ----- the text form of the state (the border of the snapshot) -----

fn put(mut o JsonObject, key str, value JsonValue) -> () {
    ro replaced = o.insert(key, value)
}

fn text_of(o JsonObject, key str) -> Option[str] {
    match o.get(key) {
        Some(v) => v.str()
        None => None
    }
}

/// The state as one line of JSON.
export fn encode_chat_state(state ChatState) -> str {
    mut o = JsonObject.new()
    match state {
        Idle => put(o, "state", JsonValue.str("Idle"))
        Awaiting { user, reply } => {
            put(o, "state", JsonValue.str("Awaiting"))
            put(o, "user", JsonValue.str(user))
            put(o, "reply", JsonValue.str(reply))
        }
        Done { reply } => {
            put(o, "state", JsonValue.str("Done"))
            put(o, "reply", JsonValue.str(reply))
        }
        Failed { code } => {
            put(o, "state", JsonValue.str("Failed"))
            put(o, "code", JsonValue.str(code.name()))
        }
    }
    JsonValue.object(o).to_str()
}

/// The state from its text; text that is not a state of the machine is `None`.
export fn decode_chat_state(text str) -> Option[ChatState] {
    ro o = match Json.parse(text) {
        Ok(v) => v.object()?
        Err(e) => return None
    }
    ro name = text_of(o, "state")?
    if name == "Idle" { return Some(Idle) }
    if name == "Awaiting" {
        ro user = text_of(o, "user")?
        ro reply = text_of(o, "reply")?
        return Some(Awaiting { user, reply })
    }
    if name == "Done" {
        ro reply = text_of(o, "reply")?
        return Some(Done { reply })
    }
    if name == "Failed" {
        ro code = text_of(o, "code")?
        return Some(Failed { code: FailCode.of(code) })
    }
    None
}

/// The name of a state.
export fn chat_state_name(state ChatState) -> str => match state {
    Idle => "Idle"
    Awaiting { user, reply } => "Awaiting"
    Done { reply } => "Done"
    Failed { code } => "Failed"
}

// ----- the events -----

/// The event of the machine for an incoming event of the engine; `None` - the machine does not know it.
export fn chat_event_of(event Incoming) -> Option[ChatEvent] {
    match event.kind {
        EventKind.Input => {
            if event.name == "user_message" { return Some(UserMessage(event.input)) }
            if event.name == "cancel" { return Some(Cancel) }
            None
        }
        EventKind.Progress => {
            // only a chunk of text is a part of the answer; a tool, a plan, a usage count, a permission request and the like
            // renew the idle term (the engine does that by the kind) and are for the journal and the page
            if event.name == "agent_chunk" { return Some(AgentChunk(event.input)) }
            None
        }
        EventKind.Answered => Some(AgentDone)
        EventKind.Refused => Some(AgentRefused(FailCode.of(event.input)))
        EventKind.Expired => Some(Timeout)
    }
}

/// The events of the outside world as the creator of an event builds them (the envelope is stamped by the engine).
export fn user_says(text str) -> Incoming => Incoming.word("user_message", text)

export fn user_cancels() -> Incoming => Incoming.word("cancel", "")

export fn agent_chunk(request str, text str) -> Incoming => Incoming.incoming(EventKind.Progress, "agent_chunk", Some(request), text)

export fn agent_done(request str) -> Incoming => Incoming.incoming(EventKind.Answered, "agent_done", Some(request), "")

export fn agent_refused(request str, code FailCode) -> Incoming => Incoming.incoming(EventKind.Refused, "agent_refused", Some(request), code.name())

// ----- the step -----

fn event_label(event ChatEvent) -> str => match event {
    UserMessage(text) => "user_message"
    AgentChunk(text) => "agent_chunk"
    AgentDone => "agent_done"
    AgentRefused(code) => "agent_refused"
    Cancel => "cancel"
    Timeout => "timeout"
}

// An event the state does not expect: nothing changes, a journal event is left.
fn ignored(state ChatState, event ChatEvent, mut environment Environment) -> Transition[ChatState] {
    environment.write_journal(journal_event("event_ignored", [param("event", event_label(event)), param("state", chat_state_name(state))]))
    Stay
}

fn finish_answer(text str, mut environment Environment) -> () {
    environment.order_finish(Conclusion { failure: None, text })
}

fn finish_refusal(code FailCode, text str, mut environment Environment) -> () {
    environment.order_finish(Conclusion { failure: Some(code), text })
}

// The many-turn session while a request is open: the chunks collect, every end of the turn brings the session back to Idle.
fn dialog_awaiting(session ChatSession, state ChatState, event ChatEvent, mut environment Environment) -> Transition[ChatState] {
    match state {
        Awaiting { user, reply } => match event {
            AgentChunk(text) => {
                environment.write_journal(journal_event("agent_chunk", [param("text", text)]))
                environment.order_save()
                Go(Awaiting { user, reply: "${reply}${text}" })
            }
            AgentDone => {
                environment.write_journal(journal_event("agent_done", []JournalParam.new()))
                environment.order_save()
                Go(Idle)
            }
            AgentRefused(code) => {
                environment.write_journal(journal_event("agent_refused", [param("code", fail_code_word(code))]))
                environment.order_save()
                Go(Idle)
            }
            Cancel => {
                environment.write_journal(journal_event("cancelled_while_waiting", []JournalParam.new()))
                environment.order_cancel(CancelOrder { party: session.party })
                environment.order_save()
                Go(Idle)
            }
            Timeout => {
                environment.write_journal(journal_event("no_answer_in_time", []JournalParam.new()))
                environment.order_save()
                Go(Idle)
            }
            _ => ignored(state, event, environment)
        }
        _ => ignored(state, event, environment)
    }
}

/// The typed core of the machine: the transition and the orders for a state and an event. Nothing but its arguments is read.
export fn chat_step(session ChatSession, state ChatState, event ChatEvent, mut environment Environment) -> Transition[ChatState] {
    match state {
        Idle => match event {
            UserMessage(text) => {
                environment.write_journal(journal_event("user_message", [param("text", text)]))
                environment.order_send(SendOrder { party: session.party, input: text, idle_term: session.idle_term })
                environment.order_save()
                Go(Awaiting { user: text, reply: "" })
            }
            Cancel => if session.multi { ignored(state, event, environment) } else {
                environment.write_journal(journal_event("cancelled_before_request", []JournalParam.new()))
                finish_refusal(FailCode.StoppedByHuman, "cancelled by the user", environment)
                environment.order_save()
                Go(Failed { code: FailCode.StoppedByHuman })
            }
            _ => ignored(state, event, environment)
        }
        Awaiting { user, reply } => if session.multi { dialog_awaiting(session, state, event, environment) } else { match event {
            AgentChunk(text) => {
                environment.write_journal(journal_event("agent_chunk", [param("text", text)]))
                environment.order_save()
                Go(Awaiting { user, reply: "${reply}${text}" })
            }
            AgentDone => {
                environment.write_journal(journal_event("agent_done", []JournalParam.new()))
                finish_answer(reply, environment)
                environment.order_save()
                Go(Done { reply })
            }
            AgentRefused(code) => {
                environment.write_journal(journal_event("agent_refused", [param("code", fail_code_word(code))]))
                finish_refusal(code, "the agent refused", environment)
                environment.order_save()
                Go(Failed { code })
            }
            Cancel => {
                environment.write_journal(journal_event("cancelled_while_waiting", []JournalParam.new()))
                environment.order_cancel(CancelOrder { party: session.party })
                finish_refusal(FailCode.StoppedByHuman, "cancelled by the user", environment)
                environment.order_save()
                Go(Failed { code: FailCode.StoppedByHuman })
            }
            Timeout => {
                environment.write_journal(journal_event("no_answer_in_time", []JournalParam.new()))
                finish_refusal(FailCode.Timeout, "no answer in time", environment)
                environment.order_save()
                Go(Failed { code: FailCode.Timeout })
            }
            _ => ignored(state, event, environment)
        } }
        Done { reply } => ignored(state, event, environment)
        Failed { code } => ignored(state, event, environment)
    }
}

// ----- the machine for the engine (protocol `Machine[ChatState]`) -----

/// The name of the machine for the journal: the many-turn session is "DialogSession", the name of its table `dialog.portolan.md` (task 114).
export fn ChatSession @name() -> str => if @multi { "DialogSession" } else { "ChatSession" }

/// The initial state: Idle.
export fn ChatSession @initial() -> ChatState => Idle

/// The name of a state.
export fn ChatSession @state_name(state ChatState) -> str => chat_state_name(state)

/// One step: the incoming event is mapped to a `ChatEvent` and goes to the core; an event the machine does not know is a
/// journal event, not a crash.
export fn ChatSession @step(current ChatState, event Incoming, mut environment Environment) -> Transition[ChatState] {
    match chat_event_of(event) {
        None => {
            environment.write_journal(journal_event("event_unknown", [param("name", event.name)]))
            Stay
        }
        Some(chat_event) => chat_step(@, current, chat_event, environment)
    }
}

/// The state as text, for the snapshot.
export fn ChatSession @encode_state(state ChatState) -> str => encode_chat_state(state)

/// The state from its text; text that is not a state is `None`.
export fn ChatSession @decode_state(text str) -> Option[ChatState] => decode_chat_state(text)
