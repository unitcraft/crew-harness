// chat_test.nv - the chat machine written as tables (machines/chat.alula.md) and its translation: the same tree as the hand-written chat.alula.json.
module crew_harness.machine_text_machines

// ORACLE-WORKAROUND(32): `std.fs` is imported first in the first file of the unit (the machines are read from the disk, task 248), or `.join` on a `[]str` is E_RECV_METHOD_MISMATCH (spikes/env/README.md, task 116 (e)); drop when item 32 is fixed
import std.fs.{Path}
import std.text
import std.encoding.json.{Json, JsonValue, JsonObject}
import crew_harness.machines.{chat_machine_text, chat_table_text, translation_files, product_registry}
import alula.machine_text.{TranslateError, error_text, translate_checked_with}

// The translation of the table of the chat with the libraries beside it (Alula 2.26, task 240: the chat connects the library of the cancel `libs/call_cancel.alula.md`), with the check:
// the tree carries the reads of the states that the check derives (AL-138).
fn chat_translation() -> Result[str, []TranslateError] {
    ro report = translate_checked_with(chat_table_text(), product_registry(), translation_files())
    if report.errors.len() > 0 { return Err(report.errors) }
    Ok(report.json)
}

fn errors_line(problems []TranslateError) -> str {
    mut parts = []str.new()
    for e in problems { parts.push(error_text(e, "chat.alula.md")) }
    parts.join(" ## ")
}

// The first place where two JSON values differ (`$.states[1].rows[0]`), or the empty text.
fn diff_path(first JsonValue, second JsonValue, path str) -> str {
    match first.object() {
        Some(fo) => {
            match second.object() {
                Some(so) => {
                    for key in fo.keys() {
                        match fo.get(key) {
                            Some(fv) => {
                                match so.get(key) {
                                    Some(sv) => {
                                        ro inner = diff_path(fv, sv, "${path}.${key}")
                                        if inner != "" { return inner }
                                    }
                                    None => return "${path}.${key} (only in the first)"
                                }
                            }
                            None => ()
                        }
                    }
                    for key in so.keys() {
                        if !fo.contains(key) { return "${path}.${key} (only in the second)" }
                    }
                    return ""
                }
                None => return path
            }
        }
        None => ()
    }
    match first.array() {
        Some(fa) => {
            match second.array() {
                Some(sa) => {
                    if fa.len() != sa.len() { return "${path} (length ${fa.len()} and ${sa.len()})" }
                    mut i = 0
                    while i < fa.len() {
                        ro inner = diff_path(fa[i], sa[i], "${path}[${i}]")
                        if inner != "" { return inner }
                        i += 1
                    }
                    return ""
                }
                None => return path
            }
        }
        None => ()
    }
    if first == second { return "" }
    // an internal name (a constant, a party, a binding) is written to the tree as the author wrote it (AL-46): the table in Russian has it in Cyrillic, the hand-written tree in Latin letters
    match first.str() {
        Some(text) => {
            if has_cyrillic_letter(text) { return "" }
        }
        None => ()
    }
    path
}

fn has_cyrillic_letter(text str) -> bool {
    for c in text.chars() {
        if (c as int) >= 1024 && (c as int) < 1280 { return true }
    }
    false
}

// Two machines written as JSON text: where they differ, the keys `title` and `alula_version` of the root not counted.
fn machine_diff(first_text str, second_text str) -> str {
    match Json.parse(first_text) {
        Ok(a) => {
            match Json.parse(second_text) {
                Ok(b) => {
                    match a.object() {
                        Some(ao) => {
                            match b.object() {
                                Some(bo) => {
                                    mut ac = JsonObject.new()
                                    mut bc = JsonObject.new()
                                    for k in ao.keys() {
                                        if k != "title" && k != "alula_version" {
                                            match ao.get(k) {
                                                Some(v) => { ro old = ac.insert(k, v) }
                                                None => ()
                                            }
                                        }
                                    }
                                    for k in bo.keys() {
                                        if k != "title" && k != "alula_version" {
                                            match bo.get(k) {
                                                Some(v) => { ro old = bc.insert(k, v) }
                                                None => ()
                                            }
                                        }
                                    }
                                    return diff_path(JsonValue.object(ac), JsonValue.object(bc), "$")
                                }
                                None => return "not an object"
                            }
                        }
                        None => return "not an object"
                    }
                }
                Err(e) => return "the second text is not JSON"
            }
        }
        Err(e) => return "the first text is not JSON"
    }
}

test "chat translates" {
    match chat_translation() {
        Ok(json) => assert(json.contains("\"machine\":\"ChatSession\""))
        Err(problems) => panic(errors_line(problems))
    }
}

test "chat equals" {
    match chat_translation() {
        Ok(json) => {
            ro where = machine_diff(json, chat_machine_text())
            if where != "" { panic("differs at ${where}") }
            assert(where == "")
        }
        Err(problems) => panic(errors_line(problems))
    }
}

test "chat diff sees" {
    match chat_translation() {
        Ok(json) => {
            assert(machine_diff(json.replace("cancelled by the user", "cancelled by a user"), chat_machine_text()) != "")
            assert(machine_diff(json.replace("\"to\":\"Awaiting\"", "\"to\":\"Failed\""), chat_machine_text()).starts_with("$.states[0].rows[0].to"))
            assert(machine_diff(json.replace("\"n\":2,", "\"n\":3,"), chat_machine_text()) != "")
            assert(machine_diff(json.replace("\"counter\":\"agent_attempt\"", "\"counter\":\"agent_attempts\""), chat_machine_text()).starts_with("$.parties[1].counter"))
            assert(machine_diff(json, json) == "")
        }
        Err(problems) => panic(errors_line(problems))
    }
    assert(machine_diff("{\"a\":[1,2]}", "{\"a\":[1,3]}") == "$.a[1]")
    assert(machine_diff("{\"a\":1}", "{\"a\":1,\"b\":2}") == "$.b (only in the second)")
    assert(machine_diff("{\"a\":{\"x\":1}}", "{\"a\":{\"x\":1}}") == "")
}
