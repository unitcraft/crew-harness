// cases_test.nv - the cases of the task: the pilot "Agent step" brought to format 2.5, the examples of the format, the
// definitions of the meeting with the file of the cycle arithmetic (the hash of the format), the fragment "Pause".
module crew_harness.machine_text_eq_machines

import std.text
import alula.machine.{Registry, Primitive, ParamSpec, TextType, ListType, Volatile, register, NamedText, find_primitive}
import alula.machine_table.{parse_machine, load_machine}
import alula.machine_run.{load_alula_machine}
import alula.machine_text.{translate_report_with, translate_checked_with, TranslateReport, TranslateError, translate_definitions, DefsReport, definitions_hash, normalize_definitions, render_summary, error_text}
import crew_harness.machines.{methodology_registry, library_files}
import alula.machine_text_eq.{case_text}

test "cs pilot loads" {
    ro report = translate_checked_with(case_text("agent-step.alula.md"), methodology_registry(), library_files())
    match load_machine(report.json, methodology_registry()) {
        Ok(def) => {
            assert(def.name == "agent_step")
            // The package's pilot fixture no longer connects Pause (0.9.1).
            assert(def.states.len() == 13)
            assert(def.common.len() == 0)
            assert(def.parties.len() == 2)
            assert(def.data.len() == 17)
            assert(def.definitions.len() == 16)
            assert(def.error_end == "Errored")
            assert(def.end_rows.len() == 13)
            assert(def.primitives.len() == 2)
        }
        Err(issues) => panic("the pilot does not load: ${issues[0].path}: ${issues[0].message}")
    }
}

test "cs pilot builds" {
    ro report = translate_checked_with(case_text("agent-step.alula.md"), methodology_registry(), library_files())
    match load_alula_machine(report.json, methodology_registry()) {
        Ok(m) => {
            assert(m.name() == "agent_step")
            assert(m.state_name(m.initial()) == "Start")
        }
        Err(e) => panic("the pilot machine is not made: ${e}")
    }
}
