/// The text of the machine of the chat session (`machines/product/chat.alula.json`).
export fn chat_machine_text() -> str => embed_str("../../machines/product/chat.alula.json")

/// The text of the machine of the many-turn chat session (`machines/product/dialog.alula.json`), the translation of `dialog.alula.md`: the machine that the session server runs.
export fn dialog_machine_text() -> str => embed_str("../../machines/product/dialog.alula.json")

/// The table of the journal codes of the product (`machines/product/journal.md`): `user_message`, `agent_chunk`, `agent_done`, `agent_refused`, `cancelled_while_waiting`, `no_answer_in_time`,
/// `cancelled_before_request`, `session_closed`, `turn_answered`, `turn_refused`.
export fn product_journal_text() -> str => embed_str("../../machines/product/journal.md")

/// The registry of the host "product": the language and the codes of the journal of the product.
export fn product_registry() -> Registry {
    match load_host("", product_journal_text()) {
        Ok(reg) => reg
        Err(errors) => panic("the registry of the product is wrong: ${errors.join(" | ")}")
    }
}
