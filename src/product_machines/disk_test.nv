// disk_test.nv - the machines of the product are read from a folder on the disk, not compiled in (task 248): the folder of the tree loads and
// passes the checks; a missing file, an alula_version that is not the one of the engine and a hash of a library that is not the hash of the file
// are errors that name the path; a file put in place of another is what the loader gives; no `embed_str` is left in the data of the machines.
module crew_harness.product_machines

import std.fs.{Fs, real_fs, Path, write_text, create_dir_all, remove_dir_all}
import alula.machine.{NamedText}
import std.os.{Os, real_os, temp_dir, pid}

// A copy of the machines of the tree (with the chat, which the kit does not hold) in a folder of its own under the temporary folder: in the files whose name starts with `target` the text
// `from` is `to`; `drop` - those files are not written.
fn dk_copy(name str, target str, from str, to str, drop bool) -> str {
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("crew-machines-test-${id}-${name}")
    mut files = tree_product_machines().files
    for chat in ["chat.alula.json", "chat.alula.md"] { files.push(NamedText { name: chat, text: tree_text("machines/product/${chat}") }) }
    with Fs = real_fs() {
        ro removed = remove_dir_all(dir)
        ro made = create_dir_all(dir.join("libs"))
        for f in files {
            ro hit = f.name.starts_with(target)
            ro text = if hit { f.text.replace(from, to) } else { f.text }
            if !(hit && drop) {
                match write_text(Path.from_bytes("${dir.display()}/${f.name}".bytes()), text) {
                    Ok(done) => ()
                    Err(e) => panic("the copy of ${f.name} cannot be written")
                }
            }
        }
    }
    dir.display()
}

fn dk_error(dir str) -> str {
    match load_product_machines(dir) {
        Ok(m) => ""
        Err(e) => e
    }
}

test "disk: the machines of the tree are read from machines/product and pass the checks" {
    match load_product_machines(tree_machines_dir()) {
        Ok(m) => {
            assert(m.dialog().contains("\"machine\":\"DialogSession\""))
            assert(m.dialog_table().starts_with("# Машина: Диалог с агентом"))
            assert(m.dialog_table().contains("- alula_version: 0.28"))
            assert(m.text("libs/call_cancel.alula.md").contains("- library: call_cancel"))
            assert(m.journal().contains("`user_message`"))
            assert(m.files.len() == 4)
            assert(m.text("chat.alula.json") == "")
            match m.registry() {
                Ok(reg) => assert(reg.journal.len() > 35)
                Err(e) => panic(e)
            }
        }
        Err(e) => panic(e)
    }
}

test "disk: the kit needs no chat: a folder of the dialog, its library and the journal loads" {
    ro dir = dk_copy("no-chat", "chat.", "", "", true)
    assert(dk_error(dir) == "")
}

test "disk: a missing file is an error that names its path" {
    ro dir = dk_copy("missing", "dialog.alula.md", "", "", true)
    ro e = dk_error(dir)
    assert(e.contains("${dir}/dialog.alula.md"))
    assert(e.contains("missing"))
    ro dir2 = dk_copy("missing-lib", "libs/", "", "", true)
    assert(dk_error(dir2).contains("${dir2}/libs/call_cancel.alula.md"))
}

test "disk: a tree, a table or a library of another alula_version is refused" {
    ro tree = dk_copy("version-tree", "dialog.alula.json", "\"alula_version\":\"0.28\"", "\"alula_version\":\"0.27\"", false)
    ro e = dk_error(tree)
    assert(e.contains("${tree}/dialog.alula.json"))
    assert(e.contains("alula_version 0.27"))
    assert(e.contains("0.28"))
    ro table = dk_copy("version-table", "dialog.alula.md", "- alula_version: 0.28", "- alula_version: 0.27", false)
    assert(dk_error(table).contains("${table}/dialog.alula.md"))
    ro lib = dk_copy("version-lib", "libs/", "- alula_version: 0.28", "- alula_version: 0.27", false)
    assert(dk_error(lib).contains("call_cancel.alula.md"))
}

test "disk: a library whose definitions_hash is not the hash of the connection is refused" {
    ro dir = dk_copy("hash", "libs/", "## Общие события", "Лишняя строка.\n\n## Общие события", false)
    ro e = dk_error(dir)
    assert(e.contains("${dir}/libs/call_cancel.alula.md"))
    assert(e.contains("2afbf89d9d64"))
    assert(e.contains("hash"))
}

test "disk: a file put in the folder is the machine the loader gives" {
    ro dir = dk_copy("swap", "dialog.alula.json", "\"Idle\"", "\"Resting\"", false)
    match load_product_machines(dir) {
        Ok(m) => {
            assert(m.dir == dir)
            assert(m.dialog().contains("\"initial\":\"Resting\""))
        }
        Err(e) => panic(e)
    }
}

test "disk: the folder of the machines is the setting, else beside the program, else the build of the tree" {
    assert(pm_join(machines_dir_candidates("C:/work/kit/crew-hub.exe"), "|") == "C:/work/kit/machines/product|C:/work/kit/../machines/product")
    assert(pm_join(machines_dir_candidates("C:\\kit\\crew-hub.exe"), "|") == "C:\\kit/machines/product|C:\\kit/../machines/product")
    assert(pm_join(machines_dir_candidates("crew-hub.exe"), "|") == "./machines/product|./../machines/product")
    match find_machines_dir("", "${tree_machines_dir()}/../../target/crew-hub.exe") {
        Ok(d) => assert(d.ends_with("/../machines/product"))
        Err(e) => panic(e)
    }
    match find_machines_dir("C:/work/nowhere/machines", "C:/work/kit/crew-hub.exe") {
        Ok(d) => assert(d == "C:/work/nowhere/machines")
        Err(e) => panic(e)
    }
    match find_machines_dir("", "C:/work/nowhere/kit/crew-hub.exe") {
        Ok(d) => panic("a folder without machines was taken: ${d}")
        Err(e) => {
            assert(e.contains("C:/work/nowhere/kit/machines/product"))
            assert(e.contains("CREW_SERVER_MACHINES_DIR"))
        }
    }
}

test "disk: nothing of machines/ is compiled into the programs" {
    for source in ["src/product_machines/data.nv", "src/machines/data.nv"] {
        ro text = tree_text(source)
        assert(!text.contains("embed_str(\""))
        assert(!text.contains("embed_dir(\""))
    }
}
