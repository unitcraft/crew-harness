#!/bin/sh
# Зачем: остановить коммит с секретом, путём машины, запрещённым именем, порчей текста, битой ссылкой или
#     неверным форматом документа задачи до того, как он попадёт в историю.
# Проверяет: страж индекса (guard-secrets.py --index) и все стражи дерева по маске check-* через run-all.sh --index
#     по содержимому индекса в том виде, как его видит хук (с --only git подставляет временный индекс).
# Не проверяет: сообщение коммита (хук commit-msg) и пуш (хук pre-push); рабочую копию вне индекса.
# Правило: AGENTS.md п.15 (приватные данные), п.4 (коммиты); ADR-0006.
#
# Код возврата решается ДО печати: вывод стражей идёт через буфер, сам хук в stdout не пишет,
# поэтому обрезанный вывод («git commit … | head -1») не превращает отказ в успех.
trap '' PIPE
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "FAIL: предпосылка: хук запущен вне репозитория git"; exit 1; }
# shellcheck disable=SC1091
. "$root/scripts/guards/lib/find-python.sh"
find_python || exit 1

gitdir=$(git rev-parse --git-dir 2>/dev/null)
buf="$gitdir/guards-precommit-out.$$"
if ! : > "$buf" 2>/dev/null; then
  buf=$(mktemp 2>/dev/null) || { echo "FAIL: предпосылка: нет места для буфера вывода"; exit 1; }
fi
trap 'rm -f "$buf"' EXIT HUP INT TERM

rc=0
sh "$root/scripts/guards/run-all.sh" --index >> "$buf" 2>&1 || rc=1
$PYTHON "$root/scripts/guards/guard-secrets.py" --index >> "$buf" 2>&1 || rc=1

cat "$buf" 2>/dev/null || true
exit "$rc"
